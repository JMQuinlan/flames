#@ [t38_ma11_stl_3d_wide]
#@ exe=hydro2
#@ dim=3

# =============================================================================
# FlowTryonFun -- T-38 Talon, 3D transonic/supersonic flow over an EMBEDDED
# SOLID from an STL CAD mesh (IC::STL -> self-contained Util::STL signed distance ->
# diffuse phi), at PHYSICAL air values and REAL aircraft size (for lift/drag).
# =============================================================================
# Condition: Ma 1.1 at STANDARD SEA LEVEL.
#
#   ATMOSPHERE (sea level):  T = 288.15 K,  p = 101325 Pa,  rho = 1.2250 kg/m^3,
#                            a = 340.29 m/s.   U = Ma*a = 1.1*340.29 = 374.32 m/s.
#   rho*U = 458.55 (kg/m^2 s).   E_per_phase = 0.5*p/(gamma-1) = 126656.25 J/m^3.
#   Freestream dynamic pressure  q_inf = 0.5*rho*U^2 = 85822 Pa.
#
#   GEOMETRY: real T-38 length 14.13 m (46'4.5"), span 7.70 m, height 3.92 m (on its gear).
#   STL t38_clean_xflow.STL (2026-11-14): T38_Solid_Model.stl (download) rotated to +x flow
#   (rotate_stl_xflow.py, nose -x, fin +z), scaled to 14.145 m long, origin-centred, in METRES
#   (scale 1, centre 0).  The download overlaps itself (wings through the fuselage, 12.9k
#   non-manifold edges): the solver's ray-parity inside test read 10% of it (the wings) as
#   fluid.  Cleaned by a winding-number fill on a 2.5 cm grid + marching cubes: watertight,
#   15.12 m^3, parity == winding everywhere.  Span 7.72 m (real 7.70; old STL 7.16 m).
#   -> placed airframe:  x[-7.07, 7.07]  y[-3.87, 3.85]  z[-1.69, 1.68]  (meters).
#
#   LIFT/DRAG: integrate pressure over the phi=0.5 surface; nondimensionalize
#   with q_inf=85822 Pa and S_ref=15.79 m^2 (T-38 wing area):
#     C_L = L/(q_inf*S_ref),  C_D = D/(q_inf*S_ref).
#   Two identical ideal gases (eta=0.5) so the mixture is one perfect-gas air.
#   NOTE Ma 1.1 is faster than the real T-38's ~Ma 1.3 limit only barely; this
#   is a low-supersonic case (detached bow shock + transonic wing flow).
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
#plot_file = ./tests/FlowTryonFun/Planes/T38-Talon/output_Ma1.1
# New folder (2026-11-14): output_Ma1.1_Wide holds the earlier wide run (old STL / meshing);
# writing there would overwrite its plotfiles of the same name.
plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowTryonFun/Planes/T38-Talon/output_Ma1.1_Wide_v2

### MESHING ###
# [2026-11-14] Optimized like the AIAA fuel-droplet LONG decks: a coarse base grid for the
# far field, shocks refined only part way (p_refinement_max_level), and only the airframe
# surface (grad phi) refined to the finest level.  In the old wide set-up (base 0.5 m,
# shocks tagged by grad rho AND grad p up to the finest level) the shock surfaces, which
# grow ~r^2 with distance from the aircraft, held almost all of the work.
#   level : 0     1     2      3       4
#   dx [m]: 1.0   0.5   0.25   0.125   0.0625
#   shocks (grad p) up to level 2 (0.25 m: shock ~0.5-0.75 m thick, ~1% of the
#   BOS comparison window); airframe surface to level 4 (0.0625 m, as before).
amr.plot_dt          = 0.01           # 30 frames: check the pattern is steady (last frames equal)
amr.max_grid_size    = 32
amr.blocking_factor  = 8
amr.regrid_int       = 16             # shocks move <= ~3 cells between regrids (cfl 0.2) < error buffer
amr.grid_eff         = 0.8
amr.max_level        = 4              # dx_finest = 1.0/2^4 = 0.0625 m (surface only)
amr.n_cell           = 48 24 32       # dx = 1.0 m
amr.n_error_buf      = 4
nghost = 4

### DIMENSIONS (meters) -- flow in +X ###
# Airframe x[-7.07, 7.07] y[0, 3.58] z[-1.59, 1.59].  The BOS photograph (reference/
# T38C_BOS_NASA.jpg) spans ~70 m across and ~40 m along the flight path, mostly the lateral
# (y) shock legs, so the half-span direction reaches 24 m (3.4 spans); 9 m upstream of the
# nose, 25 m of wake (the photo shows ~25 m behind the tail).
geometry.prob_lo     = -16.0   0.0 -16.0
geometry.prob_hi     =  32.0  24.0  16.0
geometry.is_periodic = 0 0 0

### TIME STEPPING ###
timestep            = 1e-7
dynamictimestep.on  = 1
dynamictimestep.verbose = 0
dynamictimestep.max = 1e-0
dynamictimestep.min = 1e-10
cfl                 = 0.2
stop_time           = 0.3            # ~2.3 flow-throughs of the 48 m domain (0.128 s each); far-field
                                     # shock legs at r = 24 m settle in ~r/sqrt(U^2-a^2) = 0.15 s

# ----------------------------------------------------------------------------
# EMBEDDED SOLID -- the T-38, from STL.  SHARP SLIP WALL (validated set-up of
# tests/FlowWedge vs the oblique-shock solution):
#   solid.wall_flux = 1: fluid|solid faces are solved as a mirrored wall (no mass or
#     energy crosses, solid cells held at the solid state); solid.brinkman is unused.
#   solid.slip = 1: inviscid (mu = 0) Euler wall.  Also enables the true-surface
#     normal reflection (solid.wall_normal = 1, default) and the wall placed at
#     phi = 0.5 inside the cell (solid.wall_image = 1, default) instead of the
#     staircase faces.  A no-slip mirror would stagnate the flow on every step
#     riser and put an entropy layer on the skin.
#   eps ~ 0.5 dx_finest (0.0625 m): still sharp (~1 cell), but phi keeps the exact
#     sub-cell surface position; eps << dx (a 0/1 step) loses it.  Re-set eps to
#     ~0.5 dx_finest whenever amr.max_level changes.  nghost >= 4 (normal kernel).
# ----------------------------------------------------------------------------
apply_embedded_solid = 1
solid.brinkman       = 8000           # unused with solid.wall_flux = 1 (kept for wall_flux = 0 runs)
solid.wall_flux      = 1
solid.slip           = 1
phi_refinement_criterion = 0.1        # refine on the airframe surface (grad phi)
# Box around the airframe forced to level 2 (0.25 m).  Needed: with a 1 m base grid the
# grad-phi tags alone found nothing at start-up (no level 1 was built); from level 2 the
# grad-phi tags carry the surface to level 4.  Checked 2026-11-14 at initialization: every
# solid cell of a box forced to level 4 (24503 cells) is covered by level 4 here, with 387k
# level-4 cells instead of 2.09M.
refine_box.lo        = -7.6 0.0 -2.2
refine_box.hi        =  7.6 4.4  2.2
refine_box.max_level = 2

# STL geometry IC.  d>0 fluid, d<0 solid -> phi = 0.5*(1+tanh(d/eps)).
solid.phi.ic.type                 = stl
solid.phi.ic.stl.filename         = ./tests/FlowTryonFun/Planes/T38-Talon/t38_clean_xflow.STL
solid.phi.ic.stl.scale            = 1.0               # STL is already in metres (14.145 m long)
solid.phi.ic.stl.center           = 0.0 0.0 0.0       # already origin-centred
solid.phi.ic.stl.eps              = 0.03              # ~0.5 x dx_finest (1.0/2^4 = 0.0625 m)

# Prescribed quiescent solid target (physical air at rest, p=p_inf):
solid.density.ic.type = constant
solid.density.ic.constant.value = 1.2250
solid.momentum.ic.type = constant
solid.momentum.ic.constant.value = 0.0 0.0 0.0
solid.pressure.ic.type = constant
solid.pressure.ic.constant.value = 101325.0

### ETA (alpha_1) -- uniform 0.5 (two identical gases => single ideal-gas air) ###
eta.ic.type = constant
eta.ic.constant.value = 0.5
eta.bc.type.xlo = dirichlet            # supersonic inflow (all characteristics enter)
eta.bc.val.xlo  = 0.5
eta.bc.type.xhi = neumann
eta.bc.type.ylo = Symmetry        # y=0 symmetry plane (half-body)
eta.bc.type.yhi = neumann
eta.bc.type.zlo = neumann
eta.bc.type.zhi = neumann

### EOS (ideal-gas air, gamma = 1.4) -- two identical phases ###
eos0.gamma = 1.4
eos0.p0    = 0.0
eos0.cp    = 1005.0
eos0.cv    = 717.86
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cp    = 1005.0
eos1.cv    = 717.86
mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### FLUID 0 IC (supersonic freestream in +X) ###
density0.ic.type = constant
density0.ic.constant.value = 1.2250
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "374.32"     # vx = U
velocity0.ic.expression.region1 = "0.0"        # vy
velocity0.ic.expression.region2 = "0.0"        # vz
pressure0.ic.type = constant
pressure0.ic.constant.value = 101325.0

### FLUID 1 IC (identical to fluid 0) ###
density1.ic.type = constant
density1.ic.constant.value = 1.2250
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "374.32"
velocity1.ic.expression.region1 = "0.0"
velocity1.ic.expression.region2 = "0.0"
pressure1.ic.type = constant
pressure1.ic.constant.value = 101325.0

### INTERACTIONS ###
epsilon = 0.1
sigma   = 0.0
Dv      = 0.0
pref    = 0.0
small   = 1e-6
grav    = 0.0

### BOUNDARY CONDITIONS ###
# Supersonic inflow at xlo: Dirichlet rho/M/E.  Outflow xhi + far-field y/z: Neumann.
# density.bc = MIXTURE inflow density (= rho_phys).  energy.bc = PER-PHASE
# internal energy E0=E1 = 0.5*p/(gamma-1) (NOT the mixture total).
density.bc.type.xlo  = dirichlet
density.bc.val.xlo   = 1.2250
density.bc.type.xhi  = neumann
density.bc.type.ylo  = Symmetry
density.bc.type.yhi  = neumann
density.bc.type.zlo  = neumann
density.bc.type.zhi  = neumann


# PER-PHASE partial densities (alpha rho)_k.  rho_eta0/1 are filled directly from
# their own BC, so a DIRICHLET mixture value would be written into BOTH phases
# (ghost rho = sum).  Give each phase its own (alpha rho)_k = alpha_k * rho_k.
density0.bc.type.xlo = dirichlet
density0.bc.val.xlo  = 0.6125
density0.bc.type.xhi = neumann
density0.bc.type.ylo = Symmetry
density0.bc.type.yhi = neumann
density0.bc.type.zlo = neumann
density0.bc.type.zhi = neumann

density1.bc.type.xlo = dirichlet
density1.bc.val.xlo  = 0.6125
density1.bc.type.xhi = neumann
density1.bc.type.ylo = Symmetry
density1.bc.type.yhi = neumann
density1.bc.type.zlo = neumann
density1.bc.type.zhi = neumann


# momentum (Mx, My, Mz): inflow drives Mx = rho*U = 458.55, transverse 0.
momentum.bc.type.xlo = dirichlet dirichlet dirichlet
momentum.bc.val.xlo  = 458.55 0.0 0.0
momentum.bc.type.xhi = neumann neumann neumann
momentum.bc.type.ylo = REFLECT_EVEN REFLECT_ODD REFLECT_EVEN  # Mx even, My(normal) odd, Mz even
momentum.bc.type.yhi = neumann neumann neumann
momentum.bc.type.zlo = neumann neumann neumann
momentum.bc.type.zhi = neumann neumann neumann

energy.bc.type.xlo   = dirichlet
energy.bc.val.xlo    = 126656.25
energy.bc.type.xhi   = neumann
energy.bc.type.ylo   = Symmetry
energy.bc.type.yhi   = neumann
energy.bc.type.zlo   = neumann
energy.bc.type.zhi   = neumann

### REFINEMENT CRITERIA -- shock (rho/p gradients) + airframe (grad phi) ###
eta_refinement_criterion   = 1e10
omega_refinement_criterion = 1e10
gradu_refinement_criterion = 1e10
p_refinement_criterion     = 2500.0     # Pa (jump over 2 cells): ~2.5% of p_inf, so the weaker far-field shock legs
                                        # the BOS photo shows are refined too (bow shock ~25 kPa)
p_refinement_max_level     = 2          # shocks reach level 2 (0.25 m) only; the surface goes to level 4
rho_refinement_criterion   = 1e10       # off: grad rho has no level cap and would send every shock to level 4
cutoff = 1e-16

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

apply_surface_tension = 0
apply_weight          = 0
apply_vaporization    = 0

### SOLVER ###
Riemann_Solver.type = hllc
Limiter.type        = minmod
kappa_method        = 1
