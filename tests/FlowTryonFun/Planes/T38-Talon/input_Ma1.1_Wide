#@ [t38_ma11_stl_3d_wide]
#@ exe=hydro2
#@ dim=3

# =============================================================================
# FlowTryonFun -- T-38 Talon, 3D transonic/supersonic flow over an EMBEDDED
# SOLID from an STL CAD mesh (IC::STL -> self-contained Util::STL signed distance ->
# diffuse phi), at PHYSICAL air values and REAL aircraft size (for lift/drag).
# =============================================================================
# Condition: Ma 1.1 at STANDARD SEA LEVEL.
#
#   ATMOSPHERE (sea level):  T = 288.15 K,  p = 101325 Pa,  rho = 1.2250 kg/m^3,
#                            a = 340.29 m/s.   U = Ma*a = 1.1*340.29 = 374.32 m/s.
#   rho*U = 458.55 (kg/m^2 s).   E_per_phase = 0.5*p/(gamma-1) = 126656.25 J/m^3.
#   Freestream dynamic pressure  q_inf = 0.5*rho*U^2 = 85822 Pa.
#
#   GEOMETRY: real T-38 length 14.14 m (46'4.5"), span 7.70 m, height 3.92 m.
#   The STL (t38-talon.stl) long axis is X (model dx=237.64), so the freestream
#   runs in +X.  read_stl_file does  vertex -> vertex*scale + center, so:
#     scale  = 14.14 / 237.64 = 0.059503  m/model-unit  (length -> real 14.14 m)
#     center = -scale * mesh_bbox_center = (-4.035, 0.0, -1.566)  (origin-centered)
#   -> placed airframe:  x[-7.07, 7.07]  y[-3.58, 3.58]  z[-1.59, 1.59]  (meters).
#   (Length exact; STL gives span 7.16 m / height 3.18 m -- a few % under on span,
#    short on the tail height; planform area within ~7%.)
#
#   LIFT/DRAG: integrate pressure over the phi=0.5 surface; nondimensionalize
#   with q_inf=85822 Pa and S_ref=15.79 m^2 (T-38 wing area):
#     C_L = L/(q_inf*S_ref),  C_D = D/(q_inf*S_ref).
#   Two identical ideal gases (eta=0.5) so the mixture is one perfect-gas air.
#   NOTE Ma 1.1 is faster than the real T-38's ~Ma 1.3 limit only barely; this
#   is a low-supersonic case (detached bow shock + transonic wing flow).
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
#plot_file = ./tests/FlowTryonFun/Planes/T38-Talon/output_Ma1.1
plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowTryonFun/Planes/T38-Talon/output_Ma1.1_Wide

### MESHING ###
# Base dx = 0.5 m; AMR refines the airframe surface + bow shock.
# max_level=4 -> dx_finest = 0.5/2^4 = 0.03125 m (forces-resolution).  The diffuse
# skin eps=0.09375 m is 3 finest cells wide.  WARNING: this is an EXPENSIVE 3D run
# (16x finer than max_level=2 near the surface); run it on the cluster.  Drop to
# max_level=2-3 for a quick first look.
amr.plot_dt          = 0.02
amr.max_grid_size    = 32           # better load balance across 128 ranks
amr.blocking_factor  = 16
amr.regrid_int       = 25           # shock system is quasi-steady once formed; 10 re-tags (and re-inits STL phi) too often
amr.grid_eff         = 0.8
amr.max_level        = 3             # imaging: dx_finest=0.0625 m; use 4 for forces
amr.n_cell           = 112 32 64     # dx=0.5; widened lateral (y 0..16, z +-16) so Ma-angle-65deg shocks clear the imaging window
amr.n_error_buf      = 4
nghost = 4

### DIMENSIONS (meters) -- flow in +X ###
geometry.prob_lo     = -16.0   0.0 -16.0
geometry.prob_hi     =  40.0  16.0  16.0    # ~9 m upstream, ~33 m wake, 2 spans lateral
geometry.is_periodic = 0 0 0

### TIME STEPPING ###
timestep            = 1e-7
dynamictimestep.on  = 1
dynamictimestep.verbose = 0
dynamictimestep.max = 1e-3
dynamictimestep.min = 1e-10
cfl                 = 0.4
stop_time           = 0.45           # ~3 flow-through times (L=52 m, U=374 -> 0.139 s each)

# ----------------------------------------------------------------------------
# EMBEDDED SOLID -- the T-38, from STL.  Yang full-flux porous wall.
# ----------------------------------------------------------------------------
apply_embedded_solid = 1
solid.brinkman       = 8000           # ~4*U/eps = 4*374/0.1875
phi_refinement_criterion = 0.1        # refine on the airframe surface (grad phi)

# STL geometry IC.  d>0 fluid, d<0 solid -> phi = 0.5*(1+tanh(d/eps)).
solid.phi.ic.type                 = stl
solid.phi.ic.stl.filename         = ./tests/FlowTryonFun/Planes/T38-Talon/t38_xflow.STL
solid.phi.ic.stl.scale            = 0.059503          # 14.14 m / 237.64 model-units -> real length
solid.phi.ic.stl.center           = -4.035 0.0 -1.566        # -scale*bbox_center -> origin-centered (m)
#solid.phi.ic.stl.eps              = 0.1875            # 3 finest cells (3*0.0625)
solid.phi.ic.stl.eps              = 0.001            # Very refine - might break?

# Prescribed quiescent solid target (physical air at rest, p=p_inf):
solid.density.ic.type = constant
solid.density.ic.constant.value = 1.2250
solid.momentum.ic.type = constant
solid.momentum.ic.constant.value = 0.0 0.0 0.0
solid.pressure.ic.type = constant
solid.pressure.ic.constant.value = 101325.0

### ETA (alpha_1) -- uniform 0.5 (two identical gases => single ideal-gas air) ###
eta.ic.type = constant
eta.ic.constant.value = 0.5
eta.bc.type.xlo = dirichlet            # supersonic inflow (all characteristics enter)
eta.bc.val.xlo  = 0.5
eta.bc.type.xhi = neumann
eta.bc.type.ylo = Symmetry        # y=0 symmetry plane (half-body)
eta.bc.type.yhi = neumann
eta.bc.type.zlo = neumann
eta.bc.type.zhi = neumann

### EOS (ideal-gas air, gamma = 1.4) -- two identical phases ###
eos0.gamma = 1.4
eos0.p0    = 0.0
eos0.cp    = 1005.0
eos0.cv    = 717.86
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cp    = 1005.0
eos1.cv    = 717.86
mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### FLUID 0 IC (supersonic freestream in +X) ###
density0.ic.type = constant
density0.ic.constant.value = 1.2250
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "374.32"     # vx = U
velocity0.ic.expression.region1 = "0.0"        # vy
velocity0.ic.expression.region2 = "0.0"        # vz
pressure0.ic.type = constant
pressure0.ic.constant.value = 101325.0

### FLUID 1 IC (identical to fluid 0) ###
density1.ic.type = constant
density1.ic.constant.value = 1.2250
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "374.32"
velocity1.ic.expression.region1 = "0.0"
velocity1.ic.expression.region2 = "0.0"
pressure1.ic.type = constant
pressure1.ic.constant.value = 101325.0

### INTERACTIONS ###
epsilon = 0.1
sigma   = 0.0
Dv      = 0.0
pref    = 0.0
small   = 1e-6
grav    = 0.0

### BOUNDARY CONDITIONS ###
# Supersonic inflow at xlo: Dirichlet rho/M/E.  Outflow xhi + far-field y/z: Neumann.
# density.bc = MIXTURE inflow density (= rho_phys).  energy.bc = PER-PHASE
# internal energy E0=E1 = 0.5*p/(gamma-1) (NOT the mixture total).
density.bc.type.xlo  = dirichlet
density.bc.val.xlo   = 1.2250
density.bc.type.xhi  = neumann
density.bc.type.ylo  = Symmetry
density.bc.type.yhi  = neumann
density.bc.type.zlo  = neumann
density.bc.type.zhi  = neumann

# momentum (Mx, My, Mz): inflow drives Mx = rho*U = 458.55, transverse 0.
momentum.bc.type.xlo = dirichlet dirichlet dirichlet
momentum.bc.val.xlo  = 458.55 0.0 0.0
momentum.bc.type.xhi = neumann neumann neumann
momentum.bc.type.ylo = REFLECT_EVEN REFLECT_ODD REFLECT_EVEN  # Mx even, My(normal) odd, Mz even
momentum.bc.type.yhi = neumann neumann neumann
momentum.bc.type.zlo = neumann neumann neumann
momentum.bc.type.zhi = neumann neumann neumann

energy.bc.type.xlo   = dirichlet
energy.bc.val.xlo    = 126656.25
energy.bc.type.xhi   = neumann
energy.bc.type.ylo   = Symmetry
energy.bc.type.yhi   = neumann
energy.bc.type.zlo   = neumann
energy.bc.type.zhi   = neumann

### REFINEMENT CRITERIA -- shock (rho/p gradients) + airframe (grad phi) ###
eta_refinement_criterion   = 1e10
omega_refinement_criterion = 1e10
gradu_refinement_criterion = 1e10
p_refinement_criterion     = 8000.0     # Pa (abs jump across a cell x2): shock Dp~25kPa; tags bow/canopy/wing, drops <~2kPa noise
rho_refinement_criterion   = 0.08       # kg/m^3 (abs jump x2): shock Drho~0.2; the schlieren variable, same shocks
cutoff = 1e-16

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

apply_surface_tension = 0
apply_weight          = 0
apply_vaporization    = 0

### SOLVER ###
Riemann_Solver.type = hllc
Limiter.type        = minmod
kappa_method        = 1
apply_sharpening    = 0
