#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

# ============================================================================
# FlowTryonFun / Impact_AOA30 -- Ma 10 OBLIQUE WEDGE IMPACT, velocity 30 deg from nadir
# ----------------------------------------------------------------------------
# Same 15 deg half-angle wedge as impact_Impact (axis VERTICAL, apex down) and the same
# speed (Ma 10 w.r.t. air), but the wedge moves along a path 30 deg from straight down:
# lab velocity of the wedge U (sin 30, -cos 30) = (+1716.25, -2972.62) m/s, i.e. both a
# horizontal (+x) and a vertical (down) component.  Angle of attack = 30 deg.
#
# FRAME: wedge frame -- the wedge is fixed (phi is static) and the air AND the water stream
# with -(wedge velocity) = (-1716.24, 2972.62) m/s (up and toward -x).  Gravity off:
# Galilean invariant.  The flat water surface stays horizontal (the x motion is tangential).
#
# STATES: identical to impact_Impact (air 1 atm, 1.204 kg/m^3, U = 3432.49 m/s; water SG).
#   |u_x| = 1716 m/s > c_water 1533 m/s and c_air 343 m/s: xhi is a SUPERSONIC inflow in both
#   fluids, so zero-gradient ghosts keep the uniform inflow exact (as at ylo).
#
# THEORY: the windward (+x) face turns the flow by 30 + 15 = 45 deg; the leeward (-x) face is
#   a 15 deg EXPANSION.  Max attached deflection: air Ma 10 (gamma 1.4) 44.4 deg; water
#   Ma 2.24 (SG gamma 2.35) 15.8 deg  ->  DETACHED bow shocks ahead of the windward face in
#   air and in water.  No attached-shock check here.
#
# TIMELINE: water surface y = 0 at t = 0 rises at u_y = 2972.6 m/s: reaches the apex
#   (y = 0.03) at 10.09 us and the wedge base (y = 0.05) at 16.82 us; stop 30 us.
#
# GEOMETRY: FULL width (no symmetry plane), x in [-0.06, 0.06], y in [-0.03, 0.09]; wake and
#   splash go up and toward -x.  Wedge apex (0, 0.03), base y = 0.05 (height 2 cm).
#   Finest dx 3.906e-5 m, eps/dx_finest = 2.  All boundaries zero-gradient: ylo and xhi
#   supersonic inflow, yhi and xlo supersonic outflow.
# Inviscid, no surface tension, no gravity.
# Analysis: reference/impact_schlieren.py <plotdir> <imagedir> (auto: no mirroring and no
#   attached-shock lines for a full-width domain).
# ============================================================================
alamo.program = hydro2

### OUTPUT ###
#plot_file = ./tests/FlowTryonFun/Impact/output_Impact_AOA30
plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowTryonFun/Impact/output_Impact_AOA30

### MESHING ###
amr.plot_dt          = 2.5e-7          # 120 frames to 30 us
amr.max_grid_size    = 128
amr.blocking_factor  = 8
amr.regrid_int       = 10
amr.grid_eff         = 0.8
amr.max_level        = 4
amr.n_cell           = 192 192         # base dx 6.25e-4 = 0.12/192; finest 3.906e-5
amr.n_error_buf      = 8

### DIMENSIONS ###
geometry.prob_lo     = -0.06 -0.03 0.0
geometry.prob_hi     =  0.06  0.09 0.0
geometry.is_periodic = 0 0 0

### TIME STEPPING ###
timestep                = 1.0e-12
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 4.0e-9       # Brinkman stability: solid.brinkman * dt < 2
dynamictimestep.min     = 1.0e-16
cfl                     = 0.9
cfl_v                   = 0.3
stop_time               = 3.0e-5

# ----------------------------------------------------------------------------
# EMBEDDED SOLID -- the wedge, apex DOWN at (0, ya), base at y = yb.  phi = 1 fluid, 0 solid.
#   signed distance D = max(g_right, g_left, g_base), D > 0 fluid:
#     g_right =  x cth - (y-ya) sth ,  g_left = -x cth - (y-ya) sth ,  g_base = y - yb
# ----------------------------------------------------------------------------
apply_embedded_solid = 1
solid.brinkman       = 3.5e8           # ~4 U / dx_finest (Yang porous wall)
phi_refinement_criterion = 0.1

solid.phi.ic.type = expression
solid.phi.ic.expression.constant.cth = 0.9659258
solid.phi.ic.expression.constant.sth = 0.2588190
solid.phi.ic.expression.constant.ya  = 0.03
solid.phi.ic.expression.constant.yb  = 0.05
solid.phi.ic.expression.constant.eps = 3.90625e-5
solid.phi.ic.expression.region0 = "0.5*(1.0 + tanh( max(max( x*cth - (y-ya)*sth, -x*cth - (y-ya)*sth ), y - yb) / eps ))"

# Quiescent solid target (air at 1 atm, at rest in the wedge frame)
solid.density.ic.type = constant
solid.density.ic.constant.value = 1.204
solid.momentum.ic.type = constant
solid.momentum.ic.constant.value = 0.0 0.0
solid.pressure.ic.type = constant
solid.pressure.ic.constant.value = 101325.0

### ETA (water volume fraction): water (fluid 0) below y = 0, air (fluid 1) above ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 7.8125e-5     # eps/dx_finest = 2
eta.ic.expression.region0 = "0.5*(1.0 - tanh(y/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EOS ###
# fluid 0: water (stiffened gas)
eos0.gamma = 2.35
eos0.p0    = 1.0e9
eos0.cv    = 1781.0
eos0.cp    = 4186.0
# fluid 1: air (ideal gas)
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cv    = 717.86
eos1.cp    = 1005.0
mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### FLUID IC: everything streams at 30 deg from +y toward -x, |u| = U = 3432.49 m/s (wedge frame) ###
density0.ic.type = constant
density0.ic.constant.value = 1000.0
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "-1716.245"
velocity0.ic.expression.region1 = "2972.624"
pressure0.ic.type = constant
pressure0.ic.constant.value = 101325.0

density1.ic.type = constant
density1.ic.constant.value = 1.204
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "-1716.245"
velocity1.ic.expression.region1 = "2972.624"
pressure1.ic.type = constant
pressure1.ic.constant.value = 101325.0

### INTERACTIONS ###
apply_surface_tension = 0
sigma = 0.0
Dv    = 0.0
pref  = 0.0
small = 1e-6
grav  = 0.0
apply_weight       = 0
apply_vaporization = 0

### BOUNDARY CONDITIONS ###
# ylo, xhi: supersonic inflow (uniform -> zero-gradient exact).  xlo: supersonic outflow (no symmetry plane).
# yhi: supersonic outflow.
eta.bc.type.xlo = neumann
eta.bc.type.xhi = neumann
eta.bc.type.ylo = neumann
eta.bc.type.yhi = neumann

density.bc.type.xlo = neumann
density.bc.type.xhi = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xlo = neumann
energy.bc.type.xhi = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xlo = neumann neumann
momentum.bc.type.xhi = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

### REFINEMENT CRITERIA (|grad f| * 2 dx > criterion) ###
eta_refinement_criterion   = 0.1          # free surface / splash sheets
p_refinement_criterion     = 2.0e5        # air oblique shock (dp ~1.3e6) and all water shocks
rho_refinement_criterion   = 1.0e10
omega_refinement_criterion = 1.0e10
gradu_refinement_criterion = 1.0e10
cutoff = 1.0e-4

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

### SOLVER ###
Riemann_Solver.type = hllc
Limiter.type        = minmod
integration.type    = RungeKutta
integration.rk.type = 3
