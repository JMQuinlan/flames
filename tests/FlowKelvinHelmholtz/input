#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

alamo.program = hydro2

# =============================================================================
# KELVIN-HELMHOLTZ INSTABILITY -- hydro2 (updated to new EOS form)
# =============================================================================
# Two-fluid stratified shear layer at y = 0.5:
#   upper (y > 0.5) : rho = 1.0, u_x = +0.5
#   lower (y < 0.5) : rho = 2.0, u_x = -0.5
# Sinusoidal v_y perturbation seeds the instability; characteristic KH
# rollup grows on the linear timescale ~ Lx / |Delta u|.
#
# Both phases are ideal gas (gamma = 1.4) so this is effectively single-
# fluid with the diffuse-interface tracker following the density / velocity
# transitions across the shear layer.
# =============================================================================

### OUTPUT ###
plot_file = ./tests/KelvinHelmholtz/output_KelvinHelmholtz

### MESHING ###
amr.plot_dt        = 0.2
amr.max_grid_size  = 500000
amr.blocking_factor = 2
amr.regrid_int     = 50
amr.grid_eff       = 0.8
amr.max_level      = 0
amr.n_cell         = 256 256

### TIME STEPPING ###
timestep = 1e-6
dynamictimestep.on      = 1
dynamictimestep.verbose = 1
dynamictimestep.max     = 1e-2
dynamictimestep.min     = 1e-12
cfl = 0.4

### DIMENSIONS ###
geometry.prob_lo     = 0.0 0.0 0.0
geometry.prob_hi     = 1.0 1.0 0.0
geometry.is_periodic = 1 0 0

stop_time = 8.0

### ETA INITIAL CONDITIONS (shear-layer interface) ###
# eta = 1 above the shear layer (heavy / phase 0), eta = 0 below (light / phase 1).
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.0005
eta.ic.expression.constant.y_mid   = 0.5
eta.ic.expression.region0 = "0.5*(1 + tanh((y - y_mid)/(epsilon)))"
epsilon = eta.ic.expression.constant.epsilon

### EQUATION OF STATE -- both phases ideal gas (gamma = 1.4) ###
# cv = 1000 / 1.4 ~= 714.286,  cp = 1000.0  (gamma-law normalization
# matching the original input).
eos0.gamma = 1.4
eos0.p0    = 0.0
eos0.cv    = 714.286
eos0.cp    = 1000.0

eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cv    = 714.286
eos1.cp    = 1000.0

### PER-PHASE PRIMARIES ###
# Densities: rho1 = 1.0 (upper), rho2 = 2.0 (lower), tanh-smoothed across
# the shear layer with width delta = 0.005.
density0.ic.type = expression
density0.ic.expression.constant.rho1  = 1.0
density0.ic.expression.constant.rho2  = 2.0
density0.ic.expression.constant.y_mid = 0.5
density0.ic.expression.constant.delta = 0.005
density0.ic.expression.region0 = "rho1 + (rho2 - rho1)*0.5*(1 + tanh((y - y_mid)/delta))"

density1.ic.type = expression
density1.ic.expression.constant.rho1  = 1.0
density1.ic.expression.constant.rho2  = 2.0
density1.ic.expression.constant.y_mid = 0.5
density1.ic.expression.constant.delta = 0.005
density1.ic.expression.region0 = "rho1 + (rho2 - rho1)*0.5*(1 + tanh((y - y_mid)/delta))"

# Velocity field combined in a single block per phase:
#   region0 = u_x : shear-layer tanh between u1 = +0.5 (upper) and u2 = -0.5 (lower)
#   region1 = u_y : sinusoidal perturbation A*sin(2 pi x / Lx)*exp(-(y-y_mid)^2/sigma^2)
#                   with A = 0.05, Lx = 1.0, sigma = 0.1
# Both per-phase velocity fields carry the same expressions so the IC has
# no jump at the interface (the only contrast is density).
velocity0.ic.type = expression
velocity0.ic.expression.constant.u1    = 0.5
velocity0.ic.expression.constant.u2    = -0.5
velocity0.ic.expression.constant.y_mid = 0.5
velocity0.ic.expression.constant.delta = 0.005
velocity0.ic.expression.constant.A     = 0.05
velocity0.ic.expression.constant.Lx    = 1.0
velocity0.ic.expression.constant.sigma = 0.1
velocity0.ic.expression.region0 = "u1 + (u2 - u1)*0.5*(1 + tanh((y - y_mid)/delta))"
velocity0.ic.expression.region1 = "A*sin(2*3.14159265359*x/Lx)*exp(-((y - y_mid)**2)/(sigma**2))"

velocity1.ic.type = expression
velocity1.ic.expression.constant.u1    = 0.5
velocity1.ic.expression.constant.u2    = -0.5
velocity1.ic.expression.constant.y_mid = 0.5
velocity1.ic.expression.constant.delta = 0.005
velocity1.ic.expression.constant.A     = 0.05
velocity1.ic.expression.constant.Lx    = 1.0
velocity1.ic.expression.constant.sigma = 0.1
velocity1.ic.expression.region0 = "u1 + (u2 - u1)*0.5*(1 + tanh((y - y_mid)/delta))"
velocity1.ic.expression.region1 = "A*sin(2*3.14159265359*x/Lx)*exp(-((y - y_mid)**2)/(sigma**2))"

# Uniform pressure P0 = 2.5 on both phases (mechanical equilibrium at IC).
pressure0.ic.type = expression
pressure0.ic.expression.region0 = "2.5"

pressure1.ic.type = expression
pressure1.ic.expression.region0 = "2.5"

# Inviscid Kelvin-Helmholtz (set mu* > 0 to add viscous damping).
mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

# No surface tension.
sigma = 0.0

### BOUNDARY CONDITIONS ###
# X-direction: periodic.  Y-direction: zero-gradient Neumann.
density.bc.type.xhi = periodic
density.bc.type.xlo = periodic
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = periodic
energy.bc.type.xlo = periodic
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xhi = periodic periodic
momentum.bc.type.xlo = periodic periodic
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

### REFINEMENT CRITERIA ###
eta_refinement_criterion   = 1e-4
omega_refinement_criterion = 10.0
p_refinement_criterion     = 1e+2
rho_refinement_criterion   = 1e+2
gradu_refinement_criterion = 5.0
cutoff = 1e-16

### SOURCE TERMS ###
m0.ic.type = constant
m0.ic.constant.value = "0.0"

u0.ic.type = expression
u0.ic.expression.region0 = "0.0"
u0.ic.expression.region1 = "0.0"

q.ic.type = expression
q.ic.expression.region0 = "0.0"
q.ic.expression.region1 = "0.0"

### PHYSICS FLAGS ###
apply_surface_tension = 0
apply_buoyancy        = 0
apply_weight          = 0
apply_vaporization    = 0
grav                  = 0.0

### IC PRESSURE EQUALIZATION ###
# Both per-phase pressures are identical (P0 = 2.5) so this is a no-op;
# kept on for consistency with the rest of the test suite.
equalize_ic_pressure = 1

### NUMERICAL METHODS -- standardized: HLLC + WENO3 + RK3 ###
Riemann_Solver.type = hllc
Limiter.type        = weno3
integration.type    = RungeKutta
integration.rk.type = 3
kappa_method        = 1
