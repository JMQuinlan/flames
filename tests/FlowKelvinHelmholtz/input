#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/KelvinHelmholtz/output_KelvinHelmholtz

### MESHING ###
amr.plot_dt = 0.2
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.regrid_int = 50
amr.grid_eff = 0.8
amr.max_level = 0
amr.n_cell = 256 256

### TIME STEPPING ###
timestep = 1e-6
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 1e-2
dynamictimestep.min = 1e-12
cfl = 0.4

### DIMENSIONS ###
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 0.0
geometry.is_periodic = 1 0 0

stop_time = 8.0

### ETA INITIAL CONDITIONS (SHEAR LAYER INTERFACE) ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.0005
eta.ic.expression.constant.y_mid = 0.5
eta.ic.expression.region0 = "0.5*(1 + tanh((y - y_mid)/(epsilon)))"

epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###

# ----------------------------
# Ideal Gas EOS (NO TAMMANN)
# ----------------------------
gamma_eta1 = 1.4
gamma_eta0 = 1.4

# ----------------------------
# Density: rho1 = 1.0 (upper), rho2 = 2.0 (lower)
# Using tanh profile for smooth transition
# ----------------------------
density_eta1.ic.type = expression
density_eta1.ic.expression.constant.rho1 = 1.0
density_eta1.ic.expression.constant.rho2 = 2.0
density_eta1.ic.expression.constant.y_mid = 0.5
density_eta1.ic.expression.constant.delta = 0.005
density_eta1.ic.expression.region0 = "rho1 + (rho2 - rho1)*0.5*(1 + tanh((y - y_mid)/delta))"

density_eta0.ic.type = expression
density_eta0.ic.expression.constant.rho1 = 1.0
density_eta0.ic.expression.constant.rho2 = 2.0
density_eta0.ic.expression.constant.y_mid = 0.5
density_eta0.ic.expression.constant.delta = 0.005
density_eta0.ic.expression.region0 = "rho1 + (rho2 - rho1)*0.5*(1 + tanh((y - y_mid)/delta))"

# ----------------------------
# X-velocity: u1 = 0.5 (upper), u2 = -0.5 (lower)
# Using tanh profile for smooth shear layer
# ----------------------------
velocity_eta1.ic.type = expression
velocity_eta1.ic.expression.constant.u1 = 0.5
velocity_eta1.ic.expression.constant.u2 = -0.5
velocity_eta1.ic.expression.constant.y_mid = 0.5
velocity_eta1.ic.expression.constant.delta = 0.005
velocity_eta1.ic.expression.region0 = "u1 + (u2 - u1)*0.5*(1 + tanh((y - y_mid)/delta))"
velocity_eta1.ic.expression.region1 = "0.0"

velocity_eta0.ic.type = expression
velocity_eta0.ic.expression.constant.u1 = 0.5
velocity_eta0.ic.expression.constant.u2 = -0.5
velocity_eta0.ic.expression.constant.y_mid = 0.5
velocity_eta0.ic.expression.constant.delta = 0.005
velocity_eta0.ic.expression.region0 = "u1 + (u2 - u1)*0.5*(1 + tanh((y - y_mid)/delta))"
velocity_eta0.ic.expression.region1 = "0.0"

# ----------------------------
# Y-velocity: Sinusoidal perturbation
# v = A * sin(2*pi*x/Lx) * exp(-(y-y_mid)^2/sigma^2)
# ----------------------------
velocity_eta1.ic.type = expression
velocity_eta1.ic.expression.constant.A = 0.05
velocity_eta1.ic.expression.constant.Lx = 1.0
velocity_eta1.ic.expression.constant.y_mid = 0.5
velocity_eta1.ic.expression.constant.sigma = 0.1
velocity_eta1.ic.expression.region1 = "A*sin(2*3.14159265359*x/Lx)*exp(-((y - y_mid)**2)/(sigma**2))"

velocity_eta0.ic.type = expression
velocity_eta0.ic.expression.constant.A = 0.05
velocity_eta0.ic.expression.constant.Lx = 1.0
velocity_eta0.ic.expression.constant.y_mid = 0.5
velocity_eta0.ic.expression.constant.sigma = 0.1
velocity_eta0.ic.expression.region1 = "A*sin(2*3.14159265359*x/Lx)*exp(-((y - y_mid)**2)/(sigma**2))"

# ----------------------------
# Uniform pressure: P0 = 2.5
# ----------------------------
pressure_eta1.ic.type = expression
pressure_eta1.ic.expression.region0 = "2.5"

pressure_eta0.ic.type = expression
pressure_eta0.ic.expression.region0 = "2.5"

# ----------------------------
# Temperature (consistent with ideal gas)
# ----------------------------
temperature0.ic.type = expression
temperature0.ic.expression.region0 = "300.0"

temperature1.ic.type = expression
temperature1.ic.expression.region0 = "300.0"

# ----------------------------
# Thermodynamics (gamma-law)
# ----------------------------
cp_eta1 = "1000.0"
cp_eta0 = "1000.0"
cv_eta1 = "1000.0/1.4"
cv_eta0 = "1000.0/1.4"

# ----------------------------
# No viscosity (inviscid KH)
# ----------------------------
mu_eta1 = 0.0
mu_eta1_b = 0.0
mu_eta0 = 0.0
mu_eta0_b = 0.0

# ----------------------------
# No surface tension for KH
# ----------------------------
sigma = 0.0
pref = 0.0

### BOUNDARY CONDITIONS ###
# X-direction: Periodic
# Y-direction: Neumann

density.bc.type.xhi = periodic
density.bc.type.xlo = periodic
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = periodic
energy.bc.type.xlo = periodic
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xhi = periodic periodic
momentum.bc.type.xlo = periodic periodic
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

### REFINEMENT CRITERIA ###
eta_refinement_criterion = 1e-4
omega_refinement_criterion = 10.0
p_refinement_criterion = 1e+2
rho_refinement_criterion = 1e+2
gradu_refinement_criterion = 5.0
cutoff = 1e-16

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value = 0.0 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 0
apply_buoyancy = 0
apply_weight = 0
Spec_Vol = 1
grav = 0.0

### SOLVER SETTINGS ###
Riemann_Solver.type = hllc
kappa_method = 1
