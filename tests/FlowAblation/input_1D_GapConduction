# ============================================================================
# FlowAblation / steady conduction across a gas gap to the ablating wall  (Hydro2, ablation.on = 1)
#
# Gas at rest between an ablating wall (x = 0.1, T_w = 0.9) and an open reservoir boundary at
# x = 0.2 held at T_h = 1.0 (rho 1, p 1; gamma 1.4, cp 3.5, cv 2.5 -> R = 1; k = mu cp/Pr = 4.861e-3,
# constant).  The initial temperature is the steady linear profile.  For steady conduction the
# wall heat flux is k (T_h - T_w)/h with h the gap width, so with rho_s Q* dh/dt = q_w
#     h(t) = sqrt( h0^2 + 2 k (T_h - T_w) t / (rho_s Q*) )            (rho_s Q* = 5, h0 = 0.1)
# -> h(35.5) = 0.1302 (12 cells of recession on 80 cells).  The conduction time h^2/alpha = 7
# is short against the recession time, so the quasi-steady formula holds to a few per cent; the
# gas drawn in through the open end carries heat at a Peclet number of about 0.06.
#
# Run (from bin/): mpirun -np 2 ./hydro2-2d-g++ ../tests/FlowAblation/input_1D_GapConduction plot_file=<dir>/output
# Check:           python3 ../tests/FlowAblation/reference/gap_conduction_check.py <dir>
# ============================================================================
plot_file = ./tests/FlowAblation/output_1D_GapConduction
amr.plot_dt = 1.0
amr.max_grid_size    = 500000
amr.blocking_factor = 2
amr.regrid_int       = 10
amr.grid_eff         = 0.8
amr.max_level = 0
amr.n_cell = 80 4
amr.n_error_buf      = 8
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 0.2 0.01 0.0
geometry.is_periodic = 0 1 0
timestep = 1e-5
dynamictimestep.on  = 1
dynamictimestep.verbose = 0
dynamictimestep.max = 1e-2
dynamictimestep.min = 1e-9
cfl                 = 0.3
cfl_v               = 0.3
stop_time = 35.5
apply_embedded_solid = 1
solid.wall_flux = 1
solid.phi.ic.type = expression
solid.phi.ic.expression.constant.xw = 0.1
solid.phi.ic.expression.region0 = "1.0*(x > xw)"
phi_refinement_criterion = 1e10
solid.density.ic.type = constant
solid.density.ic.constant.value = 1.0
solid.momentum.ic.type = constant
solid.momentum.ic.constant.value = 0.0 0.0
solid.pressure.ic.type = constant
solid.pressure.ic.constant.value = 1.0
eta.ic.type = constant
eta.ic.constant.value = 0.5
eos0.gamma = 1.4
eos0.p0    = 0.0
eos0.cp = 3.5
eos0.cv = 2.5
mu0 = 1.0e-3
mu0_b = 0.0
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cp = 3.5
eos1.cv = 2.5
mu1 = 1.0e-3
mu1_b = 0.0
density0.ic.type = expression
density0.ic.expression.region0 = "1.0/(0.9 + 1.0*max(x - 0.1, 0.0))"
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
pressure0.ic.type = constant
pressure0.ic.constant.value = 1.0
density1.ic.type = expression
density1.ic.expression.region0 = "1.0/(0.9 + 1.0*max(x - 0.1, 0.0))"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"
pressure1.ic.type = constant
pressure1.ic.constant.value = 1.0
epsilon = 0.1
sigma   = 0.0
Dv      = 0.0
pref    = 0.0
small   = 1e-6
grav    = 0.0
eta_refinement_criterion   = 1e10
omega_refinement_criterion = 1e10
gradu_refinement_criterion = 1e10
p_refinement_criterion = 1e10
rho_refinement_criterion = 1e10
cutoff = 1e-16
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0
apply_surface_tension = 0
apply_weight          = 0
apply_vaporization    = 0
Riemann_Solver.type = hllc
Limiter.type        = minmod
