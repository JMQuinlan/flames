amr.plot_dt = 0.05
amr.max_grid_size = 128
amr.blocking_factor = 8
amr.regrid_int       = 10
amr.grid_eff         = 0.8
amr.max_level = 0
amr.n_cell = 800 480
amr.n_error_buf      = 8
geometry.prob_lo = -1.0 -0.6 0.0
geometry.prob_hi = 1.0 0.6 0.0
geometry.is_periodic = 0 0 0
timestep            = 1e-6
dynamictimestep.on  = 1
dynamictimestep.verbose = 0
dynamictimestep.max = 1e-3
dynamictimestep.min = 1e-9
cfl                 = 0.3
cfl_v               = 0.3
stop_time = 4.0
apply_embedded_solid = 1
solid.brinkman       = 1200          # ~4*U/eps, U=3.0, eps=0.01  (kappa = 1/1200)
phi_refinement_criterion = 1e10
solid.phi.ic.type = expression
