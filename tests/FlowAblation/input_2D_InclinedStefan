# ============================================================================
# FlowAblation / Stefan problem with the wall at 26.57 deg to the grid  (Hydro2, ablation.on = 1)
#
# The gas, wall temperature and ablation constants of input_1D_Stefan (lam = 0.100), but the
# solid is a periodic set of slabs |frac(2x + y) - 1/2| < 0.16: their faces have the normal
# (2, 1)/sqrt 5, a staircase on the grid.  Each face must recede along its normal exactly as in
# 1D, s = 2 lam sqrt(alpha t) (0.01054 at t = 2 = 4.2 cells of the 400), and stay flat.
# Half-thickness of a slab along the normal: 0.16/sqrt 5 = 0.07155; gas layer 0.304 wide, against
# a conduction depth 2 sqrt(alpha t) = 0.105 at t = 2, so the two faces of a layer do not interact.
# Tests the |n_d| weighting of the staircase heat flux and the isotropy of the level-set recession.
#
# Run (from bin/): mpirun -np 8 ./hydro2-2d-g++ ../tests/FlowAblation/input_2D_InclinedStefan plot_file=<dir>/output
# Check:           python3 ../tests/FlowAblation/reference/inclined_stefan_check.py <dir>
# ============================================================================
plot_file = ./tests/FlowAblation/output_2D_InclinedStefan
amr.plot_dt = 0.25
amr.max_grid_size = 100
amr.blocking_factor = 4
amr.regrid_int       = 10
amr.grid_eff         = 0.8
amr.max_level = 0
amr.n_cell = 400 400
amr.n_error_buf      = 8
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 0.0
geometry.is_periodic = 1 1 0
timestep = 1e-5
dynamictimestep.on  = 1
dynamictimestep.verbose = 0
dynamictimestep.max = 1e-2
dynamictimestep.min = 1e-9
cfl                 = 0.3
cfl_v               = 0.3
stop_time = 2.0
apply_embedded_solid = 1
solid.wall_flux = 1
solid.phi.ic.type = expression
solid.phi.ic.expression.constant.xw = 0.16
solid.phi.ic.expression.region0 = "1.0*(abs((2.0*x + y) - floor(2.0*x + y) - 0.5) > xw)"
phi_refinement_criterion = 1e10
solid.density.ic.type = constant
solid.density.ic.constant.value = 1.0
solid.momentum.ic.type = constant
solid.momentum.ic.constant.value = 0.0 0.0
solid.pressure.ic.type = constant
solid.pressure.ic.constant.value = 1.0
eta.ic.type = constant
eta.ic.constant.value = 0.5
eos0.gamma = 1.4
eos0.p0    = 0.0
eos0.cp = 3.5
eos0.cv = 2.5
mu0 = 1.0e-3
mu0_b = 0.0
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cp = 3.5
eos1.cv = 2.5
mu1 = 1.0e-3
mu1_b = 0.0
density0.ic.type = constant
density0.ic.constant.value = 1.0
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
pressure0.ic.type = constant
pressure0.ic.constant.value = 1.0
density1.ic.type = constant
density1.ic.constant.value = 1.0
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"
pressure1.ic.type = constant
pressure1.ic.constant.value = 1.0
epsilon = 0.1
sigma   = 0.0
Dv      = 0.0
pref    = 0.0
small   = 1e-6
grav    = 0.0
eta_refinement_criterion   = 1e10
omega_refinement_criterion = 1e10
gradu_refinement_criterion = 1e10
p_refinement_criterion = 1e10
rho_refinement_criterion = 1e10
cutoff = 1e-16
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0
apply_surface_tension = 0
apply_weight          = 0
apply_vaporization    = 0
Riemann_Solver.type = hllc
Limiter.type        = minmod
kappa_method        = 1




eta.bc.type.xlo = periodic
