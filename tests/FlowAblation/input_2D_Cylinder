# ============================================================================
# FlowAblation / circular body ablating in still hot gas  (Hydro2, ablation.on = 1)
#
# A cylinder of radius 0.2 at the centre of a periodic unit box of gas at T_inf = 1 (wall at
# T_w = 0.9; gas and ablation constants of input_1D_Stefan).  By symmetry it must shrink and
# STAY ROUND on the Cartesian grid.  The radius history is compared with the axisymmetric Stefan
# problem  T_t = alpha (T_rr + T_r/r),  T(R) = T_w,  rho_s Q* dR/dt = -k T_r(R), integrated on a
# fine radial grid in reference/cylinder_check.py (a 1D numerical reference, not a closed form;
# the outer boundary is taken insulated at r = 0.5, which the heat does not reach by t = 4).
# 400 x 400 cells (R/dx = 80), t = 4: recession about 0.016 (6 cells).
#
# Run (from bin/): mpirun -np 8 ./hydro2-2d-g++ ../tests/FlowAblation/input_2D_Cylinder plot_file=<dir>/output
# Check:           python3 ../tests/FlowAblation/reference/cylinder_check.py <dir>
# ============================================================================
plot_file = ./tests/FlowAblation/output_2D_Cylinder
amr.plot_dt = 0.5
amr.max_grid_size = 100
amr.blocking_factor = 4
amr.regrid_int       = 10
amr.grid_eff         = 0.8
amr.max_level = 0
amr.n_cell = 400 400
amr.n_error_buf      = 8
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 0.0
geometry.is_periodic = 1 1 0
timestep = 1e-5
dynamictimestep.on  = 1
dynamictimestep.verbose = 0
dynamictimestep.max = 1e-2
dynamictimestep.min = 1e-9
cfl                 = 0.3
cfl_v               = 0.3
stop_time = 4.0
apply_embedded_solid = 1
solid.wall_flux = 1
solid.phi.ic.type = expression
solid.phi.ic.expression.constant.xw = 0.2
solid.phi.ic.expression.region0 = "1.0*(sqrt((x - 0.5)^2 + (y - 0.5)^2) > xw)"
phi_refinement_criterion = 1e10
solid.density.ic.type = constant
solid.density.ic.constant.value = 1.0
solid.momentum.ic.type = constant
solid.momentum.ic.constant.value = 0.0 0.0
solid.pressure.ic.type = constant
solid.pressure.ic.constant.value = 1.0
eta.ic.type = constant
eta.ic.constant.value = 0.5
eos0.gamma = 1.4
eos0.p0    = 0.0
eos0.cp = 3.5
eos0.cv = 2.5
mu0 = 1.0e-3
mu0_b = 0.0
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cp = 3.5
eos1.cv = 2.5
mu1 = 1.0e-3
mu1_b = 0.0
density0.ic.type = constant
density0.ic.constant.value = 1.0
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
pressure0.ic.type = constant
pressure0.ic.constant.value = 1.0
density1.ic.type = constant
density1.ic.constant.value = 1.0
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"
pressure1.ic.type = constant
pressure1.ic.constant.value = 1.0
epsilon = 0.1
sigma   = 0.0
Dv      = 0.0
pref    = 0.0
small   = 1e-6
grav    = 0.0
eta_refinement_criterion   = 1e10
omega_refinement_criterion = 1e10
gradu_refinement_criterion = 1e10
p_refinement_criterion = 1e10
rho_refinement_criterion = 1e10
cutoff = 1e-16
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0
apply_surface_tension = 0
apply_weight          = 0
apply_vaporization    = 0
Riemann_Solver.type = hllc
Limiter.type        = minmod
kappa_method        = 1




eta.bc.type.xlo = periodic
eta.bc.type.xhi = periodic
eta.bc.type.ylo = periodic
eta.bc.type.yhi = periodic

density.bc.type.xlo = periodic
density.bc.type.xhi = periodic
density.bc.type.ylo = periodic
density.bc.type.yhi = periodic

density0.bc.type.xlo = periodic
density0.bc.type.xhi = periodic
density0.bc.type.ylo = periodic
density0.bc.type.yhi = periodic

density1.bc.type.xlo = periodic
density1.bc.type.xhi = periodic
density1.bc.type.ylo = periodic
density1.bc.type.yhi = periodic

energy.bc.type.xlo = periodic
energy.bc.type.xhi = periodic
energy.bc.type.ylo = periodic
energy.bc.type.yhi = periodic

momentum.bc.type.xlo = periodic periodic
momentum.bc.type.xhi = periodic periodic
momentum.bc.type.ylo = periodic periodic
momentum.bc.type.yhi = periodic periodic
nghost = 4
thermal.conduction = 1
thermal.Pr = 0.72
ablation.on     = 1
