# =============================================================================
# FlowMixingCylinder / input_Galilean_Re40 -- verification of the moving rigid solid.
#
# A cylinder translating at -Uc through fluid AT REST is the static Re = 40 cylinder
# (tests/FlowVortexShed/UNIT_TEST_2D_Re40, uniform flow +Uc) seen from the lab frame.
# Same domain (40 D x 30 D), mesh (3 levels, dx/D = 0.026), fluid and impulsive start;
# only the frame differs.  The drag on the body (force opposing its motion) must
# therefore follow the static run's Cd(t):
#     static, sharp wall v17:  Cd = 1.661 (t = 10), 1.619 (20), 1.610 (30) -> 1.607 (60)
#     literature, steady Re 40: Cd 1.50-1.60
# Here Fx > 0 (the fluid pushes the body back toward +x):  Cd = Fx / (0.5 rho Uc^2 D).
#
# solid.moving = 1: phi(x,t) = circle at x_c = x0 - Uc t and the wall velocity
# u_s = (-Uc, 0) are re-evaluated every step; AMR follows the body (phi criterion).
#
# Run (from bin/):  mpirun -np 8 ./hydro2-2d-g++ ../tests/FlowMixingCylinder/input_Galilean_Re40 plot_file=<dir>/output
# =============================================================================

plot_file = ./tests/FlowMixingCylinder/output_galilean     # (run from bin/; override on the command line)

### MESHING ###
amr.plot_dt          = 0.5
amr.max_grid_size    = 500000
amr.blocking_factor  = 4
amr.regrid_int       = 10
amr.grid_eff         = 0.8
amr.max_level        = 2
amr.n_cell           = 384 240        # dx = 40/384 = 0.104, dy = 30/240 = 0.125 (same spacing as the old 144 48)
amr.n_error_buf      = 16

### DIMENSIONS ###
geometry.prob_lo     = -10.0 -15.0 0.0   # 10 D upstream, +-15 D laterally (blockage D/H = 3.3%)
geometry.prob_hi     =  30.0  15.0 0.0   # 30 D downstream
geometry.is_periodic = 0 0 0

### TIME STEPPING ###
timestep            = 1e-5
dynamictimestep.on  = 1
dynamictimestep.verbose = 0
dynamictimestep.max = 5e-3
dynamictimestep.min = 1e-9
cfl                 = 0.4
nghost              = 4            # NSCBC4 needs 4 ghost cells
stop_time           = 30.0         # the body travels 30 D: x_c from 25 to -5

# ----------------------------------------------------------------------------
# EMBEDDED SOLID BOUNDARY
# ----------------------------------------------------------------------------
apply_embedded_solid = 1
solid.brinkman       = 70             # YANG penalty ~4*U/eps (U=1, eps=0.06): gives BOTH no-penetration AND no-slip (drives u->0 in the solid)
phi_refinement_criterion = 0.1

# Cylinder of radius R0 at the origin: r>R0 -> phi=1 (fluid), r<R0 -> phi=0 (solid)
solid.phi.ic.type = expression
solid.phi.ic.expression.constant.R0  = 0.5
solid.phi.ic.expression.constant.eps = 0.013   # [2026-09-30] ~half a finest cell: phi carries the true surface position
solid.phi.ic.expression.constant.x0  = 25.0      # start 5 D from the right boundary
solid.phi.ic.expression.constant.Uc  = 1.0       # speed, moving in -x (impulsive start, as the static deck)
solid.phi.ic.expression.region0 = "0.5*(1.0 + tanh((sqrt((x - x0 + Uc*t)^2 + y*y) - R0)/eps))"

# Prescribed quiescent solid target, split by the local alpha_1 = eta = 1
# (physical solid state rho=100, p=1785.71, u=0):
#   rho_eta0 = 100, rho_eta1 = 0,    E0 = 4464.28, E1 = 0
solid.density.ic.type = constant
solid.density.ic.constant.value = 100.0
solid.momentum.ic.type = constant
solid.momentum.ic.constant.value = -100.0 0.0     # M_s = rho_s u_s,  u_s = (-Uc, 0)
solid.pressure.ic.type = constant
solid.pressure.ic.constant.value = 1785.712

### ETA (alpha_1) IC -- uniform alpha_1 = 1 (pure phase 0) ###
eta.ic.type = constant
eta.ic.constant.value = 1.0
eta.bc.type.xlo = neumann
eta.bc.type.xhi = neumann
eta.bc.type.ylo = neumann
eta.bc.type.yhi = neumann

### EOS ###
eos0.gamma = 1.4
eos0.p0    = 0.0
eos0.cp    = 1005.0
eos0.cv    = 717.86
mu0   = 2.5      # Re = rho Uc D / mu = 100 * 1 * 1 / 2.5 = 40
mu0_b = 0.0
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cp    = 1005.0
eos1.cv    = 717.86
mu1   = 2.5
mu1_b = 0.0
# Fourier heat conduction (k = mu cp / Pr).  Without it the no-slip wall has nowhere
# to put its dissipation heat: T_wall reached 1.077 T_inf by t = 6 (physical ~1.007).
thermal.conduction = 0      # [2026-09-25] off (user request; was 1)
thermal.Pr         = 0.72

### FLUID 0 IC (uniform inflow in +x) ###
density0.ic.type = constant
density0.ic.constant.value = 100.0
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"     # fluid at rest
velocity0.ic.expression.region1 = "0.0"
pressure0.ic.type = constant
pressure0.ic.constant.value = 1785.71

### FLUID 1 IC (negligible) ###
density1.ic.type = constant
density1.ic.constant.value = 100.0
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"     # fluid at rest
velocity1.ic.expression.region1 = "0.0"
pressure1.ic.type = constant
pressure1.ic.constant.value = 1785.71

### INTERACTIONS ###
epsilon = 0.1
sigma   = 0.0
Dv      = 0.0
pref    = 0.0
small   = 1e-6
grav    = 0.0

### BOUNDARY CONDITIONS ###
# Subsonic (Ma 0.2) far field: NSCBC4 non-reflecting boundaries (same set-up as the
# viscous NACA 0012 decks).  Inflow xlo fixes u, v, T; outflow xhi and the lateral
# boundaries relax toward the free-stream pressure, so start-up acoustics leave the
# domain instead of ringing (all-Dirichlet/Neumann walls trapped a +-200 pressure wave).
#   target_T = p/(rho cv (gamma-1)) = 1785.71/(100*717.86*0.4) = 6.2188658e-02
density.bc.type.xlo  = nscbc_outflow
momentum.bc.type.xlo = nscbc_outflow nscbc_outflow
energy.bc.type.xlo   = nscbc_outflow
density.bc.type.xhi  = nscbc_outflow
momentum.bc.type.xhi = nscbc_outflow nscbc_outflow
energy.bc.type.xhi   = nscbc_outflow
density.bc.type.ylo  = nscbc_outflow
momentum.bc.type.ylo = nscbc_outflow nscbc_outflow
energy.bc.type.ylo   = nscbc_outflow
density.bc.type.yhi  = nscbc_outflow
momentum.bc.type.yhi = nscbc_outflow nscbc_outflow
energy.bc.type.yhi   = nscbc_outflow
density0.bc.type.xlo = neumann
density0.bc.type.xhi = neumann
density0.bc.type.ylo = neumann
density0.bc.type.yhi = neumann
density1.bc.type.xlo = neumann
density1.bc.type.xhi = neumann
density1.bc.type.ylo = neumann
density1.bc.type.yhi = neumann

nscbc.xlo.type     = outflow
nscbc.xlo.target_p = 1785.71
nscbc.xlo.sigma    = 0.5
nscbc.xlo.beta     = 0.5
nscbc.xlo.target_u = 0.0
nscbc.xlo.target_v = 0.0
nscbc.xhi.type     = outflow
nscbc.xhi.target_p = 1785.71
nscbc.xhi.target_u = 0.0
nscbc.xhi.target_v = 0.0
nscbc.xhi.sigma    = 0.5
nscbc.xhi.beta     = 0.5
nscbc.ylo.type     = outflow
nscbc.ylo.target_p = 1785.71
nscbc.ylo.target_u = 0.0
nscbc.ylo.target_v = 0.0
nscbc.ylo.sigma    = 0.5
nscbc.ylo.beta     = 0.5
nscbc.yhi.type     = outflow
nscbc.yhi.target_p = 1785.71
nscbc.yhi.target_u = 0.0
nscbc.yhi.target_v = 0.0
nscbc.yhi.sigma    = 0.5
nscbc.yhi.beta     = 0.5
nscbc.small = 1.0e-10

### REFINEMENT CRITERIA ###
eta_refinement_criterion   = 1e10
omega_refinement_criterion = 0.5
gradu_refinement_criterion = 1.0e8
p_refinement_criterion     = 1e10
rho_refinement_criterion   = 1e10
cutoff = 1e-16

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

apply_surface_tension = 0
apply_weight          = 0
apply_vaporization    = 0

### SOLVER ###
Riemann_Solver.type = hllc
Limiter.type        = minmod
kappa_method        = 1

solid.force_int = 1
solid.wall_flux = 1   # [2026-09-30] explicit mirror wall (phi no longer thin enough for the auto test)
solid.moving    = 1   # [2026-10-05] moving rigid solid
