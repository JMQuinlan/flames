#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

# =============================================================================
# STAGE 3b -- checkpoint 1 (3b-1): VAPOR SPECIES DIFFUSION
# =============================================================================
# Same air-carrier + composition-EOS setup as Species_AirCarrier_1D, but now the
# vapor diffuses through the carrier: Dv > 0 turns on Fickian binary diffusion
#       d(rho_vap)/dt += div( rho_eta0 * Dv * grad(Y_v) ) ,   Y_v = rho_vap/rho_eta0
# (rho_eta0 = rho*eta is the gas mass per total volume, so this is the vapor mass
# flux per total area). The diffusion only redistributes vapor within the fixed
# rho_eta0 field, so the inert carrier (= rho_eta0 - rho_vap) counter-diffuses and
# INT(rho_vap) is unchanged for the no-flux (neumann) walls.
#
# Evaporation is left ON (prescribed const rate) so a vapor gradient is CREATED at
# the interface; with Dv > 0 that vapor spreads into the carrier instead of piling
# up in the interface cells -- the actual Spalding picture. Contrast against the
# Dv = 0 control (Species_AirCarrier_1D): same run, but there the mass_frac_v peak
# stays pinned to the ~2-cell interface band.
#
# Dv = 2e-3 m^2/s is EXAGGERATED (~100x the real dodecane-in-air value ~5e-6) so
# the spreading is clearly visible within the short pre-transit window and so the
# parabolic limit dt_species = cfl_v*dx^2/Dv stays above the acoustic dt (dt is
# still acoustic-limited; the run behaves like the other species tests).
#
# CHECK against integrals.dat (... 3:M_phase0_gas 4:M_phase1_liq ... 9:M_vapor
# 10:M_carrier), over the EARLY (pre acoustic-transit) window:
#   * M_carrier (= air) ~ constant     -> diffusion is conservative; carrier intact
#   * d(M_vapor) = -d(M_phase1_liq)    -> evaporated liquid becomes vapor, in balance
#   * M_vapor grows from 0; run stays stable (no NaN / pressure floor)
#   * mass_frac_v profile near the interface is broader than the Dv=0 control
#     (visual, in the plotfiles)
#   -> reuse: python check_species.py <plot_file>/integrals.dat
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = /mmfs1/home/jquinlan/runs/stefan/output_species_diff
amr.plot_dt = 2.0e-6

### MESHING (no AMR) ###
amr.max_grid_size = 500000
amr.blocking_factor = 4
amr.regrid_int = 1
amr.max_level = 0
amr.n_cell = 200 8

### DIMENSIONS ###
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 4.0e-3 1.6e-4 0.0
geometry.is_periodic = 0 0 0

### TIME STEPPING ###
timestep = 1e-11
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 1.0e-8
dynamictimestep.min = 1.0e-15
cfl = 0.2
stop_time = 1.0e-4

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 4.0e-5
eta.ic.expression.constant.x_int = 2.0e-3
eta.ic.expression.region0 = "0.5*(1 + tanh((x - x_int)/(sqrt(2)*epsilon)))"
epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###
# eos0 = AIR carrier (ideal gas): gamma=1.4, cv=717.5, cp=1004.5 (cp=gamma*cv), p0=0.
eos0.gamma = 1.4
eos0.p0 = 0.0
eos0.cv = "717.5"
eos0.cp = "1004.5"
mu0 = 0.0
mu0_b = 0.0

# eos1 = liquid dodecane (Tammann).
eos1.gamma = 2.358
eos1.p0 = 4.01e8
eos1.cv = "1.08e3"
eos1.cp = "2546.64"
mu1 = 0.0
mu1_b = 0.0

# Gas intrinsic density = air at p=1e5 Pa, T=300 K: rho = p/(R T), R = cp-cv = 287.
density0.ic.type = expression
density0.ic.expression.constant.rho_air = 1.16144
density0.ic.expression.region0 = "rho_air"

density1.ic.type = expression
density1.ic.expression.constant.rho_nDodecane = 749.5
density1.ic.expression.region0 = "rho_nDodecane"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

pressure0.ic.type = expression
pressure0.ic.expression.constant.p0 = 1.0e5
pressure0.ic.expression.region0 = "p0"

pressure1.ic.type = expression
pressure1.ic.expression.constant.p0 = 1.0e5
pressure1.ic.expression.region0 = "p0"

pref = 0.0

### VAPOR SPECIES (composition-dependent gas EOS + diffusion) ###
species_transport = 1        # evolve rho_vap, composition EOS, AND vapor diffusion
Yv_init           = 0.0      # gas starts as pure air; dodecane vapor appears via evaporation
cv_vap            = 1950.0   # dodecane-vapor cv [J/kg/K]
cp_vap            = 1994.85  # dodecane-vapor cp [J/kg/K]  (gamma_vap ~ 1.023)
Dv                = 2.0e-3   # vapor diffusivity [m^2/s] -- EXAGGERATED (~100x real) for visibility

### PRESCRIBED CONSTANT-RATE PHASE CHANGE (creates the vapor gradient) ###
apply_vap_const = 1
vap_const_mdot  = 1000.0     # interfacial mass flux [kg/m^2/s], liquid -> vapor
apply_vaporization = 0
apply_cavitation   = 0
Y_infinity = 0.0

### SURFACE TENSION / CH OFF ###
apply_surface_tension = 0
sigma = 0.0
Mob = 50.0
kappa_method = 1
smooth_kernel_size = 5
nghost = 4
kappa_grad_frac = 0.02
apply_sharpening = 0

### BOUNDARY CONDITIONS (neumann all sides) ###
density.bc.type.xlo = neumann
density.bc.type.xhi = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.xhi = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.xhi = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

### REFINEMENT CRITERIA (unused at max_level=0) ###
eta_refinement_criterion = 2e-2
omega_refinement_criterion = 1e+20
divu_refinement_criterion = 1e+20
rho_refinement_criterion = 1e+20
gradu_refinement_criterion = 1e+20

cutoff = 1e-16
small = 1e-6

### POSITIVITY-PRESERVING FLUX LIMITER ###
# species_transport=1 currently requires pp_flux_limiter=0 (FE path).
pp_flux_limiter = 0
pp_source_limiter = 0
eps_p = 1.0
eps_rho = 1e-10
p_cav = 1.0e6

### SOURCE TERM IC FIELDS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value = 0.0 0.0

apply_weight = 0
Spec_Vol = 1
grav = 9.81

### RIEMANN SOLVER ###
Riemann_Solver.type = hllc_adc
Riemann_Solver.hllc_adc.alpha = 12
Riemann_Solver.hllc_adc.adc_components = 4
adc_shock_threshold = 0.75
adc_grow = 4
