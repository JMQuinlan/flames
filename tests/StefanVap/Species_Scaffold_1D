#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

# =============================================================================
# STAGE 3a -- checkpoint 1: vapor-species field SCAFFOLDING test
# =============================================================================
# Quiescent, no-source, no-AMR 1D box. Verifies ONLY that the new conserved
# vapor field (rho_vap) is allocated, initialized, and logged correctly -- the
# field is NOT evolved yet (advection + evaporation source come in checkpoint 2),
# so everything is static. EOS is also NOT composition-dependent yet (eos0 is
# used directly); this test is EOS-agnostic since nothing moves.
#
# species_transport = 1, Yv_init = 0.5  -> rho_vap = 0.5 * rho_eta0 at IC.
# apply_vap_const = 0 (no source) and zero velocity -> nothing moves.
#
# CHECK against integrals.dat (cols ... 3:M_phase0_gas ... 9:M_vapor 10:M_carrier):
#   * a "rho_vap" field appears in the plotfiles (= 0.5*rho_eta0 in the gas)
#   * M_vapor  ~= 0.5 * M_phase0_gas at t=0, and CONSTANT over the run
#   * M_carrier = M_phase0_gas - M_vapor, also constant
#   * M_total / M_phase0 / M_phase1 all flat (quiescent, no source)
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = /mmfs1/home/jquinlan/runs/stefan/output_species_scaffold
amr.plot_dt = 5.0e-7

### MESHING (no AMR) ###
amr.max_grid_size = 500000
amr.blocking_factor = 4
amr.regrid_int = 1
amr.max_level = 0
amr.n_cell = 200 8

### DIMENSIONS ###
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 4.0e-3 1.6e-4 0.0
geometry.is_periodic = 0 0 0

### TIME STEPPING (short -- just need a few logged rows) ###
timestep = 1e-11
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 1.0e-8
dynamictimestep.min = 1.0e-15
cfl = 0.2
stop_time = 2.0e-6

### ETA INITIAL CONDITIONS ###
# eta ~ 0 inside liquid (left), eta ~ 1 in gas (right). Interface at x_int.
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 4.0e-5
eta.ic.expression.constant.x_int = 2.0e-3
eta.ic.expression.region0 = "0.5*(1 + tanh((x - x_int)/(sqrt(2)*epsilon)))"
epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###
# fluid 0 = gas (eta~1) ; fluid 1 = liquid (eta~0). EOS compositing is Stage 3a-2;
# for this static scaffolding test eos0 is used directly (values irrelevant here).
eos0.gamma = 1.023
eos0.p0 = 0.0
eos0.cv = "1.95e3"
eos0.cp = "1994.85"
mu0 = 0.0
mu0_b = 0.0

eos1.gamma = 2.358
eos1.p0 = 4.01e8
eos1.cv = "1.08e3"
eos1.cp = "2546.64"
mu1 = 0.0
mu1_b = 0.0

# Intrinsic phase densities (uniform).
density0.ic.type = expression
density0.ic.expression.constant.rho_vapor = 1.35598311723
density0.ic.expression.region0 = "rho_vapor"

density1.ic.type = expression
density1.ic.expression.constant.rho_nDodecane = 749.5
density1.ic.expression.region0 = "rho_nDodecane"

# Quiescent: zero velocity everywhere.
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

# Uniform pressure.
pressure0.ic.type = expression
pressure0.ic.expression.constant.p0 = 1.0e5
pressure0.ic.expression.region0 = "p0"

pressure1.ic.type = expression
pressure1.ic.expression.constant.p0 = 1.0e5
pressure1.ic.expression.region0 = "p0"

pref = 0.0

### VAPOR SPECIES (the thing under test) ###
species_transport = 1        # allocate + initialize + log rho_vap
Yv_init           = 0.5      # initial vapor mass fraction in the gas -> rho_vap = 0.5*rho_eta0

### PHASE CHANGE OFF (static field check) ###
apply_vap_const    = 0
vap_const_mdot     = 0.0
apply_vaporization = 0
apply_cavitation   = 0
Dv = 0.0
Y_infinity = 0.0

### SURFACE TENSION / CH OFF ###
apply_surface_tension = 0
sigma = 0.0
Mob = 50.0
kappa_method = 1
smooth_kernel_size = 5
nghost = 4
kappa_grad_frac = 0.02
apply_sharpening = 0

### BOUNDARY CONDITIONS (neumann all sides) ###
density.bc.type.xlo = neumann
density.bc.type.xhi = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.xhi = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.xhi = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

### REFINEMENT CRITERIA (unused at max_level=0) ###
eta_refinement_criterion = 2e-2
omega_refinement_criterion = 1e+20
divu_refinement_criterion = 1e+20
rho_refinement_criterion = 1e+20
gradu_refinement_criterion = 1e+20

cutoff = 1e-16
small = 1e-6

### POSITIVITY-PRESERVING FLUX LIMITER ###
pp_flux_limiter = 1
pp_source_limiter = 0
eps_p = 1.0
eps_rho = 1e-10
p_cav = 1.0e6

### SOURCE TERM IC FIELDS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value = 0.0 0.0

apply_weight = 0
Spec_Vol = 1
grav = 9.81

### RIEMANN SOLVER ###
Riemann_Solver.type = hllc_adc
Riemann_Solver.hllc_adc.alpha = 12
Riemann_Solver.hllc_adc.adc_components = 4
adc_shock_threshold = 0.75
adc_grow = 4
