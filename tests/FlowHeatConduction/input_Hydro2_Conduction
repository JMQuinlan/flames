#@ [hydro2_conduction]
#@ exe=hydro2
#@ dim=2
# =============================================================================
# FOURIER HEAT CONDUCTION unit test (thermal.conduction = 1).
#   Periodic box, gas at rest at UNIFORM pressure with a 10% temperature
#   sine wave  T = T0 (1 + 0.1 sin(2 pi x))  (built from rho = 1/(1+0.1 sin)).
#   Isobaric heat diffusion damps the mode as  exp(-kappa_p (2 pi)^2 t),
#   kappa_p = k/(rho cp) = mu/(rho Pr) = 0.01/0.72 -> rate 0.548 /time.
#   (Linear theory; the pressure equilibrates acoustically much faster.)
# Post-process: tests/FlowHeatConduction/reference/conduction_decay.py
# =============================================================================
alamo.program = hydro2
plot_file     = ./tests/FlowHeatConduction/output
amr.plot_dt   = 0.25
amr.plot_int  = -1

amr.max_grid_size    = 64
amr.blocking_factor  = 8
amr.max_level        = 0
amr.n_cell           = 64 8
geometry.prob_lo     = 0.0 0.0 0.0
geometry.prob_hi     = 1.0 0.125 0.0
geometry.is_periodic = 1 1 0

timestep            = 1e-6
dynamictimestep.on  = 1
dynamictimestep.max = 1e-2
dynamictimestep.min = 1e-10
cfl                 = 0.3
cfl_v               = 0.3
stop_time           = 2.0
nghost              = 4
relax_diag          = 0
integration.type    = RungeKutta
integration.rk.type = 3

apply_embedded_solid = 0
thermal.conduction   = 1
thermal.Pr           = 0.72

# single-phase air (eta = 1), a = 1
eta.ic.type           = constant
eta.ic.constant.value = 1.0
eos0.gamma = 1.4
eos0.p0    = 0.0
eos0.cp    = 1005.0
eos0.cv    = 717.86
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cp    = 1005.0
eos1.cv    = 717.86
mu0   = 0.01
mu1   = 0.01
mu0_b = 0.0
mu1_b = 0.0

density0.ic.type = expression
density0.ic.expression.region0 = "1.0/(1.0 + 0.1*sin(2.0*3.141592653589793*x))"
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
pressure0.ic.type = constant
pressure0.ic.constant.value = 0.714286
density1.ic.type = expression
density1.ic.expression.region0 = "1.0/(1.0 + 0.1*sin(2.0*3.141592653589793*x))"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"
pressure1.ic.type = constant
pressure1.ic.constant.value = 0.714286

epsilon = 0.1
sigma   = 0.0
Dv      = 0.0
pref    = 0.0
small   = 1e-6
grav    = 0.0
cutoff  = 0.01

# fully periodic: every field BC must say so (see input_Brinkman_Couette)
eta.bc.type.xlo = periodic
eta.bc.type.xhi = periodic
eta.bc.type.ylo = periodic
eta.bc.type.yhi = periodic
density.bc.type.xlo = periodic
density.bc.type.xhi = periodic
density.bc.type.ylo = periodic
density.bc.type.yhi = periodic
density0.bc.type.xlo = periodic
density0.bc.type.xhi = periodic
density0.bc.type.ylo = periodic
density0.bc.type.yhi = periodic
density1.bc.type.xlo = periodic
density1.bc.type.xhi = periodic
density1.bc.type.ylo = periodic
density1.bc.type.yhi = periodic
energy.bc.type.xlo = periodic
energy.bc.type.xhi = periodic
energy.bc.type.ylo = periodic
energy.bc.type.yhi = periodic
momentum.bc.type.xlo = periodic periodic
momentum.bc.type.xhi = periodic periodic
momentum.bc.type.ylo = periodic periodic
momentum.bc.type.yhi = periodic periodic

eta_refinement_criterion   = 1e10
omega_refinement_criterion = 1e10
gradu_refinement_criterion = 1e10
p_refinement_criterion     = 1e10
rho_refinement_criterion   = 1e10
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0
apply_surface_tension = 0
apply_weight          = 0
apply_vaporization    = 0
Riemann_Solver.type = hllc
Limiter.type        = vanleer
kappa_method        = 1
apply_sharpening    = 0
