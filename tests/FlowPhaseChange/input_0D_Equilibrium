# ============================================================================
# FlowPhaseChange / 0D relaxation to liquid-vapour equilibrium  (Hydro2, phasechange.on = 1)
#
# A closed periodic box, uniform and at rest: half the volume superheated liquid water, half
# water vapour, both at p = 1e5 Pa and T = 400 K (T_sat(1e5) = 372.9 K for these constants).
# The thermodynamic relaxation must take it in one step to the state with equal pressure,
# temperature and Gibbs energy at the same total mass, volume and energy; that state is
# computed independently in reference/equilibrium_0d_check.py.
#   liquid (phase 1): Le Metayer water, gamma 2.35, pi 1e9, cv 1816, rho = 1019.9 at 400 K
#   vapour (phase 0): gamma 1.43, cv 1040, rho = 0.55903 at 400 K
# Other initial states: density0/1.ic.constant.value, pressure*.ic.constant.value, eta.ic.constant.value,
# phasechange.Yv0 (vapour mass fraction of the gas; < 1 adds non-condensable gas).
#
# Run (from bin/): mpirun -np 1 ./hydro2-2d-g++ ../tests/FlowPhaseChange/input_0D_Equilibrium plot_file=<dir>/output
# Check:           python3 ../tests/FlowPhaseChange/reference/equilibrium_0d_check.py <dir> [alpha_gas rho_gas rho_liq p Yv0]
# ============================================================================
plot_file = ./tests/FlowPhaseChange/output_0D_Equilibrium

Riemann_Solver.type = hllc
Limiter.type        = minmod
nghost = 4
integration.type    = RungeKutta
integration.rk.type = 3


eta.ic.type = constant
eta.ic.constant.value = 0.5
epsilon = 0.01

amr.plot_dt = 1.0e-5
amr.max_level = 0
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.n_cell = 8 8
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 0.0
geometry.is_periodic = 1 1 0

timestep = 1.0e-6
stop_time = 1.0e-5

m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0
q.ic.type = constant
q.ic.constant.value = 0.0

cfl   = 0.4

eos0.gamma = 1.43
eos1.gamma = 2.35
eos0.p0 = 0.0
eos1.p0 = 1.0e9
eos0.cp = 1487.2
eos1.cp = 4267.6
eos0.cv = 1040.0
eos1.cv = 1816.0

mu0   = 0.0
mu1   = 0.0
sigma = 0.0
pref = 0.0

# solid (phase 0)
density0.ic.type = constant
density0.ic.constant.value = 0.55903
velocity0.ic.type = constant
velocity0.ic.constant.value = 0.0 0.0
pressure0.ic.type = constant
pressure0.ic.constant.value = 1.0e5
cp0 = 1.4
cv0 = 1.0

# gas (phase 1, trace)
density1.ic.type = constant
density1.ic.constant.value = 1019.9
velocity1.ic.type = constant
velocity1.ic.constant.value = 0.0 0.0
pressure1.ic.type = constant
pressure1.ic.constant.value = 1.0e5
cp1 = 1.4
cv1 = 1.0

density.bc.type.xhi = periodic
density.bc.type.xlo = periodic
density.bc.type.ylo = periodic
density.bc.type.yhi = periodic
energy.bc.type.xhi = periodic
energy.bc.type.xlo = periodic
energy.bc.type.ylo = periodic
energy.bc.type.yhi = periodic
momentum.bc.type.xhi = periodic periodic
momentum.bc.type.xlo = periodic periodic
momentum.bc.type.ylo = periodic periodic
momentum.bc.type.yhi = periodic periodic

eta_refinement_criterion   = 100000.1
omega_refinement_criterion = 100000.1
gradu_refinement_criterion = 100000.0
rho_refinement_criterion   = 100000.0
p_refinement_criterion     = 100000.0

kappa_method = 1
Dv = 0
g = 0.0
apply_surface_tension = 0
apply_weight = 0
apply_vaporization = 0
reinit_max_iter = 50
reinit_tolerance = 1e-6
apply_ahe   = 1
ahe.method  = 0
cutoff = 1e-4

eta.bc.type.xlo = periodic
eta.bc.type.xhi = periodic
eta.bc.type.ylo = periodic
eta.bc.type.yhi = periodic



phasechange.on = 1
phasechange.liquid = 1                       # phase 1 (eta = 0) is the liquid; phase 0 the gas
phasechange.liquid_material = water_liquid
phasechange.vapor_material  = water_vapor
phasechange.material_file   = ../data/hydro2_materials.dat
phasechange.Yv0 = 1.0                        # the gas is pure vapour
