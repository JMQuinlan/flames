def compute_schlieren(rho, dx, dy, beta=10.0, log_scale=True):
    """Calculate numerical schlieren field from density gradient magnitude."""
    drho_dx = np.gradient(rho, dx, axis=1)  # axis 1 = x direction
    drho_dy = np.gradient(rho, dy, axis=0)  # axis 0 = y direction
    grad_rho_mag = np.sqrt(drho_dx**2 + drho_dy**2)

    if log_scale:
        schlieren = np.log10(1.0 + 100.0 * grad_rho_mag)
    else:
        grad_max = np.max(grad_rho_mag)
        if grad_max > 0:
            schlieren = np.exp(-beta * grad_rho_mag / grad_max)
        else:
            schlieren = np.ones_like(grad_rho_mag)

    return schlieren


def compute_droplet_area(eta, dx, dy, threshold=0.5):
    """Compute cross-sectional area of the droplet (sum of cells where eta < threshold).

    In 2D this is the projected area [m^2].
    """
    droplet_mask = (eta < threshold)
    area = np.sum(droplet_mask) * dx * dy
    return area


def compute_aspect_ratio(eta, x_grid, y_grid, threshold=0.5):
    """Compute aspect ratio AR = R_y / R_x from bounding box of eta-band.

    R_x = (max_x - min_x) / 2   (streamwise half-extent)
    R_y = (max_y - min_y) / 2   (crossflow half-extent)
    AR  = R_y / R_x

    Returns (AR, R_x, R_y).
    """
    droplet_mask = (eta < threshold)
    if not np.any(droplet_mask):
        return (1.0, 0.0, 0.0)

    y_indices, x_indices = np.where(droplet_mask)
    x_coords = x_grid[y_indices, x_indices]
    y_coords = y_grid[y_indices, x_indices]

    x_min, x_max = float(np.min(x_coords)), float(np.max(x_coords))
    y_min, y_max = float(np.min(y_coords)), float(np.max(y_coords))

    R_x = 0.5 * (x_max - x_min)
    R_y = 0.5 * (y_max - y_min)

    if R_x > 0:
        AR = R_y / R_x
    else:
        AR = 1.0

    return (AR, R_x, R_y)


def compute_surface_area(eta, x_grid, y_grid, dx, dy, threshold=0.5):
    """Compute interface perimeter (surface area in 2D) using the diffuse-interface
    gradient method:  A = integral |grad eta| dx dy.

    This gives the total interface length [m] in 2D.
    """
    deta_dx = np.gradient(eta, dx, axis=1)
    deta_dy = np.gradient(eta, dy, axis=0)
    grad_eta_mag = np.sqrt(deta_dx**2 + deta_dy**2)
    surface_area = float(np.sum(grad_eta_mag)) * dx * dy
    return surface_area


def compute_mass_fractions(eta, rho, dx, dy):
    """Compute mass fraction of liquid and vapor in the domain.

    The volume fraction field eta is defined as:
        eta ~ 0 inside liquid (droplet)
        eta ~ 1 in gas (vapor)

    Liquid volume fraction: phi_l = (1 - eta)
    Vapor volume fraction:  phi_v = eta

    Mass of liquid:  M_l = sum_cells rho * (1 - eta) * dx * dy
    Mass of vapor:   M_v = sum_cells rho * eta * dx * dy
    Total mass:      M_total = M_l + M_v

    Returns (Y_liquid, Y_vapor) where Y = M_component / M_total.
    """
    M_liquid = float(np.sum(rho * (1.0 - eta))) * dx * dy
    M_vapor = float(np.sum(rho * eta)) * dx * dy
    M_total = M_liquid + M_vapor

    if M_total > 0:
        Y_liquid = M_liquid / M_total
        Y_vapor = M_vapor / M_total
    else:
        Y_liquid = 0.0
        Y_vapor = 0.0

    return (Y_liquid, Y_vapor)


