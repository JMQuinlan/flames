#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

# Mach 3 shock impact on a volatile n-pentane droplet.
# This is a new full-breakup/vaporization case, not a Weber-number-matched water case.

alamo.program = hydro2

### OUTPUT ###
#plot_file = ./tests/FlowPatel/Test8_ShockDroplet_Ma3_nPentane_FullBreakup
#plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowPatel/Test8_ShockDroplet_Ma3_nPentane_FullBreakup
plot_file = /mmfs1/home/spatel6/flames/bin/tests/FlowPatel/Test8_ShockDroplet_Ma3_nPentane_NoVap

### MESHING ###
amr.plot_dt = 1.0e-6
#amr.plot_int = 1
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.regrid_int = 10
amr.grid_eff = 0.8
amr.max_level = 2
amr.n_cell = 2650 200  # Base dx=dy=8e-5 on a 0.212m x 0.016m domain

### TIME STEPPING ###
## Static:
timestep = 1e-12

## Adaptive
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 5.0e-7
dynamictimestep.min = 1e-16
cfl = 0.25

### DIMENSIONS ###
geometry.prob_lo = -0.012 -0.008 0.0
geometry.prob_hi =  0.200  0.008 0.0
geometry.is_periodic = 0 0 0

### TIME STEP ###
# For D0=0.002m, rho_l=620, rho_g,2=4.725, u_2=756.209:
# t_break = D0*sqrt(rho_l/rho_g,2)/u_2 = 3.03e-5 s.
# stop_time=3e-4 s gives about 9.7 breakup times after leading-edge impact.
stop_time = 3.0e-4

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 2.0e-5
eta.ic.expression.constant.R0 = 0.001  # 1 mm droplet radius; D0 = 2 mm
eta.ic.expression.constant.x_center = 0.0
eta.ic.expression.constant.y_center = 0.0

# Code convention for this expression: eta ~ 0 inside liquid, eta ~ 1 in gas.
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt((x-x_center)**2 + (y-y_center)**2) - R0)/(2*sqrt(2)*epsilon)))"

epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###

# Air properties (fluid 0 - surrounding gas, eta ~ 1)
eos0.gamma = 1.4
eos0.p0 = 0
mu0 = 1.8e-5
mu0_b = 0.0

# n-Pentane properties (fluid 1 - volatile liquid droplet, eta ~ 0)
eos1.gamma = 1.05
eos1.p0 = 2.0e8
mu1 = 2.4e-4
mu1_b = 0.0

# Densities
density0.ic.type = expression
density0.ic.expression.constant.rho_air = 1.225
density0.ic.expression.constant.rho_shock = 4.725  # Post-shock rho_2 for M_s=3.0
density0.ic.expression.constant.x_shock = -0.010
density0.ic.expression.region0 = "(x < x_shock)*rho_shock + (x >= x_shock)*rho_air"

density1.ic.type = expression
density1.ic.expression.constant.rho_nPentane = 620.0
density1.ic.expression.region0 = "rho_nPentane"

# Velocities: post-shock gas velocity u_2 for a Mach 3 air shock.
velocity0.ic.type = expression
velocity0.ic.expression.constant.u_shock = 756.208867874
velocity0.ic.expression.constant.x_shock = -0.010
velocity0.ic.expression.region0 = "(x < x_shock)*u_shock + (x >= x_shock)*0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.constant.u_shock = 0.0
velocity1.ic.expression.constant.x_shock = -0.010
velocity1.ic.expression.region0 = "(x < x_shock)*u_shock + (x >= x_shock)*0.0"
velocity1.ic.expression.region1 = "0.0"

# Pressures: post-shock pressure p_2 for a Mach 3 air shock.
pressure0.ic.type = expression
pressure0.ic.expression.constant.p_atm = 1.01325e5
pressure0.ic.expression.constant.p_shock = 1.047025e6
pressure0.ic.expression.constant.x_shock = -0.010
pressure0.ic.expression.region0 = "(x < x_shock)*p_shock + (x >= x_shock)*p_atm"

pressure1.ic.type = expression
pressure1.ic.expression.constant.p_atm = 1.01325e5
pressure1.ic.expression.region0 = "p_atm"

# Thermodynamic properties
eos0.cp = "1005.0"
eos1.cp = "2300.0"
eos0.cv = "717.86"
eos1.cv = "2200.0"

# Realistic n-pentane/air surface tension. This is intentionally not inflated.
sigma = 0.016

# n-Pentane vapor diffusivity in air. Nonzero Dv is required for vaporization.
Dv = "0.0"
Y_infinity = 0.0

# Reference pressure
pref = 0.0

### BOUNDARY CONDITIONS ###
# Top and bottom: slip/outflow style
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

# Left: open driver side, avoids imposing a no-slip wall into the incoming shock.
density.bc.type.xlo = neumann
energy.bc.type.xlo = neumann
momentum.bc.type.xlo = neumann neumann

# Right: outflow for stripped ligaments and vapor.
density.bc.type.xhi = neumann
energy.bc.type.xhi = neumann
momentum.bc.type.xhi = neumann neumann

### REFINEMENT CRITERIA ###
eta_refinement_criterion = 1e-2
omega_refinement_criterion = 10.55
p_refinement_criterion = 1e+5
rho_refinement_criterion = 1e+3
gradu_refinement_criterion = 1e+3
cutoff = 1e-16
small = 1e-6;

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value = 0.0 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 1
apply_weight = 0
apply_vaporization = 0

Spec_Vol = 1
grav = 9.81

### DEBUGGING ###
Riemann_Solver.type = hllc
kappa_method = 1

## Interface Sharpening ##
apply_sharpening = 0
sharpening_frequency = 100
reinit_max_iter = 20
reinit_tolerance = 1e-6
omega_relax = 0.5
