#@ [dilatation_multiphase_waterair_2d]
#@ exe=hydro2
#@ dim=2
#
# ============ DILATATIONAL VISCOSITY UNIT TEST: MULTIPHASE, WATER + AIR ============
# (2026-10-22)  2D quarter-domain gas cylinder (R0 = 2 um) in SOFTENED water with a
# purely viscous shell (marmottant 0, sigma 0, mu 0): released from p_b = 1.1 p_inf it
# breathes and the ONLY damping is kappa_s (plus numerics: run kappa_s = 0 on the same
# mesh as the baseline).  Reference: incompressible cylindrical Rayleigh-Plesset with
# R_inf = equal-area circle of the box (bin/ShellRework/scripts/rp2d.py physics);
# reference/analyze_cyl_damping.py fits kappa_eff/kappa_s.  This is the 2D version of
# tests/FlowMarmottant/input_Linear_ShellDamping_UNIT (where L1 gave 0.49, contour-rate
# 0.62) and contains the Kapila band-gas lag that the single-phase test removes.
# Sweep: amr.max_level 1/2/3 (R0/dx 8/16/32) x epsilon (eps/dx 1/2/4) x kappa_s on/off.
# ====================================================================================

alamo.program = hydro2
plot_file = ./tests/FlowDilationViscosity/output_Multiphase_WaterAir_2D
amr.plot_int = -1
amr.plot_dt = 2.0e-8
amr.max_grid_size = 32
amr.blocking_factor = 8
amr.regrid_int = 10
amr.grid_eff = 0.8
amr.max_level = 1   # R0/dx = 8 at L1, 16 at L2, 32 at L3
amr.n_cell = 32 32
amr.n_error_buf = 4
nghost = 4
timestep = 1.0e-11
dynamictimestep.on = 1
dynamictimestep.verbose = 0
dynamictimestep.max = 1.0e-9
dynamictimestep.min = 1.0e-17
cfl = 0.5
geometry.prob_lo = 0.0 0.0
geometry.prob_hi = 1.6e-5 1.6e-5   # 8 R0
geometry.is_periodic = 0 0
stop_time = 2.0e-6   # ~1.7 periods
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 5.0e-7   # eps/dx = 2 at L1
eta.ic.expression.constant.R0 = 2.0e-6
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon
eos0.gamma = 2.35
eos0.p0 = 1.0e8   # SOFTENED water (c ~ 485 m/s), as input_Linear_ShellDamping_UNIT
eos0.cv = 1781.0
eos0.cp = 4186.0
eos1.gamma = 1.4
eos1.p0 = 0.0
eos1.cv = 714.286
eos1.cp = 1000.0
density0.ic.type = expression
density0.ic.expression.region0 = "1000.0"
density1.ic.type = expression
density1.ic.expression.region0 = "1.0"
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"
pressure0.ic.type = expression
pressure0.ic.expression.constant.p_inf = 1.0e5
pressure0.ic.expression.constant.p_b = 1.1e5   # 10% over-pressure: linear-ish breathing
pressure0.ic.expression.constant.R0 = 2.0e-6
pressure0.ic.expression.constant.r_inf = 1.80541e-05   # equal-area circle of the quarter box = rp2d R_inf
pressure0.ic.expression.region0 = "p_inf - (p_inf - p_b)*log(r_inf/max(sqrt(x*x + y*y), R0))/log(r_inf/R0)"   # 2D incompressible field at t = 0
pressure1.ic.type = expression
pressure1.ic.expression.constant.p_b = 1.1e5
pressure1.ic.expression.region0 = "p_b"
mu0 = 0.0   # inviscid liquid: kappa_s is the only damping
mu0_b = 0.0
mu1 = 0.0
mu1_b = 0.0
apply_surface_tension = 1
sigma = 0.0   # no Laplace term
pref = 0.0
kappa_method = 1
marmottant = 0   # no elastic shell
marmottant.R0 = 2.0e-6
marmottant.R_buckling = 1.96e-6
marmottant.chi = 1.0
marmottant.sigma_break = 0.073
shell.kappa_s = 3.6e-8   # 2D shell jump is kappa_s Rdot/R^2: 1st peak 1.055 (1.070 at kappa 0)
shell.mu_s = 0.0
nscbc.xhi.type = outflow
nscbc.xhi.target_p = 1.0e5
nscbc.xhi.sigma = 0.6
nscbc.xhi.beta = 0.5
nscbc.xhi.L_ref = 5.0e-8
nscbc.yhi.type = outflow
nscbc.yhi.target_p = 1.0e5
nscbc.yhi.sigma = 0.6
nscbc.yhi.beta = 0.5
nscbc.yhi.L_ref = 5.0e-8
eta.bc.type.xlo = REFLECT_EVEN
eta.bc.type.xhi = neumann
eta.bc.type.ylo = REFLECT_EVEN
eta.bc.type.yhi = neumann
density.bc.type.xlo = REFLECT_EVEN
density.bc.type.xhi = nscbc_outflow
density.bc.type.ylo = REFLECT_EVEN
density.bc.type.yhi = nscbc_outflow
energy.bc.type.xlo = REFLECT_EVEN
energy.bc.type.xhi = nscbc_outflow
energy.bc.type.ylo = REFLECT_EVEN
energy.bc.type.yhi = nscbc_outflow
momentum.bc.type.xlo = REFLECT_ODD REFLECT_EVEN
momentum.bc.type.xhi = nscbc_outflow nscbc_outflow
momentum.bc.type.ylo = REFLECT_EVEN REFLECT_ODD
momentum.bc.type.yhi = nscbc_outflow nscbc_outflow
eta_refinement_criterion = 1.0e-1
omega_refinement_criterion = 1.0e+10
p_refinement_criterion = 1.0e+10
rho_refinement_criterion = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value = 0.0 0.0
apply_buoyancy = 0
apply_weight = 0
apply_vaporization = 0
grav = 0.0
Riemann_Solver.type = hllc
Limiter.type = muscl2   # project default
integration.type = RungeKutta
integration.rk.type = 3
apply_sharpening = 0
sharpening_frequency = 20
reinit_max_iter = 100
reinit_tolerance = 1e-6
omega_relax = 0.5
plot_minimal = 1
relax_diag = 0
equalize_ic_pressure = 1
