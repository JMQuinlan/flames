#@ [dilatation_singlephase_pulse_slab3d]
#@ exe=hydro2
#@ dim=3
#
# ======== DILATATIONAL VISCOSITY UNIT TEST: SINGLE PHASE, RADIAL SLAB (3D) ========
# (2026-10-23)  input_SinglePhase_Pulse_2D run as a 1D spherical (3D) problem on a slab
# 4 cells thick: x in [0,6], y, z in [0, h], h = 4 dx.
# The transverse hi faces are RADIAL: the ghosts are refilled from the
# near-axis row at the same radius (momentum rotated, u = u_r x/|x|), so the
# Cartesian stencils see an exactly spherical field.  Same membrane, fluid and
# pulse as the quarter-domain deck; reference: acoustic_shell_1d.py with D = 3.
# Analyse with  reference/analyze_dilatation.py RUN --slab  (x-axis probes only).
# Change resolution with  amr.n_cell=N 4 4  geometry.prob_hi="6 24/N 24/N"
# (keep 4 cells across) and eta.ic.expression.constant.epsilon=E.
# RADIAL needs prob_lo = 0 and symmetry at xlo/ylo/zlo.  AMR works (2026-10-24; eta tagging
# refines the whole slab width), but the pulse then crosses the coarse mesh on its
# way to the band, so compare AMR runs with AMR baselines only.
# ====================================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowDilationViscosity/output_SinglePhase_Pulse_Slab3D

### MESHING (uniform: the pulse needs the fine mesh everywhere) ###
amr.plot_int        = -1
amr.plot_dt         = 0.02
amr.max_grid_size   = 64
amr.blocking_factor = 4
amr.regrid_int      = 10
amr.grid_eff        = 0.8
amr.max_level       = 0
amr.n_cell          = 96 4 4           # R0/dx = 16; 4 cells across the slab
nghost = 4

### TIME STEPPING ###
timestep                = 1.0e-4
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 1.0e-2
dynamictimestep.min     = 1.0e-10
cfl                     = 0.5

### DIMENSIONS ###
geometry.prob_lo     = 0.0 0.0 0.0
geometry.prob_hi     = 6.0 0.25 0.25 # h = 4 dx (keep n_cell[1]*dx = h)
geometry.is_periodic = 0 0 0
stop_time            = 1.0             # both probe signals are complete by t ~ 0.8; boundary echo reaches r = 2 at t ~ 2.7

### ETA (membrane position only: both phases are the same fluid) ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.0625     # eps/dx = 2 at R0/dx = 32
eta.ic.expression.constant.R0      = 1.0
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y + z*z) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EOS: Garrick normalised liquid on BOTH sides ###
eos0.gamma = 5.5
eos0.p0    = 1.505
eos0.cv    = 717.5
eos0.cp    = 1004.5
eos1.gamma = 5.5
eos1.p0    = 1.505
eos1.cv    = 717.5
eos1.cp    = 1004.5

### INITIAL CONDITIONS ###
density0.ic.type = expression
density0.ic.expression.region0 = "0.991"
density1.ic.type = expression
density1.ic.expression.region0 = "0.991"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

pressure0.ic.type = expression
pressure0.ic.expression.constant.p_inf = 1.0
pressure0.ic.expression.constant.A     = 0.01
pressure0.ic.expression.constant.w     = 0.4
pressure0.ic.expression.region0 = "p_inf + A*exp(-(x*x + y*y + z*z)/(w*w))"
pressure1.ic.type = expression
pressure1.ic.expression.constant.p_inf = 1.0
pressure1.ic.expression.constant.A     = 0.01
pressure1.ic.expression.constant.w     = 0.4
pressure1.ic.expression.region0 = "p_inf + A*exp(-(x*x + y*y + z*z)/(w*w))"

### VISCOSITY: none in the bulk ###
mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### SHELL: dilatational viscosity only ###
apply_surface_tension = 1
sigma = 0.0
pref  = 0.0
kappa_method = 1
marmottant   = 0
shell.kappa_s = 1.0              # normalised; 0 for the baseline.  dt ~ dx^3 eps/kappa (shell limit)
shell.mu_s    = 0.0

### BOUNDARY CONDITIONS: centre (xlo) and axis planes (ylo, zlo) symmetric; RADIAL slab faces yhi, zhi ###
eta.bc.type.xlo = REFLECT_EVEN
eta.bc.type.xhi = neumann
eta.bc.type.ylo = REFLECT_EVEN
eta.bc.type.yhi = RADIAL
eta.bc.type.zlo = REFLECT_EVEN
eta.bc.type.zhi = RADIAL

density.bc.type.xlo = REFLECT_EVEN
density.bc.type.xhi = neumann
density.bc.type.ylo = REFLECT_EVEN
density.bc.type.yhi = RADIAL
density.bc.type.zlo = REFLECT_EVEN
density.bc.type.zhi = RADIAL

energy.bc.type.xlo = REFLECT_EVEN
energy.bc.type.xhi = neumann
energy.bc.type.ylo = REFLECT_EVEN
energy.bc.type.yhi = RADIAL
energy.bc.type.zlo = REFLECT_EVEN
energy.bc.type.zhi = RADIAL

momentum.bc.type.xlo = REFLECT_ODD  REFLECT_EVEN REFLECT_EVEN
momentum.bc.type.xhi = neumann neumann neumann
momentum.bc.type.ylo = REFLECT_EVEN REFLECT_ODD  REFLECT_EVEN
momentum.bc.type.yhi = RADIAL RADIAL RADIAL
momentum.bc.type.zlo = REFLECT_EVEN REFLECT_EVEN REFLECT_ODD
momentum.bc.type.zhi = RADIAL RADIAL RADIAL

### REFINEMENT (off: max_level 0) ###
eta_refinement_criterion   = 1.0e-1
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4

### SOURCE TERMS / FLAGS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0
apply_buoyancy     = 0
apply_weight       = 0
apply_vaporization = 0
grav               = 0.0

### NUMERICS (project defaults) ###
Riemann_Solver.type = hllc
Limiter.type        = muscl2
integration.type    = RungeKutta
integration.rk.type = 3
apply_sharpening     = 0
sharpening_frequency = 20
reinit_max_iter      = 100
reinit_tolerance     = 1e-6
omega_relax          = 0.5
relax_diag           = 0
