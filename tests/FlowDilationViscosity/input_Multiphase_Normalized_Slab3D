#@ [dilatation_multiphase_normalized_slab3d]
#@ exe=hydro2
#@ dim=3
#
# ===== DILATATIONAL VISCOSITY UNIT TEST: COATED GAS BUBBLE, RADIAL SLAB (3D) =====
# (2026-10-24)  The bubble-relevant kappa_s test.  A gas sphere (R0 = 1) in the
# Garrick normalised liquid (gamma 5.5, p0 1.505, rho 0.991; gas gamma 1.4,
# rho 1e-3, p_inf = 1) with a purely viscous shell (marmottant 0, sigma 0,
# mu 0), released from p_b = 1.1 p_inf with the incompressible pressure field
# p = p_inf + (p_b - p_inf) R0/r.  It breathes (period ~3) and the only damping
# is kappa_s plus numerics, so run kappa_s = 0 on the same mesh as the baseline.
# Unlike the single-phase pulse this has the Kapila gas-in-band lag, and the
# wavelength of the motion is >> R0, which is the regime of a real coated bubble.
# Reference: Keller-Miksis (tests/FlowMarmottant/reference/marmottant_rpe_km.py,
# chi = 0, sigma = 0, liquid c = 3.73).  Analyse with
#     reference/analyze_bubble_slab.py RUN --baseline RUN_K0
# Shell strength: kappa_s here is K* = kappa_s/(R0^2 sqrt(rho p_inf)); Mili/Light
# use K* = 0.18.
# Slab: x in [0, 40] (the sound round trip, 80/3.73 = 21, is longer than the run),
# y, z in [0, h], h = 4 coarse dx, RADIAL on yhi/zhi.  Resolution:
#     amr.n_cell="40N 4 4"  geometry.prob_hi="40 4/N 4/N"   (R0/dx = N on level 0)
#     amr.max_level = L     (R0/dx = N 2^L at the band)   eps = E/(N 2^L)
# ====================================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowDilationViscosity/output_Multiphase_Normalized_Slab3D

### MESHING ###
amr.plot_int        = -1
amr.plot_dt         = 0.05
amr.max_grid_size   = 64
amr.blocking_factor = 4
amr.regrid_int      = 10
amr.grid_eff        = 0.8
amr.max_level       = 2
amr.n_error_buf     = 4
amr.n_cell          = 320 4 4          # R0/dx = 8 on level 0, 32 at the band
nghost = 4

### TIME STEPPING ###
timestep                = 1.0e-4
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 1.0e-2
dynamictimestep.min     = 1.0e-10
cfl                     = 0.5

### DIMENSIONS ###
geometry.prob_lo     = 0.0 0.0 0.0
geometry.prob_hi     = 40.0 0.5 0.5    # h = 4 coarse dx
geometry.is_periodic = 0 0 0
stop_time            = 10.0            # ~3.3 periods

### ETA: eta = 0 gas inside, 1 liquid outside ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.0625     # eps/dx = 2 at the band (R0/dx 32)
eta.ic.expression.constant.R0      = 1.0
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y + z*z) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EOS ###
eos0.gamma = 5.5   # Garrick normalised liquid
eos0.p0    = 1.505
eos0.cv    = 717.5
eos0.cp    = 1004.5
eos1.gamma = 1.4   # gas
eos1.p0    = 0.0
eos1.cv    = 714.286
eos1.cp    = 1000.0

### INITIAL CONDITIONS ###
density0.ic.type = expression
density0.ic.expression.region0 = "0.991"
density1.ic.type = expression
density1.ic.expression.region0 = "1.0e-3"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

pressure0.ic.type = expression
pressure0.ic.expression.constant.p_inf = 1.0
pressure0.ic.expression.constant.p_b   = 1.1
pressure0.ic.expression.constant.R0    = 1.0
pressure0.ic.expression.region0 = "p_inf + (p_b - p_inf)*R0/max(sqrt(x*x + y*y + z*z), R0)"
pressure1.ic.type = expression
pressure1.ic.expression.constant.p_b = 1.1
pressure1.ic.expression.region0 = "p_b"

### VISCOSITY: none in the bulk ###
mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### SHELL: dilatational viscosity only ###
apply_surface_tension = 1
sigma = 0.0
pref  = 0.0
kappa_method = 1
marmottant   = 0
shell.kappa_s = 0.18             # = K*; 0 for the baseline.  dt ~ dx^3 eps/kappa (shell limit)
shell.mu_s    = 0.0
shell.nus_rho_floor = 1.0e-3      # gas density: the sub-cycler stability floor (default 1.0 is for the dimensional Sch20 decks)

### BOUNDARY CONDITIONS: centre (xlo) and axis planes (ylo, zlo) symmetric; RADIAL slab faces yhi, zhi ###
eta.bc.type.xlo = REFLECT_EVEN
eta.bc.type.xhi = neumann
eta.bc.type.ylo = REFLECT_EVEN
eta.bc.type.yhi = RADIAL
eta.bc.type.zlo = REFLECT_EVEN
eta.bc.type.zhi = RADIAL

density.bc.type.xlo = REFLECT_EVEN
density.bc.type.xhi = neumann
density.bc.type.ylo = REFLECT_EVEN
density.bc.type.yhi = RADIAL
density.bc.type.zlo = REFLECT_EVEN
density.bc.type.zhi = RADIAL

energy.bc.type.xlo = REFLECT_EVEN
energy.bc.type.xhi = neumann
energy.bc.type.ylo = REFLECT_EVEN
energy.bc.type.yhi = RADIAL
energy.bc.type.zlo = REFLECT_EVEN
energy.bc.type.zhi = RADIAL

momentum.bc.type.xlo = REFLECT_ODD  REFLECT_EVEN REFLECT_EVEN
momentum.bc.type.xhi = neumann neumann neumann
momentum.bc.type.ylo = REFLECT_EVEN REFLECT_ODD  REFLECT_EVEN
momentum.bc.type.yhi = RADIAL RADIAL RADIAL
momentum.bc.type.zlo = REFLECT_EVEN REFLECT_EVEN REFLECT_ODD
momentum.bc.type.zhi = RADIAL RADIAL RADIAL

### REFINEMENT (eta-tagged: the fine levels cover the band across the whole slab) ###
eta_refinement_criterion   = 1.0e-1
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4

### SOURCE TERMS / FLAGS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0
apply_buoyancy     = 0
apply_weight       = 0
apply_vaporization = 0
grav               = 0.0

### NUMERICS (project defaults) ###
Riemann_Solver.type = hllc
Limiter.type        = muscl2
integration.type    = RungeKutta
integration.rk.type = 3
apply_sharpening     = 0
sharpening_frequency = 20
reinit_max_iter      = 100
reinit_tolerance     = 1e-6
omega_relax          = 0.5
relax_diag           = 0
plot_minimal         = 1
equalize_ic_pressure = 1
