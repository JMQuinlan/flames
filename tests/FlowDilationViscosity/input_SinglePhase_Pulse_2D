#@ [dilatation_singlephase_pulse_2d]
#@ exe=hydro2
#@ dim=2
#
# ================ DILATATIONAL VISCOSITY UNIT TEST: SINGLE PHASE ================
# (2026-10-22)  A viscous membrane (Boussinesq-Scriven kappa_s, no elastic shell,
# no surface tension) on the circle r = R0 = 1 in ONE fluid: both eta-phases are
# the Garrick normalised liquid (gamma 5.5, p0 1.505, rho 0.991), so
#   * the Kapila source S = K div u vanishes identically (K ~ Z1 - Z0 = 0),
#   * the eta contours move exactly with the fluid, and
#   * the membrane is the ONLY thing at r = R0.
# Any error is therefore the diffuse shell operator itself (band width, |grad eta|
# weighting, discrete div_s u / P), not the band-gas lag of the liquid/gas runs.
#
# Set-up: quarter domain [0,6]^2 (symmetry on x = 0, y = 0), uniform mesh, p = 1
# plus a Gaussian acoustic pulse at the centre,
#     p = p_inf + A exp(-(r/w)^2),  A = 0.01,  w = 0.4 R0,
# which runs out through the membrane.  The membrane is a dashpot with impedance
# kappa_s (D-1)^2 / R^2 = kappa_s (D = 2); the shell partially reflects it.
# kappa_s = 1  ->  kappa_s/(rho c R^2) = 0.27, transmitted peak ~0.88 of kappa = 0.
# COST: the shell viscous limit dt ~ rho eps dx^2/kappa_s binds (600x below acoustic
# at R0/dx 32, kappa 2), so R0/dx 64 needs shell sub-cycling to be practical.
#
# REFERENCE: reference/acoustic_shell_1d.py (sharp membrane, linear acoustics,
# D = 2, converged to 4 digits).  Compare with reference/analyze_dilatation.py:
#   probes p(r = 0.5, t) [reflection] and p(r = 2.0, t) [transmission], along the
#   diagonal and the axes; kappa_eff fitted to the reference.
#
# Sweep (reference/run_sweep.sh):  R0/dx = 16, 32  x  eps/dx = 1, 2, 4,
# kappa_s on/off.  Change with
#     amr.n_cell=N N   (N = 6 R0/dx)   eta.ic.expression.constant.epsilon=E
# =================================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowDilationViscosity/output_SinglePhase_Pulse_2D

### MESHING (uniform: the pulse needs the fine mesh everywhere) ###
amr.plot_int        = -1
amr.plot_dt         = 0.02
amr.max_grid_size   = 64
amr.blocking_factor = 8
amr.regrid_int      = 10
amr.grid_eff        = 0.8
amr.max_level       = 0
amr.n_cell          = 192 192          # R0/dx = 32
nghost = 4

### TIME STEPPING ###
timestep                = 1.0e-4
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 1.0e-2
dynamictimestep.min     = 1.0e-10
cfl                     = 0.5

### DIMENSIONS ###
geometry.prob_lo     = 0.0 0.0
geometry.prob_hi     = 6.0 6.0
geometry.is_periodic = 0 0
stop_time            = 1.0             # both probe signals are complete by t ~ 0.8; boundary echo reaches r = 2 at t ~ 2.7

### ETA (membrane position only: both phases are the same fluid) ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.0625     # eps/dx = 2 at R0/dx = 32
eta.ic.expression.constant.R0      = 1.0
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EOS: Garrick normalised liquid on BOTH sides ###
eos0.gamma = 5.5
eos0.p0    = 1.505
eos0.cv    = 717.5
eos0.cp    = 1004.5
eos1.gamma = 5.5
eos1.p0    = 1.505
eos1.cv    = 717.5
eos1.cp    = 1004.5

### INITIAL CONDITIONS ###
density0.ic.type = expression
density0.ic.expression.region0 = "0.991"
density1.ic.type = expression
density1.ic.expression.region0 = "0.991"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

pressure0.ic.type = expression
pressure0.ic.expression.constant.p_inf = 1.0
pressure0.ic.expression.constant.A     = 0.01
pressure0.ic.expression.constant.w     = 0.4
pressure0.ic.expression.region0 = "p_inf + A*exp(-(x*x + y*y)/(w*w))"
pressure1.ic.type = expression
pressure1.ic.expression.constant.p_inf = 1.0
pressure1.ic.expression.constant.A     = 0.01
pressure1.ic.expression.constant.w     = 0.4
pressure1.ic.expression.region0 = "p_inf + A*exp(-(x*x + y*y)/(w*w))"

### VISCOSITY: none in the bulk ###
mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### SHELL: dilatational viscosity only ###
apply_surface_tension = 1
sigma = 0.0
pref  = 0.0
kappa_method = 1
marmottant   = 0
shell.kappa_s = 1.0              # normalised; 0 for the baseline.  dt ~ dx^3 eps/kappa (shell limit)
shell.mu_s    = 0.0

### BOUNDARY CONDITIONS: symmetry on x=0, y=0; neumann far field ###
eta.bc.type.xlo = REFLECT_EVEN
eta.bc.type.xhi = neumann
eta.bc.type.ylo = REFLECT_EVEN
eta.bc.type.yhi = neumann

density.bc.type.xlo = REFLECT_EVEN
density.bc.type.xhi = neumann
density.bc.type.ylo = REFLECT_EVEN
density.bc.type.yhi = neumann

energy.bc.type.xlo = REFLECT_EVEN
energy.bc.type.xhi = neumann
energy.bc.type.ylo = REFLECT_EVEN
energy.bc.type.yhi = neumann

momentum.bc.type.xlo = REFLECT_ODD  REFLECT_EVEN
momentum.bc.type.xhi = neumann neumann
momentum.bc.type.ylo = REFLECT_EVEN REFLECT_ODD
momentum.bc.type.yhi = neumann neumann

### REFINEMENT (off: max_level 0) ###
eta_refinement_criterion   = 1.0e-1
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4

### SOURCE TERMS / FLAGS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0
apply_buoyancy     = 0
apply_weight       = 0
apply_vaporization = 0
grav               = 0.0

### NUMERICS (project defaults) ###
Riemann_Solver.type = hllc
Limiter.type        = muscl2
integration.type    = RungeKutta
integration.rk.type = 3
apply_sharpening     = 0
sharpening_frequency = 20
reinit_max_iter      = 100
reinit_tolerance     = 1e-6
omega_relax          = 0.5
relax_diag           = 0
