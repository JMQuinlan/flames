alamo.program = hydro2

### OUTPUT ###
#plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowTwoPhase/LargeBubbleRPE_2_Bar.GammaHighTammann2
plot_file = tests/FlowShockTubeTests/output_case_1
#plot_file = /mmfs1/home/jquinlan/runs/RDE/droplet/droplet_20250529/output_Bubble



### MESHING ###
amr.plot_dt = 0.20
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.regrid_int = 2
amr.grid_eff = 0.8

amr.max_level = 0
amr.n_cell = 100 10

### TIME STEPING ###
## Static:
timestep  = 3.5e-3
## Adaptive                # Can comment out dt params for default #
adaptive_timestep = false
dt_min = 2e-6
dt_max = 5e-6
dt_growth = 1.5

### DIMENSIONS ###
geometry.prob_lo = 0.0 -0.05 0.0 # [ m ]
geometry.prob_hi = 1.0  0.05 0.0 # [ m ]
geometry.is_periodic = 0 0 0
 
### TIME STEP ###
stop_time = 0.20

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon  = 0.0005
# eta.ic.expression.constant.R0   = 0.01
# Eqn: "0.5*(1+tanh((sqrt(((x-xc)/a)**2 + ((y-yc)/b)**2) - Diameter)/Boundry_Thickness))
# RPE Verification
# eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt((x)**2 + (y)**2) - 0.01)/0.001))"
eta.ic.expression.region0 = "1.0"
epsilon = eta.ic.expression.constant.epsilon


### HYDRO INITIAL CONDITIONS ###
gamma0 = 1.4  # 1.63 # 7.15 
gamma1 = 1.4

p0_0 = 0 #.3*10**3 # 0.3*10**9
p0_1 = 0

mu0   = 0.0
mu1   = 0.0

mu0_b   = 0
mu1_b   = 0

density0.ic.type = expression
density0.ic.expression.constant.rho_L = 1.0
density0.ic.expression.constant.rho_R = 0.125
density0.ic.expression.region0 = "rho_L*(x<0.3) + rho_R*(x>0.3)" 

density1.ic.type = expression
density1.ic.expression.region0 = "1.3"

velocity0.ic.type = expression
velocity0.ic.expression.constant.v_L = 0.75
velocity0.ic.expression.constant.v_R = 0.0
velocity0.ic.expression.region0 = "v_L*(x<0.3) + v_R*(x>0.3)"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

pressure0.ic.type = expression
pressure0.ic.expression.constant.p_L = 1.0
pressure0.ic.expression.constant.p_R = 0.1
pressure0.ic.expression.region0 = "p_L*(x<0.3) + p_R*(x>0.3)"

pressure1.ic.type = expression
pressure1.ic.expression.region0 = "2e5"

sigma = 0.0 #72.8; # 0.078 # For Air/Water

cfl = 0.9
# pref = 1e5;
pref = 0.0

### ETA BC  ###
pf.eta.bc.type.xlo = neumann
pf.eta.bc.type.xhi = neumann
pf.eta.bc.type.ylo = neumann
pf.eta.bc.type.yhi = neumann
pf.eta.bc.type.zlo = neumann
pf.eta.bc.type.zhi = neumann

### HYDRO BC ###
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

#momentum.bc.type.xhi = dirichlet dirichlet
#momentum.bc.type.xlo = dirichlet dirichlet
#momentum.bc.type.ylo = dirichlet dirichlet
#momentum.bc.type.yhi = dirichlet dirichlet
