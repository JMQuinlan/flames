#momentum.bc.val.ylo = 0.0 0.0
#momentum.bc.val.yhi = 0.0 0.0

### HYDRO REFINEMENT CRITERIA ###
eta_refinement_criterion = 1111110.0001
omega_refinement_criterion = 9999910.55
p_refinement_criterion = 9999991e+4
rho_refinement_criterion = 99999991e+2
gradu_refinement_criterion = 99999991e+2
cutoff = 1e-16

### SOURCE TERMS ###
q.ic.type = expression
q.ic.expression.region0 = "0.0"
q.ic.expression.region1 = "0.0"
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 0
apply_buoyancy = 0
apply_weight = 0
grav = 9.81

### DEBUGGING ###
# Used for testing of the model
Riemann_Solver = 1 # Valid Entries: 0:"Roe" / 1:"HLLC" / 2:"HLLE" / 3:"Mixed"
kappa_method = 2   # Valid Entries: 1:"Regular" / 2:"Runnels Regularization"
scheme = 0 # Valid Entries: 0:"Forward Euler" / 1:"RK4" / 2:"SSPRK3"

