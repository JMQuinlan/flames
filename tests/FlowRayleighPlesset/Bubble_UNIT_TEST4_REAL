#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/RayleighPlesset/output_RayleighPlesset_BubbleOscillation

### MESHING ###
amr.plot_dt = 5.0e-6
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.regrid_int = 50
amr.grid_eff = 0.8
amr.max_level = 1
amr.n_cell = 256 256

### TIME STEPPING ###
timestep = 1e-8
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 1e-6
dynamictimestep.min = 1e-12
cfl = 0.1

### DIMENSIONS ###
# Domain: 4R0 x 4R0 (bubble radius R0 = 1mm at center)
geometry.prob_lo = -4.0e-3 -4.0e-3 0.0
geometry.prob_hi =  4.0e-3  4.0e-3 0.0
geometry.is_periodic = 0 0 0

stop_time = 5.0e-4

### ETA INITIAL CONDITIONS (BUBBLE INTERFACE) ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 2.0e-5
eta.ic.expression.constant.R0 = 1.0e-3
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt((x)**2 + (y)**2) - R0)/(2*sqrt(2)*epsilon)))"

epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###

# ----------------------------
# STIFFENED GAS EOS (TAIT/TAMMANN)
# For water-like incompressible behavior
# Based on: Colagrossi & Landrini (2003) JCP
# Reference: "Numerical simulation of interfacial flows by smoothed particle hydrodynamics"
# ----------------------------

# Liquid (water) - Phase 0
gamma0 = 7.15
p0_0 = 3.0e8  # Tammann pressure for water [Pa]

# Gas (air bubble) - Phase 1
gamma1 = 1.4
p0_1 = 0.0    # Ideal gas (no stiffening)

# ----------------------------
# Density: Water = 1000 kg/m^3, Air = 1.0 kg/m^3
# Based on: Popinet & Zaleski (1999) IJMF
# Reference: "A front-tracking algorithm for accurate representation of surface tension"
# ----------------------------
density0.ic.type = expression
density0.ic.expression.region0 = "1000.0"

density1.ic.type = expression
density1.ic.expression.region0 = "1.0"

# ----------------------------
# Initial velocities (rest)
# ----------------------------
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

# ----------------------------
# Pressure: Hydrostatic equilibrium
# Based on Rayleigh-Plesset equation
# P_liquid = P_atm + 2*sigma/R0
# Reference: Brennen (1995) "Cavitation and Bubble Dynamics"
# ----------------------------

# Atmospheric pressure
pressure0.ic.type = expression
pressure0.ic.expression.constant.P_atm = 101325.0
pressure0.ic.expression.constant.sigma = 0.0728
pressure0.ic.expression.constant.R0 = 1.0e-3
pressure0.ic.expression.region0 = "P_atm + 2.0*sigma/R0"

# Gas pressure inside bubble (equilibrium with Laplace pressure)
pressure1.ic.type = expression
pressure1.ic.expression.constant.P_atm = 101325.0
pressure1.ic.expression.constant.sigma = 0.0728
pressure1.ic.expression.constant.R0 = 1.0e-3
pressure1.ic.expression.region0 = "P_atm + 2.0*sigma/R0"

# ----------------------------
# Thermodynamics (stiffened gas)
# For water: cv = 4186 J/(kg*K), cp = cv (incompressible limit)
# Reference: Saurel & Abgrall (1999) JCP
# "A multiphase Godunov method for compressible multifluid flows"
# ----------------------------
cp0 = "4186.0"
cp1 = "1005.0"
cv0 = "4186.0"
cv1 = "718.0"

# ----------------------------
# No viscosity (inviscid Rayleigh-Plesset)
# ----------------------------
mu0 = 0.0
mu0_b = 0.0
mu1 = 0.0
mu1_b = 0.0

# ----------------------------
# Surface tension: Water-air interface
# sigma = 0.0728 N/m at 20 C
# Reference: Popinet (2009) JCP
# "An accurate adaptive solver for surface-tension-driven interfacial flows"
# ----------------------------
sigma = 0.0728
pref = 101325.0

### BOUNDARY CONDITIONS ###
# Neumann (zero gradient) on all boundaries
# Allows bubble to oscillate freely without wall effects

density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

### REFINEMENT CRITERIA ###
# Refine near interface and high vorticity regions
eta_refinement_criterion = 100
omega_refinement_criterion = 100.0
p_refinement_criterion = 1e4
rho_refinement_criterion = 100.0
gradu_refinement_criterion = 10.0
cutoff = 1e-16

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value = 0.0 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 1
apply_buoyancy = 0
apply_weight = 0
Spec_Vol = 1
grav = 0.0

### DEBUGGING ###
Riemann_Solver.type = hllc
kappa_method = 1

# ==============================================================================
# VALIDATION NOTES:
# ==============================================================================
# This test case simulates a spherical bubble oscillating under surface tension
# in an incompressible liquid (water). The analytical solution is given by the
# Rayleigh-Plesset equation for small amplitude oscillations:
#
# Natural frequency: omega_0 = sqrt(3*gamma*P0/(rho_liquid*R0^2))
#                              = sqrt(3*1.4*101325/(1000*1e-6))
#                              = 20,500 rad/s
#
# Period: T = 2*pi/omega_0 = 3.07e-4 s
#
# Expected behavior:
# - Bubble should oscillate radially with period ~0.3 ms
# - Amplitude should decay due to numerical dissipation (no physical viscosity)
# - Interface should remain smooth (no spurious currents if surface tension correct)
#
# Key references:
# 1. Popinet & Zaleski (1999) IJMF - Surface tension validation
# 2. Colagrossi & Landrini (2003) JCP - Stiffened gas EOS for water
# 3. Saurel & Abgrall (1999) JCP - Multiphase Godunov method
# 4. Brennen (1995) "Cavitation and Bubble Dynamics" - Rayleigh-Plesset theory
# 5. Popinet (2009) JCP - Adaptive surface tension solver validation
# ==============================================================================
