# ==============================================================================
# UNIT TEST 1: GAS PRESSURE (ADIABATIC COMPRESSION)
# ==============================================================================
# Purpose: Test if gas pressure follows adiabatic law p_B = p_B0 * (R0/R)^(2*gamma)
# Method: Prescribe small oscillation and verify pressure response
# Expected: p_B should increase when R decreases following adiabatic relation
# ==============================================================================

#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/RayleighPlesset/TEST1_GasPressure
amr.plot_dt = 2e-4

### MESHING ###
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.regrid_int = 50
amr.grid_eff = 0.8
amr.max_level = 4
amr.n_cell = 64 64

### TIME STEPPING ###
timestep = 1e-6
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 1e-0
dynamictimestep.min = 1e-12
cfl = 0.5

### DIMENSIONS ###
geometry.prob_lo = -0.50 -0.50 0.0
geometry.prob_hi =  0.50  0.50 0.0
geometry.is_periodic = 0 0 0
stop_time = 10e-3

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.0002
eta.ic.expression.constant.R0 = 0.02
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt((x)**2 + (y)**2) - R0)/(epsilon)))"
epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###
# Ideal Gas EOS
gamma_eta1 = 1.4
gamma_eta0 = 1.4

# Density ratio 1:10
density_eta1.ic.type = expression
density_eta1.ic.expression.region0 = "10.0"
density_eta0.ic.type = expression
density_eta0.ic.expression.region0 = "1.0"

# Initial velocities (rest)
velocity_eta1.ic.type = expression
velocity_eta1.ic.expression.region0 = "0.0"
velocity_eta1.ic.expression.region1 = "0.0"
velocity_eta0.ic.type = expression
velocity_eta0.ic.expression.region0 = "0.0"
velocity_eta0.ic.expression.region1 = "0.0"

# SMALL PRESSURE DIFFERENCE for gentle oscillation
pressure_eta1.ic.type = expression
pressure_eta1.ic.expression.region0 = "500.0"
pressure_eta0.ic.type = expression
pressure_eta0.ic.expression.region0 = "550.0"  # Small overpressure

# Specific Heats
cp_eta1 = "1000.0"
cp_eta0 = "1000.0"
cv_eta1 = "1000.0/1.4"
cv_eta0 = "1000.0/1.4"

# Stiffened pressure
p0_0 = 0.0
p0_1 = 0.0

# ZERO VISCOSITY - isolate pressure effects
mu_eta1 = 0.0
mu_eta1_b = 0.0
mu_eta0 = 0.0
mu_eta0_b = 0.0

# ZERO SURFACE TENSION - isolate pressure effects
sigma = 0.0
pref = 0.0

### BOUNDARY CONDITIONS ###
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

### REFINEMENT CRITERIA ###
eta_refinement_criterion = 1e-4
omega_refinement_criterion = 10.55
p_refinement_criterion = 1e+2
rho_refinement_criterion = 1e+10
gradu_refinement_criterion = 1e+1
cutoff = 1e-16

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value = 0.0 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 0  # OFF
apply_buoyancy = 0
apply_weight = 0
Spec_Vol = 1
grav = 0.0

### DEBUGGING ###
Riemann_Solver.type = hllc
kappa_method = 1

