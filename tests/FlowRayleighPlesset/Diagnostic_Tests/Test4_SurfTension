# ==============================================================================
# UNIT TEST 4: SURFACE TENSION TERM
# ==============================================================================
# Purpose: Test if surface tension term (-sigma/R) is properly implemented
# Method: Zero viscosity, surface tension active - capillary oscillation
# Expected: Damped oscillation driven by surface tension restoring force
# ==============================================================================

#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/RayleighPlesset/TEST4_SurfaceTension
amr.plot_dt = 5e-4

### MESHING ###
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.regrid_int = 50
amr.grid_eff = 0.8
amr.max_level = 3
amr.n_cell = 32 32

### TIME STEPPING ###
timestep = 1e-6
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 1e-0
dynamictimestep.min = 1e-12
cfl = 0.5

### DIMENSIONS ###
geometry.prob_lo = -0.10 -0.10 0.0
geometry.prob_hi =  0.10  0.10 0.0
geometry.is_periodic = 0 0 0
stop_time = 50e-3

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.0005
eta.ic.expression.constant.R0 = 0.02
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt((x)**2 + (y)**2) - R0)/(epsilon)))"
epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###
# Ideal Gas EOS
gamma0 = 1.4
gamma1 = 1.4

# Density ratio 1:10
density0.ic.type = expression
density0.ic.expression.region0 = "10.0"
density1.ic.type = expression
density1.ic.expression.region0 = "1.0"

# Initial velocities (rest)
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

# NO PRESSURE DIFFERENCE - surface tension only
pressure0.ic.type = expression
pressure0.ic.expression.region0 = "500.0"
pressure1.ic.type = expression
pressure1.ic.expression.region0 = "500.0"  # Equal pressure

# Specific Heats
cp0 = "1000.0"
cp1 = "1000.0"
cv0 = "1000.0/1.4"
cv1 = "1000.0/1.4"

# Stiffened pressure
p0_0 = 0.0
p0_1 = 0.0

# SMALL VISCOSITY - minimal damping to see oscillations
mu0 = 0.01  # Small but non-zero to provide slight damping
mu0_b = 0.0
mu1 = 0.0
mu1_b = 0.0

# SURFACE TENSION ACTIVE - this is what we're testing
sigma = 7.28
pref = 0.0

### BOUNDARY CONDITIONS ###
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

### REFINEMENT CRITERIA ###
eta_refinement_criterion = 1e-4
omega_refinement_criterion = 10.55
p_refinement_criterion = 1e+2
rho_refinement_criterion = 1e+10
gradu_refinement_criterion = 1e+1
cutoff = 1e-16

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value = 0.0 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 1  # ON - this is what we're testing
apply_buoyancy = 0
apply_weight = 0
grav = 0.0

### DEBUGGING ###
Riemann_Solver.type = hllc
kappa_method = 1

# ==============================================================================
# DIAGNOSTIC INSTRUCTIONS:
# 1. Run simulation for full 50 ms
# 2. Extract R(t), R_dot(t), R_ddot(t) from eta field
# 3. Extract curvature kappa from simulation
# 4. Compute surface tension term: -sigma/(rho_L*R)
# 5. Compare to analytical surface tension force
# 6. Check if oscillation frequency matches capillary frequency
# 7. Verify surface tension provides restoring force
#
# EXPECTED BEHAVIOR:
# - Bubble should oscillate around equilibrium radius
# - Oscillation frequency: omega ~ sqrt(sigma/(rho_L*R0^3))
# - Surface tension term should be proportional to 1/R
# - Curvature kappa should equal 1/R for circular bubble
# - Slight damping due to small viscosity
#
# FAILURE MODES:
# - No oscillation: surface tension not being applied
# - Wrong frequency: surface tension magnitude incorrect
# - Surface tension term zero: not coupled to momentum equation
# - Curvature wrong: interface geometry not computed correctly
# - Monotonic collapse: surface tension not providing restoring force
#
# VALIDATION:
# - Compare numerical surface tension term to analytical: -sigma/(rho*R)
# - Verify curvature: kappa = 1/R for 2D circle
# - Check oscillation frequency against: omega = sqrt(2*sigma/(rho*R0^3))
# - Verify Fsvx field magnitude and distribution
# - Confirm surface tension force acts normal to interface
#
# CAPILLARY OSCILLATION THEORY (2D):
# - Natural frequency: omega_0 = sqrt(2*sigma/(rho_L*R0^3))
# - For R0=0.02m, sigma=7.28 N/m, rho=10 kg/m^3:
#   omega_0 ~ 6.77 rad/s
#   Period T ~ 0.93 ms
# - Should see multiple oscillation cycles in 50 ms
# ==============================================================================
