#@ [rpe_02_rayleigh_collapse]
#@ exe=hydro2
#@ dim=2

# =============================================================================
# RPE Benchmark 02 - Driven Bubble Collapse (Rayleigh-Plesset classical)
# =============================================================================
# Air bubble in water at atmospheric pressure, surrounded by elevated-pressure
# water (10x atm). Drives collapse. Surface tension included with real
# water-air value.
#
#   liquid: rho_l = 1000 kg/m^3, p_inf = 1.0e6 Pa  (driven, ~10 atm)
#           Tammann gamma = 7.15, p_inf_Tammann = 3.0e8 Pa
#   gas:    rho_g = 1.2 kg/m^3,  p_g0  = 1.01325e5 Pa  (1 atm)
#           ideal gas, gamma = 1.4
#   bubble: R0 = 1.0e-3 m
#   surface tension: sigma = 0.0728 N/m (real water)
#   pressure ratio: p_inf / p_g0 ~ 9.87
#
# Reference timescale: Rayleigh collapse time
#   tau_R = 0.91468 R0 sqrt(rho_l / (p_inf - p_g0))
#         ~= 0.91468 * 1e-3 * sqrt(1000 / 9e5) ~= 30.5 us
#
# Reference: Rayleigh-Plesset ODE with adiabatic gas + surface tension
# Compare R(t), collapse time, peak pressure, rebound radius.
# Citation: Khoo, Lim & Yeo (2020) Sec. 5.2-5.4 driven-collapse benchmark.
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowRayleighPlesset/OtherTests/output_RPE_02_RayleighCollapse

### MESHING ###
amr.plot_dt        = 1.0e-6        # 150 frames over 150 us
amr.max_grid_size  = 500000
amr.blocking_factor = 2
amr.regrid_int     = 10
amr.grid_eff       = 0.8
amr.max_level      = 0
amr.n_cell         = 256 256

nghost = 4

### TIME STEPPING ###
timestep                = 5.0e-10
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 5.0e-8
dynamictimestep.min     = 1.0e-13
cfl                     = 0.2

### DIMENSIONS ###
geometry.prob_lo     = -5.0e-3 -5.0e-3 0.0
geometry.prob_hi     =  5.0e-3  5.0e-3 0.0
geometry.is_periodic = 0 0 0
stop_time            = 1.5e-4                  # 150 us captures Chen 2D collapse + rebound

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 7.8e-5
eta.ic.expression.constant.R0      = 1.0e-3
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EQUATION OF STATE ###
# Liquid (Tammann water)
eos0.gamma = 7.15
eos0.p0    = 3.0e8
eos0.cv    = 4186.0
eos0.cp    = 4186.0

# Gas (ideal air)
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cv    = 718.0
eos1.cp    = 1005.0

### HYDRO INITIAL CONDITIONS ###
density0.ic.type = expression
density0.ic.expression.region0 = "1000.0"

density1.ic.type = expression
density1.ic.expression.region0 = "1.2"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

pressure0.ic.type = expression
pressure0.ic.expression.region0 = "1.0e6"       # driven liquid (10 atm)

pressure1.ic.type = expression
pressure1.ic.expression.region0 = "1.01325e5"   # gas at 1 atm

### VISCOSITY (off, inviscid RP reference) ###
mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### SURFACE TENSION (real water) ###
sigma = 0.0728
pref  = 0.0

### BOUNDARY CONDITIONS - NSCBC4 outflow ###
density.bc.type.xhi  = nscbc_outflow
density.bc.type.xlo  = nscbc_outflow
density.bc.type.ylo  = nscbc_outflow
density.bc.type.yhi  = nscbc_outflow
energy.bc.type.xhi   = nscbc_outflow
energy.bc.type.xlo   = nscbc_outflow
energy.bc.type.ylo   = nscbc_outflow
energy.bc.type.yhi   = nscbc_outflow
momentum.bc.type.xhi = nscbc_outflow nscbc_outflow
momentum.bc.type.xlo = nscbc_outflow nscbc_outflow
momentum.bc.type.ylo = nscbc_outflow nscbc_outflow
momentum.bc.type.yhi = nscbc_outflow nscbc_outflow

nscbc.xlo.type = outflow
nscbc.xlo.target_p = 1.0e6
nscbc.xlo.sigma = 0.15
nscbc.xlo.beta  = 0.5
nscbc.xlo.L_ref = 1.0e-2
nscbc.xlo.target_u = 0.0
nscbc.xlo.target_v = 0.0

nscbc.xhi.type = outflow
nscbc.xhi.target_p = 1.0e6
nscbc.xhi.sigma = 0.15
nscbc.xhi.beta  = 0.5
nscbc.xhi.L_ref = 1.0e-2
nscbc.xhi.target_u = 0.0
nscbc.xhi.target_v = 0.0

nscbc.ylo.type = outflow
nscbc.ylo.target_p = 1.0e6
nscbc.ylo.sigma = 0.15
nscbc.ylo.beta  = 0.5
nscbc.ylo.L_ref = 1.0e-2
nscbc.ylo.target_u = 0.0
nscbc.ylo.target_v = 0.0

nscbc.yhi.type = outflow
nscbc.yhi.target_p = 1.0e6
nscbc.yhi.sigma = 0.15
nscbc.yhi.beta  = 0.5
nscbc.yhi.L_ref = 1.0e-2
nscbc.yhi.target_u = 0.0
nscbc.yhi.target_v = 0.0

nscbc.small = 1.0e-10

### REFINEMENT (single level) ###
eta_refinement_criterion   = 1.0e+10
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

### PHYSICS FLAGS ###
apply_surface_tension = 1
apply_buoyancy        = 0
apply_weight          = 0
Spec_Vol              = 1
grav                  = 0.0

Riemann_Solver.type = hllc
kappa_method        = 1

apply_sharpening     = 0
sharpening_frequency = 50
reinit_max_iter      = 100
reinit_tolerance     = 1e-6
omega_relax          = 0.5
