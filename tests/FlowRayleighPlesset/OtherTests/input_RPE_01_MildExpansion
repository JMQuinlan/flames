#@ [rpe_01_mild_expansion]
#@ exe=hydro2
#@ dim=2

# =============================================================================
# RPE Benchmark 01 - Mild Bubble Expansion (2D cylindrical, scaled units)
# =============================================================================
# Scaled-units 2D analog of Tiwari/Coralic mild over-pressured air-water
# bubble. Setup identical to your working Bubble_UNIT_TEST2_Expand_NSCBC
# except sigma=0 (no surface tension) so this test isolates compressible
# RP dynamics from capillary effects.
#
# Why scaled units? Real water (Tammann pi = 3e8 Pa) gives sound speed
# ~1465 m/s and acoustic impedance ~1.5e6, putting ~57 acoustic round trips
# per oscillation. That stresses the BC reflection budget too hard for the
# current NSCBC4 to handle cleanly. The scaled setup below has the SAME
# dimensionless physics (p_g0/p_inf, R0/r_inf, etc.) but ~16 round trips
# per simulation. Run real-water values when the solver matures.
#
#   liquid (water analog, fluid 0): rho_l = 10, p_inf = 500
#                                    Tammann gamma=7.15, pi_Tammann=5000
#   gas    (air   analog, fluid 1): rho_g = 1,  p_g0 = 750  (~1.5x p_inf)
#                                    ideal gas, gamma=1.4
#   bubble: R0 = 0.02 m
#   sigma = 0 (off for this test)
#   mu_l  = 0 (off for this test - inviscid Chen 2D reference)
#
# Reference: Chen 2D cylindrical RPE
# Predicted Chen 2D R_max ~= 24.5 mm at t ~= 94 ms; period ~= 200 ms (slow,
# logarithmic factor inflates 2D inertia).
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowRayleighPlesset/OtherTests/output_RPE_01_MildExpansion

### MESHING ###
amr.plot_dt        = 1.0e-3        # 100 frames over 100 ms
amr.max_grid_size  = 500000
amr.blocking_factor = 2
amr.regrid_int     = 10
amr.grid_eff       = 0.8
amr.max_level      = 0
amr.n_cell         = 128 128

nghost = 4

### TIME STEPPING ###
timestep                = 1.0e-6
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 1.0e-4
dynamictimestep.min     = 1.0e-12
cfl                     = 0.2

### DIMENSIONS ###
geometry.prob_lo     = -0.10 -0.10 0.0
geometry.prob_hi     =  0.10  0.10 0.0
geometry.is_periodic = 0 0 0
stop_time            = 1.0e-1                   # 100 ms = 0.5 oscillation period

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.002
eta.ic.expression.constant.R0      = 0.02
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EQUATION OF STATE (matches working Bubble_UNIT_TEST2_Expand_NSCBC) ###
eos0.gamma = 7.15
eos0.p0    = 5000.0
eos0.cv    = 714.286
eos0.cp    = 1000.0

eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cv    = 714.286
eos1.cp    = 1000.0

### HYDRO INITIAL CONDITIONS ###
density0.ic.type = expression
density0.ic.expression.region0 = "10.0"

density1.ic.type = expression
density1.ic.expression.region0 = "1.0"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

pressure0.ic.type = expression
pressure0.ic.expression.region0 = "500.0"      # liquid far-field (p_inf)

pressure1.ic.type = expression
pressure1.ic.expression.region0 = "750.0"      # gas at R0 (p_g0 = 1.5 p_inf)

### VISCOSITY (off for inviscid Chen 2D match) ###
mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### SURFACE TENSION (OFF for this test) ###
sigma = 0.0
pref  = 0.0

### BOUNDARY CONDITIONS - NSCBC4 outflow on all 4 walls ###
density.bc.type.xhi  = nscbc_outflow
density.bc.type.xlo  = nscbc_outflow
density.bc.type.ylo  = nscbc_outflow
density.bc.type.yhi  = nscbc_outflow
energy.bc.type.xhi   = nscbc_outflow
energy.bc.type.xlo   = nscbc_outflow
energy.bc.type.ylo   = nscbc_outflow
energy.bc.type.yhi   = nscbc_outflow
momentum.bc.type.xhi = nscbc_outflow nscbc_outflow
momentum.bc.type.xlo = nscbc_outflow nscbc_outflow
momentum.bc.type.ylo = nscbc_outflow nscbc_outflow
momentum.bc.type.yhi = nscbc_outflow nscbc_outflow

nscbc.xlo.type = outflow
nscbc.xlo.target_p = 500.0
nscbc.xlo.sigma = 0.15
nscbc.xlo.beta  = 0.5
nscbc.xlo.L_ref = 0.20
nscbc.xlo.target_u = 0.0
nscbc.xlo.target_v = 0.0

nscbc.xhi.type = outflow
nscbc.xhi.target_p = 500.0
nscbc.xhi.sigma = 0.15
nscbc.xhi.beta  = 0.5
nscbc.xhi.L_ref = 0.20
nscbc.xhi.target_u = 0.0
nscbc.xhi.target_v = 0.0

nscbc.ylo.type = outflow
nscbc.ylo.target_p = 500.0
nscbc.ylo.sigma = 0.15
nscbc.ylo.beta  = 0.5
nscbc.ylo.L_ref = 0.20
nscbc.ylo.target_u = 0.0
nscbc.ylo.target_v = 0.0

nscbc.yhi.type = outflow
nscbc.yhi.target_p = 500.0
nscbc.yhi.sigma = 0.15
nscbc.yhi.beta  = 0.5
nscbc.yhi.L_ref = 0.20
nscbc.yhi.target_u = 0.0
nscbc.yhi.target_v = 0.0

nscbc.small = 1.0e-10

### REFINEMENT (single level) ###
eta_refinement_criterion   = 1.0e+10
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

### PHYSICS FLAGS ###
apply_surface_tension = 0
apply_buoyancy        = 0
apply_weight          = 0
Spec_Vol              = 1
grav                  = 0.0

Riemann_Solver.type = hllc
kappa_method        = 1

apply_sharpening     = 0
sharpening_frequency = 50
reinit_max_iter      = 100
reinit_tolerance     = 1e-6
omega_relax          = 0.5
