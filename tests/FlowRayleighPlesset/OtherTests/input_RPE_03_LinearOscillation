#@ [rpe_03_linear_oscillation]
#@ exe=hydro2
#@ dim=2

# =============================================================================
# RPE Benchmark 03 - Small-Amplitude Bubble Oscillation (2D cylindrical)
# =============================================================================
# 2D-cylindrical Chen-RPE linearized form. Bubble starts near 2D-Laplace
# equilibrium with a 5% initial radius perturbation; oscillates at the
# linearized natural frequency:
#
#   omega_0^2 = (2 gamma p_g_eq - sigma / R_eq) / (rho_l R_eq^2 ln(r_inf/R_eq))
#
# For R_eq=0.95mm, r_inf=5mm, p_inf=1atm, sigma=0.0728:
#   p_g_eq(R_eq) = p_inf + sigma/R_eq = 1.0140e5 Pa  (2D Laplace balance)
#   omega_0 ~= 14790 rad/s     ->     T ~= 425 us
#
# Polytropic relation maps p_g back to R0:
#   p_g0 = p_g(R_eq) * (R_eq/R0)^(2 gamma) ~= 87612 Pa
#
#   liquid: rho_l = 1000, p_inf = 1.01325e5 Pa
#   gas:    rho_g = 1.2,  p_g0 = 87612 Pa (under-pressured at R0=1mm)
#   bubble: R0 = 1.0e-3 m   (5% over-expanded relative to R_eq=0.95mm)
#   sigma = 0.0728 N/m
#
# Bubble collapses toward R_eq, overshoots, and oscillates with period ~470 us.
# Reference: Chen 2D RPE ODE + linearized cosine solution.
# stop_time = 1.5 ms covers ~3 periods.
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowRayleighPlesset/OtherTests/output_RPE_03_LinearOscillation

### MESHING ###
amr.plot_dt        = 5.0e-6        # 120 frames over 600 us (~2 periods)
amr.max_grid_size  = 500000
amr.blocking_factor = 2
amr.regrid_int     = 10
amr.grid_eff       = 0.8
amr.max_level      = 0
amr.n_cell         = 256 256

nghost = 4

### TIME STEPPING ###
timestep                = 1.0e-9
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 5.0e-7
dynamictimestep.min     = 1.0e-13
cfl                     = 0.2

### DIMENSIONS ###
geometry.prob_lo     = -5.0e-3 -5.0e-3 0.0
geometry.prob_hi     =  5.0e-3  5.0e-3 0.0
geometry.is_periodic = 0 0 0
stop_time            = 1.5e-3                  # 1.5 ms - 2D oscillation slower than 3D

### ETA INITIAL CONDITIONS ###
# Note: R0=1mm is the *initial* (perturbed) radius.
# Equilibrium R_eq is approximately 0.95e-3 (back-solved so that p_g0 satisfies
# Laplace at R_eq). This 5% perturbation is enough to see oscillation but
# small enough that linearized theory holds.
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 7.8e-5
eta.ic.expression.constant.R0      = 1.0e-3
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EQUATION OF STATE ###
eos0.gamma = 7.15
eos0.p0    = 3.0e8
eos0.cv    = 4186.0
eos0.cp    = 4186.0

eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cv    = 718.0
eos1.cp    = 1005.0

### HYDRO INITIAL CONDITIONS ###
density0.ic.type = expression
density0.ic.expression.region0 = "1000.0"

density1.ic.type = expression
density1.ic.expression.region0 = "1.2"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

pressure0.ic.type = expression
pressure0.ic.expression.region0 = "1.01325e5"

# Gas pressure such that Chen 2D polytropic relation
#   p_g(R) = p_g0 * (R0/R)^(2 gamma)
# yields Laplace balance p_g(R_eq) = p_inf + sigma/R_eq at R_eq = 0.95 mm.
# Solving:  p_g0 = (p_inf + sigma/R_eq) * (R_eq/R0)^(2 gamma)
#                = (101325 + 0.0728/0.95e-3) * (0.95/1.0)^(2*1.4)
#                ~= 87612 Pa
# So the initial bubble at R0 = 1 mm is *over-expanded*; it collapses toward
# R_eq, overshoots, and oscillates with period ~ 468 us.
pressure1.ic.type = expression
pressure1.ic.expression.region0 = "87612.0"

### VISCOSITY ###
mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### SURFACE TENSION (real water) ###
sigma = 0.0728
pref  = 0.0

### BOUNDARY CONDITIONS - NSCBC4 outflow at p_inf ###
density.bc.type.xhi  = nscbc_outflow
density.bc.type.xlo  = nscbc_outflow
density.bc.type.ylo  = nscbc_outflow
density.bc.type.yhi  = nscbc_outflow
energy.bc.type.xhi   = nscbc_outflow
energy.bc.type.xlo   = nscbc_outflow
energy.bc.type.ylo   = nscbc_outflow
energy.bc.type.yhi   = nscbc_outflow
momentum.bc.type.xhi = nscbc_outflow nscbc_outflow
momentum.bc.type.xlo = nscbc_outflow nscbc_outflow
momentum.bc.type.ylo = nscbc_outflow nscbc_outflow
momentum.bc.type.yhi = nscbc_outflow nscbc_outflow

nscbc.xlo.type = outflow
nscbc.xlo.target_p = 1.01325e5
nscbc.xlo.sigma = 0.15
nscbc.xlo.beta  = 0.5
nscbc.xlo.L_ref = 1.0e-2
nscbc.xlo.target_u = 0.0
nscbc.xlo.target_v = 0.0

nscbc.xhi.type = outflow
nscbc.xhi.target_p = 1.01325e5
nscbc.xhi.sigma = 0.15
nscbc.xhi.beta  = 0.5
nscbc.xhi.L_ref = 1.0e-2
nscbc.xhi.target_u = 0.0
nscbc.xhi.target_v = 0.0

nscbc.ylo.type = outflow
nscbc.ylo.target_p = 1.01325e5
nscbc.ylo.sigma = 0.15
nscbc.ylo.beta  = 0.5
nscbc.ylo.L_ref = 1.0e-2
nscbc.ylo.target_u = 0.0
nscbc.ylo.target_v = 0.0

nscbc.yhi.type = outflow
nscbc.yhi.target_p = 1.01325e5
nscbc.yhi.sigma = 0.15
nscbc.yhi.beta  = 0.5
nscbc.yhi.L_ref = 1.0e-2
nscbc.yhi.target_u = 0.0
nscbc.yhi.target_v = 0.0

nscbc.small = 1.0e-10

### REFINEMENT (single level) ###
eta_refinement_criterion   = 1.0e+10
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

### PHYSICS FLAGS ###
apply_surface_tension = 1
apply_buoyancy        = 0
apply_weight          = 0
Spec_Vol              = 1
grav                  = 0.0

Riemann_Solver.type = hllc
kappa_method        = 1

apply_sharpening     = 0
sharpening_frequency = 50
reinit_max_iter      = 100
reinit_tolerance     = 1e-6
omega_relax          = 0.5
