#@ [sch20_oscillating_nscbc_large]
#@ exe=hydro2
#@ dim=2

# =============================================================================
# Schmidmayer-Bryngelson-Colonius (JCP 402, 2020) -- SPHERICAL BUBBLE
# Case 1: LOW-PRESSURE-RATIO  (p_inf / p_b = 10)  -- "OSCILLATING" bubble
# LARGE-DOMAIN NSCBC VARIANT
# =============================================================================
# Large-domain twin of Sch20_Oscillating_NSCBC: same NSCBC4 non-reflecting
# outflow BCs, but expanded to the +/- 4 m domain + 5-level eta-only AMR of
# Sch20_Oscillating_Neumann_Large.  This is the NSCBC counterpart to the
# Neumann _Large run -- it lets us separate physical acoustic-radiation damping
# from boundary artefacts by comparing two different far-field treatments
# (characteristic NSCBC outflow here vs. plain Neumann walls) on the SAME large
# domain.
#
# Pressure IC is the Sch20_Oscillating_Neumann_Large field (the variant giving
# the closest match to the Chen-2D RPE reference); see that file's header for
# the full derivation.
#
# Domain reasoning (from _Large):
#   c_l = sqrt(gamma_l (p_inf + pi_l)/rho_l) = sqrt(2.35*(1e5+1e9)/1e3) ~ 1533 m/s
#   tau_c = 0.915 R0 sqrt(rho_l / p_inf) ~ 1.83e-3 s
#   L_half = 4 m -> first-collapse wave reaches the boundary at
#       t_arrive ~ tau_c + L_half/c_l ~ 4.43 ms (~0.8 ms past first cycle end);
#   NSCBC outflow then absorbs it rather than reflecting.
#
# AMR resolution (matched to _Large finest dx):
#   base 320x320 over 8 m -> dx_coarse = 0.025 m
#   max_level = 5 (refRatio 2 each) -> dx_finest = 7.8e-4 m
#   R0 / dx_finest = 25.6  -- matches Sch20 nominal NR0.
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
# plot_file = ./tests/FlowRayleighPlesset/output_Sch20_Oscillating
plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowRayleighPlesset/output_Sch20_Oscillating

### MESHING ###
amr.plot_int       = -1
amr.plot_dt        = 1.0e-4         # ~50 frames over 5 ms
amr.max_grid_size  = 500000
amr.blocking_factor = 2
amr.regrid_int     = 10
amr.grid_eff       = 0.8
amr.max_level      = 5
amr.n_cell         = 320 320        # base; effective finest = 10240 x 10240

# n_error_buf keeps the coarse-fine boundary out of the mixed-eta interface band
# (Q-Fix density-partition is exact only at pure-phase c/f boundaries).
# See memory note: feedback_density_partition_breaks_cf_ghosts.md
amr.n_error_buf    = 16

nghost = 4

### TIME STEPPING ###
timestep                = 1.0e-7
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 1.0e-5
dynamictimestep.min     = 1.0e-13
cfl                     = 0.5

### DIMENSIONS ###
geometry.prob_lo     = -4.00 -4.00 0.0
geometry.prob_hi     =  4.00  4.00 0.0
geometry.is_periodic = 0 0 0
stop_time            = 1e-2

### ETA INITIAL CONDITIONS (identical to _Large) ###
# eta = 0 inside bubble (gas, phase 1), eta = 1 outside (liquid, phase 0).
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.0016     # ~ 2 cells across the band at finest
eta.ic.expression.constant.R0      = 0.02
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EQUATION OF STATE -- Sch20 water (Tammann) + air (ideal gas) ###
eos0.gamma = 2.35
eos0.p0    = 1.0e9
eos0.cv    = 1781.0
eos0.cp    = 4186.0

eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cv    = 714.286
eos1.cp    = 1000.0

### HYDRO INITIAL CONDITIONS (identical to _Large) ###
density0.ic.type = expression
density0.ic.expression.region0 = "1000.0"

density1.ic.type = expression
density1.ic.expression.region0 = "1.0"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

# Pressure field IDENTICAL to Sch20_Oscillating_Neumann_Large (closest match to
# the Chen-2D RPE reference).  See the _Large file header for the derivation.
pressure0.ic.type = expression
pressure0.ic.expression.constant.p_inf = 1.0e5
pressure0.ic.expression.constant.p_b   = 1.0e4
pressure0.ic.expression.constant.R0    = 0.02
pressure0.ic.expression.constant.r_inf = 4.00
pressure0.ic.expression.region0 = "p_inf - (p_inf - p_b)*R0/max(sqrt(x*x + y*y), R0)"
#pressure0.ic.expression.region0 = "p_inf - (p_inf - p_b)*log(r_inf/max(sqrt(x*x + y*y), R0))/log(r_inf/R0)"

# Gas interior: uniform bubble pressure p_b.
pressure1.ic.type = expression
pressure1.ic.expression.constant.p_b = 1.0e4
pressure1.ic.expression.region0 = "p_b"

### VISCOSITY (inviscid -- Sch20 nominal) ###
mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### SURFACE TENSION (none in Sch20 nominal collapse cases) ###
sigma = 72.8e-3
pref  = 0.0

### BOUNDARY CONDITIONS - NSCBC4 non-reflecting outflow, target = p_inf ###
density.bc.type.xhi  = nscbc_outflow
density.bc.type.xlo  = nscbc_outflow
density.bc.type.ylo  = nscbc_outflow
density.bc.type.yhi  = nscbc_outflow
energy.bc.type.xhi   = nscbc_outflow
energy.bc.type.xlo   = nscbc_outflow
energy.bc.type.ylo   = nscbc_outflow
energy.bc.type.yhi   = nscbc_outflow
momentum.bc.type.xhi = nscbc_outflow nscbc_outflow
momentum.bc.type.xlo = nscbc_outflow nscbc_outflow
momentum.bc.type.ylo = nscbc_outflow nscbc_outflow
momentum.bc.type.yhi = nscbc_outflow nscbc_outflow

# L_ref scaled to the 8 m domain (was 0.40 for the 0.4 m small-domain NSCBC).
nscbc.xlo.type = outflow
nscbc.xlo.target_p = 1.0e5
nscbc.xlo.sigma = 0.15
nscbc.xlo.beta  = 0.5
nscbc.xlo.L_ref = 8.00
nscbc.xlo.target_u = 0.0
nscbc.xlo.target_v = 0.0

nscbc.xhi.type = outflow
nscbc.xhi.target_p = 1.0e5
nscbc.xhi.sigma = 0.15
nscbc.xhi.beta  = 0.5
nscbc.xhi.L_ref = 8.00
nscbc.xhi.target_u = 0.0
nscbc.xhi.target_v = 0.0

nscbc.ylo.type = outflow
nscbc.ylo.target_p = 1.0e5
nscbc.ylo.sigma = 0.15
nscbc.ylo.beta  = 0.5
nscbc.ylo.L_ref = 8.00
nscbc.ylo.target_u = 0.0
nscbc.ylo.target_v = 0.0

nscbc.yhi.type = outflow
nscbc.yhi.target_p = 1.0e5
nscbc.yhi.sigma = 0.15
nscbc.yhi.beta  = 0.5
nscbc.yhi.L_ref = 8.00
nscbc.yhi.target_u = 0.0
nscbc.yhi.target_v = 0.0

nscbc.small = 1.0e-10

### REFINEMENT -- eta-only, conservative threshold (identical to _Large) ###
eta_refinement_criterion   = 1.0e-1
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

### PHYSICS FLAGS (identical to _Large) ###
apply_surface_tension = 0
apply_buoyancy        = 0
apply_weight          = 0
apply_vaporization    = 0
grav                  = 0.0

### NUMERICS -- WENO3 + SSPRK3 (project-standard for Sch20 tests) ###
Riemann_Solver.type = hllc
Limiter.type        = weno3
integration.type    = RungeKutta
integration.rk.type = 3
kappa_method        = 1

apply_sharpening     = 0
sharpening_frequency = 50
reinit_max_iter      = 100
reinit_tolerance     = 1e-6
omega_relax          = 0.5
relax_diag           = 1

# IC pressure equalization (see _Large header): gamma-weighted Mix() kills the
# step-1 pressure kick at the interface.
equalize_ic_pressure = 1
