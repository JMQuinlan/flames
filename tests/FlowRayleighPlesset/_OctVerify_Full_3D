#@ [octverify_full]
#@ exe=hydro2
#@ dim=3
# =============================================================================
# OCTANT-SYMMETRY VERIFICATION -- FULL-DOMAIN REFERENCE
# =============================================================================
# Bubble at the ORIGIN, full +/-0.1 m domain, 32^3 UNIFORM (no AMR), neumann on
# all 6 faces.  Paired with _OctVerify_Oct_3D, which computes only the +x+y+z
# octant [0,0.1]^3 at 16^3 with SYMMETRY (reflect) BCs on the inner faces.
# Both have dx = 0.2/32 = 0.1/16 = 6.25e-3, so the octant run MUST reproduce
# this run's +x+y+z corner if the reflect_even/reflect_odd path is correct.
# Sch20 Case-1 physics, deliberately under-resolved + short -- this is a BC
# correctness check, not a physics-accuracy run.
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowRayleighPlesset/output_OctVerify_Full

### MESHING (uniform, no AMR) ###
amr.plot_int        = -1
amr.plot_dt         = 1.0e-4
amr.max_grid_size   = 8
amr.blocking_factor = 2
amr.max_level       = 0
amr.n_cell          = 32 32 32
nghost = 4

### TIME STEPPING ###
timestep                = 1.0e-7
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 1.0e-5
dynamictimestep.min     = 1.0e-13
cfl                     = 0.5

### DIMENSIONS ###
geometry.prob_lo     = -0.10 -0.10 -0.10
geometry.prob_hi     =  0.10  0.10  0.10
geometry.is_periodic = 0 0 0
stop_time            = 2.0e-4

### ETA IC -- bubble centered at origin ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.0125
eta.ic.expression.constant.R0      = 0.02
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y + z*z) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EOS -- Sch20 water (Tammann) + air (ideal) ###
eos0.gamma = 2.35
eos0.p0    = 1.0e9
eos0.cv    = 1781.0
eos0.cp    = 4186.0
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cv    = 714.286
eos1.cp    = 1000.0

### HYDRO IC ###
density0.ic.type = expression
density0.ic.expression.region0 = "1000.0"
density1.ic.type = expression
density1.ic.expression.region0 = "1.0"
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
velocity0.ic.expression.region2 = "0.0"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"
velocity1.ic.expression.region2 = "0.0"
pressure0.ic.type = expression
pressure0.ic.expression.constant.p_inf = 1.0e5
pressure0.ic.expression.constant.p_b   = 1.0e4
pressure0.ic.expression.constant.R0    = 0.02
pressure0.ic.expression.region0 = "p_inf - (p_inf - p_b)*R0/max(sqrt(x*x + y*y + z*z), R0)"
pressure1.ic.type = expression
pressure1.ic.expression.constant.p_b = 1.0e4
pressure1.ic.expression.region0 = "p_b"

### VISCOSITY (inviscid) ###
mu0 = 0.0
mu0_b = 0.0
mu1 = 0.0
mu1_b = 0.0

### SURFACE TENSION (off) ###
sigma = 72.8e-3
pref  = 0.0

### BOUNDARY CONDITIONS -- neumann on all 6 faces ###
eta.bc.type.xlo = neumann
eta.bc.type.xhi = neumann
eta.bc.type.ylo = neumann
eta.bc.type.yhi = neumann
eta.bc.type.zlo = neumann
eta.bc.type.zhi = neumann
density.bc.type.xlo = neumann
density.bc.type.xhi = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann
density.bc.type.zlo = neumann
density.bc.type.zhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.xhi = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann
energy.bc.type.zlo = neumann
energy.bc.type.zhi = neumann
momentum.bc.type.xlo = neumann neumann neumann
momentum.bc.type.xhi = neumann neumann neumann
momentum.bc.type.ylo = neumann neumann neumann
momentum.bc.type.yhi = neumann neumann neumann
momentum.bc.type.zlo = neumann neumann neumann
momentum.bc.type.zhi = neumann neumann neumann

### REFINEMENT (off) ###
eta_refinement_criterion   = 1.0e+10
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

### PHYSICS FLAGS ###
apply_surface_tension = 0
apply_buoyancy        = 0
apply_weight          = 0
apply_vaporization    = 0
grav                  = 0.0

### NUMERICS ###
Riemann_Solver.type = hllc
Limiter.type        = weno3
integration.type    = RungeKutta
integration.rk.type = 3
kappa_method        = 1
apply_sharpening     = 0
sharpening_frequency = 50
reinit_max_iter      = 100
reinit_tolerance     = 1e-6
omega_relax          = 0.5
relax_diag           = 0

equalize_ic_pressure = 1
