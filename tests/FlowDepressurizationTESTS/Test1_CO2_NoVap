#@ exe=hydro2
#@ dim=2

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowDepressurization/Test1_CO2_NoVap

### MESHING ###
amr.plot_dt = 5e-3
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.regrid_int = 50
amr.grid_eff = 0.8
amr.max_level = 0
amr.n_cell = 5000 2           # 5000 cells in x-direction to match paper

### TIME STEPPING ###
timestep = 1e-8

## Adaptive
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 1e-0
dynamictimestep.min = 1e-12
cfl = 0.8

### DIMENSIONS ###
geometry.prob_lo = 0.0 -0.5 0.0
geometry.prob_hi = 80.0  0.5 0.0
geometry.is_periodic = 0 1 0

### TIME STEP ###
stop_time = 0.08                # Match paper: t = 0.08 s

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.04
eta.ic.expression.constant.x_interface = 50.0
eta.ic.expression.region0 = "1.0 - 0.5*(1 + tanh((x - x_interface)/(2*sqrt(2)*epsilon)))"
epsilon = eta.ic.expression.constant.epsilon

### STIFFENED GAS EOS PARAMETERS ###
# Phase 0 = Liquid CO2
gamma_eta1 = 1.23
p0_0 = 1.32e8                   # P_inf for liquid (Pa)
mu_eta1 = 1.0e-4
mu_eta1_b = 0.0

# Phase 1 = Vapor CO2
gamma_eta0 = 1.06
p0_1 = 8.86e5                   # P_inf for vapor (Pa)
mu_eta0 = 1.0e-5
mu_eta0_b = 0.0

### INITIAL CONDITIONS ###
# Left side: P_L = 60 bar, T_L = 273 K, alpha_L = 1e-5 (mostly liquid)
# Right side: P_R = 10 bar, T_R = 273 K, alpha_R = 1 - 1e-5 (mostly vapor)

# Densities (calculated from stiffened gas EOS)
# Using step function: value_left + (value_right - value_left) * 0.5 * (1 + tanh((x - x_interface)/width))

# Left side (liquid): rho_L = 902 kg/m^3, Right side: rho_R = 1.0 kg/m^3
density_eta1.ic.type = expression
density_eta1.ic.expression.constant.rho_left = 902.0
density_eta1.ic.expression.constant.rho_right = 1.0
density_eta1.ic.expression.constant.x_step = 50.0
density_eta1.ic.expression.constant.width = 0.1
#density_eta1.ic.expression.region0 = "rho_left + (rho_right - rho_left) * 0.5 * (1 + tanh((x - x_step)/width))"
density_eta1.ic.expression.region0 = "rho_left"

# Right side (vapor): rho_L = 1.0 kg/m^3, rho_R = 47.8 kg/m^3
density_eta0.ic.type = expression
density_eta0.ic.expression.constant.rho_left = 1.0
density_eta0.ic.expression.constant.rho_right = 47.8
density_eta0.ic.expression.constant.x_step = 50.0
density_eta0.ic.expression.constant.width = 0.1
#density_eta0.ic.expression.region0 = "rho_left + (rho_right - rho_left) * 0.5 * (1 + tanh((x - x_step)/width))"
density_eta0.ic.expression.region0 = "rho_right"

# Velocities (initially zero)
velocity_eta1.ic.type = expression
velocity_eta1.ic.expression.region0 = "0.0"
velocity_eta1.ic.expression.region1 = "0.0"

velocity_eta0.ic.type = expression
velocity_eta0.ic.expression.region0 = "0.0"
velocity_eta0.ic.expression.region1 = "0.0"

# Pressures (using step function)
# Left: 60 bar = 6.0e6 Pa, Right: 10 bar = 1.0e6 Pa
pressure_eta1.ic.type = expression
pressure_eta1.ic.expression.constant.p_left = 6.0e6
pressure_eta1.ic.expression.constant.p_right = 1.0e6
pressure_eta1.ic.expression.constant.x_step = 50.0
pressure_eta1.ic.expression.constant.width = 0.1
#pressure_eta1.ic.expression.region0 = "p_left + (p_right - p_left) * 0.5 * (1 + tanh((x - x_step)/width))"
pressure_eta1.ic.expression.region0 = "p_left"

pressure_eta0.ic.type = expression
pressure_eta0.ic.expression.constant.p_left = 6.0e6
pressure_eta0.ic.expression.constant.p_right = 1.0e6
pressure_eta0.ic.expression.constant.x_step = 50.0
pressure_eta0.ic.expression.constant.width = 0.1
#pressure_eta0.ic.expression.region0 = "p_left + (p_right - p_left) * 0.5 * (1 + tanh((x - x_step)/width))"
pressure_eta0.ic.expression.region0 = "p_right"

# Temperatures (not directly used, but for reference)
temperature0.ic.type = expression
temperature0.ic.expression.region0 = "273.0"

temperature1.ic.type = expression
temperature1.ic.expression.region0 = "273.0"

# Thermodynamic properties (from Table 1)
# Cv values
cv_eta1 = 2440.0                    # Liquid Cv (J/kg/K)
cv_eta0 = 2410.0                    # Vapor Cv (J/kg/K)

# Cp = gamma * Cv
cp_eta1 = 3001.2                    # gamma_eta1 * cv_eta1 = 1.23 * 2440
cp_eta0 = 2554.6                    # gamma_eta0 * cv_eta0 = 1.06 * 2410

# Surface tension (minimal for this test)
sigma = 0.001

# Vapor Diffusivity
Dv = "1.0e-5"

# Reference pressure
pref = 0.0

### BOUNDARY CONDITIONS ###
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.yhi = periodic
density.bc.type.ylo = periodic

momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.yhi = periodic periodic
momentum.bc.type.ylo = periodic periodic

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.yhi = periodic
energy.bc.type.ylo = periodic

### REFINEMENT CRITERIA ###
eta_refinement_criterion = 0.01
omega_refinement_criterion = 100.0
p_refinement_criterion = 1e+5
rho_refinement_criterion = 1e+2
gradu_refinement_criterion = 1e+3
cutoff = 1e-16

### SOURCE TERMS ###
m0.ic.type = constant
m0.ic.constant.value = 0.0

u0.ic.type = constant
u0.ic.constant.value = 0.0 0.0

q.ic.type = constant
q.ic.constant.value = 0.0 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 0       # DISABLED for shock tube
apply_buoyancy = 0
apply_weight = 0
apply_vaporization = 0          # TEST 1: NO VAPORIZATION
static_eta = 0
Spec_Vol = 1
grav = 9.81

### SOLVER SETTINGS ###
Riemann_Solver.type = hllc
kappa_method = 1
small = 1e-8
lagrange = 0.0
