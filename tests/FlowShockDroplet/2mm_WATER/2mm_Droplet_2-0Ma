#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

# THE Main Shock Droplet Interaction Script

alamo.program = hydro2

### OUTPUT ###
#plot_file = ./tests/FlowShockDroplet/output_Shock1mmDroplet
plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowShockDroplet/output_2mm_Droplet_2-0Ma

### MESHING ###
amr.plot_dt = 0.5e-6
#amr.plot_int = 10
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.regrid_int = 20
amr.grid_eff = 0.8
amr.max_level = 2
amr.n_cell = 256 128  # Maintains aspect ratio for 0.02m × 0.01m domain
amr.n_error_buf    = 16

### TIME STEPPING ###
## Static:
timestep = 1e-12

## Adaptive
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 1e-4
dynamictimestep.min = 1e-10
cfl = 0.3

### DIMENSIONS ###
geometry.prob_lo = -0.005 -0.005 0.0  # 1/4 tube left of droplet
geometry.prob_hi =  0.015  0.005 0.0  # 3/4 tube right of droplet (0.02m × 0.01m)
geometry.is_periodic = 0 0 0
 
### TIME STEP ###
stop_time = 0.0002  # Shorter time for shock interaction

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.00002
eta.ic.expression.constant.R0 = 0.001  # 5mm droplet radius
eta.ic.expression.constant.x_center = 0.0  # Centered at origin
eta.ic.expression.constant.y_center = 0.0  # Centered at origin

# Droplet shape definition (air is eta=0, water is eta=1)
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt((x-x_center)**2 + (y-y_center)**2) - R0)/(2*sqrt(2)*epsilon)))"

epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###

# Air properties (fluid 0 - surrounding vapor/gas)
eos0.gamma = 1.4   # Air
eos0.p0 = 0       # Ideal gas
mu0 = 0.0 # 1.8e-5   # Air viscosity [Pa-s]
mu0_b = 0.0

# Water properties (fluid 1 - droplet)
eos1.gamma = 7.15  # Water
eos1.p0 = 3.0e8   # Tammann EOS parameter for water
mu1 = 0.0 # 1.0e-3   # Water viscosity [Pa-s]
mu1_b = 0.0 # 0.001

# Densities
density0.ic.type = expression
density0.ic.expression.constant.rho_air = 1.225
density0.ic.expression.constant.rho_shock = 4.7
density0.ic.expression.constant.x_shock = -0.004  # Shock region near left wall
# Air field with shock
density0.ic.expression.region0 = "(x < x_shock)*rho_shock + (x >= x_shock)*rho_air"

density1.ic.type = expression
density1.ic.expression.constant.rho_water = 1000.0
# Water density (constant in droplet)
density1.ic.expression.region0 = "rho_water"

# Velocities (initially at rest, except shock region)
velocity0.ic.type = expression
velocity0.ic.expression.constant.u_shock = 690.0  # Shock velocity [m/s]
velocity0.ic.expression.constant.x_shock = -0.004
velocity0.ic.expression.region0 = "(x < x_shock)*u_shock + (x >= x_shock)*0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.constant.u_shock = 0.0
velocity1.ic.expression.constant.x_shock = -0.004
velocity1.ic.expression.region0 = "(x < x_shock)*u_shock + (x >= x_shock)*0.0"
velocity1.ic.expression.region1 = "0.0"

# Pressures
pressure0.ic.type = expression
pressure0.ic.expression.constant.p_atm = 1.01325e5
pressure0.ic.expression.constant.p_shock = 10.0e5  # High pressure shock region
pressure0.ic.expression.constant.x_shock = -0.004
# Air pressure with shock
pressure0.ic.expression.region0 = "(x < x_shock)*p_shock + (x >= x_shock)*p_atm"

pressure1.ic.type = expression
pressure1.ic.expression.constant.p_atm = 1.01325e5
# Water pressure (atmospheric in droplet)
pressure1.ic.expression.region0 = "p_atm"

# Thermodynamic properties
eos0.cp = "1005.0"  # Air specific heat [J/kg-K]
eos1.cp = "4179.0"  # Water specific heat [J/kg-K]
eos0.cv = "717.86"  # Air cv = cp/gamma
eos1.cv = "4179.0/7.15"  # Water cv = cp/gamma

# Surface tension
sigma = 72.8e-3  # Water-air surface tension [N/m]

# Vapor Diffusivity
Dv = "2.3e-5"	# Water-Vapor Diffusivity [m^2/s]

# Reference pressure
pref = 0.0

### BOUNDARY CONDITIONS ###
# Top and bottom walls: Neumann (slip walls)
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

# Left wall: Dirichlet (no-slip, no-penetration)
density.bc.type.xlo = neumann
energy.bc.type.xlo = neumann
momentum.bc.type.xlo = neumann neumann
#momentum.bc.type.xlo = dirichlet dirichlet
#momentum.bc.val.xlo = 0.0 0.0  # No-slip

# Right wall: Neumann (outflow)
density.bc.type.xhi = neumann
energy.bc.type.xhi = neumann
momentum.bc.type.xhi = neumann neumann

### REFINEMENT CRITERIA ###
eta_refinement_criterion = 1e-4
omega_refinement_criterion = 1e+5
p_refinement_criterion = 1e+6
rho_refinement_criterion = 1e+5
gradu_refinement_criterion = 1e+5
cutoff = 1e-16
small = 1e-6;

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value = 0.0 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 1
apply_weight = 0
apply_vaporization = 1

Spec_Vol = 1
grav = 9.81

### DEBUGGING ### 
Riemann_Solver.type = hllc
Limiter.type        = minmod
integration.type    = RungeKutta
integration.rk.type = 3
kappa_method = 1   # Valid Entries: 1:"Regular" / 2:"Runnels Regularization"

## Interface Sharpening ##
apply_sharpening = 0
sharpening_frequency = 100
reinit_max_iter = 20
reinit_tolerance = 1e-6
omega_relax = 0.5
