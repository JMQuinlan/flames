#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

# =============================================================================
# DROPLET-STATIONARY-UNIFORM  -- eta-width isolation: NO AMR regrid
# =============================================================================
# Isolation #1 in the eta-interface-widening investigation. IDENTICAL physics to
# Droplet-stationary (zero velocity, surface tension on, Mob=130, CH on) EXCEPT
# the mesh is UNIFORM at the AMR finest cell size, with NO regridding:
#
#   AMR finest dx = (0.16/320)/2^4 = 5e-4/16 = 3.125e-5 m
#   uniform mesh  = 640 x 640 over a [-0.010,0.010]^2 box -> dx = 3.125e-5 m
#   max_level = 0  ->  amr.regrid_int never fires, eta is never re-interpolated.
#
# The cell size is held EQUAL to the AMR finest level so the Cahn-Hilliard
# discretization (epsilon/dx ~ 2.56) is the SAME as the AMR run; the ONLY changed
# variable is the presence/absence of regrid interpolation of eta. The domain is
# shrunk (the droplet does not translate in the stationary case) only to keep the
# uniform-fine cell count tractable -- it does not affect the interface CH balance.
#
# DECISIVE READ:
#   * width HOLDS near 4.40e-4 m  -> the AMR-run broadening was REGRID interpolation
#                                    diffusion of eta (fix = refinement/band handling,
#                                    NOT mobility).
#   * width STILL grows           -> the broadening is the under-resolved CH tail /
#                                    CH discretization (fix = more cells per epsilon,
#                                    or an AC-style pinning term).
# Pair with Droplet-stationary-uniform-Mob0 (CH off) to isolate the CH term itself.
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = /mmfs1/home/jquinlan/runs/dodecane/output_Droplet_stationary_uniform
amr.plot_dt = 0.5e-6

### MESHING -- UNIFORM FINE, NO REGRID ###
amr.max_grid_size = 128
amr.blocking_factor = 16
amr.regrid_int = 1
amr.grid_eff = 0.8
amr.n_error_buf = 4
amr.max_level = 0
amr.n_cell = 640 640

### TIME STEPPING ###
timestep = 1e-11
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 1.0e-7
dynamictimestep.min = 1.0e-15
cfl = 0.2

### DIMENSIONS ###
# Sealed box (neumann BCs); droplet centred at the origin and does not move.
# Tight box around the droplet (R0=4.4e-3) so the uniform-fine mesh is tractable.
geometry.prob_lo = -0.010 -0.010 0.0
geometry.prob_hi =  0.010  0.010 0.0
geometry.is_periodic = 0 0 0

### STOP ###
stop_time = 2.0e-5

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 8.0e-5
eta.ic.expression.constant.R0 = 4.4e-3
eta.ic.expression.constant.x_center = 0.0
eta.ic.expression.constant.y_center = 0.0
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt((x-x_center)**2 + (y-y_center)**2) - R0)/(sqrt(2)*epsilon)))"
epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###
eos0.gamma = 1.4
eos0.p0 = 0.0
mu0 = 1.85e-5
mu0_b = 0.0
eos1.gamma = 2.358
eos1.p0 = 4.01e8
mu1 = 1.35e-3
mu1_b = 0.0

density0.ic.type = expression
density0.ic.expression.constant.rho_amb = 0.9699142
density0.ic.expression.region0 = "rho_amb"

density1.ic.type = expression
density1.ic.expression.constant.rho_nDodecane = 750.0
density1.ic.expression.region0 = "rho_nDodecane"

# ZERO velocity.
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

pressure0.ic.type = expression
pressure0.ic.expression.constant.p_amb = 101325.0
pressure0.ic.expression.region0 = "p_amb"
pressure1.ic.type = expression
pressure1.ic.expression.constant.p_amb = 101325.0
pressure1.ic.expression.constant.p_laplace = 5.6818181818
pressure1.ic.expression.region0 = "p_amb + p_laplace"

eos0.cv = "717.5"
eos0.cp = "1004.5"
eos1.cv = "1.08e3"
eos1.cp = "2546.64"

sigma = 0.025
pref  = 0.0

### REACTIVE PHYSICS -- ALL OFF ###
apply_vaporization = 0
species_transport  = 0
apply_latent_heat  = 0
apply_cavitation   = 0
k0_thermal = 0.0
k1_thermal = 0.0

### BOUNDARY CONDITIONS (sealed box, no flow) ###
density.bc.type.xlo = neumann
density.bc.type.xhi = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.xhi = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.xhi = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

### REFINEMENT CRITERIA (inert with max_level=0) ###
eta_refinement_criterion   = 2e-2
omega_refinement_criterion = 1e+20
divu_refinement_criterion  = 1e+20
rho_refinement_criterion   = 1e+20
gradu_refinement_criterion = 1e+20

cutoff = 1e-16
small  = 1e-6

### POSITIVITY-PRESERVING FLUX LIMITER ###
pp_flux_limiter   = 1
pp_source_limiter = 1
eps_p   = 1.0
eps_rho = 1e-10
p_cav = 1.0e6

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value = 0.0 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 1
apply_weight = 0
grav = 0.0
Spec_Vol = 1

### RIEMANN SOLVER ###
Riemann_Solver.type = hllc_adc
Riemann_Solver.hllc_adc.alpha = 12
Riemann_Solver.hllc_adc.adc_components = 4
adc_shock_threshold = 0.75
adc_grow = 4
adc_interface_band = 0.05

### SURFACE-TENSION NORMAL CALC ###
kappa_method = 1
smooth_kernel_size = 5
nghost = 4
kappa_grad_frac = 0.02

### INTERFACE SHARPENING (off) ###
apply_sharpening = 0

### CAHN-HILLIARD ###
apply_ch_companion = 0
Mob = 130
