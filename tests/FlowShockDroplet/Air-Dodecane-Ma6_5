#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

# =============================================================================
# AIR-DODECANE SHOCK-DROPLET, Ma = 6.5  (air carrier + Spalding evaporation)
# =============================================================================
# Air-carrier version of Dodecane_Case_M6.5_Vap. The surrounding gas is now an
# INERT AIR CARRIER (eos0: gamma=1.4, p0=0, cv=717.5, cp=1004.5), and dodecane
# VAPOR is a transported species (rho_vap; cp_vap/cv_vap = the old eos0 dodecane-
# vapor props) generated by surface evaporation. The Stage-2 physical Spalding
# driving force (spalding_saturation=1) drives mass transfer from the saturation
# mass fraction Y_s(T,p) via the same Antoine curve as cavitation. See
# tests/StefanVap/README.md and Saturation_1D for the verified closure.
#
# SHOCK STATES recomputed for AIR (gamma=1.4, R=cp-cv=287) at Ms=6.5.
#   ambient (pre-shock) air:  p1 = 101325 Pa (1 atm), T1 = 364 K
#     (T1 = 364 K matches the droplet bulk T under the textbook-SG EOS, so gas and
#      liquid are thermally paired at t=0 -- no spurious initial conduction.)
#     -> rho1 = p1/(R T1)            = 0.9699142 kg/m^3
#        a1   = sqrt(gamma R T1)     = 382.4333 m/s
#        W    = Ms a1                = 2485.816 m/s   (shock speed, lab frame)
#   normal-shock jump (Ms=6.5, gamma=1.4):
#        rho2/rho1 = (g+1)M^2/((g-1)M^2+2) = 5.3650794 -> rho2 = 5.203667
#        p2/p1     = 1 + 2g/(g+1)(M^2-1)   = 49.125     -> p2  = 4977590.625 Pa
#        T2        = T1 (p2/p1)/(rho2/rho1) = 3332.94 K   (CPG; hot but correct)
#        u_p (induced) = W(1 - rho1/rho2)   = 2022.484 m/s  (post-shock velocity)
#   inflow conserved state (xlo Dirichlet, pure air Yv=0):
#        rho = 5.203667,  rho*u = 10524.33,
#        E   = p2/(g-1) + 0.5 rho2 u_p^2 = 23086624.0 J/m^3
#   (p2 and the flow Mach behind the shock, u_p/a2 ~ 1.75, are unchanged from the
#    300 K case -- they depend only on Ms; only rho1, a1, W, u_p, rho2 shift.)
#
# AMBIENT CHOICE: lab air at 1 atm, T1 = 364 K (paired with the droplet). Change
# p1/T1 (and rederive the states above) to match a specific experiment.
#
# EOS NOTE: this case relies on TWO temperature fixes in Solver/EOS:
#   1) textbook stiffened-gas pure-phase T = (p + p0)/((gamma-1) rho cv)
#      (Tammann.H) -- puts physical-density liquid (rho=750) at a physical BULK
#      T ~ 364.6 K (was ~860 K with the old (p+gamma*p0) form).
#   2) thermal-equilibrium MIXTURE T (EOS.H MixedTemperature):
#      T = [eta*(p+pi0)/((g0-1)cv0) + (1-eta)*(p+pi1)/((g1-1)cv1)] / rho,
#      which stays BOUNDED between the pure-phase T's across the diffuse band
#      (the old single-effective-fluid form superheated the band to ~900 K and
#      clamped the saturation closure). Together these resolve the production-
#      density saturation clamping at both the droplet interior and the interface.
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = /mmfs1/home/jquinlan/runs/dodecane/output_air_dodecane_Ma6_5_test
# plot_file = /mmfs1/home/jquinlan/runs/dodecane/output_air_dodecane_Ma6_5_no_vap

### MESHING ###
amr.plot_dt = 0.25e-6
# amr.plot_int = 1
amr.max_grid_size = 500000
amr.blocking_factor = 16
amr.regrid_int = 1
amr.grid_eff = 0.8
amr.n_error_buf = 4
amr.max_level = 3
# amr.n_cell = 1024 256
amr.n_cell = 2048 512

### TIME STEPPING ###
## Static:
timestep = 1e-11

## Adaptive
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 1.0e-7
dynamictimestep.min = 1.0e-15
cfl = 0.2

### DIMENSIONS ###
#geometry.prob_lo = 0.000 0.000 0.0
#geometry.prob_hi = 0.160 0.080 0.0
geometry.prob_lo = -0.020 -0.0175 0.0
geometry.prob_hi =  0.120  0.0175 0.0
geometry.is_periodic = 0 0 0

### TIME STEP ###
stop_time = 2.0e-4
# stop_time = 1.0e-5
# stop_time = 5.0e-7

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 4.0e-5
eta.ic.expression.constant.R0 = 4.4e-3
eta.ic.expression.constant.x_center = 0.0
eta.ic.expression.constant.y_center = 0.0

# convention for this expression: eta ~ 0 inside liquid, eta ~ 1 in gas.
# Interface width = sqrt(2)*epsilon is the exact equilibrium of the code's
# chemical potential mu = -epsilon^2 lap(eta) + 4 eta (eta-0.5)(eta-1).
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt((x-x_center)**2 + (y-y_center)**2) - R0)/(sqrt(2)*epsilon)))"

epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###

# eos0 = gas: INERT AIR CARRIER (fluid 0 - surrounding gas, eta ~ 1).
# gamma=1.4, p0=0; cv/cp set below. (dodecane vapor is now a transported species,
# cp_vap/cv_vap -- see the SPECIES block.)
eos0.gamma = 1.4
eos0.p0 = 0.0
mu0 = 1.85e-5      # air dynamic viscosity ~ 1.85e-5 Pa s at 300 K (constant)
mu0_b = 0.0

# liquid n-dodecane properties (fluid 1 - droplet, eta ~ 0)
eos1.gamma = 2.358
eos1.p0 = 4.01e8
mu1 = 1.35e-3
mu1_b = 0.0

# Densities (air shock; see header for the jump calc)
density0.ic.type = expression
density0.ic.expression.constant.rho_amb   = 0.9699142    # pre-shock air (1 atm, 364 K)
density0.ic.expression.constant.rho_shock = 5.203667     # post-shock air
density0.ic.expression.constant.x_shock = -0.005
density0.ic.expression.constant.delta = 4.0e-5
density0.ic.expression.region0 = "rho_shock + (rho_amb - rho_shock)*0.5*(1.0 + tanh((x - x_shock)/delta))"

density1.ic.type = expression
# Physical liquid n-dodecane density. With the textbook-SG temperature fix and the
# original Le Metayer values (cv=1080), this gives T ~ 364.6 K (see eos1 block);
# no density inflation needed.
density1.ic.expression.constant.rho_nDodecane = 750.0
density1.ic.expression.region0 = "rho_nDodecane"

# Velocities: post-shock gas velocity from the moving-shock induced velocity for Ms=6.5 in air.
velocity0.ic.type = expression
velocity0.ic.expression.constant.u_shock = 2022.484
velocity0.ic.expression.constant.x_shock = -0.005
velocity0.ic.expression.constant.delta = 4.0e-5
velocity0.ic.expression.region0 = "u_shock*0.5*(1.0 - tanh((x - x_shock)/delta))"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

# Pressures: pre/post shock air pressure consistent with the density/velocity states.
pressure0.ic.type = expression
pressure0.ic.expression.constant.p_amb   = 101325.0      # pre-shock air (1 atm)
pressure0.ic.expression.constant.p_shock = 4977590.625   # post-shock air
pressure0.ic.expression.constant.x_shock = -0.005
pressure0.ic.expression.constant.delta = 4.0e-5
pressure0.ic.expression.region0 = "p_shock + (p_amb - p_shock)*0.5*(1.0 + tanh((x - x_shock)/delta))"

pressure1.ic.type = expression
pressure1.ic.expression.constant.p_amb = 101325.0
# Laplace pressure for a 2D droplet: dP = sigma/R = 0.025 / 4.4e-3 = 5.6818 Pa.
# Adding this to the droplet interior puts it in mechanical equilibrium with the
# ambient air at t=0, suppressing a spurious expansion wave.
pressure1.ic.expression.constant.p_laplace = 5.6818181818
pressure1.ic.expression.region0 = "p_amb + p_laplace"

# Thermodynamic properties
# eos0 = AIR carrier:
eos0.cv = "717.5"
eos0.cp = "1004.5"
# eos1 = liquid n-dodecane (original Le Metayer SG values):
# With the textbook SG temperature T = (p + p0)/((gamma-1)*rho*cv) (the EOS fix),
# the pure liquid at rho = 750, p ~ 1 atm sits at
#   T = (101330.68 + 4.01e8)/(1.358*750*1080) = 364.6 K,
# so no parameter retune is needed -- the literature values give a physical T.
eos1.cv = "1.08e3"
eos1.cp = "2546.64"

# Surface tension from paper
sigma = 0.025

# Reference pressure
pref = 0.0

### SPALDING VAPORIZATION + STAGE-2 SATURATION DRIVING FORCE ###
apply_vaporization  = 1        # Spalding mass transfer on
spalding_saturation = 1        # Stage 2: B_M from Antoine saturation Y_s(T,p)
Y_infinity          = 0.0      # far-field (ambient) vapor mass fraction
# Antoine for p_sat (n-dodecane, bar): log10(p_sat) = A - B/(T+C). Shared with cavitation.
antoine_A = 4.10549
antoine_B = 1625.928
antoine_C = -92.839

### SPECIES (air carrier + dodecane vapor) + DIFFUSION ###
species_transport = 1          # gas = carrier(eos0=air) + transported dodecane vapor
Yv_init           = 0.0        # gas starts as pure air -> vapor grows by evaporation
cp_vap            = 1994.85    # dodecane-vapor cp [J/kg/K]  (R_v = cp_vap - cv_vap = 44.85)
cv_vap            = 1950.0     # dodecane-vapor cv [J/kg/K]  (old eos0 dodecane-vapor props)
Dv = "1.0e-5"                  # vapor diffusivity [m^2/s] (physical-ish; could be higher, but really should add T and P dependence)
L_film = 3.19e-8                 # Spalding film thickness [m]: m'' = (rho_g*Dv/L_film)*B'. Dv/L_film = 50 m/s mass-transfer velocity (quasi-steady stagnant-film). Restores the rate magnitude (the bare |grad eta| form was missing 1/L -> ran ~1/epsilon too small).

### LATENT HEAT (on) / CONDUCTION (off: never validated 2-phase) ###
apply_latent_heat = 1
L_vap             = 256.0e3
k0_thermal        = 0.047
k1_thermal        = 0.1175

### BOUNDARY CONDITIONS ###
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

# xlo inflow = post-shock AIR state (pure carrier, Yv=0)
density.bc.type.xlo = dirichlet
density.bc.val.xlo  = "5.203667"
energy.bc.type.xlo = dirichlet
energy.bc.val.xlo  = "23086624.0"
momentum.bc.type.xlo = dirichlet neumann
momentum.bc.val.xlo  = "10524.33" "0.0"

density.bc.type.xhi = neumann
energy.bc.type.xhi = neumann
momentum.bc.type.xhi = neumann neumann

### REFINEMENT CRITERIA ###
eta_refinement_criterion = 2e-2 # Interface location
omega_refinement_criterion = 1e+20
divu_refinement_criterion = 0.3 # Shock location (actually Ducros gating, so 0 to 1)
rho_refinement_criterion = 1e+2
gradu_refinement_criterion = 5e+4


cutoff = 1e-16
small = 1e-6

### POSITIVITY-PRESERVING FLUX LIMITER (Hu-Adams-Shu) ###
# Blends the selected (HLLC-ADC) flux toward HLL per face so the Forward-Euler
# update keeps rho > eps_rho and absolute pressure p >= eps_p. eps_p floors the
# physical pressure (not p + p0_eff), so the stiffened liquid is held at p >= eps_p
# rather than eps_p - p0_eff (~ -400 MPa). Set pp_flux_limiter = 0 to disable.
# NOTE: species (rho_vap) + conduction are FE-only; the Pass-B limiter path does
# not yet carry the species flux / multi-grid rho_vap ghost fill (see memory).
pp_flux_limiter = 1
pp_source_limiter=1
# Small values
eps_p = 1.0
eps_rho = 1e-10

# Liquid cavitation/tensile floor: hold the liquid (eta->0) at p >= -p_cav
# while gas (eta->1) stays p >= eps_p. 0 = vacuum floor (no tension).
p_cav = 1.0e6

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value = 0.0 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 1
apply_weight = 0

# HRM bulk cavitation: off (isolate surface Spalding evaporation).
apply_cavitation = 0
tau_cav   = 1.0e-4

Spec_Vol = 1
grav = 9.81

### RIEMANN SOLVER ###
Riemann_Solver.type = hllc_adc
# NOTE: parameters for the selected solver live under Riemann_Solver.<type>.
Riemann_Solver.hllc_adc.alpha = 12
# 4 = blend mass + normal + tangential momentum + energy toward HLL at shocks
# (genuine all-component HLL at tagged faces; carbuncle-free).
Riemann_Solver.hllc_adc.adc_components = 4

# Carbuncle cure: Ducros-weighted div(u) compression sensor tags the shock, grown
# by adc_grow cells; tagged faces use omega=0 (HLL), untagged omega=1 (full HLLC).
adc_shock_threshold = 0.75
adc_grow = 4

# Surface tension nhat calc adjustments
kappa_method = 1
smooth_kernel_size = 5  # Gaussian normal smoothing kernel: 3 (3x3, default) or 5 (5x5)
nghost = 4             # Ghost cell depth (= N_int for HF band). Requires amr.blocking_factor >= nghost.
kappa_grad_frac = 0.02

## Interface Sharpening ##
apply_sharpening = 0
sharpening_frequency = 100
reinit_max_iter = 20
reinit_tolerance = 1e-6
omega_relax = 0.5

# Cahn-Hilliard mobility scale from interface Peclet estimate:
# Pe_CH = U*epsilon^2/(M*sigma), M = M0*epsilon^2, M0 ~ U/sigma.
Mob = 130
