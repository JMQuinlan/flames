alamo.program = hydro2

### OUTPUT ###
# plot_file = /mmfs1/home/spatel6/flames/bin/tests/output/Dodecane_flat
plot_file = /mmfs1/home/jquinlan/runs/dodecane/output_dodecane_flat

### MESHING ###
amr.plot_dt = 0.25e-6
amr.plot_int = 1
amr.max_grid_size = 500000
amr.blocking_factor = 16
amr.regrid_int = 1
amr.grid_eff = 0.8
amr.n_error_buf = 4
amr.max_level = 4
amr.n_cell = 1024 256

### TIME STEPPING ###
## Static:
timestep = 1e-11

## Adaptive
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 1.0e-7
dynamictimestep.min = 1.0e-15
cfl = 0.3

### DIMENSIONS ###
#geometry.prob_lo = 0.000 0.000 0.0
#geometry.prob_hi = 0.160 0.080 0.0
geometry.prob_lo = -0.020 -0.0175 0.0
geometry.prob_hi =  0.120  0.0175 0.0
geometry.is_periodic = 0 0 0

### TIME STEP ###
# stop_time = 2.0e-4
# stop_time = 1.0e-5
stop_time = 5.0e-7

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 2.0e-5
eta.ic.expression.constant.x_interface = 0.0

# convention for this expression: eta ~ 0 inside liquid, eta ~ 1 in gas.
# Flat vertical interface at x = x_interface: gas (eta~1) on the left, liquid (eta~0) on the right.
# Width = sqrt(2)*epsilon is the EXACT 1D equilibrium of the code's chemical
# potential mu = -epsilon^2 lap(eta) + 4 eta (eta-0.5)(eta-1): eta = 0.5(1 + tanh(x/(sqrt(2)*epsilon))).
# (The old droplet IC used 2*sqrt(2)*epsilon -- a profile 2x too wide -- which leaves a
# residual mu dipole at t=0.)
eta.ic.expression.region0 = "0.5*(1 + tanh((x_interface - x)/(sqrt(2)*epsilon)))"

epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###

# n-dodecane vapor properties (fluid 0 - surrounding gas, eta ~ 1)
eos0.gamma = 1.023
eos0.p0 = 0.0
mu0 = 5.27529422768e-5
mu0_b = 0.0

# liquid n-dodecane properties (fluid 1 - droplet, eta ~ 0)
eos1.gamma = 2.358
eos1.p0 = 4.01e8
mu1 = 1.35e-3
mu1_b = 0.0

# Densities: uniform in each fluid (no shock).
density0.ic.type = expression
density0.ic.expression.constant.rho_vapor = 1.35598311723
density0.ic.expression.region0 = "rho_vapor"

density1.ic.type = expression
density1.ic.expression.constant.rho_nDodecane = 749.5
density1.ic.expression.region0 = "rho_nDodecane"

# Velocities: quiescent (no shock).
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

# Pressures: uniform p_vapor everywhere -> mechanical equilibrium across the
# flat interface. A flat interface has zero curvature, so there is no Laplace
# jump and both fluids share the same pressure.
pressure0.ic.type = expression
pressure0.ic.expression.constant.p_vapor = 3.53948205141e4
pressure0.ic.expression.region0 = "p_vapor"

pressure1.ic.type = expression
pressure1.ic.expression.constant.p_vapor = 3.53948205141e4
pressure1.ic.expression.region0 = "p_vapor"

# Thermodynamic properties from paper
eos0.cv = "1.95e3"
eos0.cp = "1994.85"
eos1.cv = "1.08e3"
eos1.cp = "2546.64"

# Surface tension from paper
sigma = 0.025

Dv = "1.0e-5"
Y_infinity = 0.0

# Reference pressure
pref = 0.0

### BOUNDARY CONDITIONS ###
# density.bc.type = expression
# momentum.bc.type = expression
# energy.bc.type = expression

density.bc.type.ylo = neumann
density.bc.type.yhi = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

# No inflow: quiescent equilibrium, so xlo is zero-gradient like xhi.
density.bc.type.xlo = neumann
energy.bc.type.xlo = neumann
momentum.bc.type.xlo = neumann neumann


density.bc.type.xhi = neumann
energy.bc.type.xhi = neumann
momentum.bc.type.xhi = neumann neumann

### REFINEMENT CRITERIA ###
eta_refinement_criterion = 1e-3
omega_refinement_criterion = 1e+10
divu_refinement_criterion = 0.05
rho_refinement_criterion = 5e+1
gradu_refinement_criterion = 5e+2


cutoff = 1e-16
small = 1e-6

### POSITIVITY-PRESERVING FLUX LIMITER (Hu-Adams-Shu) ###
# Blends the selected (HLLC-ADC) flux toward HLL per face so the Forward-Euler
# update keeps rho > eps_rho and absolute pressure p >= eps_p. eps_p floors the
# physical pressure (not p + p0_eff), so the stiffened liquid is held at p >= eps_p
# rather than eps_p - p0_eff (~ -400 MPa). Set pp_flux_limiter = 0 to
# disable and recover the unlimited high-order flux.
pp_flux_limiter = 0
eps_p = 1.0
eps_rho = 1e-10

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value = 0.0 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 0
apply_weight = 0
apply_vaporization = 0

Spec_Vol = 1
grav = 9.81

### DEBUGGING ###
# Riemann_Solver.type = hllc
# Riemann_Solver.type = hll
# Riemann_Solver.type = hllc_lm
# Riemann_Solver.ma_limit = 0.1 # transverse Ma limit below which HLLC_LM damps more
Riemann_Solver.type = hllc_adc
# NOTE: parameters for the selected solver live under Riemann_Solver.<type>.
# select_default constructs the solver with prefix "Riemann_Solver.hllc_adc",
# so a bare "Riemann_Solver.alpha" is NOT read by HLLC_ADC::Parse (it silently
# falls back to the code default). Use the fully-qualified prefix below.
Riemann_Solver.hllc_adc.alpha = 12
# 2 = Simon & Mandal paper-faithful cure (blend mass + normal momentum only).
# 4 = also blend tangential momentum + energy toward HLL at shocks.
# With omega=0 (tagged region below), adc=2 leaves the energy + tangential
# fluxes at full antidiffusive HLLC -- the exact components that differ from a
# pure-HLL run, which is why adc=2 fails to cure the carbuncle. adc=4 makes a
# tagged face a genuine all-component HLL flux, identical to the pure-HLL run
# that is confirmed carbuncle-free.
Riemann_Solver.hllc_adc.adc_components = 4

# Carbuncle cure: locate the shock with a Ducros-weighted div(u) compression
# sensor (not the pressure jump, which is carbuncle-quiet), tag cells above
# adc_shock_threshold, then grow the tag by adc_grow cells so the full-HLL
# dissipation covers the post-shock band. Tagged faces use omega = 0 (HLL on
# mass + normal momentum), untagged faces use omega = 1 (full HLLC). Set
# adc_grow = -1 to disable and fall back to the pressure-ratio sensor.
adc_shock_threshold = 0.75
adc_grow = 4

# Surface tension nhat calc adjustments
kappa_method = 1
smooth_kernel_size = 3

## Interface Sharpening ##
apply_sharpening = 0
sharpening_frequency = 100
reinit_max_iter = 20
reinit_tolerance = 1e-6
omega_relax = 0.5

# Cahn-Hilliard mobility scale from interface Peclet estimate:
# Pe_CH = U*epsilon^2/(M*sigma), M = M0*epsilon^2, M0 ~ U/sigma.
# With sigma = 0.025 N/m, M0 = 1025.239/0.025 = 4.10095716768e4
# Mob = 4.1e4
# Mob = 4000.0
Mob = 1e-20
