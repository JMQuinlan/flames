#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@
alamo.program = hydro2

### OUTPUT ###
plot_file = tests/RayleighTaylor/RayleighTaylor_UNIT_TEST

### MESHING ###
amr.plot_dt = 0.5
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.regrid_int = 10
amr.grid_eff = 0.8
amr.max_level = 0
amr.n_cell = 64 192  # Match Python: 64 x 192 (aspect ratio 1:3)
#amr.n_cell = 128 384  # Match Python: 64 x 192 (aspect ratio 1:3)

### TIME STEPPING ###
## Adaptive based on CFL
timestep = 1e-7
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.min = 1e-12
dynamictimestep.max = 1e-0
cfl = 0.6

### DIMENSIONS ###
geometry.prob_lo = 0.0 0.0 0.0    # [m]
geometry.prob_hi = 0.5 1.5 0.0    # [m] - Match Python domain
geometry.is_periodic = 1 0 0      # Periodic in x, reflecting in y
 
### TIME STEP ###
stop_time = 30.0  # Match Python simulation time

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.004
eta.ic.expression.constant.w0 = 0.0025  # Perturbation amplitude

# Interface at y=0.75 with 2D perturbation
# eta=1 is heavy fluid (top), eta=0 is light fluid (bottom)
eta.ic.expression.region0 = "0.5 * (1.0 + tanh((y - 0.75) / epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###
# Heavy fluid properties (top, eta=1) - density = 2.0
gamma0 = 1.4
p0_0 = 0.0
mu0 = 0.0
mu0_b = 0.0

# Light fluid properties (bottom, eta=0) - density = 1.0
gamma1 = 1.4
p0_1 = 0.0
mu1 = 0.0
mu1_b = 0.0

# Densities - heavy on top (rho=2), light on bottom (rho=1)
density0.ic.type = expression
density0.ic.expression.region0 = "2.0"  # Heavy fluid
density1.ic.type = expression
density1.ic.expression.region0 = "1.0"  # Light fluid

# Velocities - initial perturbation
velocity0.ic.type = expression
velocity0.ic.expression.constant.w0 = 0.0025
velocity0.ic.expression.region0 = "0.0"  # vx = 0
velocity0.ic.expression.region1 = "w0 * (1.0 - cos(4.0 * 3.14159 * x)) * (1.0 - cos(4.0 * 3.14159 * y / 3.0))"  # vy perturbation

velocity1.ic.type = expression
velocity1.ic.expression.constant.w0 = 0.0025
velocity1.ic.expression.region0 = "0.0"  # vx = 0
velocity1.ic.expression.region1 = "w0 * (1.0 - cos(4.0 * 3.14159 * x)) * (1.0 - cos(4.0 * 3.14159 * y / 3.0))"  # vy perturbation

# Pressures - hydrostatic with interface at y=0.75
pressure0.ic.type = expression
pressure0.ic.expression.constant.P0 = 2.5
pressure0.ic.expression.constant.g = -0.1
pressure0.ic.expression.region0 = "P0 + g * (y - 0.75) * 2.0"  # Heavy fluid

pressure1.ic.type = expression
pressure1.ic.expression.constant.P0 = 2.5
pressure1.ic.expression.constant.g = -0.1
pressure1.ic.expression.region0 = "P0 + g * (y - 0.75) * 1.0"  # Light fluid

# Temperatures (constant)
temperature0.ic.type = expression
temperature0.ic.expression.region0 = "293.15"
temperature1.ic.type = expression
temperature1.ic.expression.region0 = "293.15"

# Thermodynamic properties (ideal gas)
cp0 = "1005.0"
cp1 = "1005.0"

cv0 = "717.86"  # cp/gamma for gamma=1.4
cv1 = "717.86"

# Surface tension
sigma = 0.0 

# Reference pressure
pref = 0.0

### BOUNDARY CONDITIONS ###
density.bc.type.xhi = periodic
density.bc.type.xlo = periodic
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = periodic
energy.bc.type.xlo = periodic
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xhi = periodic periodic
momentum.bc.type.xlo = periodic periodic
momentum.bc.type.ylo = dirichlet dirichlet
momentum.bc.val.ylo  = 0.0       0.0
momentum.bc.type.yhi = dirichlet dirichlet
momentum.bc.val.yhi  = 0.0       0.0

### REFINEMENT CRITERIA ###
eta_refinement_criterion = 0.0001
omega_refinement_criterion = 10.0
p_refinement_criterion = 1e+2
rho_refinement_criterion = 0.5
gradu_refinement_criterion = 1e+1
cutoff = 1e-16

### SOURCE TERMS ###
q.ic.type = expression
q.ic.expression.region0 = "0.0"
q.ic.expression.region1 = "0.0"

m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 0
apply_buoyancy = 0
apply_weight = 1
Spec_Vol = 1
grav = 0.1

### NUMERICAL METHODS ###
Riemann_Solver.type = hllc
