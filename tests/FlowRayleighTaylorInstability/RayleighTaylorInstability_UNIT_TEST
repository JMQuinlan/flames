#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@
alamo.program = hydro2

# =============================================================================
# RAYLEIGH-TAYLOR INSTABILITY -- hydro2 UNIT TEST (updated to new EOS form)
# =============================================================================
# Two-fluid stratified setup with a perturbed interface at y = 0.75:
#   eta = 0 below : LIGHT fluid (rho = 1)
#   eta = 1 above : HEAVY fluid (rho = 2)
# Gravity pulls heavy down -> RT instability grows.
#
# Companion VoF reference is in Raleigh_Taylor_Instability_STANDALONE.py.
# =============================================================================

### OUTPUT ###
plot_file = tests/RayleighTaylor/RayleighTaylor_UNIT_TEST

### MESHING ###
amr.plot_dt        = 0.5
amr.max_grid_size  = 500000
amr.blocking_factor = 2
amr.regrid_int     = 10
amr.grid_eff       = 0.8
amr.max_level      = 0
amr.n_cell         = 64 192   # 1:3 aspect ratio matches the standalone VoF

### TIME STEPPING ###
timestep = 1e-7
dynamictimestep.on      = 1
dynamictimestep.verbose = 1
dynamictimestep.min     = 1e-12
dynamictimestep.max     = 1e-0
cfl = 0.6

### DIMENSIONS ###
geometry.prob_lo     = 0.0 0.0 0.0    # [m]
geometry.prob_hi     = 0.5 1.5 0.0    # [m]
geometry.is_periodic = 1 0 0          # periodic in x, reflecting in y

stop_time = 30.0

### ETA INITIAL CONDITIONS ###
# eta = 1 above the interface (heavy fluid, phase 0).
# eta = 0 below the interface (light fluid, phase 1).
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.004
eta.ic.expression.constant.w0      = 0.0025
eta.ic.expression.region0 = "0.5 * (1.0 + tanh((y - 0.75) / epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EQUATION OF STATE -- both phases ideal gas (gamma = 1.4) ###
# cv = R / (gamma - 1) for an ideal gas; cv = 717.86, cp = 1005 used in
# the original input for air-like normalization.
eos0.gamma = 1.4
eos0.p0    = 0.0
eos0.cv    = 717.86
eos0.cp    = 1005.0

eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cv    = 717.86
eos1.cp    = 1005.0

mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### PER-PHASE PRIMARIES ###
# Densities -- heavy on top (rho = 2), light on bottom (rho = 1).
density0.ic.type = expression
density0.ic.expression.region0 = "2.0"          # heavy (phase 0)

density1.ic.type = expression
density1.ic.expression.region0 = "1.0"          # light (phase 1)

# Velocities -- initial perturbation on v_y to seed the instability.
# u_x = 0;  u_y = w0 * (1 - cos(4*pi*x)) * (1 - cos(4*pi*y/3))
velocity0.ic.type = expression
velocity0.ic.expression.constant.w0 = 0.0025
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "w0 * (1.0 - cos(4.0 * 3.14159 * x)) * (1.0 - cos(4.0 * 3.14159 * y / 3.0))"

velocity1.ic.type = expression
velocity1.ic.expression.constant.w0 = 0.0025
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "w0 * (1.0 - cos(4.0 * 3.14159 * x)) * (1.0 - cos(4.0 * 3.14159 * y / 3.0))"

# Pressures -- hydrostatic equilibrium  p = P0 + rho * g * (y - 0.75)
# with g = -0.1 (downward); per-phase IC pressures match the local fluid
# density, then the equalize_ic_pressure formula gives p_mix = p_k in
# pure-phase cells (no IC kick).
pressure0.ic.type = expression
pressure0.ic.expression.constant.P0 = 2.5
pressure0.ic.expression.constant.g  = -0.1
pressure0.ic.expression.region0     = "P0 + g * (y - 0.75) * 2.0"   # heavy

pressure1.ic.type = expression
pressure1.ic.expression.constant.P0 = 2.5
pressure1.ic.expression.constant.g  = -0.1
pressure1.ic.expression.region0     = "P0 + g * (y - 0.75) * 1.0"   # light

# Surface tension off for the nominal RT (Atwood-driven growth only).
sigma = 0.0

### BOUNDARY CONDITIONS ###
density.bc.type.xhi = periodic
density.bc.type.xlo = periodic
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = periodic
energy.bc.type.xlo = periodic
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xhi = periodic periodic
momentum.bc.type.xlo = periodic periodic
momentum.bc.type.ylo = dirichlet dirichlet
momentum.bc.val.ylo  = 0.0 0.0                  # no-slip at bottom (reflecting wall)
momentum.bc.type.yhi = dirichlet dirichlet
momentum.bc.val.yhi  = 0.0 0.0                  # no-slip at top (reflecting wall)

### REFINEMENT CRITERIA ###
eta_refinement_criterion   = 0.0001
omega_refinement_criterion = 10.0
p_refinement_criterion     = 1e+2
rho_refinement_criterion   = 0.5
gradu_refinement_criterion = 1e+1
cutoff = 1e-16

### SOURCE TERMS ###
q.ic.type = expression
q.ic.expression.region0 = "0.0"
q.ic.expression.region1 = "0.0"

m0.ic.type = constant
m0.ic.constant.value = 0.0

u0.ic.type = expression
u0.ic.expression.region0 = "0.0"
u0.ic.expression.region1 = "0.0"

### PHYSICS FLAGS ###
apply_surface_tension = 0
apply_buoyancy        = 0
apply_weight          = 1            # apply gravity (g below)
apply_vaporization    = 0
grav                  = 0.1

### IC PRESSURE EQUALIZATION ###
# Per-phase IC pressures differ across the interface (each tracks its own
# rho*g*y baseline), but in pure-phase cells the per-phase = mixture so
# this is essentially no-op outside the band.  Inside the band the
# gamma-weighted form gives the same answer as the linear average since
# both phases share gamma; flag kept on for consistency.
equalize_ic_pressure = 1

### NUMERICAL METHODS -- standardized: HLLC + WENO3 + RK3 ###
# Previously had `Riemann_Solver.type = roe` and `lax_friedrich` commented;
# standardizing per the EOS-conversion sweep.  Flip the active line if you
# want to revert.
Riemann_Solver.type = hllc
#Riemann_Solver.type = roe
#Riemann_Solver.type = lax_friedrich
Limiter.type        = weno3
integration.type    = RungeKutta
integration.rk.type = 3
