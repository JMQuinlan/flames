#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

alamo.program = hydro2

### OUTPUT ###
#plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowTwoPhase/AirBubble_2Bar_in_Water_1Bar
#plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowTwoPhase/LargeBubbleRPE_2_Bar.GammaHigh_SmallEta_HLLETamman
plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowTwoPhase/RPE
#plot_file = tests/LargeBubbleRPE_2_Bar.GammaHigh
#plot_file = /mmfs1/home/jquinlan/runs/RDE/droplet/droplet_20250529/output_Bubble


### MESHING ###
amr.plot_dt = 5e-5
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.regrid_int = 100
amr.grid_eff = 0.8
amr.max_level = 5
amr.n_cell = 64 64

### TIME STEPING ###
## Static:
timestep  = 1e-6
## Adaptive
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.min = 2e-8
dynamictimestep.max = 1e-6
cfl = 0.8e7

### DIMENSIONS ###
geometry.prob_lo = -0.10 -0.10 0.0 # [ m ]
geometry.prob_hi =  0.10  0.10 0.0 # [ m ]
geometry.is_periodic = 0 0 0
 
### TIME STEP ###
stop_time = 0.05

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.0005
eta.ic.expression.constant.R0 = 0.01  # Increased bubble radius for better visibility

# Bubble shape definition
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt((x)**2 + (y)**2) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###
# Water properties (fluid 0)
gamma0 = 7.15  # Water
p0_0 = 3.0e8   # Tammann EOS parameter for water
mu0 = 1.0e-3   # Water viscosity [Pa-s]
mu0_b = 0.001

# Air properties (fluid 1)
gamma1 = 1.4   # Air
p0_1 = 0       # Ideal gas
mu1 = 1.8e-5   # Air viscosity [Pa-s]
mu1_b = 0

# Densities
density0.ic.type = expression
density0.ic.expression.region0 = "997.0"  # Water density [kg/m3]

density1.ic.type = expression
density1.ic.expression.region0 = "2.377"  # Air density at 2 bar [kg/m3]

# Velocities (initially at rest)
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

# Pressures
pressure0.ic.type = expression
pressure0.ic.expression.region0 = "1.0e5"  # Water at 1 bar [Pa]

pressure1.ic.type = expression
pressure1.ic.expression.region0 = "2.0e5"  # Air at 2 bar [Pa]

# Temperatures
temperature0.ic.type = expression
temperature0.ic.expression.region0 = "293.15"  # 20 C

temperature1.ic.type = expression
temperature1.ic.expression.region0 = "293.15"  # 20 C

# Thermodynamic properties
cp0.ic.type = expression
cp0.ic.expression.region0 = "4179.0"  # Water specific heat [J/kg-K]

cp1.ic.type = expression
cp1.ic.expression.region0 = "1005.0"  # Air specific heat [J/kg-K]

cv0.ic.type = expression
cv0.ic.expression.region0 = "4179.0/7.15"  # Water cv = cp/gamma

cv1.ic.type = expression
cv1.ic.expression.region0 = "717.86"  # Air cv = cp/gamma

# Thermal conductivities
k0_thermal.ic.type = expression
k0_thermal.ic.expression.region0 = "0.6"  # Water [W/m-K]

k1_thermal.ic.type = expression
k1_thermal.ic.expression.region0 = "0.026"  # Air [W/m-K]

h0_thermal.ic.type = expression
h0_thermal.ic.expression.region0 = "4179.0"  # Water heat transfer coefficient

h1_thermal.ic.type = expression
h1_thermal.ic.expression.region0 = "1005.0"  # Air heat transfer coefficient

# Surface tension
sigma = 72.8  # Water-air surface tension [N/m]

# Reference pressure
pref = 0.0

### BOUNDARY CONDITIONS ###
# Hydro boundary conditions
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

### REFINEMENT CRITERIA ###
eta_refinement_criterion = 0.000001
omega_refinement_criterion = 10.55
p_refinement_criterion = 1e+4
rho_refinement_criterion = 1e+2
gradu_refinement_criterion = 1e+2
cutoff = 1e-16

### SOURCE TERMS ###
q.ic.type = expression
q.ic.expression.region0 = "0.0"
q.ic.expression.region1 = "0.0"

m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 1
apply_buoyancy = 0
apply_weight = 0
Spec_Vol = 1
grav = 9.81

### DEBUGGING ### 
# Used for testing of the model
Riemann_Solver = 1 # Valid Entries: 0:"Roe" / 1:"HLLC" / 2:"HLLE" / 3:"Mixed"
kappa_method = 2   # Valid Entries: 1:"Regular" / 2:"Runnels Regularization"
scheme = 0		   # Valid Entries: 0:"Forward Euler" / 1:"SSPRK3" / 2:"RK4"
Limiter = 0        # Valid Entries: 0:"None" / 1:"MinMod" / 2:"Van Leer"
