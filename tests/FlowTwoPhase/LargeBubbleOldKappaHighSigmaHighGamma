#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

alamo.program = hydro2

### OUTPUT ###
plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowTwoPhase/LargeBubbleRPE_2_Bar.RPEVerify2

### MESHING ###
amr.plot_dt = 5e-4
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.regrid_int = 100
amr.grid_eff = 0.8

amr.max_level = 6
timestep  = 1e-6
amr.n_cell = 16 16

### DIMENSIONS ###
geometry.prob_lo = -0.050 -0.050 0.0 # [ m ]
geometry.prob_hi =  0.050  0.050 0.0 # [ m ]
geometry.is_periodic = 0 0 0
 
### TIME STEP ###
stop_time = 0.05

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
# Eqn: "0.5*(1+tanh((sqrt(((x-xc)/a)**2 + ((y-yc)/b)**2) - Diameter)/Boundry_Thickness))
# RPE Verification
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt((x)**2 + (y)**2) - 0.01)/0.00015))"


### HYDRO INITIAL CONDITIONS ###
gamma0 = 1.4
gamma1 = 1.4

p0_0 = 0
p0_0 = 0

mu0   = 10
mu1   = 0.000018 

mu0_b   = 0
mu1_b   = 0

density0.ic.type = expression
density0.ic.expression.region0 = "997.0"

density1.ic.type = expression
density1.ic.expression.region0 = "1.3"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

pressure0.ic.type = expression
pressure0.ic.expression.region0 = "1e5" #" + (1e5*(x<=-0.0007))"

pressure1.ic.type = expression
pressure1.ic.expression.region0 = "2e5"

sigma = 72.8; # 0.078 # For Air/Water

cfl = 0.4;
pref = 1e5;

### ETA BC  ###
pf.eta.bc.type.xlo = neumann
pf.eta.bc.type.xhi = neumann
pf.eta.bc.type.ylo = neumann
pf.eta.bc.type.yhi = neumann
pf.eta.bc.type.zlo = neumann
pf.eta.bc.type.zhi = neumann

### HYDRO BC ###
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

#momentum.bc.type.xhi = dirichlet dirichlet
#momentum.bc.type.xlo = dirichlet dirichlet
#momentum.bc.type.ylo = dirichlet dirichlet
#momentum.bc.type.yhi = dirichlet dirichlet
#momentum.bc.val.xhi = 0.0 0.0
#momentum.bc.val.xlo = 0.0 0.0
#momentum.bc.val.ylo = 0.0 0.0
#momentum.bc.val.yhi = 0.0 0.0

### HYDRO REFINEMENT CRITERIA ###
eta_refinement_criterion = 0.01
omega_refinement_criterion = 10.55
cutoff = 1e-6

### SOURCE TERMS ###
q.ic.type = expression
q.ic.expression.region0 = "0.0"
q.ic.expression.region1 = "0.0"
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 1
apply_buoyancy = 0
apply_weight = 0
grav = 9.81

### DEBUGGING ### 
# Used for testing of the model
Riemann_Solver = 2 # Valid Entries: 0:"Roe" / 1:"HLLC" / 2:"HLLE" / 3:"Mixed"
kappa_method = 1   # Valid Entries: 1:"Regular" / 2:"Runnels Regularization"
