# ============================================================================
# FlowMovingWall / Stokes' first problem: impulsively started wall  (Hydro2, sharp no-slip wall)
#
# Gas at rest (rho 1, p 1, mu 2e-4 -> nu = 2e-4) above an embedded wall (solid y < 0) that moves along
# itself at U = 0.1 (Mach 0.085) from t = 0; periodic in x.  Exact (incompressible):
#     u(y, t) = U erfc( y / (2 sqrt(nu t)) ),   wall shear = mu U / sqrt(pi nu t).
# delta = 2 sqrt(nu t) = 0.049 = 20 cells at t = 3.  Tests the wall velocity and WHERE the no-slip
# plane sits: on the fluid|solid face with solid.visc_mirror = 1, dx/2 inside the solid with 0 (default).
#
# Run (from bin/): mpirun -np 1 ./hydro2-2d-g++ ../tests/FlowMovingWall/input_1D_Stokes plot_file=<dir>/output solid.visc_mirror=1
# Check:           python3 ../tests/FlowMovingWall/reference/stokes_check.py <dir>
# ============================================================================
plot_file = ./tests/FlowMovingWall/output_1D_Stokes
amr.plot_dt = 0.25
amr.max_grid_size = 200
amr.blocking_factor = 4
amr.regrid_int       = 10
amr.grid_eff         = 0.8
amr.max_level = 0
amr.n_cell = 8 200
amr.n_error_buf      = 8
geometry.prob_lo = 0.0 -0.05 0.0
geometry.prob_hi = 0.02 0.45 0.0
geometry.is_periodic = 1 0 0
timestep = 1e-5
dynamictimestep.on  = 1
dynamictimestep.verbose = 0
dynamictimestep.max = 1e-2
dynamictimestep.min = 1e-9
cfl                 = 0.3
cfl_v               = 0.3
stop_time = 3.0
apply_embedded_solid = 1
solid.wall_flux = 1
solid.phi.ic.type = expression
solid.phi.ic.expression.constant.xw = 0.3
solid.phi.ic.expression.region0 = "1.0*(y > 0.0)"
phi_refinement_criterion = 1e10
solid.density.ic.type = constant
solid.density.ic.constant.value = 1.0
solid.momentum.ic.type = constant
solid.momentum.ic.constant.value = 0.1 0.0
solid.pressure.ic.type = constant
solid.pressure.ic.constant.value = 1.0
eta.ic.type = constant
eta.ic.constant.value = 0.5
eos0.gamma = 1.4
eos0.p0    = 0.0
eos0.cp = 3.5
eos0.cv = 2.5
mu0 = 2.0e-4
mu0_b = 0.0
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cp = 3.5
eos1.cv = 2.5
mu1 = 2.0e-4
mu1_b = 0.0
density0.ic.type = constant
density0.ic.constant.value = 1.0
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
pressure0.ic.type = constant
pressure0.ic.constant.value = 1.0
density1.ic.type = constant
density1.ic.constant.value = 1.0
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"
pressure1.ic.type = constant
pressure1.ic.constant.value = 1.0
epsilon = 0.1
sigma   = 0.0
Dv      = 0.0
pref    = 0.0
small   = 1e-6
grav    = 0.0
eta_refinement_criterion   = 1e10
omega_refinement_criterion = 1e10
gradu_refinement_criterion = 1e10
p_refinement_criterion = 1e10
rho_refinement_criterion = 1e10
cutoff = 1e-16
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0
apply_surface_tension = 0
apply_weight          = 0
apply_vaporization    = 0
Riemann_Solver.type = hllc
Limiter.type        = minmod
kappa_method        = 1




eta.bc.type.xlo = periodic
eta.bc.type.xhi = periodic
eta.bc.type.ylo = neumann
eta.bc.type.yhi = neumann

density.bc.type.xlo = periodic
density.bc.type.xhi = periodic
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

density0.bc.type.xlo = periodic
density0.bc.type.xhi = periodic
density0.bc.type.ylo = neumann
density0.bc.type.yhi = neumann

density1.bc.type.xlo = periodic
density1.bc.type.xhi = periodic
density1.bc.type.ylo = neumann
density1.bc.type.yhi = neumann

energy.bc.type.xlo = periodic
energy.bc.type.xhi = periodic
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xlo = periodic periodic
momentum.bc.type.xhi = periodic periodic
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann
nghost = 4
thermal.conduction = 0
thermal.Pr = 0.72
ablation.on = 0
ablation.T_wall = 1.0
ablation.rho_s  = 1.0
