alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowSQR_tests/output_Q_202060502
# plot_file = /mmfs1/home/jquinlan/runs/temp5/output_RPE_20260416

### MESHING ###
amr.plot_dt = 0.1e-6
amr.plot_int = 1
amr.max_grid_size = 500000
amr.blocking_factor = 4 # Must be >= nghost so FillBoundary can fill all ghost layers from neighbor valid cells
amr.regrid_int = 1
amr.grid_eff = 0.8
# amr.max_level = 5
# amr.max_level = 3
amr.max_level = 0
# amr.n_cell = 32 32
# amr.n_cell = 256 256
amr.n_cell = 512 512
# amr.n_cell = 1024 1024

### TIME STEPING ###
timestep  = 1e-10
# timestep  = 1e-8
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 1e-0
dynamictimestep.min = 1e-10
cfl = 0.3

### DIMENSIONS ###
geometry.prob_lo = -0.20 -0.20 0.0
geometry.prob_hi =  0.20  0.20 0.0
geometry.is_periodic = 0 0 0

# stop_time = 1e-3
stop_time = 1e-4

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.001
# eta.ic.expression.constant.epsilon = 0.01
eta.ic.expression.constant.R0 = 0.02
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt((x)**2 + (y)**2) - R0)/(sqrt(2)*epsilon)))"
epsilon = eta.ic.expression.constant.epsilon


### HYDRO INITIAL CONDITIONS ###

# ----------------------------
# Tammann EOS (water outer + gas inner)
# ----------------------------

gamma_eta1 = 7.15  # Water (liquid surrounding bubble)
gamma_eta0 = 1.4   # Air/gas (inside bubble)

# ----------------------------
# Density ratio 1 : 10
# ----------------------------

density_eta1.ic.type = expression
density_eta1.ic.expression.region0 = "10.0"

density_eta0.ic.type = expression
density_eta0.ic.expression.region0 = "1.0"

# ----------------------------
# Initial velocities (rest)
# ----------------------------

velocity_eta1.ic.type = expression
velocity_eta1.ic.expression.region0 = "0.0"
velocity_eta1.ic.expression.region1 = "0.0"

velocity_eta0.ic.type = expression
velocity_eta0.ic.expression.region0 = "0.0"
velocity_eta0.ic.expression.region1 = "0.0"

# ----------------------------
# Lowest stable pressure
# ----------------------------

pressure_eta1.ic.type = expression
pressure_eta1.ic.expression.region0 = "1.0e5"

pressure_eta0.ic.type = expression
# pressure_eta0.ic.expression.region0 = "1.0e5+364"
# pressure_eta0.ic.expression.region0 = "1.0e5"
pressure_eta0.ic.expression.region0 = "1.0e6"

# ----------------------------
# Specific Heats
# ----------------------------

cp_eta1 = "1000.0"
cp_eta0 = "1000.0"
cv_eta1 = "1000.0/1.4"
cv_eta0 = "1000.0/1.4"

# ----------------------------
# Stiffened pressure (Tammann EOS pi)
# ----------------------------
pi_eta1 = 3.0e8   # Water Tammann pressure
pi_eta0 = 0.0     # Ideal gas (no Tammann)

# ----------------------------
# Free-energy calibration (Phase 2: dmu_bulk consistency check)
# ----------------------------
# With ch_thermo_consistent = 1 the integrator computes
#   dmu_bulk(x) = f_g(rho_0, T_0) - f_l(rho_1, T_1)
# at every cell, where T_k is recomputed locally from each phase's
# conservatives. At t=0 every cell has the same per-phase state, so
# dmu_bulk is constant in space and we calibrate q_eta1 to make it zero:
#
#   T_0 = p_0 / [(gamma_0 - 1) rho_0 cv_0]                             = 3500 K
#   T_1 = (p_1 + gamma_1 pi_1) / [(gamma_1 - 1) rho_1 cv_1]            = 48832.80 K
#   f_g = cv_0 T_0 (1 - ln(T_0/T_ref)) + R_eta0 T_0 ln(rho_0/rho_ref_eta0)
#       = -3,641,839 J/kg              (rho_ref_eta0 = 1.0  -> ln=0)
#   f_l|q_l=0 = cv_1 T_1 (1 - ln(T_1/T_ref)) + pi_1/rho_1
#       = -112,738,665 J/kg            (rho_ref_eta1 = 10.0 -> ln=0)
#   q_eta1 = f_g - f_l|q_l=0           ~ +1.09097e8 J/kg
#
# Setting rho_ref_eta{0,1} to match the bulk densities zeros out the
# ln(rho/rho_ref) term at IC, keeping the calibration arithmetic clean.

T_ref          = 300.0
rho_ref_eta0   = 1.0
rho_ref_eta1   = 10.0
R_eta0         = 285.714286   # cp - cv = 1000 - 1000/1.4

q_eta0         = 0.0
qprime_eta0    = 0.0
# q_eta1         = 1.09097974e8
# qprime_eta1    = 0.0

# ### FREE-ENERGY CALIBRATION (matches input_stefan_sqr) ###
# # Calibrated for f_g - f_l = 0 at (rho_g_sat, rho_l_sat, T_sat).
# # See input_stefan_sqr for derivation.
# T_ref          = 373.15
# rho_ref_eta0   = 0.5882
# rho_ref_eta1   = 958.4
# R_eta0         = 461.4
# q_eta0         = 0.0
# qprime_eta0    = 0.0
q_eta1         = -3.00017e+06
qprime_eta1    = -5510.35

ch_thermo_consistent = 1

# ----------------------------
# Viscosity
# ----------------------------

mu_eta1 = 0.0
mu_eta1_b = 0.0
mu_eta0 = 0.0
mu_eta0_b = 0.0

# ----------------------------
# Surface tension ON
# ----------------------------

sigma = 7.28

pref = 0.0

### BOUNDARY CONDITIONS ###
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

#momentum.bc.type.xhi = dirichlet dirichlet
#momentum.bc.type.xlo = dirichlet dirichlet
#momentum.bc.type.yhi = dirichlet dirichlet
#momentum.bc.type.ylo = dirichlet dirichlet
#momentum.bc.val.xhi = 0.0 0.0
#momentum.bc.val.xlo = 0.0 0.0

### REFINEMENT CRITERIA ###
eta_refinement_criterion    = 1e-3
omega_refinement_criterion  = 10.55
p_refinement_criterion      = 1e+4
rho_refinement_criterion    = 1e+4
gradu_refinement_criterion  = 1e+4
cutoff = 1e-8

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value = 0.0 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 0
apply_weight = 0
apply_vaporization = 0
Spec_Vol = 1
grav = 0.0

### DEBUGGING / SOLVER ###
# Phase 6: ch_emergent routes m0/u0/q from ComputeEffectiveBSSources into
# ApplyBSSource each step. To compare against the prior "no BS coupling"
# behavior, set this to "off" — m0_eff / u0_eff / q_eff are still computed
# and plotted as diagnostics but not consumed by ApplyBSSource.
sqr_source_mode      = ch_emergent
p_int_method        = 2     # 0: Off, 1: pressure average, 2: eta weighted pressure. 3: acoustic impedance matched pressure
Riemann_Solver.type = hllc
kappa_method        = 1
smooth_kernel_size  = 3
nghost              = 4
integration.type    = ForwardEuler

# Implicit CH active (Phase 4 will wire dmu_bulk into f'(eta) here).
implicit_ch     = 2
# Phase 4 mobility (spec §1.7): the new ch_mobility_scaling param controls
# how ch_mobility_nom is interpreted.
#   "magaletti"  -> M_eff = ch_mobility_nom * epsilon^2  (default; matched-asymptotic)
#                   With epsilon = 5e-6, factor = 2.5e-11, so for M_eff ~ 1e-4
#                   you would need ch_mobility_nom ~ 4e6.
#   "allen_cahn" -> M_eff = ch_mobility_nom * epsilon
#   "explicit"   -> M_eff = ch_mobility_nom directly  (used here for clarity).
ch_mobility_scaling = magaletti
ch_newton_iters     = 5
ch_newton_tol       = 1e-10

# CH equilibrium-width relation (well-balanced Korteweg + Q-trace path).
# For IC eta(x) = 0.5*(1 + tanh(arg/(sqrt(2)*epsilon))) with W = eta^2*(1-eta)^2,
# CH equilibrium kappa nabla^2 eta = lambda W'(eta) reduces to:
#   lambda = kappa / epsilon^2
# For epsilon = 1e-3:
#   lambda = 4e-4 / 1e-6 = 400  (with kappa = 4e-4)
# Implied surface tension sigma = sqrt(2*kappa*lambda)/6 ~ 0.094 N/m.
#
# (Earlier value lambda = 2e6 was carried over from a thermo-consistent
#  spinodal-margin tuning that does NOT apply here once q_eta1 has been
#  swapped from the calibration constant +1.09e8 to the Clausius-Clapeyron
#  value -3e6 below. With the new Korteweg path applied unconditionally
#  in RHS_PerPhase, lambda far above kappa/epsilon^2 leaves the IC tanh
#  far from CH equilibrium and produces large transient forces; matching
#  the equilibrium width recovers the quiescent behavior this test wants.)
ch_W_scale          = 400        # lambda = kappa / epsilon^2
ch_kappa            = 4.0e-4     # = lambda * epsilon^2  (consistent)
ch_mobility_degenerate = 1
# Phase 6 calibration (2026-04-28): with thermo_consistent=1 + ch_emergent
# routing, the Magaletti baseline M_nom=1 gave m0_eff ~1800x the analytical
# Stefan flux (0.17 kg/m^2/s), driving ApplyBSSource so hard the system
# went NaN by step 16. Lowered to 1e-3 to bring CH-derived rate near the
# heat-conduction-limited Stefan rate. Tune up/down based on observed
# m0_eff_max vs analytical m0(t) = rho_g * beta * sqrt(alpha/(t+t_off)).
ch_mobility_nom        = 0

nscbc.enabled   = true
  nscbc.sigma     = 0.28   # 0.28 is a good value for shock-droplet with gamma=1.4, but may need tuning for other problems. Higher sigma means more dissipation added by NSCBC, which can help stabilize but also adds more error.
  nscbc.beta      = 1.0    # Lodato (2008) recommended: 0 = full transverse, 1 = pure LODI
  # NOTE: beta=0.0 (full transverse) is unstable for Tammann water because the T1/T4 terms
  # scale as rho*a (~1.47e5 for water vs ~430 for air), amplifying tiny velocity gradients
  # from the bubble's incompressible velocity field into large L-wave corrections that
  # corrupt boundary ghost cells over ~15 timesteps. Use beta=1.0 (pure LODI) for stiffened
  # EOS or any case where rho*a >> 1. The Lodato transverse terms require separate
  # normalization by rho*a to be stable for high-impedance fluids.
  nscbc.xlo       = outflow
  nscbc.xlo.p_target = 1.0e5   # Pa
  nscbc.xhi       = outflow
  nscbc.xhi.p_target = 1.0e5   # Pa
  nscbc.ylo       = outflow
  nscbc.ylo.p_target = 1.0e5   # Pa
  nscbc.yhi       = outflow
  nscbc.yhi.p_target = 1.0e5   # Pa
