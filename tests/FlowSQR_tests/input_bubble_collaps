#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

### Rayleigh-Plesset equation test case


alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowSQR_tests/output_RPE
# plot_file = /mmfs1/home/jquinlan/runs/temp5/output_RPE_20260502

### MESHING ###
amr.plot_dt = 0.25e-6
# amr.plot_int = 1
amr.max_grid_size = 500000
amr.blocking_factor = 4 # Must be >= nghost so FillBoundary can fill all ghost layers from neighbor valid cells
amr.regrid_int = 1
amr.grid_eff = 0.8
amr.max_level = 5
# amr.max_level = 6
# amr.max_level = 7
amr.n_cell = 32 32
# amr.n_cell = 256 256
# amr.n_cell = 1024 1024

### TIME STEPING ###
timestep  = 5e-10
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 1e-0
dynamictimestep.min = 1e-10
# cfl = 0.05
cfl = 0.3

### DIMENSIONS ###
geometry.prob_lo = -0.20 -0.20 0.0
geometry.prob_hi =  0.20  0.20 0.0
geometry.is_periodic = 0 0 0

# stop_time = 1e-4   # captures ~50% of Rayleigh collapse
stop_time = 2e-4     # captures collapse + start of rebound
# stop_time = 1e-7

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.001      # used with 5 levels of AMR
# eta.ic.expression.constant.epsilon = 0.0005     # used with 6 levels of AMR
# eta.ic.expression.constant.epsilon = 0.00025    # used with 7 levels of AMR
eta.ic.expression.constant.R0 = 0.02
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt((x)**2 + (y)**2) - R0)/(sqrt(2)*epsilon)))"
epsilon = eta.ic.expression.constant.epsilon


### HYDRO INITIAL CONDITIONS ###

# ----------------------------
# Tammann EOS (water outer + gas inner)
# ----------------------------

gamma_1 = 7.15  # Water (liquid surrounding bubble)
gamma_0 = 1.4   # Air/gas (inside bubble)

# ----------------------------
# Density (water 1000 kg/m³; gas from ideal gas law at p₀=100000 Pa, T=290 K)
# ----------------------------

density_1.ic.type = expression
density_1.ic.expression.region0 = "1000.0"

density_0.ic.type = expression
density_0.ic.expression.region0 = "1.207"

# ----------------------------
# Initial velocities (rest)
# ----------------------------

velocity_1.ic.type = expression
velocity_1.ic.expression.region0 = "0.0"
velocity_1.ic.expression.region1 = "0.0"

velocity_0.ic.type = expression
velocity_0.ic.expression.region0 = "0.0"
velocity_0.ic.expression.region1 = "0.0"

# ----------------------------
# Initial pressures
# ----------------------------
# Temperature check (thermal: T = (UE - π)/(ρ cv) = (p + π)/((γ-1) ρ cv)):
#   T_0 = p_0 / ((γ_0-1) ρ_0 cv_0)        = 100 / (0.4 × 0.001207 × 714.3)   ≈ 290
#   T_1 = (p_1+π_1)/((γ_1-1) ρ_1 cv_1)    = 3.001e8 / (6.15 × 10 × 16827)    ≈ 290
# Both phases at ~290 K: S3 energy relaxation (E_vel > 0) is safe.
# Rayleigh collapse time: t_c ≈ 0.915 R_0 sqrt(ρ_1/(p_1-p_0)) ≈ 1.9e-4 s.

pressure_1.ic.type = expression
pressure_1.ic.expression.region0 = "1.0e5"

pressure_0.ic.type = expression
pressure_0.ic.expression.region0 = "1.0e2"

# ----------------------------
# Specific Heats (γ = cp/cv, so cv = cp/γ)
# ----------------------------

cp_1 = "120315.0"       # = gamma_1 * cv_1 (calibrated for T_1 ≈ 290 K)
cp_0 = "1000.0"
cv_1 = "16827.0"        # = (p_1+pi_1)/((gamma_1-1)*rho_1*290) ≈ 16827
cv_0 = "1000.0/1.4"     # = cp_0/gamma_0

# ----------------------------
# Stiffened pressure (Tammann EOS pi)
# ----------------------------
pi_1 = 3.0e8   # Water Tammann pressure
pi_0 = 0.0     # Ideal gas (no Tammann)

# ----------------------------
# Viscosity
# ----------------------------

mu_1 = 0.0
mu_1_b = 0.0
mu_0 = 0.0
mu_0_b = 0.0

# ----------------------------
# Surface tension ON
# ----------------------------

sigma = 7.28

pref = 0.0

### BOUNDARY CONDITIONS ###
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

# momentum.bc.type.xhi = neumann neumann
# momentum.bc.type.xlo = neumann neumann
# momentum.bc.type.ylo = neumann neumann
# momentum.bc.type.yhi = neumann neumann

momentum.bc.type.xhi = dirichlet dirichlet
momentum.bc.type.xlo = dirichlet dirichlet
momentum.bc.type.yhi = dirichlet dirichlet
momentum.bc.type.ylo = dirichlet dirichlet
momentum.bc.val.xhi = 0.0 0.0
momentum.bc.val.xlo = 0.0 0.0

### REFINEMENT CRITERIA ###
eta_refinement_criterion    = 1e-3
omega_refinement_criterion  = 1e10
p_refinement_criterion      = 1e+4
rho_refinement_criterion    = 1e+4
gradu_refinement_criterion  = 1e+4
cutoff = 1e-8

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value = 0.0 0.0

### ADDITIONAL SOURCES ###
# Phase 6: ch_emergent routes m0/u0/q from ComputeEffectiveBSSources into
# ApplyBSSource each step. To compare against the prior "no BS coupling"
# behavior, set this to "off" — m0_eff / u0_eff / q_eff are still computed
# and plotted as diagnostics but not consumed by ApplyBSSource.
sqr_source_mode      = ch_emergent
# sqr_source_mode = prescribed
# sqr_source_mode      = off
apply_surface_tension = 1
apply_weight = 0
apply_vaporization = 0

# --- S3 closure framework (replaces legacy p_int_method) ---
sqr_legacy_p_int_method = 0    # 0 = new closure-strategy framework (REQUIRED for S2/S3)
# p_int_method = 4             # legacy (superseded)

# Normal velocity (S3): pressure equilibrium baseline (p₀-p₁)∇η compensates
# HLLC nozzling; J_un drives the kinematic constraint u_n,0 → u_n,1.
# v_un sizing: explicit stability needs v_un × dt × |∇η|_max < 1.
#   ε = 5e-4, |∇η|_max ≈ 1/(2√2 ε) = 707 (tanh with √2 argument).
#   a_1 = √(γ_1(p_1+π_1)/ρ_1) ≈ 14,650 m/s (stiffened water).
#   dt_CFL ≈ 0.3 dx_fine/a_1 ≈ 4e-9 s (dx_fine ≈ 1.95e-4 m at level 6).
#   v_un = 0.1/(dt×|∇η|_max) ≈ 35,400 → use 15,000 (≈ a_1, stiff penalty).
closure.un_strategy    = relax
closure.un_vel         = 15000.0   # [m/s]; τ_loc ~ 1/(v_un×|∇η|) ~ 9.4e-8 s

# Energy (S3): pressure-work baseline (p₀u₀-p₁u₁)·∇η is active (nozzling
# compensation); J_E temperature relaxation drives T₀ → T₁.
# With thermal T convention and calibrated cv, T₀ ≈ T₁ ≈ 290 K at IC,
# so energy relaxation is safe.  Scale E_vel like v_un for stiff coupling.
closure.E_strategy     = relax
closure.E_vel          = 15000.0   # [m/s]; thermal T relaxation active (T₀ ≈ T₁ ≈ 290 K)

# Tangential velocity: inviscid → no tangential coupling.
closure.ut_strategy    = constitutive

# Interface-average methods (only used by Constitutive strategy; inert under S3):
closure.un_pint_method = 4
closure.E_pint_method  = 4

Spec_Vol = 1
grav = 0.0

## DEBUGGING ###
Riemann_Solver.type = hllc
kappa_method = 1   # 1:"Smooth Normals" (default)  2:"Height Function"  3:"Hybrid (HF+SN blend)"
smooth_kernel_size = 5  # Gaussian normal smoothing kernel: 3 (3x3, default) or 5 (5x5)
nghost = 4             # Ghost cell depth (= N_int for HF band). Requires amr.blocking_factor >= nghost.
integration.type = ForwardEuler
# integration.type = RungeKutta

# implicit_ch = 1
# ch_mobility_nom = 0.032   # optional: override auto M = 2*ε*c_max
# ch_mobility_nom = 1e-4  # seems to need to be smaller
# implicit_ch = 0 # solves CH rhs explicitly (faster but dx^4 reduction in timestep needed, so only on course grids)
implicit_ch = 2
  ch_mobility_nom = 10.0
#   ch_mobility_nom = 0
  ch_newton_iters = 5       # default, usually converges in 3
  ch_newton_tol = 1e-10     # default
  # CH equilibrium-width relation (well-balanced Korteweg + Q-trace path).
  # IC eta = 0.5*(1 + tanh((r - R0)/(sqrt(2)*epsilon))) with W = eta^2*(1-eta)^2
  # ==> equilibrium needs   lambda = kappa / epsilon^2
  # ch_kappa default = epsilon^2 (auto when ch_kappa = 0).
  # With epsilon = 1e-3 ⇒ kappa = 1e-6,  lambda must be 1.0 to match.
  # Implied sigma = sqrt(2*kappa*lambda)/6 ~ 2.4e-4 N/m (the legacy `sigma`
  # knob set above is informational only — Brackbill is muted.)
  ch_W_scale = 1.0          # lambda = kappa / epsilon^2  (matches equilibrium)
  ch_mobility_degenerate = 0  # 0: mobility applies everwhere, 1: mobility only effects the solution in the interface

# nscbc.enabled   = true
nscbc.enabled   = false
  nscbc.sigma     = 0.28   # 0.28 is a good value for shock-droplet with gamma=1.4, but may need tuning for other problems. Higher sigma means more dissipation added by NSCBC, which can help stabilize but also adds more error.
  nscbc.beta      = 1.0    # Lodato (2008) recommended: 0 = full transverse, 1 = pure LODI
  # NOTE: beta=0.0 (full transverse) is unstable for Tammann water because the T1/T4 terms
  # scale as rho*a (~1.47e5 for water vs ~430 for air), amplifying tiny velocity gradients
  # from the bubble's incompressible velocity field into large L-wave corrections that
  # corrupt boundary ghost cells over ~15 timesteps. Use beta=1.0 (pure LODI) for stiffened
  # EOS or any case where rho*a >> 1. The Lodato transverse terms require separate
  # normalization by rho*a to be stable for high-impedance fluids.
  nscbc.xlo       = outflow
  nscbc.xlo.p_target = 1.0e5   # Pa
  nscbc.xhi       = outflow
  nscbc.xhi.p_target = 1.0e5   # Pa
  nscbc.ylo       = outflow
  nscbc.ylo.p_target = 1.0e5   # Pa
  nscbc.yhi       = outflow
  nscbc.yhi.p_target = 1.0e5   # Pa
