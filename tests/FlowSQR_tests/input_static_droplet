#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

# Well-balanced Korteweg + Q-trace static-droplet test.
#
# A circular liquid droplet in a quiescent gas atmosphere should sit in
# mechanical equilibrium with the Laplace pressure jump Δp = σ/R = 144 Pa
# (for σ = 0.072 N/m, R = 0.5 mm). The flux-form Korteweg stress in the
# new HLLC path:
#   Σ_K_wb = -κ ∇η⊗∇η + (κη∇²η + (κ/2)|∇η|²)I − Q(η)·I
#   Q(η)   = λ·η²·(3η−1)·(η−1)         (well-balanced trace correction)
# evaluates Σ_K on faces, with ∇²η from a 9-point isotropic cell
# Laplacian averaged to faces (4th-order accurate; suppresses the C4
# grid-aligned anisotropy that the 5-point stencil injects on circular
# interfaces). At static CH equilibrium of η (which is what the IC tanh
# is, by construction below), the Korteweg flux divergence cancels Q's
# trace gradient identically, so spurious parasitic currents are at
# truncation only.
#
# Surface tension is set by the CH parameters κ, λ via
#   σ_implied = √(2κλ)/6
# rather than by the legacy `sigma` knob (which used to drive the now-
# deleted Brackbill block). Choose κ, λ to satisfy BOTH:
#   1. CH equilibrium for the IC tanh form 0.5*(1 − tanh(r/(√2·ε))):
#      λ = κ/ε²
#   2. Required σ_implied = 0.072 N/m:
#      κ·λ = (6σ)²/2 = 0.0933
# Solving simultaneously: κ = √(0.0933·ε²) = 1.222e-5,  λ = 7637.5.
#
# Pass criteria:
#   max|u| stays at truncation level over the run
#   Δp = σ/R = 144 Pa inside the droplet, matches analytical Laplace
#
# The CH solver is silenced (implicit_ch = 0, static_eta = 1,
# ch_mobility_nom = 0, ch_thermo_consistent = 0) so η is held at the
# IC tanh and the test isolates the Korteweg + Q discretization.

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowSQR_tests/output_static_droplet

### MESHING ###
amr.plot_dt = 5.0e-7
# amr.plot_int = 1
amr.max_grid_size = 500000
amr.blocking_factor = 4
amr.regrid_int = 1
amr.grid_eff = 0.8
amr.max_level = 0
amr.n_cell = 200 200
# amr.n_cell = 400 400

### TIME STEPING ###
timestep = 1.0e-9
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 5.0e-8
dynamictimestep.min = 1.0e-12
cfl = 0.3

### DIMENSIONS ###
geometry.prob_lo = -1.0e-3 -1.0e-3 0.0
geometry.prob_hi =  1.0e-3  1.0e-3 0.0
geometry.is_periodic = 0 0 0

stop_time = 1.0e-5

### ETA INITIAL CONDITIONS ###
# Circular droplet of radius R0 centered at origin. eta=1 inside (liquid),
# eta=0 outside (gas). dx = 2 mm / 200 = 1e-5 m, so epsilon = 4*dx = 4e-5 m
# resolves the diffuse interface across ~6-8 cells.
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 4.0e-5
eta.ic.expression.constant.R0 = 5.0e-4
eta.ic.expression.region0 = "0.5*(1 - tanh((sqrt(x**2 + y**2) - R0)/(sqrt(2)*epsilon)))"
epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###

# ----------------------------
# Water (liquid, eta=1) + air (gas, eta=0)
# ----------------------------
gamma_eta1 = 7.15
gamma_eta0 = 1.4

density_eta1.ic.type = expression
density_eta1.ic.expression.region0 = "1000.0"

density_eta0.ic.type = expression
density_eta0.ic.expression.region0 = "1.225"

# Initial velocity zero everywhere — any growth comes from the discretization
velocity_eta1.ic.type = expression
velocity_eta1.ic.expression.region0 = "0.0"
velocity_eta1.ic.expression.region1 = "0.0"

velocity_eta0.ic.type = expression
velocity_eta0.ic.expression.region0 = "0.0"
velocity_eta0.ic.expression.region1 = "0.0"

# Flat IC pressure on both phases. The well-balanced Korteweg+Q path
# delivers the Laplace jump Δp = σ/R = 144 Pa as an EMERGENT steady
# state — presetting the jump in the IC stacks on top of the
# formulation's contribution and gives ~2σ/R.
pressure_eta1.ic.type = expression
pressure_eta1.ic.expression.region0 = "1.01325e5"

pressure_eta0.ic.type = expression
pressure_eta0.ic.expression.region0 = "1.01325e5"

# Specific heats (water/air canonical)
cp_eta1 = 4180.0
cp_eta0 = 1005.0
cv_eta1 = 4180.0/7.15
cv_eta0 = 1005.0/1.4

# Tammann stiffened-gas pressure for water; ideal gas has pi=0
pi_eta1 = 3.0e8
pi_eta0 = 0.0

# Free-energy parameters: silenced (ch_thermo_consistent = 0). The CH
# bulk EOS contribution is muted, leaving the standard double-well
# only — keeps mu_chem_mf consistent with the Korteweg discretization.
T_ref          = 300.0
rho_ref_eta0   = 1.225
rho_ref_eta1   = 1000.0
R_eta0         = 287.0
q_eta0         = 0.0
qprime_eta0    = 0.0
q_eta1         = 0.0
qprime_eta1    = 0.0

ch_thermo_consistent = 0

# No viscosity — isolate the capillary force
mu_eta1   = 0.0
mu_eta1_b = 0.0
mu_eta0   = 0.0
mu_eta0_b = 0.0

# ----------------------------
# Surface tension: water-air at 20°C, sigma = 0.072 N/m.
# Laplace pressure Δp = sigma/R = 0.072 / 0.5e-3 = 144 Pa.
# NOTE: the `sigma` knob is informational only — the legacy Brackbill
# block that consumed it has been muted. Actual surface tension is set
# by ch_kappa, ch_W_scale below via σ_implied = √(2κλ)/6.
# ----------------------------
sigma = 0.072

pref = 0.0

### BOUNDARY CONDITIONS ###
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

### REFINEMENT CRITERIA ###
eta_refinement_criterion    = 1.0e-3
omega_refinement_criterion  = 1.0e10
p_refinement_criterion      = 1.0e10
rho_refinement_criterion    = 1.0e10
gradu_refinement_criterion  = 1.0e10
cutoff = 1.0e-8

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

### ADDITIONAL SOURCES ###
# apply_surface_tension is now informational — the legacy Brackbill
# block in ApplyBSSource has been permanently muted (do_st = 0).
# Surface tension is delivered by the flux-form Korteweg + Q-trace
# path inside RHS_PerPhase, gated only by the CH parameters
# (ch_kappa, ch_W_scale).
apply_surface_tension = 1
apply_weight          = 0
apply_vaporization    = 0
apply_heat_conduction = 0
Spec_Vol              = 1
grav                  = 0.0

# BS source mode (Phase 6): "off" | "prescribed" | "ch_emergent".
# For the static droplet ic_m0/ic_q are zero so the source is silent
# anyway; "off" makes that explicit.
bs_source_mode = off
p_int_method    = 0

Riemann_Solver.type = hllc
kappa_method        = 1
smooth_kernel_size  = 5
nghost              = 4
integration.type    = ForwardEuler

# CH solver silenced; eta is only advected. Static-droplet equilibrium
# is set by the IC tanh and held there.
implicit_ch     = 0
static_eta      = 1
ch_mobility_nom = 0.0

# CH gradient-energy + double-well, sized for σ_implied = √(2κλ)/6 = 0.072
# AND CH equilibrium for IC eta(r) = 0.5*(1 − tanh((r−R0)/(√2·ε))) with
# W = η²(1−η)²:
#   λ = κ/ε²              (equilibrium for tanh(r/(√2·ε)) form)
#   κ·λ = (6σ)²/2 = 0.0933 (target Laplace σ)
# ⇒ κ = √(0.0933·ε²) = 1.222e-5,  λ = κ/ε² = 7637.5
ch_W_scale      = 7637.5      # lambda
ch_kappa        = 1.222e-5    # kappa  (= lambda * epsilon^2)

nscbc.enabled = false
