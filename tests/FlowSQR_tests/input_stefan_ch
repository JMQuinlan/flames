#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

# =============================================================================
#  Stefan problem — CH-emergent mode (Phase 6: BS-bridge validation)
# =============================================================================
#  Same geometry, EOS, and free-energy calibration as input_stefan_sqr, but:
#    - bs_source_mode = ch_emergent
#    - ch_thermo_consistent = 1
#    - implicit_ch = 2     (Newton-MLMG CH solver active)
#
#  In ch_emergent mode the BS source fields m0/u0/q are overwritten each step
#  by the CH-derived effective values (m0_eff, u0_eff, q_eff) populated in
#  Hydro2::ComputeEffectiveBSSources. The same ApplyBSSource consumes them,
#  so phase change feeds back into per-phase mass / momentum / energy via the
#  existing source-term machinery — no parallel coupling path. Driver of
#  motion is the EOS-derived dmu_bulk = f_g(rho_0,T_0) - f_l(rho_1,T_1) inside
#  the CH solver (Phase 4) plus the CH flux divergence going into m0_eff.
#
#  Both m0 (prescribed slot) and m0_eff (CH diagnostic) are visible in the
#  plotfile for offline comparison against the analytical Stefan flux
#    m0_analytic(t) = rho_g * beta * sqrt(alpha_g / (t + t_off))
#  Use stefan_postprocess.py to compare X(t) trajectories.
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowSQR_tests/output_stefan_ch

### MESHING ###
amr.plot_dt        = 5e-7
amr.plot_int = 1
amr.max_grid_size  = 500000
amr.blocking_factor = 4
amr.regrid_int     = 1
amr.grid_eff       = 0.8
amr.max_level      = 0
amr.n_cell         = 400 8
# amr.n_cell         = 200 4

### TIME STEPING ###
timestep                = 1e-10
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 1e-8
dynamictimestep.min     = 1e-11
cfl                     = 0.3

### DIMENSIONS ###
geometry.prob_lo     = 0.0     0.0     0.0
geometry.prob_hi     = 1.0e-3  2.0e-5  0.0
geometry.is_periodic = 0       1       0

stop_time = 1e-4

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 1.0e-5      # 4*dx; 4-cell interface for CH stability
eta.ic.expression.constant.x_int0  = 9.097e-4   # matches input_stefan_sqr
eta.ic.expression.region0 = "0.5*(1 - tanh((x - x_int0)/(sqrt(2)*epsilon)))"
epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###
density_eta1.ic.type = expression
density_eta1.ic.expression.region0 = "958.4"

density_eta0.ic.type = expression
density_eta0.ic.expression.region0 = "0.5882"

velocity_eta1.ic.type = expression
velocity_eta1.ic.expression.region0 = "0.0"
velocity_eta1.ic.expression.region1 = "0.0"
velocity_eta0.ic.type = expression
velocity_eta0.ic.expression.region0 = "0.0"
velocity_eta0.ic.expression.region1 = "0.0"

pressure_eta1.ic.type = expression
pressure_eta1.ic.expression.region0 = "101325.0"
pressure_eta0.ic.type = expression
pressure_eta0.ic.expression.region0 = "101325.0"

### EOS / SPECIFIC HEATS ###
gamma_eta1 = 2.35
gamma_eta0 = 1.327
cv_eta1 = "1816.0"
cv_eta0 = "1411.0"
cp_eta1 = "4267.6"
cp_eta0 = "1872.4"
pi_eta1 = 3.7313e8
pi_eta0 = 0.0

mu_eta1 = 0.0
mu_eta1_b = 0.0
mu_eta0 = 0.0
mu_eta0_b = 0.0

sigma = 0.0
pref  = 0.0

### FREE-ENERGY CALIBRATION (matches input_stefan_sqr) ###
# Calibrated for f_g - f_l = 0 at (rho_g_sat, rho_l_sat, T_sat).
# See input_stefan_sqr for derivation.
T_ref          = 373.15
rho_ref_eta0   = 0.5882
rho_ref_eta1   = 958.4
R_eta0         = 461.4
q_eta0         = 0.0
qprime_eta0    = 0.0
q_eta1         = -3.00017e+06
qprime_eta1    = -5510.35

# CH-emergent mode flags
ch_thermo_consistent = 1

### BOUNDARY CONDITIONS ###
# Same per-phase split as input_stefan_sqr — see that file for derivation.

# Mixture energy.bc — all-Neumann (legacy fall-through).
energy.bc.type.xlo = neumann
energy.bc.type.xhi = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

# Per-phase energy_eta0 (gas): heat in at xhi.
energy_eta0.bc.type.xlo = neumann
energy_eta0.bc.type.xhi = dirichlet
energy_eta0.bc.val.xhi  = 351200.0
energy_eta0.bc.type.ylo = neumann
energy_eta0.bc.type.yhi = neumann

# Per-phase energy_eta1 (liquid spectator near gas wall): all-Neumann.
energy_eta1.bc.type.xlo = neumann
energy_eta1.bc.type.xhi = neumann
energy_eta1.bc.type.ylo = neumann
energy_eta1.bc.type.yhi = neumann

density.bc.type.xlo = neumann
density.bc.type.xhi = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

# Per-phase density BC workaround for fixed-UE Dirichlet at the heated wall.
# With energy_eta0.bc Dirichlet UE = ρ·cv·T_wall at xhi, T = UE/(ρ·cv) is only
# correct as long as ρ_0 stays at ρ_ref. Without pinning ρ_0, the gas rarefies
# at the wall (closed momentum BC + heating) and T runs away (visit0174.png
# showed T ≈ 860 K at xhi, ρ_0 ≈ 0.28 kg/m³, vs intended 423 K / 0.5882).
# Pinning ρ_0 at xhi to its IC value enforces the intended T as a workaround.
# Spectator ρ_1 stays Neumann so dmu_bulk's f_l(ρ_1, T_1) isn't poisoned.
# Proper fix (deferred): a Dirichlet-T BC type that computes UE_ghost from the
# live interior ρ_0 each fill. Tracked in HYDRO2_..._post_phase_4.md §4.5.
density_eta0.bc.type.xlo = neumann
density_eta0.bc.type.xhi = dirichlet
density_eta0.bc.val.xhi  = 0.5882
density_eta0.bc.type.ylo = neumann
density_eta0.bc.type.yhi = neumann

density_eta1.bc.type.xlo = neumann
density_eta1.bc.type.xhi = neumann
density_eta1.bc.type.ylo = neumann
density_eta1.bc.type.yhi = neumann

momentum.bc.type.xlo = dirichlet dirichlet
momentum.bc.val.xlo  = 0.0 0.0
momentum.bc.type.xhi = dirichlet dirichlet
momentum.bc.val.xhi  = 0.0 0.0
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

### REFINEMENT CRITERIA ###
eta_refinement_criterion   = 1e-3
omega_refinement_criterion = 1e+6
p_refinement_criterion     = 1e+6
rho_refinement_criterion   = 1e+6
gradu_refinement_criterion = 1e+6
cutoff = 1e-8

### SOURCE TERMS ###
# In bs_source_mode = ch_emergent these IC values are immediately overwritten
# at the start of every Advance step by ParallelCopy of m0_eff / u0_eff /
# q_eff from ComputeEffectiveBSSources. The IC values below are placeholders
# that only matter for step 0 (before the first ComputeEffectiveBSSources
# fires inside Initialize -> MixDiagnostic; they're zeroed there anyway).
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0
bs_sources_time_dependent = 0   # ignored in ch_emergent mode

### ADDITIONAL SOURCES ###
apply_surface_tension = 0
apply_weight          = 0
apply_vaporization    = 0
apply_viscous         = 0
apply_heat_conduction = 1
k_eta0 = 1.0          # match input_stefan_sqr
k_eta1 = 1.0
Spec_Vol = 1
grav     = 0.0

### DEBUGGING / SOLVER ###
# Phase 6: ch_emergent routes m0/u0/q from ComputeEffectiveBSSources into
# ApplyBSSource each step. To compare against the prior "no BS coupling"
# behavior, set this to "off" — m0_eff / u0_eff / q_eff are still computed
# and plotted as diagnostics but not consumed by ApplyBSSource.
bs_source_mode      = ch_emergent
p_int_method        = 2     # 0: Off, 1: pressure average, 2: eta weighted pressure. 3: acoustic impedance matched pressure
Riemann_Solver.type = hllc
kappa_method        = 1
smooth_kernel_size  = 3
nghost              = 4
integration.type    = ForwardEuler

# Implicit CH active (Phase 4 will wire dmu_bulk into f'(eta) here).
implicit_ch     = 2
# Phase 4 mobility (spec §1.7): the new ch_mobility_scaling param controls
# how ch_mobility_nom is interpreted.
#   "magaletti"  -> M_eff = ch_mobility_nom * epsilon^2  (default; matched-asymptotic)
#                   With epsilon = 5e-6, factor = 2.5e-11, so for M_eff ~ 1e-4
#                   you would need ch_mobility_nom ~ 4e6.
#   "allen_cahn" -> M_eff = ch_mobility_nom * epsilon
#   "explicit"   -> M_eff = ch_mobility_nom directly  (used here for clarity).
ch_mobility_scaling = magaletti
ch_newton_iters     = 5
ch_newton_tol       = 1e-10

# Spinodal-margin rescaling.  With Clausius-Clapeyron-calibrated (q,q'),
# |dmu_bulk| at 50 K superheat is ~4e5 J/kg.  CH theory needs |dmu|/lambda
# < 0.385 (spec §1.10), so lambda must be >= ~1.3e6.  Choose lambda = 2e6
# to leave headroom.  Then keep delta = epsilon (=4*dx) by setting
# kappa = 2*epsilon^2*lambda = 4e-4 (decoupled from the legacy kappa=eps^2).
# Implied surface tension sigma = sqrt(2*kappa*lambda)/6 ~ 6.7 N/m -- about
# 100x water's, but sigma is a spectator parameter for a planar Stefan
# problem (no curvature), so this is fine.  Document and move on.
ch_W_scale          = 2.0e6      # lambda
ch_kappa            = 4.0e-4     # = 2 * epsilon^2 * lambda
ch_mobility_degenerate = 1
# Phase 6 calibration (2026-04-28): with thermo_consistent=1 + ch_emergent
# routing, the Magaletti baseline M_nom=1 gave m0_eff ~1800x the analytical
# Stefan flux (0.17 kg/m^2/s), driving ApplyBSSource so hard the system
# went NaN by step 16. Lowered to 1e-3 to bring CH-derived rate near the
# heat-conduction-limited Stefan rate. Tune up/down based on observed
# m0_eff_max vs analytical m0(t) = rho_g * beta * sqrt(alpha/(t+t_off)).
ch_mobility_nom        = 10.e-1

nscbc.enabled = false
