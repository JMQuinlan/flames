#@ [case1]
#@ exe=hydro2
#@ dim=2

# 1-D acoustic wave in air impinging on a normal air/water interface.
# Purpose: verify the acoustic impedance mismatch (pressure-velocity coupling)
# at the diffuse interface — i.e. that the simulated reflection / transmission
# coefficients match the analytical 1-D plane-wave values.
#
# Phases (SI units), in thermal AND pressure equilibrium at T0 = 287 K, p0 = 101325 Pa.
# Densities are chosen so each EOS inverts (p0, rho_k) -> T0 = 287 K, removing the
# IC ΔT that would otherwise drive an immediate energy-relax flux at the interface.
#   eta=0  air   (CPG, R = cp - cv = 287):
#                  rho_a = p / (R*T)        = 101325/(287*287)        ~ 1.2301351 kg/m^3
#                  c_air  = sqrt(gamma*R*T) = 287*sqrt(1.4)            ~ 339.58298 m/s
#                  Z_air  = rho*c                                      ~ 417.7  kg/(m^2 s)
#   eta=1  water (Tammann/stiffened gas, gamma=5.5, pi=6.0e8 Pa, cv=4180):
#                  Convention B inversion: p + gamma*pi = (gamma-1)*rho*cv*T
#                  rho_w = (p + gamma*pi) / ((gamma-1)*cv*T)
#                        = (101325 + 5.5*6e8)/(4.5*4180*287)           ~ 611.30308 kg/m^3
#                  c_water = sqrt(gamma*(p+pi)/rho)                    ~ 2323.7 m/s
#                  Z_water = rho*c                                     ~ 1.421e6 kg/(m^2 s)
#   (Note: rho_w = 611 kg/m^3 isn't physical liquid water, but the test only needs
#    internal consistency between IC and EOS. The impedance ratio Z_w/Z_a ~ 3400
#    is still huge, so the acoustic-mismatch physics is unchanged.)
#
# Analytical plane-wave reflection / transmission across the interface
# (right-traveling pulse in air hitting water):
#   R_p =  (Z_w - Z_a) / (Z_w + Z_a)  ~  +0.999413   (pressure reflection)
#   T_p =   2 Z_w      / (Z_w + Z_a)  ~  +1.999413   (pressure transmission)
#   R_u = -(Z_w - Z_a) / (Z_w + Z_a)  ~  -0.999413   (velocity reflection — sign flips)
#   T_u =   2 Z_a      / (Z_w + Z_a)  ~  +5.879e-4   (velocity transmission — small)
#
# The high impedance ratio (~4360) means almost the entire pulse should reflect
# back into the air with the same pressure sign; the water sees essentially
# zero motion but ~2x pressure amplitude in the (small) transmitted wave.

### OUTPUT ###
plot_file   = ./tests/FlowSQR_tests/output_acoustic_1d
amr.plot_dt = 1.0e-4
# amr.plot_int = 1

### MESHING ###
amr.max_level      = 0
amr.max_grid_size  = 500000
amr.blocking_factor = 4
amr.grid_eff       = 0.8
# amr.n_cell         = 512 8
amr.n_cell         = 1024 16

### DIMENSIONS ###
# 2-m-wide channel in x; very thin in y (periodic) so the run is effectively 1-D.
geometry.prob_lo     = -1.0  -0.015625  0.0   # [ m ]
geometry.prob_hi     =  1.0   0.015625  0.0   # [ m ]
geometry.is_periodic =  0     1         0

### TIME STEP ###
# dx = 2.0/1024 ~ 1.95e-3 m;  c_max = c_water ~ 1817 m/s
# CFL=0.4  =>  dt_max ~ 4.3e-7 s
# Pulse travel time x0=-0.5  ->  x=0  is 0.5/340  ~ 1.47 ms.
# Stopping at 2.0 ms gives ~0.5 ms after the strike: reflected wave is at
# x ~ -0.18 m (still well inside the air domain, away from xlo).
timestep  = 1.0e-7
stop_time = 2.0e-3
cfl       = 0.4

### Sources ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0
q.ic.type            = constant
q.ic.constant.value  = 0.0

### HYDRO PARAM ###
# Diffuse interface eta(x) = 0.5*(1 + tanh(x/epsilon)).
# epsilon = 0.01 m  =>  ~5 cells across the interface for the chosen mesh.
eta.ic.type                            = expression
eta.ic.expression.constant.epsilon     = 1.0e-2
eta.ic.expression.region0              = "(0.5 * (1.0 + tanh(x / epsilon)))"
epsilon = eta.ic.expression.constant.epsilon

# eta=0 phase (LHS, x<0): air — calorically perfect gas
gamma_0 = 1.4
pi_0    = 0.0
mu_0    = 0.0

# eta=1 phase (RHS, x>0): water — stiffened gas (Tammann)
gamma_1 = 5.5
pi_1    = 6.0e8
mu_1    = 0.0

### Reference pressure (vestigial — slated for removal) ###
pref = 0.0

### IC State - eta=0 phase (air) ###
# Right-traveling acoustic Gaussian pulse centered at x0 = -0.5 m, width sigma = 0.05 m.
#   delta_p   = dp_max * exp(-(x-x0)^2 / (2 sigma^2))
#   delta_u   = (dp_max / (rho0 c0)) * exp(...)    (right-traveling: dp and du in phase, same sign)
#   delta_rho = (dp_max / c0^2)      * exp(...)
# Amplitude dp_max = 100 Pa  (~0.001 * p0)  -> linear-acoustic regime.
density_0.ic.type                          = expression
density_0.ic.expression.constant.rho0      = 1.2301351
density_0.ic.expression.constant.dp_max    = 100.0
density_0.ic.expression.constant.c0        = 339.58298
density_0.ic.expression.constant.x0        = -0.5
density_0.ic.expression.constant.sigma     = 0.05
density_0.ic.expression.region0            = "rho0 + (dp_max/(c0*c0)) * exp(-(x-x0)*(x-x0)/(2.0*sigma*sigma))"

velocity_0.ic.type                          = expression
velocity_0.ic.expression.constant.rho0      = 1.2301351
velocity_0.ic.expression.constant.dp_max    = 100.0
velocity_0.ic.expression.constant.c0        = 339.58298
velocity_0.ic.expression.constant.x0        = -0.5
velocity_0.ic.expression.constant.sigma     = 0.05
velocity_0.ic.expression.region0            = "(dp_max/(rho0*c0)) * exp(-(x-x0)*(x-x0)/(2.0*sigma*sigma))"
velocity_0.ic.expression.region1            = "0.0"

pressure_0.ic.type                          = expression
pressure_0.ic.expression.constant.p0        = 101325.0
pressure_0.ic.expression.constant.dp_max    = 100.0
pressure_0.ic.expression.constant.x0        = -0.5
pressure_0.ic.expression.constant.sigma     = 0.05
pressure_0.ic.expression.region0            = "p0 + dp_max * exp(-(x-x0)*(x-x0)/(2.0*sigma*sigma))"

# CPG calibration for air: cv = R / (gamma-1) = 287/0.4 = 717.5,  cp = gamma*cv = 1004.5
cp_0 = "1004.5"
cv_0 = "717.5"

### IC State - eta=1 phase (water at rest, matched pressure AND temperature) ###
# rho_1 chosen so Convention-B Tammann inversion gives T_1 = 287 K at p = 101325:
#   rho_1 = (p + gamma*pi) / ((gamma-1)*cv*T)
#         = (101325 + 5.5*6e8) / (4.5*4180*287)  ~  611.30308 kg/m^3
density_1.ic.type           = constant
density_1.ic.constant.value = 611.30308

velocity_1.ic.type                = expression
velocity_1.ic.expression.region0  = "0.0"
velocity_1.ic.expression.region1  = "0.0"

pressure_1.ic.type           = constant
pressure_1.ic.constant.value = 101325.0

# Stiffened-gas calibration for water: take cv such that cv ~ liquid-water value (4180 J/kg/K).
# cp = gamma*cv keeps the EOS-internal cp/cv ratio consistent with gamma_1=5.5.
cp_1 = "22990.0"
cv_1 = "4180.0"

### ETA BC ###
pf.eta.bc.type.xlo = neumann
pf.eta.bc.type.xhi = neumann
pf.eta.bc.type.ylo = periodic
pf.eta.bc.type.yhi = periodic

### HYDRO BC ###
# Neumann (zero-gradient) outflow on x.  In 2.0 ms the reflected (air-side)
# wave travels back at most ~0.5 m, so it does not reach xlo at -1.0.
# The transmitted (water-side) wave travels c_w*0.5 ms ~ 0.91 m by stop_time
# and may interact with xhi=+1.0 at the very end of the run; its amplitude is
# tiny in velocity (T_u ~ 5e-4) so any reflection there is a small correction.
density.bc.type.xhi  = neumann
density.bc.type.xlo  = neumann
density.bc.type.ylo  = periodic
density.bc.type.yhi  = periodic

energy.bc.type.xhi   = neumann
energy.bc.type.xlo   = neumann
energy.bc.type.ylo   = periodic
energy.bc.type.yhi   = periodic

momentum.bc.type.xhi = neumann  periodic
momentum.bc.type.xlo = neumann  periodic
momentum.bc.type.ylo = neumann  periodic
momentum.bc.type.yhi = neumann  periodic

### HYDRO REFINEMENT CRITERIA (single-level run) ###
eta_refinement_criterion   = 100000.1
omega_refinement_criterion = 100000.1
gradu_refinement_criterion = 100000.0
rho_refinement_criterion   = 100000.0
p_refinement_criterion     = 100000.0

Spec_Vol = 1

sigma = 0;
Dv    = 0;
g     = 0.0;

apply_surface_tension = 1
apply_weight          = 0
apply_vaporization    = 0

# Korteweg stress-tensor form (see tests/FlowSQR_tests/theory/korteweg_well_balanced.tex):
#   chempot  (default): Σ_K = κ[½|∇η|² I − ∇η⊗∇η] + κη∇²η I; WB trace λ[ηW' − W].
#   gradient          : Σ_K = κ[½|∇η|² I − ∇η⊗∇η];          WB trace −λW(η).
# Run both and compare the diagnostic plot variables korteweg_Snn_{0,1} and
# korteweg_divSigmaK_{0,1} to quantify the per-face residual on the planar
# CH-equilibrium tanh.
# korteweg_form = chempot   # current Form B (default)
korteweg_form = gradient  # Form A (TeX writeup)


### DEBUGGING / SOLVER ###
# Pure-hydro acoustic test: turn off the BS source coupling and freeze the CH
# field (mobility = 0).  The interface profile sits at its IC tanh; only the
# compressible Euler system carries the acoustic pulse across the interface.
sqr_source_mode     = ch_emergent
# p_int_method        = 3       # acoustic-impedance-matched interface pressure
                              # (this is the closure being validated here)
Riemann_Solver.type = hllc
kappa_method        = 1
smooth_kernel_size  = 3
nghost              = 4
integration.type    = ForwardEuler

# CH parameters: present for consistency, but mobility = 0 freezes the field.
implicit_ch         = 0
ch_mobility_scaling = explicit
ch_newton_iters     = 5
ch_newton_tol       = 1e-10

# Equilibrium-tanh match: lambda = 2*kappa/epsilon^2.
# epsilon = 1e-2  =>  for lambda = 12.5,  kappa = 12.5 * (1e-2)^2 / 2 = 6.25e-4.
ch_W_scale             = 12.5
ch_kappa               = 6.25e-4
ch_mobility_degenerate = 1
ch_mobility_nom        = 0     # freeze CH — interface is stationary

# HYDRO CLOSURE STRATEGIES (Phase B+)
# `closure.{un,E}_strategy` selects the per-quantity SQR closure for
# momentum and energy. Default "constitutive" uses the (p_k - p_int) ∇η
# (resp. (p_k u_k - p_int u_int)·∇η) form that vanishes at intensive
# equilibrium — so the per-phase pressure ground state survives and the
# spurious interfacial waves seen with the asymmetric pillbox (S1) closure
# do not get excited. The interface average p_int / u_int is selected by
# `closure.{un,E}_pint_method`: 1=arith (default), 2=eta-weighted,
# 3=acoustic-impedance, 4=mass-fraction. Method 2 was previously confirmed
# to clear the spurious-wave failure under the legacy
# `sqr_legacy_p_int_method=1 + p_int_method=2` switch — set it explicitly
# here so the new-framework run reproduces that fix.
# Other strategies: jump (S2), relax (S3), pillbox (asymmetric S1, research),
# pillbox_symmetric (S1', research) — see Hydro2.H closure-strategy block.
# closure.un_strategy    = constitutive
# closure.E_strategy     = constitutive
#
# --- S3 (capacity-scaled transfer flux) validation ---------------------------
# IMPORTANT: relax/jump only take effect on the new-framework path, i.e. with
# sqr_legacy_p_int_method = 0 (set below). With the legacy switch nonzero the
# un/E/rho/ut_close dispatch is bypassed entirely.
#
# S3 form: J_Q = -C_Q * v_Q * <<phi>>, applied via the |grad eta| flux template.
# The intensive jump then decays at the band-local rate v_Q*|grad eta|, i.e. an
# emergent relaxation time tau_loc = 1/(v_Q*|grad eta|). Here |grad eta|_max =
# 0.5/epsilon = 50, so v_Q = 2e4 gives tau_loc ~ 1e-6 s at the band center;
# explicit Euler with dt = 1e-7 => dt/tau_loc ~ 0.1 (stable, ~10 steps to relax).
#
# Normal velocity (S3): J_un = -rho_eff * v_un * (u_n,0 - u_n,1).
# NB <<u_n>> = 0 is an exact kinematic constraint, so this is a stiff penalty
# (faithful only as v_un -> inf), not a physical finite-resistance interface.
closure.un_strategy    = relax
closure.un_vel         = 2e-14    # transfer velocity [m/s]; tau_loc ~ 1/(v_un*|grad eta|)
# Energy / temperature (S3): J_E = -C_E * v_E * (T_0 - T_1).
closure.E_strategy     = relax
closure.E_vel          = 2e-14    # transfer velocity [m/s]; tau_loc ~ 1/(v_E*|grad eta|)
# Tangential velocity: inviscid case here, u_t is unconstrained — leave at the
# Constitutive no-op stub (S1/angular-momentum, A10, not yet implemented).
closure.ut_strategy    = constitutive
# Density / phase change (S3): relaxes the chemical-potential jump
# <<mu_chem>> = dmu_bulk = f_g - f_l toward zero. Needs ch_thermo_consistent = 1
# (else dmu_bulk is zeroed and this is inert). Enabling it turns the pure-
# acoustic test into acoustic + phase change, so uncomment deliberately:
# ch_thermo_consistent          = 1
# closure.rho_strategy   = relax
# closure.rho_vel        = 2e4    # transfer velocity [m/s]
#
sqr_legacy_p_int_method       = 0      # 0 = new closure-strategy framework (REQUIRED for relax/jump)
closure.un_pint_method = 2      # only used by the Constitutive strategy; ignored under relax
closure.E_pint_method  = 2      # only used by the Constitutive strategy; ignored under relax

nscbc.enabled = false
