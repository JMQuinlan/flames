#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

# Density-ratio sanity test (Phase C4 of HYDRO2_CONSERVATIVE_HLLC_SPEC).
#
# A static circular droplet at a 1000:1 density ratio (water-like in a
# light-gas atmosphere) — sister to input_static_droplet but with a
# round 1:1000 ratio specifically chosen to expose the difference
# between mass-fraction and volume-fraction Korteweg splits.
#
# Why this test:
#   The new flux-form Korteweg + Q-trace path in HLLC carries
#     kfd.kappa = Y_k_face · κ_global,
#     kfd.q_eta = Y_k_face · Q_global,
#   where Y_k_face = (α_k ρ_k)_face / ρ_mix_face is the mass-fraction
#   weight at the face. The two phases sum to the full mixture stress
#   regardless of split choice, but PER-PHASE acceleration depends on
#   it: with mass-fraction Y_k both phases see the same a = F/m, while
#   volume-fraction α_k would give the lighter phase O(ρ_heavy/ρ_light)
#   excess acceleration — here, ~1000× excess on the gas side.
#
# Pass criteria:
#   * Δp = σ/R = 144 Pa across the interface (matches Laplace), same
#     value as input_static_droplet — the Korteweg formulation should
#     be density-ratio-invariant for the equilibrium pressure jump.
#   * max|u_eta0| ≈ max|u_eta1| at the interface, both at truncation
#     level — equal acceleration on both phases.
#   * No 1000× blow-up on the gas side. (Volume-fraction split would
#     show this; mass-fraction shouldn't.)
#
# CH config and equilibrium-width tuning identical to input_static_droplet.

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowSQR_tests/output_droplet_density_ratio

### MESHING ###
amr.plot_dt = 5.0e-7
amr.plot_int = 1
amr.max_grid_size = 500000
amr.blocking_factor = 4
amr.regrid_int = 1
amr.grid_eff = 0.8
amr.max_level = 0
amr.n_cell = 200 200

### TIME STEPING ###
timestep = 1.0e-9
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 5.0e-8
dynamictimestep.min = 1.0e-12
cfl = 0.3

### DIMENSIONS ###
geometry.prob_lo = -1.0e-3 -1.0e-3 0.0
geometry.prob_hi =  1.0e-3  1.0e-3 0.0
geometry.is_periodic = 0 0 0

stop_time = 1.0e-5

### ETA INITIAL CONDITIONS ###
# Circular droplet of radius R0 centered at origin. eta=1 inside (heavy),
# eta=0 outside (light). dx = 2 mm / 200 = 1e-5 m, so epsilon = 4*dx = 4e-5 m
# resolves the diffuse interface across ~6-8 cells.
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 4.0e-5
eta.ic.expression.constant.R0 = 5.0e-4
eta.ic.expression.region0 = "0.5*(1 - tanh((sqrt(x**2 + y**2) - R0)/(sqrt(2)*epsilon)))"
epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###

# ----------------------------
# 1000:1 density ratio. Round numbers chosen to make the ratio exact;
# physical units roughly water-air at room conditions.
# ----------------------------
gamma_eta1 = 7.15
gamma_eta0 = 1.4

density_eta1.ic.type = expression
density_eta1.ic.expression.region0 = "1000.0"

density_eta0.ic.type = expression
density_eta0.ic.expression.region0 = "1.0"

# Initial velocity zero on both phases — any growth is from the discretization.
velocity_eta1.ic.type = expression
velocity_eta1.ic.expression.region0 = "0.0"
velocity_eta1.ic.expression.region1 = "0.0"

velocity_eta0.ic.type = expression
velocity_eta0.ic.expression.region0 = "0.0"
velocity_eta0.ic.expression.region1 = "0.0"

# Flat IC pressure on both phases. The well-balanced Korteweg+Q path
# delivers Δp = σ/R = 144 Pa as an emergent steady state; presetting
# the jump in the IC stacks on top and gives ~2σ/R (verified on
# input_static_droplet).
pressure_eta1.ic.type = expression
pressure_eta1.ic.expression.region0 = "1.01325e5"

pressure_eta0.ic.type = expression
pressure_eta0.ic.expression.region0 = "1.01325e5"

# Specific heats (water/air canonical)
cp_eta1 = 4180.0
cp_eta0 = 1005.0
cv_eta1 = 4180.0/7.15
cv_eta0 = 1005.0/1.4

# Tammann stiffened-gas pressure for water; ideal gas has pi=0
pi_eta1 = 3.0e8
pi_eta0 = 0.0

# Free-energy parameters: silenced (ch_thermo_consistent = 0).
T_ref          = 300.0
rho_ref_eta0   = 1.0
rho_ref_eta1   = 1000.0
R_eta0         = 287.0
q_eta0         = 0.0
qprime_eta0    = 0.0
q_eta1         = 0.0
qprime_eta1    = 0.0

ch_thermo_consistent = 0

# No viscosity — isolate the capillary force.
mu_eta1   = 0.0
mu_eta1_b = 0.0
mu_eta0   = 0.0
mu_eta0_b = 0.0

# Surface tension: water-air at 20°C, sigma = 0.072 N/m.
# Laplace pressure Δp = sigma/R = 0.072 / 0.5e-3 = 144 Pa.
# `sigma` knob is informational — the legacy Brackbill block is muted.
# Actual surface tension is set by ch_kappa, ch_W_scale below.
sigma = 0.072

pref = 0.0

### BOUNDARY CONDITIONS ###
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

### REFINEMENT CRITERIA ###
eta_refinement_criterion    = 1.0e-3
omega_refinement_criterion  = 1.0e10
p_refinement_criterion      = 1.0e10
rho_refinement_criterion    = 1.0e10
gradu_refinement_criterion  = 1.0e10
cutoff = 1.0e-8

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 1
apply_weight          = 0
apply_vaporization    = 0
apply_heat_conduction = 0
Spec_Vol              = 1
grav                  = 0.0

bs_source_mode = off
p_int_method   = 0

Riemann_Solver.type = hllc
kappa_method        = 1
smooth_kernel_size  = 5
nghost              = 4
integration.type    = ForwardEuler

# CH solver silenced; eta is held at the IC tanh.
implicit_ch     = 0
static_eta      = 1
ch_mobility_nom = 0.0

# CH gradient-energy + double-well, sized for σ_implied = √(2κλ)/6 = 0.072
# AND CH equilibrium for IC eta(r) = 0.5*(1 − tanh((r−R0)/(√2·ε))) with
# W = η²(1−η)²:
#   λ = κ/ε²              (equilibrium for tanh(r/(√2·ε)) form)
#   κ·λ = (6σ)²/2 = 0.0933 (target Laplace σ)
# ⇒ κ = √(0.0933·ε²) = 1.222e-5,  λ = κ/ε² = 7637.5
ch_W_scale      = 7637.5      # lambda
ch_kappa        = 1.222e-5    # kappa  (= lambda * epsilon^2)

nscbc.enabled = false
