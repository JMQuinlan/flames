# Korteweg stress-tensor form (see tests/FlowSQR_tests/theory/korteweg_well_balanced.tex):
#   chempot  (default): Σ_K = κ[½|∇η|² I − ∇η⊗∇η] + κη∇²η I,
#                       WB trace correction λ[ηW' − W].  ∇·Σ_K = −η ∇μ_K.
#   gradient          : Σ_K = κ[½|∇η|² I − ∇η⊗∇η],
#                       WB trace correction −λW(η).      ∇·Σ_K = −μ_K ∇η.
# Both are well-balanced on the planar CH-equilibrium tanh (Σ_nn = 0 pointwise).
# Compare residuals via the korteweg_Snn_{0,1} and korteweg_divSigmaK_{0,1}
# plot variables. apply_surface_tension = 0 zeros Σ_K under either form.
# korteweg_form = chempot
# korteweg_form = gradient

### DEBUGGING / SOLVER ###

sqr_source_mode      = ch_emergent

Riemann_Solver.type = hllc
kappa_method        = 1
smooth_kernel_size  = 3
nghost              = 4
integration.type    = ForwardEuler

implicit_ch     = 2
# Phase 4 mobility (spec §1.7): the new ch_mobility_scaling param controls
# how ch_mobility_nom is interpreted.
#   "magaletti"  -> M_eff = ch_mobility_nom * epsilon^2  (default; matched-asymptotic)
#   "allen_cahn" -> M_eff = ch_mobility_nom * epsilon
#   "explicit"   -> M_eff = ch_mobility_nom directly  (used here for clarity).
ch_mobility_scaling = magaletti
# ch_mobility_scaling = explicit
ch_newton_iters     = 5
ch_newton_tol       = 1e-10

# Tune lambda so the CH equilibrium tanh matches the IC tanh exactly.
# IC: eta(x) = 0.5 * (1 + tanh(x / epsilon)).  Equilibrium  kappa nabla^2 eta
# = lambda W'(eta) for W(eta) = eta^2 (1-eta)^2 reduces to:
#   kappa / epsilon^2 = lambda / 2
#   ==>   lambda = 2 * kappa / epsilon^2
# (Equivalently kappa = lambda * epsilon^2 / 2.) For kappa = 4e-4 and
# epsilon = 8e-3:   lambda = 2 * 4e-4 / 6.4e-5 = 12.5.
# With this choice the IC tanh is at CH equilibrium, so the well-balanced
# Korteweg + Q-trace correction in RHS_PerPhase produces zero force at
# the interface (up to truncation), recovering the Korteweg-off baseline.
#
# (NB: an earlier comment in this file used the relation
#  "kappa = 2 * epsilon^2 * lambda", which is wrong by a factor of 4 for
#  the IC tanh form above — argument is x/epsilon, not x/(2 epsilon).)
#
# The earlier value lambda = 2e6 was chosen for thermo-consistent mode to
# satisfy the spinodal margin |dmu_bulk|/lambda < 0.385 (spec §1.10) with
# Clausius-Clapeyron-calibrated (q, q'). That margin only applies when
# ch_thermo_consistent = 1 (dmu_bulk wired into mu_chem). This test
# leaves ch_thermo_consistent at its default (0), so dmu_bulk is unused
# and the only constraint on lambda is the equilibrium-width match above.
# Implied surface tension sigma = sqrt(2*kappa*lambda)/6 ~ 1.7e-2 N/m;
# sigma is a spectator parameter for a planar Riemann test (no curvature).
# ch_W_scale          = 12.5       # lambda = 2 * kappa / epsilon^2
# ch_kappa            = 4.0e-4     # = lambda * epsilon^2 / 2  (consistent)
# ch_mobility_degenerate = 1
# ch_mobility_nom        = 0.1
ch_W_scale          = 12.5       # lambda = 2 * kappa / epsilon^2
ch_kappa            = 4.0e-4     # = lambda * epsilon^2 / 2  (consistent)
ch_mobility_degenerate = 1
# ch_mobility_nom convention:  <0 = auto (0.2*ε*c_max),  0 = off (frozen η),  >0 = user value
ch_mobility_nom        = 10.0

# HYDRO CLOSURE STRATEGIES (Phase B+)
# `closure.{un,E}_strategy` selects the per-quantity SQR closure for
# momentum and energy. Default "constitutive" uses the (p_k - p_int) ∇η
# (resp. (p_k u_k - p_int u_int)·∇η) form that vanishes at intensive
# equilibrium — so the per-phase pressure ground state survives and the
# spurious interfacial waves seen with the asymmetric pillbox (S1) closure
# do not get excited. The interface average p_int / u_int is selected by
# `closure.{un,E}_pint_method`: 1=arith (default), 2=eta-weighted,
# 3=acoustic-impedance, 4=mass-fraction. For this gas-liquid Riemann test
# the historical legacy choice was `p_int_method = 4` (mass-fraction);
# carried over below as `closure.{un,E}_pint_method = 4` for documentation,
# inert under the active Relax (S3) strategy.
# Other strategies: jump (S2), relax (S3), pillbox (asymmetric S1, research),
# pillbox_symmetric (S1', research) — see Hydro2.H closure-strategy block.
# closure.un_strategy    = constitutive
# closure.E_strategy     = constitutive
#
# --- S3 (capacity-scaled transfer flux) validation ---------------------------
# IMPORTANT: relax/jump only take effect on the new-framework path, i.e. with
# sqr_legacy_p_int_method = 0 (set below). With the legacy switch nonzero the
# un/E/rho/ut_close dispatch is bypassed entirely.
#
# S3 form: J_Q = -C_Q * v_Q * <<phi>>, applied via the |grad eta| flux template.
# The intensive jump decays at the band-local rate v_Q*|grad eta|, i.e. an
# emergent relaxation time tau_loc = 1/(v_Q*|grad eta|). Here |grad eta|_max =
# 0.5/epsilon = 62.5 (epsilon = 8e-3) and dt = 2.5e-4 (cfl = 0.4 cap). For
# explicit-Euler stability with dt/tau_loc ~ 0.1 (~10 steps to relax),
#   v_Q = 0.1 / (dt * |grad eta|_max) ≈ 6.4 m/s.
# Shock-band transit (~6*epsilon at c ~ 2.5–3 m/s) is ~64 dt ~ 6 tau_loc, so a
# fluid element fully equilibrates while crossing the diffuse band.
# NB this is a *soft* relaxation choice (v_Q ~ 2–3 × c). A stiffer near-sharp
# limit (v_Q >> c) would require implicit / sub-stepped relaxation to stay
# stable under the explicit hydro dt — not yet implemented.
#
# Normal velocity (S3): J_un = -rho_eff * v_un * (u_n,0 - u_n,1).
# NB <<u_n>> = 0 is an exact kinematic constraint, so this is a stiff penalty
# (faithful only as v_un -> inf), not a physical finite-resistance interface.
closure.un_strategy    = relax
# closure.un_vel         = 6.4 #e-1    # transfer velocity [m/s]; tau_loc ~ 1/(v_un*|grad eta|)
closure.un_vel         = 6.4
# closure.un_strategy    = constitutive
# Energy / temperature (S3): J_E = -C_E * v_E * (T_0 - T_1).
closure.E_strategy     = relax
closure.E_vel          = 0    # no thermal coupling — pure Riemann benchmark (T₀ ≠ T₁ accepted)
# closure.E_strategy     = const0itutive
# Tangential velocity: inviscid case here, u_t is unconstrained — leave at the
# Constitutive no-op stub (S1/angular-momentum, A10, not yet implemented).
closure.ut_strategy    = constitutive
# Density / phase change (S3): relaxes the chemical-potential jump
# <<mu_chem>> = dmu_bulk = f_g - f_l toward zero. Needs ch_thermo_consistent = 1
# (else dmu_bulk is zeroed and this is inert). Enabling it turns the pure-
# Riemann test into Riemann + phase change, so uncomment deliberately:
# ch_thermo_consistent          = 1
# closure.rho_strategy   = relax
# closure.rho_vel        = 6.4    # transfer velocity [m/s]
#
sqr_legacy_p_int_method       = 0      # 0 = new closure-strategy framework (REQUIRED for relax/jump)
closure.un_pint_method = 4      # only used by the Constitutive strategy; ignored under relax
closure.E_pint_method  = 4      # only used by the Constitutive strategy; ignored under relax

# Ghost-fluid relaxation: damp minority-phase state toward IC.
  # Convention: τ < 0 = disabled, τ = 0 = error, τ > 0 = active [s].
  ghost_tau_rho_0 = 1e-2
  ghost_tau_rho_1 = 1e-2
  ghost_tau_mom_0 = 1e-2
  ghost_tau_mom_1 = 1e-2
  ghost_tau_eng_0 = 1e-2
  ghost_tau_eng_1 = 1e-2


nscbc.enabled = false
