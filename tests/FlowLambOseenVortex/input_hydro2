#@ exe=hydro2
#@ dim=2
# alamo.program = hydro2

# =============================================================================
# LAMB-OSEEN VORTEX -- hydro2 single-phase variant
# =============================================================================
# Hydro2 6-eq port of FlowLambOseenVortex/input.  Single phase by degeneracy:
# eos0 == eos1, mu0 == mu1, density0 == density1, AND both per-phase IC
# fields carry the same Lamb-Oseen expressions so the equalized IC state is
# exactly the analytical vortex field.
#
# Lamb-Oseen vortex:
#   center      (xc, yc) = (5.0, 5.0)
#   circulation Gamma    = 1.0
#   core radius rc       = 0.5
#   u_theta(r) = (Gamma / (2 pi r)) * (1 - exp(-r^2 / rc^2))
#   In Cartesian:
#     u = -(Gamma / (2 pi)) * ((y - yc) / r^2) * (1 - exp(-r^2/rc^2))
#     v =  (Gamma / (2 pi)) * ((x - xc) / r^2) * (1 - exp(-r^2/rc^2))
#
# Viscous decay (Lamb-Oseen analytical):
#   u_theta(r, t) = (Gamma / (2 pi r)) * (1 - exp(-r^2 / (rc^2 + 4 nu t)))
#   nu = mu / rho = 0.01 / 1.0 = 0.01.
#
# eta convention: eta = 1 everywhere -> pure phase 0 (the active fluid here).
# =============================================================================

### OUTPUT ###
plot_file = ./tests/FlowLambOseenVortex/FlowLambOseenVortex

### MESHING ###
amr.plot_dt        = 0.5
amr.max_grid_size  = 64
amr.blocking_factor = 8
amr.regrid_int     = 10
amr.grid_eff       = 0.8
amr.max_level      = 0
amr.n_cell         = 256 256

### DIMENSIONS ###
# 10 x 10 domain so the vortex has space to decay without boundary contamination.
geometry.prob_lo     = 0.0 0.0 0.0
geometry.prob_hi     = 10.0 10.0 0.0
geometry.is_periodic = 1 1 0

### TIME STEP ###
timestep  = 1.0e-4
stop_time = 10.0

### HYDRO PARAM ###

### EQUATION OF STATE -- single fluid (both phases identical, ideal gas) ###
# gamma = 1.4 matches the original.  cv = 1.0, cp = gamma = 1.4 in
# normalized units; the test only exercises viscous vortex decay.
eos0.gamma = 1.4
eos0.p0    = 0.0
eos0.cv    = 1.0
eos0.cp    = 1.4

eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cv    = 1.0
eos1.cp    = 1.4

cfl   = 0.5
mu0   = 0.01      # dynamic viscosity
mu0_b = 0.0       # no bulk viscosity
mu1   = 0.01
mu1_b = 0.0

### ETA IC ###
# Pure phase 0 throughout (eta = 1).  No interface dynamics; epsilon is a
# parser-required placeholder.
eta.ic.type = expression
eta.ic.expression.region0 = "1.0"
epsilon = 0.01

### SOURCE-TERM ICs (off) ###
m0.ic.type = constant
m0.ic.constant.value = "0.0"

u0.ic.type = expression
u0.ic.expression.region0 = "0.0"
u0.ic.expression.region1 = "0.0"

q.ic.type = expression
q.ic.expression.region0 = "0.0"
q.ic.expression.region1 = "0.0"

### PER-PHASE PRIMARIES ###
# Phase 0 (active -- carries the Lamb-Oseen field).
density0.ic.type = expression
density0.ic.expression.region0 = "1.0"

# Lamb-Oseen velocity field.  1e-8 in the denominator regularizes the
# r -> 0 singularity at the vortex center.
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "-(1.0 / (2.0 * 3.14159265)) * ((y-5.0) / ((x-5.0)**2 + (y-5.0)**2 + 1e-8)) * (1.0 - exp(-((x-5.0)**2 + (y-5.0)**2) / (0.5**2)))"
velocity0.ic.expression.region1 =  "(1.0 / (2.0 * 3.14159265)) * ((x-5.0) / ((x-5.0)**2 + (y-5.0)**2 + 1e-8)) * (1.0 - exp(-((x-5.0)**2 + (y-5.0)**2) / (0.5**2)))"

pressure0.ic.type = expression
pressure0.ic.expression.region0 = "0.1"

# Phase 1 (degenerate copy -- same fields as phase 0).  The parser
# requires per-phase ICs to be defined; keeping them identical means
# Mix() + equalize_ic_pressure both reproduce the analytical IC exactly.
density1.ic.type = expression
density1.ic.expression.region0 = "1.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "-(1.0 / (2.0 * 3.14159265)) * ((y-5.0) / ((x-5.0)**2 + (y-5.0)**2 + 1e-8)) * (1.0 - exp(-((x-5.0)**2 + (y-5.0)**2) / (0.5**2)))"
velocity1.ic.expression.region1 =  "(1.0 / (2.0 * 3.14159265)) * ((x-5.0) / ((x-5.0)**2 + (y-5.0)**2 + 1e-8)) * (1.0 - exp(-((x-5.0)**2 + (y-5.0)**2) / (0.5**2)))"

pressure1.ic.type = expression
pressure1.ic.expression.region0 = "0.1"

### HYDRO BC -- ALL PERIODIC ###
pf.eta.bc.type.xlo = periodic
pf.eta.bc.type.xhi = periodic
pf.eta.bc.type.ylo = periodic
pf.eta.bc.type.yhi = periodic

density.bc.type.xlo = periodic
density.bc.type.xhi = periodic
density.bc.type.ylo = periodic
density.bc.type.yhi = periodic

energy.bc.type.xlo = periodic
energy.bc.type.xhi = periodic
energy.bc.type.ylo = periodic
energy.bc.type.yhi = periodic

momentum.bc.type.xlo = periodic periodic
momentum.bc.type.xhi = periodic periodic
momentum.bc.type.ylo = periodic periodic
momentum.bc.type.yhi = periodic periodic

### REFINEMENT CRITERIA ###
# Refine on vorticity / velocity-gradient to capture the vortex core
# (only matters if amr.max_level > 0).
eta_refinement_criterion   = 1.0e+10
omega_refinement_criterion = 0.1
gradu_refinement_criterion = 0.1
rho_refinement_criterion   = 1.0e+10
p_refinement_criterion     = 1.0e+10
cutoff = 0.01

amr.abort_on_nan = 1
small = 1E-8


### PHYSICS FLAGS ###
apply_surface_tension = 0
apply_weight          = 0
apply_vaporization    = 0

### DYNAMIC TIMESTEP ###
dynamictimestep.on      = 1
dynamictimestep.verbose = 1
dynamictimestep.cfl     = 0.5

### IC PRESSURE EQUALIZATION ###
# Both per-phase pressure ICs are identical here, so this is a no-op;
# kept on for consistency with the rest of the test suite.
equalize_ic_pressure = 1

### NUMERICS -- standardized: HLLC + WENO3 + RK3 ###
Riemann_Solver.type = hllc
Limiter.type        = weno3
integration.type    = RungeKutta
integration.rk.type = 3
