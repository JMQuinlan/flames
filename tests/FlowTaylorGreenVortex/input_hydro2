#@ [case1]
#@ exe=hydro2
#@ dim=2

# alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowTaylorGreenVortex/TaylorGreenDecay

### MESHING ###
amr.plot_dt = 0.5
amr.max_grid_size = 64
amr.blocking_factor = 8
amr.regrid_int = 10
amr.grid_eff = 0.8
amr.max_level = 0
amr.n_cell = 256 256

### DIMENSIONS ###
# Taylor-Green Vortex on [0, 2pi] × [0, 2pi] domain
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 6.283185307 6.283185307 0.0  # 2*pi

# CRITICAL: TGV requires full periodicity
geometry.is_periodic = 1 1 0

### TIME STEP ###
timestep  = 1.0e-4
stop_time = 10.0

### ETA IC ###
eta.ic.type = constant
eta.ic.constant.value = 0.0
eta.ic.expression.constant.epsilon  = 1.0
epsilon = eta.ic.expression.constant.epsilon

m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0
q.ic.type = constant
q.ic.constant.value = 0.0

### HYDRO PARAM ###
gamma_eta1 = 1.4
gamma_eta0 = 1.4
cfl   = 0.5
mu_eta1   = 0.01    # Adjust for desired Reynolds number: Re = rho*U*L/mu
mu_eta0   = 0.01
pref  = 0.0

### IC State ###
# Fluid 0 (inactive phase)
density_eta1.ic.type = expression
density_eta1.ic.expression.region0 = "1.0"
velocity_eta1.ic.type = expression
velocity_eta1.ic.expression.region0 = "0.0"
velocity_eta1.ic.expression.region1 = "0.0"
pressure_eta1.ic.type = expression
pressure_eta1.ic.expression.region0 = "0.0"

# Fluid 1 (active phase - Taylor-Green Vortex)
density_eta0.ic.type = expression
density_eta0.ic.expression.region0 = "1.0"

### TAYLOR-GREEN INITIAL CONDITIONS ###
# u =  sin(x) * cos(y)
# v = -cos(x) * sin(y)
# p = p0 + (rho/4) * (cos(2*x) + cos(2*y))
velocity_eta0.ic.type = expression
velocity_eta0.ic.expression.region0 = "sin(x) * cos(y)"
velocity_eta0.ic.expression.region1 = "-cos(x) * sin(y)"

pressure_eta0.ic.type = expression
pressure_eta0.ic.expression.region0 = "1.1 + 0.25 * (cos(2.0*x) + cos(2.0*y))"

### THERMODYNAMICS ###
temperature0.ic.type = expression
temperature0.ic.expression.region0 = "294.0"
temperature1.ic.type = expression
temperature1.ic.expression.region0 = "294.0"

k0_thermal.ic.type = expression
k0_thermal.ic.expression.region0 = "0.6"
k1_thermal.ic.type = expression
k1_thermal.ic.expression.region0 = "0.6"

h0_thermal.ic.type = expression
h0_thermal.ic.expression.region0 = "1.4"
h1_thermal.ic.type = expression
h1_thermal.ic.expression.region0 = "1.0"

### HYDRO BC - ALL PERIODIC ###
density.bc.type.xlo = periodic
density.bc.type.xhi = periodic
density.bc.type.ylo = periodic
density.bc.type.yhi = periodic

energy.bc.type.xlo = periodic
energy.bc.type.xhi = periodic
energy.bc.type.ylo = periodic
energy.bc.type.yhi = periodic

momentum.bc.type.xlo = periodic periodic
momentum.bc.type.xhi = periodic periodic
momentum.bc.type.ylo = periodic periodic
momentum.bc.type.yhi = periodic periodic

### HYDRO REFINEMENT CRITERIA ###
omega_refinement_criterion = 0.1
gradu_refinement_criterion = 0.1

apply_surface_tension = 0
apply_weight = 0
apply_vaporization = 0

amr.abort_on_nan = 1

dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.cfl = 0.5
dynamictimestep.max = 1.0
dynamictimestep.min = 1.0e-12

Riemann_Solver.type = hllc
#integration.type = RungeKutta
#integration.rk.type = 4
