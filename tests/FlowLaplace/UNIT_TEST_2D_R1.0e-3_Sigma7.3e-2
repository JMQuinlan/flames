#@ [r1.0e-3_sigma7.3e-2]
#@ exe=hydro2
#@ dim=2

# =============================================================================
# Laplace pressure test (air/water)  --  R = 0.001 m,  sigma = 0.073 N/m
# =============================================================================
# 2D cylindrical bubble at rest, gas pressure Laplace-balanced against the
# liquid:
#     p_gas - p_liquid = sigma / R = 73 Pa     (Young-Laplace, single curvature)
# A correct Brackbill CSF holds the bubble motionless at R0 = 0.001 m.  Drift,
# oscillation, or collapse indicates a surface-tension scaling bug.
#
# Fluid: air / water (validated Sch20 Tammann-water + ideal-gas-air pair).
#   water (phase 0, eta=1, outside):  rho=1000, gamma=2.35, p0=1000000000
#   air   (phase 1, eta=0, inside):   rho=1, gamma=1.4, p0=0
#   p_liquid = 101325 Pa (1 atm),  p_gas = p_liquid + sigma/R = 101398 Pa
#   dp/p_liquid = 0.0007204539847  (small -> well-conditioned pressure field)
#
# Mesh: 64x64 base + 1 AMR level (eta-only) over a 0.004 m box.
#   dx_finest = 3.125e-05 = R/32;  R resolved by 32 finest cells.
#   epsilon   = 2*dx_finest = 6.25e-05 = 0.0625 R  (interface band).
#
# Time: acoustic transit R/c_l = 6.52295027e-07 s (c_l = 1533.048634 m/s);
#   capillary tau = sqrt(rho R^3/sigma) = 0.003701166051 s;
#   stop_time = 500 * R/c_l = 0.0003261475135 s (50 frames).
#
# This is a unit test -- keep it fast: low resolution, eta-only AMR, Neumann
# walls (bubble is far from the boundary in the 0.004 m box).
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
# plot_file = ./tests/FlowLaplace/UNIT_TEST_2D/output_R1.0e-3_Sigma7.3e-2                                  # DESKTOP (run from bin/)
plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowLaplace/UNIT_TEST_2D/output_R1.0e-3_Sigma7.3e-2   # INCLINE /mmfs1 (default)

### MESHING ###
amr.plot_int        = -1
amr.plot_dt         = 6.52295027e-06
amr.max_grid_size   = 500000
amr.blocking_factor = 2
amr.regrid_int      = 10
amr.grid_eff        = 0.8
amr.max_level       = 1
amr.n_cell          = 64 64

nghost = 4

### TIME STEPPING ###
timestep                = 1e-12
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 1.630737567e-06
dynamictimestep.min     = 1e-14
cfl                     = 0.3

### DIMENSIONS ###
geometry.prob_lo     = -0.002 -0.002 0.0
geometry.prob_hi     =  0.002  0.002 0.0
geometry.is_periodic = 0 0 0
stop_time            = 0.0003261475135

### ETA INITIAL CONDITIONS ###
# eta = 0 inside bubble (air, phase 1), eta = 1 outside (water, phase 0).
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 6.25e-05
eta.ic.expression.constant.R0      = 0.001
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EQUATION OF STATE -- Sch20 Tammann water + ideal-gas air ###
eos0.gamma = 2.35
eos0.p0    = 1000000000
eos0.cp    = 4186
eos0.cv    = 1781

eos1.gamma = 1.4
eos1.p0    = 0
eos1.cp    = 1000
eos1.cv    = 714.286

### HYDRO INITIAL CONDITIONS ###
density0.ic.type = expression
density0.ic.expression.region0 = "1000"

density1.ic.type = expression
density1.ic.expression.region0 = "1"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

# Laplace-balanced pressures: p_gas - p_liquid = sigma/R = 73 Pa
pressure0.ic.type = expression
pressure0.ic.expression.region0 = "101325"      # water (outside, eta=1)

pressure1.ic.type = expression
pressure1.ic.expression.region0 = "101398"      # air (inside, eta=0)

### VISCOSITY (zero -- pure Laplace test, no damping) ###
mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### SURFACE TENSION ###
sigma = 0.073
pref  = 0.0

### BOUNDARY CONDITIONS - Neumann walls (bubble far from boundary) ###
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

### REFINEMENT -- eta-only at the interface band ###
eta_refinement_criterion   = 1.0e-1
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

### PHYSICS FLAGS ###
apply_surface_tension = 1
apply_buoyancy        = 0
apply_weight          = 0
apply_vaporization    = 0
grav                  = 0.0

### NUMERICS -- WENO3 + SSPRK3 (project standard) ###
Riemann_Solver.type = hllc
Limiter.type        = weno3
integration.type    = RungeKutta
integration.rk.type = 3
kappa_method        = 1

apply_sharpening     = 0
sharpening_frequency = 50
reinit_max_iter      = 100
reinit_tolerance     = 1e-6
omega_relax          = 0.5
relax_diag           = 1
