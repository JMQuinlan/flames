#@ [@NAMETAG@]
#@ exe=hydro2
#@ dim=2

# =============================================================================
# Laplace pressure test  --  R = @R0@,  sigma = @SIGMA@
# =============================================================================
# 2D cylindrical bubble at rest, gas pressure Laplace-balanced against the
# liquid:
#     p_gas - p_liquid = sigma / R = @DP@      (Young-Laplace, single curvature)
# A correct Brackbill CSF holds the bubble motionless at R0 = @R0@.
#
# Fluid: Garrick (2017) Tammann liquid + ideal gas (cheap but stiffened).
#   liquid (phase 0, eta=1, outside):  rho=0.991, gamma=5.5, p0=1.505
#   gas    (phase 1, eta=0, inside):   rho=1.241, gamma=1.4, p0=0
#   p_liquid = 1.0,  p_gas = p_liquid + sigma/R = @PGAS@
#
# Mesh: 64x64 base + 1 eta-only AMR level over a @BOX@ box.
#   dx_finest = @DXFINE@ = R/32;  epsilon = @EPSILON@ (~2 finest cells).
# Timescale tau = @TAU@;  stop_time = 15 tau = @STOP_TIME@ (50 frames).
#
# NOTE: this is a TEMPLATE.  RUN_LAPLACE.bash fills the @...@ placeholders per
# (R, sigma) combination and runs it.  The committed standalone inputs
# tests/FlowLaplace/R*_Sigma* are the same thing pre-expanded by
# tests/FlowLaplace/reference/gen_inputs.py -- both share those formulas.
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = @OUTPUT_PATH@

### MESHING ###
amr.plot_int        = -1
amr.plot_dt         = @PLOT_DT@
amr.max_grid_size   = 500000
amr.blocking_factor = 2
amr.regrid_int      = 10
amr.grid_eff        = 0.8
amr.max_level       = 1
amr.n_cell          = 64 64

nghost = 4

### TIME STEPPING ###
timestep                = @DT_INIT@
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = @DT_MAX@
dynamictimestep.min     = @DT_MIN@
cfl                     = 0.4

### DIMENSIONS ###
geometry.prob_lo     = @NEG_HALF@ @NEG_HALF@ 0.0
geometry.prob_hi     =  @HALF@  @HALF@ 0.0
geometry.is_periodic = 0 0 0
stop_time            = @STOP_TIME@

### ETA INITIAL CONDITIONS ###
# eta = 0 inside bubble (gas, phase 1), eta = 1 outside (liquid, phase 0).
eta.ic.type = expression
eta.ic.expression.constant.epsilon = @EPSILON@
eta.ic.expression.constant.R0      = @R0@
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EQUATION OF STATE -- Garrick Tammann liquid + ideal gas ###
eos0.gamma = 5.5
eos0.p0    = 1.505
eos0.cp    = 1004.5
eos0.cv    = 717.5

eos1.gamma = 1.4
eos1.p0    = 0
eos1.cp    = 1004.5
eos1.cv    = 717.5

### HYDRO INITIAL CONDITIONS ###
density0.ic.type = expression
density0.ic.expression.region0 = "0.991"

density1.ic.type = expression
density1.ic.expression.region0 = "1.241"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

# Laplace-balanced pressures: p_gas - p_liquid = sigma/R = @DP@
pressure0.ic.type = expression
pressure0.ic.expression.region0 = "1.0"      # liquid (outside, eta=1)

pressure1.ic.type = expression
pressure1.ic.expression.region0 = "@PGAS@"      # gas (inside, eta=0)

### VISCOSITY (zero -- pure Laplace test, no damping) ###
mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### SURFACE TENSION ###
sigma = @SIGMA@
pref  = 0.0

### BOUNDARY CONDITIONS - Neumann walls (bubble far from boundary) ###
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

### REFINEMENT -- eta-only at the interface band ###
eta_refinement_criterion   = 1.0e-1
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

### PHYSICS FLAGS ###
apply_surface_tension = @APPLY_ST@
apply_buoyancy        = 0
apply_weight          = 0
apply_vaporization    = 0
Spec_Vol              = 1
grav                  = 0.0

### NUMERICS -- WENO3 + SSPRK3 (project standard) ###
Riemann_Solver.type = hllc
Limiter.type        = weno3
integration.type    = RungeKutta
integration.rk.type = 3
kappa_method        = 1

apply_sharpening     = 0
sharpening_frequency = 50
reinit_max_iter      = 100
reinit_tolerance     = 1e-6
omega_relax          = 0.5
relax_diag           = 1
