#@ [nscbcdrive_sine]
#@ exe=hydro2
#@ dim=2
#@
# =============================================================================
# NSCBC ACOUSTIC DRIVE -- SINGLE-TONE SINE -- 1D TUBE
# =============================================================================
# Companion to input_AcousticBC*, which drive the same tube through a
# time-dependent primitive DIRICHLET boundary.  This one drives through the
# NSCBC incoming characteristic instead -- the path the driven-bubble cases
# use -- so it isolates the drive from everything else in those runs.
#
#   p_target(t) = p0 + A sin(w t),  A = 0.01, f = 5 Hz (w = 31.415927)
#
# Analytic reference (d'Alembert, right-traveling, valid before the front
# reaches xhi):  p(x,t) = p0 + A sin(w (t - x/c0)) H(t - x/c0),  c0 = 1.18322.
#
# Geometry: 1D (thin y, periodic), air, uniform and at rest initially.
#   xlo = NSCBC outflow with a driven target  (the source)
#   xhi = NSCBC outflow, passive              (the sink)
#   ylo/yhi = periodic
#
# WHAT CAN GO WRONG, AND WHY THIS TEST EXISTS
# The NSCBC does not impose p = p_target; it RELAXES the incoming wave toward
# it at rate K = sigma (1-M^2) a / L_ref.  That is a first-order low-pass on
# the drive: amplitude is scaled by 1/sqrt(1+(w/K)^2) and lagged by
# arctan(w/K).  Too small a K and the drive barely couples; too large and the
# face stops being non-reflecting and becomes a pressure wall.  sigma and
# L_ref therefore set BOTH the damping and the drive transfer function, which
# is exactly the interference this test is built to measure.
#
#   here: a = c0 = 1.18322, L_ref = 0.05 -> K = 14.20 rad/s
#         drive w = 31.4159 -> w/K = 2.2126
#         predicted amplitude transfer = 0.4118
#         predicted phase lag          = 1.1463 rad
#
# Analyze with tests/FlowAcoustic/reference/AnalyzeNSCBCDrive.py
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file   = ./tests/FlowAcoustic/output_NSCBCDrive_Sine
amr.plot_dt = 0.01
amr.max_level = 0
amr.max_grid_size = 500000
amr.blocking_factor = 4
amr.grid_eff = 0.8
amr.n_cell = 400 4

nghost = 4                     # REQUIRED: selects NSCBC4, which carries the drive

### DIMENSIONS ###
geometry.prob_lo = 0.0  -0.01  0.0
geometry.prob_hi = 1.0   0.01  0.0
geometry.is_periodic = 0 1 0

### TIME STEP ###
timestep  = 5.0e-4
cfl       = 0.4
stop_time = 0.7

### DIFFUSE INTERFACE (single phase) ###
eta.ic.type = constant
eta.ic.constant.value = 0.0
epsilon = 0.005

m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0
q.ic.type = constant
q.ic.constant.value = 0.0

### SOLVER ###
Riemann_Solver.type = hllc
Limiter.type        = weno3
integration.type    = RungeKutta
integration.rk.type = 3

### EOS - IDEAL GAS (AIR) ###
eos0.gamma = 1.4
eos0.p0 = 0.0
eos0.cp = 1004.5
eos0.cv = 717.5
eos1.gamma = 1.4
eos1.p0 = 0.0
eos1.cp = 1004.5
eos1.cv = 717.5

mu0 = 0.0
mu1 = 0.0
sigma = 0.0
pref  = 0.0
apply_surface_tension = 0

### INITIAL CONDITIONS - uniform base state at rest ###
density0.ic.type = expression
density0.ic.expression.region0 = "1.0"
density1.ic.type = expression
density1.ic.expression.region0 = "1.0"
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"
pressure0.ic.type = expression
pressure0.ic.expression.region0 = "1.0"
pressure1.ic.type = expression
pressure1.ic.expression.region0 = "1.0"

### BOUNDARY CONDITIONS -- NSCBC both ends, y periodic ###
density.bc.type.xlo  = nscbc_outflow
density.bc.type.xhi  = nscbc_outflow
energy.bc.type.xlo   = nscbc_outflow
energy.bc.type.xhi   = nscbc_outflow
momentum.bc.type.xlo = nscbc_outflow nscbc_outflow
momentum.bc.type.xhi = nscbc_outflow nscbc_outflow
eta.bc.type.xlo = neumann
eta.bc.type.xhi = neumann

nscbc.small = 1.0e-10

# ---- xlo: the SOURCE.  Same outflow machinery, but with a driven target. ----
nscbc.xlo.type     = outflow
nscbc.xlo.target_p = 1.0
nscbc.xlo.sigma    = 0.6
nscbc.xlo.beta     = 0.5
nscbc.xlo.L_ref    = 0.05
nscbc.xlo.target_u = 0.0
nscbc.xlo.target_v = 0.0
nscbc.xlo.drive_amp   = 0.01
nscbc.xlo.drive_omega = 31.415927

# ---- xhi: passive non-reflecting outflow ----
nscbc.xhi.type     = outflow
nscbc.xhi.target_p = 1.0
nscbc.xhi.sigma    = 0.6
nscbc.xhi.beta     = 0.5
nscbc.xhi.L_ref    = 0.05
nscbc.xhi.target_u = 0.0
nscbc.xhi.target_v = 0.0

### REFINEMENT (off) ###
eta_refinement_criterion   = 1.0e+10
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4

apply_buoyancy     = 0
apply_weight       = 0
apply_vaporization = 0
grav               = 0.0
apply_sharpening   = 0
