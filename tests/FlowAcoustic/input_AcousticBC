#@ [acoustic_bc_1d]
#@ exe=hydro2
#@ dim=2
#@
# =============================================================================
# TIME-DEPENDENT PRIMITIVE BC TEST -- sinusoidal acoustic source (1D)
# =============================================================================
# First exercise of the primitive/phase-specific BC path (bc.primitive=1, see
# bin/PrimitiveBC.md).  A sinusoidal pressure wave is injected at the LEFT (xlo)
# boundary via a time-dependent Dirichlet primitive BC.  To inject a CLEAN
# right-traveling acoustic wave (impedance matched, minimal source reflection)
# all three primitives are perturbed consistently with linear acoustics:
#
#   p'(0,t)   = amp * sin(omega t)
#   u'(0,t)   = p'/(rho0 c0)      ->  M_x'(0,t) = p'/c0          = (amp/c0)  sin
#   rho'(0,t) = p'/c0^2           ->  rho (0,t) = rho0 + p'/c0^2 = (amp/c0sq) sin
#
# Base state: rho0=1, p0=1, ideal-gas air (gamma=1.4, pi=0) -> c0=sqrt(1.4)=1.18322.
#
# Geometry: 1D unit test (thin y, periodic) like FlowRiemannUnitTests, fast.
#   xlo = time-dependent primitive Dirichlet (the source)
#   xhi = neumann (approx outflow; non-reflecting only while wave is mid-domain)
#   ylo/yhi = periodic
#
# Analytical reference (d'Alembert right-traveling wave, valid before the front
# reaches xhi):  p(x,t) = p0 + amp*sin(omega*(t - x/c0)) * H(t - x/c0).
# Compare with tests/FlowAcoustic/AcousticBC.py.
#
# stop_time chosen so the front (x = c0*t) stays inside the domain: c0*0.7 = 0.83.
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file   = ./tests/FlowAcoustic/output_AcousticBC
amr.plot_dt = 0.01
amr.max_level = 0
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.grid_eff = 0.8
amr.n_cell = 400 4

nghost = 2

### DIMENSIONS ###
geometry.prob_lo = 0.0  -0.01  0.0
geometry.prob_hi = 1.0   0.01  0.0
geometry.is_periodic = 0 1 0

### TIME STEP ###
timestep  = 5.0e-4         # < CFL limit 0.4*dx/c0 = 8.5e-4
cfl       = 0.4
stop_time = 0.7

### DIFFUSE INTERFACE (single phase: eta=0 -> phase 1 active, frozen) ###
eta.ic.type = constant
eta.ic.constant.value = 0.0
epsilon = 0.005

### DIFFUSE BOUNDARY SOURCES ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0
q.ic.type = constant
q.ic.constant.value = 0.0

### SOLVER ###
Riemann_Solver.type = hllc

### EOS - IDEAL GAS (AIR) ###
eos0.gamma = 1.4
eos0.p0 = 0.0
eos0.cp = 1004.5
eos0.cv = 717.5
eos1.gamma = 1.4
eos1.p0 = 0.0
eos1.cp = 1004.5
eos1.cv = 717.5

### VISCOSITY ###
mu0 = 0.0
mu1 = 0.0

### SURFACE TENSION ###
sigma = 0.0
pref  = 0.0

### INITIAL CONDITIONS - uniform base state at rest (wave enters from xlo) ###
density0.ic.type = expression
density0.ic.expression.region0 = "1.0"
density1.ic.type = expression
density1.ic.expression.region0 = "1.0"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

pressure0.ic.type = expression
pressure0.ic.expression.region0 = "0.0"
pressure1.ic.type = expression
pressure1.ic.expression.region0 = "1.0"

# =============================================================================
# PRIMITIVE / PHASE-SPECIFIC BOUNDARY CONDITIONS
# =============================================================================
bc.primitive = 1

# ---- PRESSURE: sinusoidal source on xlo, neumann (outflow) on xhi ----
pressure.bc.constant.p_base = 1.0
pressure.bc.constant.amp    = 0.01
pressure.bc.constant.omega  = 31.415926536      # 2*pi*f,  f = 5
pressure.bc.type.xlo = dirichlet
pressure.bc.val.xlo  = "p_base + amp*sin(omega*t)"
pressure.bc.type.xhi = neumann
pressure.bc.val.xhi  = "0.0"
pressure.bc.type.ylo = periodic
pressure.bc.type.yhi = periodic

# ---- DENSITY: rho0 + p'/c0^2 on xlo (consistent acoustic perturbation) ----
density.bc.constant.rho_base = 1.0
density.bc.constant.amp      = 0.01
density.bc.constant.c0sq     = 1.4              # c0^2 = gamma*p0/rho0
density.bc.constant.omega    = 31.415926536
density.bc.type.xlo = dirichlet
density.bc.val.xlo  = "rho_base + (amp/c0sq)*sin(omega*t)"
density.bc.type.xhi = neumann
density.bc.val.xhi  = "0.0"
density.bc.type.ylo = periodic
density.bc.type.yhi = periodic

# ---- MOMENTUM: M_x = p'/c0 on xlo (impedance-matched right-traveling wave) ----
momentum.bc.constant.amp   = 0.01
momentum.bc.constant.c0    = 1.1832159566
momentum.bc.constant.omega = 31.415926536
momentum.bc.type.xlo = dirichlet dirichlet
momentum.bc.val.xlo  = "(amp/c0)*sin(omega*t)" "0.0"
momentum.bc.type.xhi = neumann neumann
momentum.bc.val.xhi  = "0.0" "0.0"
momentum.bc.type.ylo = periodic periodic
momentum.bc.type.yhi = periodic periodic

# ---- ENERGY BC: unused for the physical fill in primitive mode (pressure
#      drives the reconstruction), but energy_bc still fills mu_chem ghosts.
#      Keep it zero-gradient. ----
energy.bc.type.xlo = neumann
energy.bc.val.xlo  = "0.0"
energy.bc.type.xhi = neumann
energy.bc.val.xhi  = "0.0"
energy.bc.type.ylo = periodic
energy.bc.type.yhi = periodic

# eta BC: omitted -> defaults to ZeroNeumann (eta stays 0).

### REFINEMENT CRITERIA (DISABLED) ###
eta_refinement_criterion   = 1000.0
omega_refinement_criterion = 1000.0
gradu_refinement_criterion = 1000.0
rho_refinement_criterion   = 1000.0
p_refinement_criterion     = 1000.0
