# ============================================================================
# FlowChemistry / constant-volume reactor  (Hydro2, species.on = 1, chem.on = 1: native one-step Arrhenius reaction)
#
# Gas at rest in a periodic box (rho 1, p 1, gamma 1.2, cv 5 -> R = 1, T = 1), all of it "Fuel".
#     Fuel -> Product + Q,   dY/dt = -A Y exp(-T_a/T),   cv dT/dt = -Q dY/dt     (constant volume)
# so T = T_0 + Q (1 - Y)/cv exactly, p = rho R T, and
#   * T_a = 0 (this deck: A = 1, Q = 5):  Y = exp(-A t),  T = 1 + (1 - exp(-t))      closed form
#   * T_a > 0 (chem.Ta=10 chem.A=2000 chem.Q=10 stop_time=1.5): thermal explosion; reference = the same ODE integrated
#     by scipy in the check script (ignition time = time of the steepest temperature rise).
# Checks the reaction step, its sub-stepping, the energy bookkeeping (rho E rises by Q times the fuel consumed) and that
# species stay closed (Fuel + Product = phase mass).
#
# Run (from bin/): mpirun -np 1 ./hydro2-2d-g++ ../tests/FlowChemistry/input_0D_Reactor plot_file=<dir>/output
# Check:           python3 ../tests/FlowChemistry/reference/chemistry_check.py reactor <dir> [<dir> ...]
# ============================================================================
plot_file = ./tests/FlowChemistry/output_0D_Reactor
# Check:           python3 ../tests/FlowSpecies/reference/species_check.py advection <dir> [<dir> ...]
# ============================================================================
plot_file = ./tests/FlowSpecies/output_1D_Advection
# Check:           python3 ../tests/FlowConjugateHeat/reference/becker_shock_check.py <dir> [<dir> ...]
# ============================================================================
plot_file = ./tests/FlowConjugateHeat/output_1D_BeckerShock
# Check:           python3 ../tests/FlowAblation/reference/stefan_check.py <dir>
# ============================================================================
plot_file = ./tests/FlowAblation/output_1D_Stefan
