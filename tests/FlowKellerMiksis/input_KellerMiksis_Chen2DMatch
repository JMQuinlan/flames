#@ [keller_miksis_chen2d_match]
#@ exe=hydro2
#@ dim=2

# =============================================================================
# Chen 2D Match Benchmark -- Small-amplitude linear oscillation, FIRST QUARTER
# =============================================================================
# Purpose:
#   Show one CLEAN match of the 2D-Cartesian Hydro2 sim to the Chen 2D
#   cylindrical RPE. Strategy: set up a small-amplitude oscillation around the
#   Young-Laplace equilibrium, then validate ONLY the first quarter cycle (t
#   from 0 to first peak) before NSCBC4 reflections arrive. At small amplitude
#   the wall Mach stays << 0.02 throughout, so KM and incompressible Chen 2D
#   are indistinguishable -- and Chen 2D's linear Minnaert frequency
#   (rayleigh_plesset_solver.linear_natural_frequency_chen2d) becomes the
#   tightest analytical reference we can target.
#
#   This is the "validation window" approach used by Saurel-Petitpas-Berry
#   2009 §6.3, Johnsen-Colonius 2006 §V.C, and Schmidmayer 2020 §5.2:
#   accept that subsequent cycles will be contaminated by BC reflections, and
#   only quote results from the clean part of the run.
#
# Setup -- elevated p_inf with ~14% gas over-pressure (drives expansion):
#   liquid : rho_l = 10, p_inf = 8000, gamma = 7.15, pi = 5000
#            -> c_l ~= 96.4 m/s
#   gas    : rho_g = 1,  p_g0_ic = 9500  ( ~ 13.6% over the Young-Laplace value
#            for R0 = 0.020, which would be 8000 + sigma/R0 = 8364 )
#   bubble : R0 = 0.02 m
#   sigma  = 7.28
#   mu_l   = 0
#
#   The bubble starts over-pressurized at R = R0. It expands and reaches a
#   first peak at R_max/R0 ~= 1.10 around t ~= 1.72 ms (from the Chen 2D ODE).
#
# Why it works (validation-window arithmetic, the central design constraint):
#   - Wall Mach |R'|/c_l peaks at ~ 0.019 (just inside the 0.02 KM-vs-RP
#     divergence threshold; compressibility correction is ~ a percent)
#   - First peak at  t ~ 1.72 ms  (Chen 2D ODE)
#   - Acoustic round-trip from bubble center to wall and back:
#     2 * (0.10 m) / 96.4 m/s = 2.07 ms
#   - First peak (1.72) < round-trip (2.07) with 17% margin: CLEAN window.
#   - Subsequent cycles WILL be contaminated; the analysis script reports
#     only the first-peak metrics (R_peak, t_peak) vs Chen 2D ODE.
#
# Resolution:
#   1024 x 1024 over a 0.20 m domain --> dx = 1.95e-4 m, R0/dx = 102 cpr
#   epsilon = 0.0008 m gives ~ 4 cells across the diffuse interface band.
#
# Reference: Brennen "Cavitation and Bubble Dynamics" Sec. 4.4 (linearized RP);
#   Schmidmayer-Bryngelson-Colonius JCP 402 (2020) Sec. 5.2 (2D Cartesian
#   protocol with cylindrical Minnaert correction).
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowKellerMiksis/output_KellerMiksis_Chen2DMatch

### MESHING ###
amr.plot_dt        = 2.5e-5         # 0.025 ms -- tight sampling for quarter-cycle
amr.max_grid_size  = 500000
amr.blocking_factor = 2
amr.regrid_int     = 10
amr.grid_eff       = 0.8
amr.max_level      = 0
amr.n_cell         = 512 512

nghost = 4

### TIME STEPPING ###
timestep                = 1.0e-7
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 1.0e-5
dynamictimestep.min     = 1.0e-13
cfl                     = 0.5

### DIMENSIONS ###
geometry.prob_lo     = -0.10 -0.10 0.0
geometry.prob_hi     =  0.10  0.10 0.0
geometry.is_periodic = 0 0 0
stop_time            = 4.0e-3     # 4 ms -- covers first peak (~3 ms) with margin

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.0008
eta.ic.expression.constant.R0      = 0.02
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EQUATION OF STATE ###
eos0.gamma = 7.15
eos0.p0    = 5000.0       # default Tammann pi -- DO NOT raise (BC issue per RPE_ValidationNotes.md)
eos0.cv    = 714.286
eos0.cp    = 1000.0

eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cv    = 714.286
eos1.cp    = 1000.0

### HYDRO INITIAL CONDITIONS ###
density0.ic.type = expression
density0.ic.expression.region0 = "10.0"

density1.ic.type = expression
density1.ic.expression.region0 = "1.0"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

# Liquid at elevated far-field pressure (raises c_l so first-peak time fits
# comfortably inside the BC reflection round-trip window)
pressure0.ic.type = expression
pressure0.ic.expression.region0 = "8000.0"

# Gas ~14% over Young-Laplace value 8364 -- mild perturbation, low Mach
pressure1.ic.type = expression
pressure1.ic.expression.region0 = "9500.0"

### VISCOSITY ###
mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### SURFACE TENSION ###
sigma = 7.28
pref  = 0.0

### BOUNDARY CONDITIONS - NSCBC4 outflow ###
density.bc.type.xhi  = nscbc_outflow
density.bc.type.xlo  = nscbc_outflow
density.bc.type.ylo  = nscbc_outflow
density.bc.type.yhi  = nscbc_outflow
energy.bc.type.xhi   = nscbc_outflow
energy.bc.type.xlo   = nscbc_outflow
energy.bc.type.ylo   = nscbc_outflow
energy.bc.type.yhi   = nscbc_outflow
momentum.bc.type.xhi = nscbc_outflow nscbc_outflow
momentum.bc.type.xlo = nscbc_outflow nscbc_outflow
momentum.bc.type.ylo = nscbc_outflow nscbc_outflow
momentum.bc.type.yhi = nscbc_outflow nscbc_outflow

# Far-field target = liquid pressure
nscbc.xlo.type = outflow
nscbc.xlo.target_p = 8000.0
nscbc.xlo.sigma = 0.15
nscbc.xlo.beta  = 0.5
nscbc.xlo.L_ref = 0.20
nscbc.xlo.target_u = 0.0
nscbc.xlo.target_v = 0.0

nscbc.xhi.type = outflow
nscbc.xhi.target_p = 8000.0
nscbc.xhi.sigma = 0.15
nscbc.xhi.beta  = 0.5
nscbc.xhi.L_ref = 0.20
nscbc.xhi.target_u = 0.0
nscbc.xhi.target_v = 0.0

nscbc.ylo.type = outflow
nscbc.ylo.target_p = 8000.0
nscbc.ylo.sigma = 0.15
nscbc.ylo.beta  = 0.5
nscbc.ylo.L_ref = 0.20
nscbc.ylo.target_u = 0.0
nscbc.ylo.target_v = 0.0

nscbc.yhi.type = outflow
nscbc.yhi.target_p = 8000.0
nscbc.yhi.sigma = 0.15
nscbc.yhi.beta  = 0.5
nscbc.yhi.L_ref = 0.20
nscbc.yhi.target_u = 0.0
nscbc.yhi.target_v = 0.0

nscbc.small = 1.0e-10

### REFINEMENT (off for first validation) ###
eta_refinement_criterion   = 1.0e+10
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

### PHYSICS FLAGS ###
apply_surface_tension = 1
apply_buoyancy        = 0
apply_weight          = 0
apply_vaporization    = 0
grav                  = 0.0

Riemann_Solver.type = hllc
kappa_method        = 1

apply_sharpening     = 0
sharpening_frequency = 50
reinit_max_iter      = 100
reinit_tolerance     = 1e-6
omega_relax          = 0.5
