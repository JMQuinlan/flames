#@ [keller_miksis_mild_oscillation]
#@ exe=hydro2
#@ dim=2

# =============================================================================
# Keller-Miksis Benchmark -- MILD Oscillation (2D Cartesian, scaled units)
# =============================================================================
# Companion to input_KellerMiksis_DrivenCollapse, but tuned for OSCILLATION
# rather than violent collapse:
#
#   - p_inf / p_g0 = 3  (vs 20 in the driven-collapse case)
#   - peak wall Mach |R'|/c_l ~ 0.05-0.10  (KM regime, but mild)
#   - bubble undergoes 2-3 visible cycles before BC reflections contaminate
#   - amplitude decay across cycles is the headline KM-vs-RP signature
#     (incompressible RP has no acoustic radiation -> zero damping; KM has
#     ~ omega_0 * R_eq / (2 * c_l) per cycle)
#
# Setup:
#   liquid (water analog): rho_l = 10, p_inf = 1500   (3 x p_g0)
#                          Tammann gamma = 7.15, pi = 5000
#   gas    (air   analog): rho_g = 1, p_g0 = 500
#                          ideal gas, gamma = 1.4
#   bubble: R0 = 0.02 m  (1/5 of half-domain --> 5*R0 to wall)
#   sigma = 7.28
#   mu_l  = 0
#
# Expected dynamics (from KM ODE in rayleigh_plesset_solver.py):
#   - first collapse:  R_min/R0 ~ 0.65,  wall Mach peak ~ 0.07
#   - rebound to R/R0 ~ 0.95
#   - second collapse: R_min/R0 ~ 0.75,  wall Mach ~ 0.04
#   - oscillation period ~ 1.2-1.5 ms
#   - 2-3 cycles in 5 ms before round-trip noise from NSCBC4
#
# Domain & duration:
#   The acoustic round-trip across the 0.20 m domain at c_l = 63 m/s is ~ 3.2 ms.
#   stop_time = 5.0 ms catches the first 2-3 oscillations cleanly. Treat data
#   beyond ~ 3 ms with caution -- BC reflections may distort.
#
# Reference: Schmidmayer-Bryngelson-Colonius JCP 402 (2020) 109080, Sec. 5.2
#            ("acoustically forced bubble", same protocol).
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowKellerMiksis/output_KellerMiksis_MildOscillation
#plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowKellerMiksis/output_KellerMiksis_MildOscillation

Riemann_Solver.type = hllc
#Limiter.type        = weno3
nghost = 4
#integration.type    = RungeKutta
#integration.rk.type = 3

### MESHING ###
amr.plot_dt        = 2.5e-5         # 0.025 ms -- tighter sampling for oscillations
amr.max_grid_size  = 500000
amr.blocking_factor = 2
amr.regrid_int     = 10
amr.grid_eff       = 0.8
amr.max_level      = 0
amr.n_cell         = 256 256     # match the converged-resolution KM-collapse run

### TIME STEPPING ###
timestep                = 1.0e-7
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 1.0e-5
dynamictimestep.min     = 1.0e-13
cfl                     = 0.1 # 0.5

### DIMENSIONS ###
geometry.prob_lo     = -0.10 -0.10 0.0
geometry.prob_hi     =  0.10  0.10 0.0
geometry.is_periodic = 0 0 0
stop_time            = 12.0e-3     # 5 ms -- captures 2-3 oscillation cycles

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.0024 # 0.0008
eta.ic.expression.constant.R0      = 0.02
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EQUATION OF STATE ###
eos0.gamma = 7.15
eos0.p0    = 2.0e5
eos0.cv    = 714.286
eos0.cp    = 1000.0

eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cv    = 714.286
eos1.cp    = 1000.0

### HYDRO INITIAL CONDITIONS ###
density0.ic.type = expression
density0.ic.expression.region0 = "10.0"

density1.ic.type = expression
density1.ic.expression.region0 = "1.0"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

pressure0.ic.type = expression
pressure0.ic.expression.region0 = "1500.0"   # liquid driven (3x p_g0) -- MILD

pressure1.ic.type = expression
pressure1.ic.expression.region0 = "500.0"

### VISCOSITY ###
mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### SURFACE TENSION ###
sigma = 7.28
pref  = 0.0

### BOUNDARY CONDITIONS - NSCBC4 outflow on all 4 sides ###
density.bc.type.xhi  = nscbc_outflow
density.bc.type.xlo  = nscbc_outflow
density.bc.type.ylo  = nscbc_outflow
density.bc.type.yhi  = nscbc_outflow
energy.bc.type.xhi   = nscbc_outflow
energy.bc.type.xlo   = nscbc_outflow
energy.bc.type.ylo   = nscbc_outflow
energy.bc.type.yhi   = nscbc_outflow
momentum.bc.type.xhi = nscbc_outflow nscbc_outflow
momentum.bc.type.xlo = nscbc_outflow nscbc_outflow
momentum.bc.type.ylo = nscbc_outflow nscbc_outflow
momentum.bc.type.yhi = nscbc_outflow nscbc_outflow

# Far-field target = liquid pressure (mild driving)
nscbc.xlo.type = outflow
nscbc.xlo.target_p = 1500.0
nscbc.xlo.sigma = 0.15
nscbc.xlo.beta  = 0.5
nscbc.xlo.L_ref = 0.20
nscbc.xlo.target_u = 0.0
nscbc.xlo.target_v = 0.0

nscbc.xhi.type = outflow
nscbc.xhi.target_p = 1500.0
nscbc.xhi.sigma = 0.15
nscbc.xhi.beta  = 0.5
nscbc.xhi.L_ref = 0.20
nscbc.xhi.target_u = 0.0
nscbc.xhi.target_v = 0.0

nscbc.ylo.type = outflow
nscbc.ylo.target_p = 1500.0
nscbc.ylo.sigma = 0.15
nscbc.ylo.beta  = 0.5
nscbc.ylo.L_ref = 0.20
nscbc.ylo.target_u = 0.0
nscbc.ylo.target_v = 0.0

nscbc.yhi.type = outflow
nscbc.yhi.target_p = 1500.0
nscbc.yhi.sigma = 0.15
nscbc.yhi.beta  = 0.5
nscbc.yhi.L_ref = 0.20
nscbc.yhi.target_u = 0.0
nscbc.yhi.target_v = 0.0

nscbc.small = 1.0e-10

### REFINEMENT (off for first validation) ###
eta_refinement_criterion   = 1.0e+10
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

### PHYSICS FLAGS ###
apply_surface_tension = 1
apply_buoyancy        = 0
apply_weight          = 0
apply_vaporization    = 0
grav                  = 0.0

kappa_method        = 1

apply_sharpening     = 0
sharpening_frequency = 50
reinit_max_iter      = 100
reinit_tolerance     = 1e-6
omega_relax          = 0.5

apply_ahe   = 1
ahe.method  = 0
relax_diag = 1
