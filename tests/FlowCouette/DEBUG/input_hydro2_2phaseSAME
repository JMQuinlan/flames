#@ [2d-serial]
#@ exe=hydro2
#@ dim=2
#@

alamo.program = hydro2

### OUTPUT ###
#plot_file = /mmfs1/home/ttryon/flames/bin/tests/CouetteFlow/CouetteFlow2Phase
plot_file = tests/CouetteFlow/CouetteFlow2Phase

### MESHING ###
#amr.plot_dt = 1e-5
amr.plot_int = 1
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.regrid_int = 100
amr.grid_eff = 0.8
amr.max_level = 0
amr.n_cell = 160 32

### TIME STEPING ###
## Static:
timestep  = 1e-9
## Adaptive
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 1e-3
dynamictimestep.min = 1e-12
cfl = 0.8

### DIMENSIONS ###
geometry.prob_lo = -0.05 -0.005 0.0 # [ m ]
geometry.prob_hi =  0.05  0.005 0.0 # [ m ]
geometry.is_periodic = 1 0 0

 
### TIME STEP ###
stop_time = 10.0

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.0005
eta.ic.expression.region0 = "0.5 * (1.0 + tanh((y) / epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###
# Air properties (fluid 0)
gamma0 = 7.154   # Air
p0_0 = 3.0e8       # Ideal gas
mu0 = 1.0e-3   # Air viscosity [Pa-s]
mu0_b = 0.001

# Water properties (fluid 1)
gamma1 = 7.15  # Water
p0_1 = 3.0e8   # Tammann EOS parameter for water
mu1 = 1.0e-3   # Water viscosity [Pa-s]
mu1_b = 0.001


# Densities
density0.ic.type = expression
density0.ic.expression.region0 = "997.0"  # Air density at 2 bar [kg/m3] 

density1.ic.type = expression
density1.ic.expression.region0 = "997.0"  # Water density [kg/m3]

# Velocities (initially at rest)
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

# Pressures
pressure0.ic.type = expression
pressure0.ic.expression.region0 = "100000"  # Air at Equiulibrium

pressure1.ic.type = expression
pressure1.ic.expression.region0 = "100000"  # Water at 1 bar [Pa]

# Temperatures
temperature0.ic.type = expression
temperature0.ic.expression.region0 = "293.15"  # 20 C

temperature1.ic.type = expression
temperature1.ic.expression.region0 = "293.15"  # 20 C

# Thermodynamic properties
cp0.ic.type = expression
cp0.ic.expression.region0 = "4179.0"  # Water specific heat [J/kg-K]

cp1.ic.type = expression
cp1.ic.expression.region0 = "1005.0"  # Air specific heat [J/kg-K]

cv0.ic.type = expression
cv0.ic.expression.region0 = "4179.0/7.15"  # Water cv = cp/gamma

cv1.ic.type = expression
cv1.ic.expression.region0 = "717.86"  # Air cv = cp/gamma

# Thermal conductivities
k0_thermal.ic.type = expression
k0_thermal.ic.expression.region0 = "0.6"  # Water [W/m-K]

k1_thermal.ic.type = expression
k1_thermal.ic.expression.region0 = "0.026"  # Air [W/m-K]

h0_thermal.ic.type = expression
h0_thermal.ic.expression.region0 = "4179.0"  # Water heat transfer coefficient

h1_thermal.ic.type = expression
h1_thermal.ic.expression.region0 = "1005.0"  # Air heat transfer coefficient

# Surface tension
sigma = 0.0

# Vapor Diffusivity
Dv = 0.0

# Reference pressure
pref = 0.0

### BOUNDARY CONDITIONS ###
density.bc.type.xhi = periodic
density.bc.type.xlo = periodic
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann
#density.bc.val.xhi = 0.0
#density.bc.val.xlo = 0.0
#density.bc.val.ylo = 0.0
#density.bc.val.yhi = 0.0

energy.bc.type.xhi = periodic
energy.bc.type.xlo = periodic
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann
#energy.bc.val.xhi = 0.0
#energy.bc.val.xlo = 0.0
#energy.bc.val.ylo = 0.0 
#energy.bc.val.yhi = 0.0

momentum.bc.type.xlo = periodic periodic
momentum.bc.type.xhi = periodic periodic
momentum.bc.type.ylo = dirichlet dirichlet
momentum.bc.type.yhi = dirichlet dirichlet
#momentum.bc.val.xlo = 0.0 0.0
#momentum.bc.val.xhi = 0.0 0.0
momentum.bc.val.ylo = 0.0 0.0
momentum.bc.val.yhi = 1.0 0.0


### REFINEMENT CRITERIA ###
eta_refinement_criterion = 10000000000
omega_refinement_criterion = 10.55
p_refinement_criterion = 1e+4
rho_refinement_criterion = 1e+2
gradu_refinement_criterion = 1e+2
cutoff = 1e-16

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value = 0.0 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 0
apply_buoyancy = 0
apply_weight = 0
apply_vaporization = 0
Spec_Vol = 1
grav = 9.81

### DEBUGGING ### 
# Used for testing of the model
Riemann_Solver = 1 # Valid Entries: 0:"Roe" / 1:"HLLC" / 2:"HLLE" / 3:"Mixed"
kappa_method = 2   # Valid Entries: 1:"Regular" / 2:"Runnels Regularization"
scheme = 0		   # Valid Entries: 0:"Forward Euler" / 1:"SSPRK3" / 2:"RK4"
Limiter = 0        # Valid Entries: 0:"None" / 1:"MinMod" / 2:"Van Leer"
