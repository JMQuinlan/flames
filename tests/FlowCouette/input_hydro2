#@ exe=hydro2
#@ dim=2
# alamo.program = hydro2


### OUTPUT ###
plot_file = ./tests/FlowCouette/output

### MESHING ###
amr.plot_dt = 0.5
amr.max_level = 1
amr.max_grid_size = 500000
amr.blocking_factor = 2
#amr.regrid_int = 100
amr.grid_eff = 0.8
amr.n_cell = 4 64 0

### DIMENSIONS ###
geometry.prob_lo = 0.0 0.0 0.0 # [ m ] 
geometry.prob_hi = 0.1875 3.0 0.0 # [ m ]
geometry.is_periodic = 1 0 0

### TIME STEP ###

timestep  = 1.0e-3
stop_time = 30.0

### HYDRO PARAM ###

gamma_eta1 = 1.4
gamma_eta0 = 1.4
cfl   = 0.4
mu_eta1   = 1.0
mu_eta0   = 10.0


### ETA IC ###

eta.ic.type = expression
eta.ic.expression.constant.eps   = 0.20
eta.ic.expression.region0        = "(0.5*tanh((y - 0.5)/eps) - 0.5*tanh((y - 2.5)/eps))"
epsilon = eta.ic.expression.constant.eps

m0.ic.type = constant
m0.ic.constant.value = "0.0"

u0.ic.type = expression
u0.ic.expression.region0 = "0.001*(y>1.5)"
u0.ic.expression.region1 = "0.0"

q.ic.type = expression
q.ic.expression.region0 = "0.0"
q.ic.expression.region1 = "0.0"

density_eta1.ic.type = expression
density_eta1.ic.expression.region0 = "100.0"

velocity_eta1.ic.type = expression
velocity_eta1.ic.expression.region0 = "0.0"
velocity_eta1.ic.expression.region1 = "0.0"

pressure_eta1.ic.type = expression
pressure_eta1.ic.expression.region0 = "100.0"

density_eta0.ic.type = expression
density_eta0.ic.expression.region0 = "100.0"

velocity_eta0.ic.type = expression
velocity_eta0.ic.expression.region0 = "0.1*(y>1.5)" #"0.5*(tanh((y-1.5)/.05) + 1)" # 0 at bottom plate and 1 at top plate
velocity_eta0.ic.expression.region1 = "0.0"

pressure_eta0.ic.type = expression
pressure_eta0.ic.expression.region0 = "100.0"

cp_eta1 = "1.4"
cv_eta1 = "1.0"

cp_eta0 = "1.4"
cv_eta0 = "1.0"

### HYDRO BC ###
pf.eta.bc.type.xlo = neumann
pf.eta.bc.type.xhi = neumann
pf.eta.bc.type.ylo = neumann
pf.eta.bc.type.yhi = neumann

density.bc.type.xhi = periodic
density.bc.type.xlo = periodic
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann
density.bc.val.xhi = 0.0
density.bc.val.xlo = 0.0
density.bc.val.ylo = 0.0
density.bc.val.yhi = 0.0

energy.bc.type.xhi = periodic
energy.bc.type.xlo = periodic
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann
energy.bc.val.xhi = 0.0
energy.bc.val.xlo = 0.0
energy.bc.val.ylo = 0.0 
energy.bc.val.yhi = 0.0

momentum.bc.type.xlo = periodic periodic
momentum.bc.type.xhi = periodic periodic
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann
momentum.bc.val.xlo = 0.0 0.0
momentum.bc.val.xhi = 0.0 0.0
momentum.bc.val.ylo = 0.0 0.0
momentum.bc.val.yhi = 0.0 0.0

### HYDRO REFINEMENT CRITERIA ###
eta_refinement_criterion   = 100000.1
omega_refinement_criterion = 100000.1
gradu_refinement_criterion = 100000.0
rho_refinement_criterion   = 100000.0
p_refinement_criterion     = 100000.0

static_eta = 1
Spec_Vol = 1

Riemann_Solver.type = hllc
