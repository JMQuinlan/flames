#@ [case1]
#@ exe=hydro2
#@ dim=3

# 3D AMR Garrick (Riemann normal to x) -- exercises the 3D coarse-fine reflux:
# the interface at x=0 is refined one level, so x/y/z-face flux registers and
# the cc->face conversion (k-shift + 3D face areas) all get exercised.

### OUTPUT ###
plot_file = ./tests/FlowRiemannUnitTests/output_Garrick_x_AMR
Riemann_Solver.type = hllc
Limiter.type        = weno3
nghost = 4
integration.type    = RungeKutta
integration.rk.type = 3

eta.ic.type = expression
eta.ic.expression.constant.epsilon = "1.25e-3"
eta.ic.expression.region0 = "0.5 * (1.0 + tanh(x / epsilon))"
epsilon = eta.ic.expression.constant.epsilon

amr.plot_int = 50

### MESHING (1 refinement level; interface refined) ###
amr.max_level = 1
amr.ref_ratio = 2
amr.max_grid_size = 500000
amr.blocking_factor = 8
amr.grid_eff = 0.7
amr.n_cell = 400 16 16

### DIMENSIONS ###
geometry.prob_lo = -1.0  -0.04  -0.04 # [ m ]
geometry.prob_hi =  1.0   0.04   0.04 # [ m ]
geometry.is_periodic = 0 1 1

### TIME STEP ###
timestep  = 1.0e-4
stop_time = 0.2

m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0
q.ic.type = constant
q.ic.constant.value = 0.0

### HYDRO PARAM ###
cfl   = 0.4
relax_diag = 0

## EOS ##
eos0.gamma = 5.5
eos1.gamma = 1.4
eos0.p0 = 1.505
eos1.p0 = 0.0
eos0.cp = 1004.5
eos1.cp = 1004.5
eos0.cv = 717.5
eos1.cv = 717.5

mu0   = 0.0
mu1   = 0.0
sigma = 0.0
pref  = 0.0

### IC State - Fluid 0 (x < 0) - LIQUID ###
density0.ic.type = constant
density0.ic.constant.value = 0.991
velocity0.ic.type = constant
velocity0.ic.constant.value = 0.0 0.0
pressure0.ic.type = constant
pressure0.ic.constant.value = 3.059e-4
cp0 = 1.4
cv0 = 1.0

### IC State - Fluid 1 (x > 0) - GAS ###
density1.ic.type = constant
density1.ic.constant.value = 1.241
velocity1.ic.type = constant
velocity1.ic.constant.value = 0.0 0.0
pressure1.ic.type = constant
pressure1.ic.constant.value = 2.753
cp1 = 1.4
cv1 = 1.0

### HYDRO BC ###
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = periodic
density.bc.type.yhi = periodic
density.bc.type.zlo = periodic
density.bc.type.zhi = periodic

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = periodic
energy.bc.type.yhi = periodic
energy.bc.type.zlo = periodic
energy.bc.type.zhi = periodic

momentum.bc.type.xhi = neumann neumann neumann
momentum.bc.type.xlo = neumann neumann neumann
momentum.bc.type.ylo = periodic periodic periodic
momentum.bc.type.yhi = periodic periodic periodic
momentum.bc.type.zlo = periodic periodic periodic
momentum.bc.type.zhi = periodic periodic periodic

### HYDRO REFINEMENT CRITERIA (refine the interface) ###
eta_refinement_criterion   = 0.5
omega_refinement_criterion = 100000.1
gradu_refinement_criterion = 100000.0
rho_refinement_criterion   = 100000.0
p_refinement_criterion     = 100000.0

kappa_method = 1
Dv = 0
g = 0.0
apply_surface_tension = 0
apply_weight = 0
apply_vaporization = 0
apply_sharpening = 0

apply_ahe   = 1
ahe.method  = 0
