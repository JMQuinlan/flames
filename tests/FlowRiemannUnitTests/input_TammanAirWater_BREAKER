#@ [case1]
#@ exe=hydro2
#@ dim=2

# alamo.program = hydro2

### IMPORTANT: SEE https://faculty.washington.edu/rjl/riemann_book/Euler_equations_TammannEOS.html
### WARNING: This test is designed to push the code to the limits fast to quickly debug. 
###				- Contains Tamman EOS for water
###				- Contains hypersonic shock for air
###				- Contains dynamic timestepping
###				- Contains AMR

### OUTPUT ###

plot_file = ./tests/FlowRiemannUnitTests/output

### MESHING ###
amr.plot_int = 20
amr.max_level = 1
amr.regrid_int = 10
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.grid_eff = 0.8
amr.n_cell = 800 32

### DIMENSIONS ###
geometry.prob_lo = -5.0  -0.2   0.0 # [ m ]
geometry.prob_hi =  5.0   0.2   0.0 # [ m ]
geometry.is_periodic = 0 0 0

### TIME STEP ###
stop_time = 1.0
## Static:
timestep  = 1e-9
## Adaptive
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 1e-5
dynamictimestep.min = 1e-12
cfl = 0.5

### ETA IC ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0
q.ic.type = constant
q.ic.constant.value = 0.0

# Set eta to 1 for water (left) and 0 for air (right)
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.005  # Interface thickness
eta.ic.expression.region0 = "0.5 * (1.0 + tanh(-(x*x + 2*x)/epsilon))"  # Water on left, air on right
epsilon = eta.ic.expression.constant.epsilon


### HYDRO PARAM ###
gamma0 = 1.4		 # Air gamma
p0_0 = 0.0           # Air (ideal gas, no Tammann term)
b0 = 0				 # Air Covolume

gamma1 = 7.15        # Water gamma
p0_1 = 3.31e8         # Water Tammann EOS parameter
b1 = 6.61e-4		 # Water Covolume


cfl = 0.4
mu0 = 0.0
mu1 = 0.0

### Surface tension coefficient ###
sigma = 1000000.0

### Reference pressure ###
pref = 0.0

### IC State ###
# Densities - Water (1000 kg/m³) on left, Air (1.2 kg/m³) on right
density0.ic.type = expression
density0.ic.expression.region0 = "20.0"

density1.ic.type = expression
density1.ic.expression.region0 = "1000.0"

# Velocities - Initially at rest
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "1750.0" # FAST AS F BOIIII
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

# Pressures - Equal pressure on both sides (1 bar = 10^5 Pa)
pressure0.ic.type = expression
pressure0.ic.expression.region0 = "20.0e5" # Not bad as venus

pressure1.ic.type = expression
pressure1.ic.expression.region0 = "1.0e5"

# Temperatures
temperature0.ic.type = expression
temperature0.ic.expression.region0 = "293.15"  # 20°C

temperature1.ic.type = expression
temperature1.ic.expression.region0 = "293.15"  # 20°C

# Thermodynamic properties - Water
cp0.ic.type = expression
cp0.ic.expression.region0 = "4179.0"  # Water specific heat [J/kg·K]

cv0.ic.type = expression
cv0.ic.expression.region0 = "4179.0/7.15"  # Water cv = cp/gamma

# Thermodynamic properties - Air
cp1.ic.type = expression
cp1.ic.expression.region0 = "1005.0"  # Air specific heat [J/kg·K]

cv1.ic.type = expression
cv1.ic.expression.region0 = "717.86"  # Air cv = cp/gamma

# Thermal properties
k0_thermal.ic.type = expression
k0_thermal.ic.expression.region0 = "0.6"  # Water [W/m·K]

k1_thermal.ic.type = expression
k1_thermal.ic.expression.region0 = "0.026"  # Air [W/m·K]

h0_thermal.ic.type = expression
h0_thermal.ic.expression.region0 = "4179.0"  # Water heat transfer coefficient

h1_thermal.ic.type = expression
h1_thermal.ic.expression.region0 = "1005.0"  # Air heat transfer coefficient

### ETA BC  ###
pf.eta.bc.type.xlo = neumann
pf.eta.bc.type.xhi = neumann
pf.eta.bc.type.ylo = neumann
pf.eta.bc.type.yhi = neumann


### HYDRO BC ###
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann

momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

#momentum.bc.type.xhi = dirichlet dirichlet
#momentum.bc.type.xlo = dirichlet dirichlet
#momentum.bc.type.ylo = dirichlet dirichlet
#momentum.bc.type.yhi = dirichlet dirichlet
#momentum.bc.val.xhi = 0.0 0.0
#momentum.bc.val.xlo = 0.0 0.0
#momentum.bc.val.ylo = 0.0 0.0
#momentum.bc.val.yhi = 0.0 0.0

### HYDRO REFINEMENT CRITERIA ###
eta_refinement_criterion   = 0.01  # Enable refinement at interface
omega_refinement_criterion = 100000.1
gradu_refinement_criterion = 100000.0
rho_refinement_criterion   = 100000.0
p_refinement_criterion     = 100000.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 1  # Enable surface tension
apply_buoyancy = 0        # Not needed, using gravity instead
apply_weight = 1          # Enable gravity

### NUMERICAL METHODS ###
Riemann_Solver.type = hllc
Limiter.type        = weno3
integration.type    = RungeKutta
integration.rk.type = 3
