#@ [case1]
#@ exe=hydro2
#@ dim=2

# Garrick et al. (2017) Section 4.1 - Gas-Liquid Riemann Problem
# Reference: https://www.sciencedirect.com/science/article/pii/S0021999117301948
# Equation 68

### OUTPUT ###
plot_file = ./tests/FlowRiemannUnitTests/output_Garrick_GasLiquid2
Riemann_Solver.type = hllc

# Interface at x=0 (sharp transition)
eta.ic.type = expression
eta.ic.expression.constant.epsilon = "1.25e-3"
eta.ic.expression.region0 = "0.5 * (1.0 + tanh(x / epsilon))" 
epsilon = eta.ic.expression.constant.epsilon

amr.plot_int = 1

### MESHING ###
amr.max_level = 0
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.grid_eff = 0.8
amr.n_cell = 800 16

### DIMENSIONS ###
geometry.prob_lo = -1.0  -0.02   0.0 # [ m ]
geometry.prob_hi =  1.0   0.02   0.0 # [ m ]
geometry.is_periodic = 0 1 0

### TIME STEP ###
timestep  = 2.5e-4
#stop_time = 0.2
stop_time = 0.2

m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0
q.ic.type = constant
q.ic.constant.value = 0.0

### HYDRO PARAM ###
gamma0 = 5.5   
gamma1 = 1.4 
cfl   = 0.4
mu0   = 0.0
mu1   = 0.0
p0_0  = 1.505 
p0_1  = 0.0  

### Surface tension coefficient ###
sigma = 0.0       # No surface tension in this test

### Reference pressure ###
pref = 0.0

### IC State - Fluid 0 (LEFT side, x < 0) - LIQUID ###

density0.ic.type = constant
density0.ic.constant.value = 0.991    

velocity0.ic.type = constant
velocity0.ic.constant.value = 0.0 0.0

pressure0.ic.type = constant
pressure0.ic.constant.value = 3.059e-4  

cp0 = 1.4
cv0 = 1.0

### IC State - Fluid 1 (RIGHT side, x > 0) - GAS ###
density1.ic.type = constant
density1.ic.constant.value = 1.241  

velocity1.ic.type = constant
velocity1.ic.constant.value = 0.0 0.0

pressure1.ic.type = constant
pressure1.ic.constant.value = 2.753 

cp1 = 1.4
cv1 = 1.0

### ETA BC  ###
### HYDRO BC ###
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = periodic
density.bc.type.yhi = periodic

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = periodic
energy.bc.type.yhi = periodic

momentum.bc.type.xhi = dirichlet dirichlet
momentum.bc.type.xlo = dirichlet dirichlet
momentum.bc.type.ylo = dirichlet dirichlet
momentum.bc.type.yhi = dirichlet dirichlet

### HYDRO REFINEMENT CRITERIA ###
eta_refinement_criterion   = 100000.1
omega_refinement_criterion = 100000.1
gradu_refinement_criterion = 100000.0
rho_refinement_criterion   = 100000.0
p_refinement_criterion     = 100000.0

Spec_Vol = 1
kappa_method = 1
Dv = 0
g = 0.0
apply_surface_tension = 0
apply_weight = 0
apply_vaporization = 0
