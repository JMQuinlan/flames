#@ [case1]
#@ exe=hydro2
#@ dim=3

# 3D NSCBC test: Garrick Riemann normal to z, with NSCBC non-reflecting OUTFLOW
# on the z-lo and z-hi faces (x,y transverse periodic).  Exercises the new 3D
# Z-LO / Z-HI NSCBC4 face blocks.

### OUTPUT ###
plot_file = ./tests/FlowRiemannUnitTests/output_Garrick_z_NSCBC
Riemann_Solver.type = hllc
Limiter.type        = weno3
nghost = 4
integration.type    = RungeKutta
integration.rk.type = 3

eta.ic.type = expression
eta.ic.expression.constant.epsilon = "1.25e-3"
eta.ic.expression.region0 = "0.5 * (1.0 + tanh(z / epsilon))"
epsilon = eta.ic.expression.constant.epsilon

amr.plot_int = 50

### MESHING ###
amr.max_level = 0
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.grid_eff = 0.8
amr.n_cell = 16 16 800

### DIMENSIONS ###
geometry.prob_lo = -0.02  -0.02  -1.0
geometry.prob_hi =  0.02   0.02   1.0
geometry.is_periodic = 1 1 0

### TIME STEP ###
timestep  = 1.0e-4
stop_time = 0.2

m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0
q.ic.type = constant
q.ic.constant.value = 0.0

### HYDRO PARAM ###
cfl   = 0.4
relax_diag = 0

## EOS ##
eos0.gamma = 5.5
eos1.gamma = 1.4
eos0.p0 = 1.505
eos1.p0 = 0.0
eos0.cp = 1004.5
eos1.cp = 1004.5
eos0.cv = 717.5
eos1.cv = 717.5

mu0   = 0.0
mu1   = 0.0
sigma = 0.0
pref  = 0.0

### IC State - Fluid 0 (z < 0) - LIQUID ###
density0.ic.type = constant
density0.ic.constant.value = 0.991
velocity0.ic.type = constant
velocity0.ic.constant.value = 0.0 0.0
pressure0.ic.type = constant
pressure0.ic.constant.value = 3.059e-4
cp0 = 1.4
cv0 = 1.0

### IC State - Fluid 1 (z > 0) - GAS ###
density1.ic.type = constant
density1.ic.constant.value = 1.241
velocity1.ic.type = constant
velocity1.ic.constant.value = 0.0 0.0
pressure1.ic.type = constant
pressure1.ic.constant.value = 2.753
cp1 = 1.4
cv1 = 1.0

### HYDRO BC : x,y periodic ; z = NSCBC non-reflecting outflow ###
density.bc.type.xlo = periodic
density.bc.type.xhi = periodic
density.bc.type.ylo = periodic
density.bc.type.yhi = periodic
density.bc.type.zlo = nscbc_outflow
density.bc.type.zhi = nscbc_outflow

energy.bc.type.xlo = periodic
energy.bc.type.xhi = periodic
energy.bc.type.ylo = periodic
energy.bc.type.yhi = periodic
energy.bc.type.zlo = nscbc_outflow
energy.bc.type.zhi = nscbc_outflow

momentum.bc.type.xlo = periodic periodic periodic
momentum.bc.type.xhi = periodic periodic periodic
momentum.bc.type.ylo = periodic periodic periodic
momentum.bc.type.yhi = periodic periodic periodic
momentum.bc.type.zlo = nscbc_outflow nscbc_outflow nscbc_outflow
momentum.bc.type.zhi = nscbc_outflow nscbc_outflow nscbc_outflow

### NSCBC PARAMETERS ###
nscbc.small = 1.0e-10
# z-lo : liquid side (p ~ 3.059e-4)
nscbc.zlo.type     = outflow
nscbc.zlo.target_p = 3.059e-4
nscbc.zlo.sigma    = 0.25
nscbc.zlo.beta     = 0.5
nscbc.zlo.L_ref    = 0.20
nscbc.zlo.target_u = 0.0
nscbc.zlo.target_v = 0.0
# z-hi : gas side (p ~ 2.753)
nscbc.zhi.type     = outflow
nscbc.zhi.target_p = 2.753
nscbc.zhi.sigma    = 0.25
nscbc.zhi.beta     = 0.5
nscbc.zhi.L_ref    = 0.20
nscbc.zhi.target_u = 0.0
nscbc.zhi.target_v = 0.0

### HYDRO REFINEMENT CRITERIA ###
eta_refinement_criterion   = 100000.1
omega_refinement_criterion = 100000.1
gradu_refinement_criterion = 100000.0
rho_refinement_criterion   = 100000.0
p_refinement_criterion     = 100000.0

kappa_method = 1
Dv = 0
g = 0.0
apply_surface_tension = 0
apply_weight = 0
apply_vaporization = 0
apply_sharpening = 0

apply_ahe   = 1
ahe.method  = 0
