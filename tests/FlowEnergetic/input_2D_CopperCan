pressure1.ic.expression.region0 = "1.0e5 + (1.0e9 - 1.0e5)*(x < 0.107)*((0.25*(1.0 + tanh((x - 0.097)/w))*(1.0 - tanh((x - 0.303)/w))*0.5*(1.0 - tanh((y - 0.096)/w))) > 0.5)"
