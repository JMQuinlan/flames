#@ [r000850000]
#@ exe=hydro2
#@ dim=2
# =============================================================================
# MARMOTTANT COATED-BUBBLE STATIC LAPLACE TEST  --  R0 = 8.50000000e-04 m
# =============================================================================
# TEMPLATE.  RUN_MARMOTTANT_SWEEP.bash fills the @...@ placeholders per case.
# Do not run this file directly.
#
# Shell (Marmottant 2005), sigma as a function of AREAL STRAIN carried by the
# advected shell density Gamma (NOT re-derived from curvature):
#
#     sigma(Gamma) = 0                                Gamma >= Gamma_buck   (buckled)
#                    chi (Gamma_buck/Gamma - 1)       ramp                  (elastic)
#                    sigma_break                      Gamma <= Gamma_rupt   (ruptured)
#
#   chi        = 0.55 N/m        shell elastic modulus
#   R_buckling = 1.0e-3 m        sigma = 0 at and below this radius
#   sigma_brk  = 0.073 N/m     rupture tension (= clean-liquid sigma)
#   R_rupture  = 1.06429661e-03 m        = R_buckling sqrt(1 + sigma_brk/chi)
#
# This case:  R0/R_buckling = 0.85  ->  buckled branch,  sigma_eff = 0.00000000e+00 N/m
#
# Laplace balance (2D cylindrical, single curvature):
#     p_gas - p_liquid = sigma_eff / R0 = 0.000000 Pa   ->   p_gas = 101325.000000 Pa
# The bubble starts in mechanical equilibrium, so the CORRECT ANSWER IS THAT
# NOTHING MOVES.  Any radius drift, tension spread, or interfacial velocity is
# numerical.
#
# Mesh: 64x64 base + 2 AMR levels over a 5.000000e-03 m box.
#   dx_finest = 1.95312500e-05 m,  epsilon = 7.81250000e-05 m  (eps/dx = 4)
# Time: capillary time sqrt(rho R^3/sigma) = 3.701166e-03 s; stop_time = 1.0e-2 s.
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = /home/ttryon/Desktop/flames2/bin/tests/FlowMarmottant/quarter/R000850000

### MESHING ###
amr.plot_dt         = 2.5e-5
amr.plot_int        = -1
amr.max_grid_size   = 500000
amr.blocking_factor = 8
amr.regrid_int      = 10
amr.grid_eff        = 0.8
amr.max_level       = 2
amr.n_cell          = 32 32

nghost = 4

### TIME STEPPING ###
timestep                 = 1.0e-12
dynamictimestep.on       = 1
dynamictimestep.verbose  = 0
dynamictimestep.max      = 1e-0
dynamictimestep.min      = 1.0e-16
cfl                      = 0.3

### DIMENSIONS ###
geometry.prob_lo     = 0.0 0.0 0.0
geometry.prob_hi     = 2.50000000e-03 2.50000000e-03 0.0
geometry.is_periodic = 0 0 0

stop_time = 1.0e-2

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 7.81250000e-05
eta.ic.expression.constant.R0      = 8.50000000e-04
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt((x)**2 + (y)**2) - R0)/(epsilon)))"
epsilon = eta.ic.expression.constant.epsilon

### EQUATIONS OF STATE ###
# phase 0 = liquid (stiffened gas), phase 1 = gas (ideal)
eos0.gamma = 2.35
eos0.p0    = 1.0e9
eos0.cp    = 4186.0
eos0.cv    = 1781.0
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cp    = 1000.0
eos1.cv    = 714.286

### HYDRO INITIAL CONDITIONS ###
density0.ic.type = expression
density0.ic.expression.region0 = "1000.0"
density1.ic.type = expression
density1.ic.expression.region0 = "1.0"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

pressure0.ic.type = expression
pressure0.ic.expression.region0 = "101325.0"      # liquid (outside, eta=1)
pressure1.ic.type = expression
pressure1.ic.expression.region0 = "101325.000000"      # gas    (inside,  eta=0)

### VISCOSITY ###
mu0   = 1.0e-3
mu0_b = 0.0
mu1   = 1.8e-5
mu1_b = 0.0

pref = 0.0

### SURFACE TENSION ###
# `sigma` is the clean-liquid tension; with marmottant=1 it is also the value
# the ruptured branch saturates at, and the one dt_capillary is sized on.
sigma = 0.073

### MARMOTTANT COATED SHELL ###
marmottant               = 1
marmottant.R0            = 8.50000000e-04        # reference radius: shell starts UNSTRAINED here
marmottant.chi           = 0.55
marmottant.R_buckling    = 1.0e-3
marmottant.sigma_break   = 0.073

### CAPILLARY FORMULATION ###
# Schmidmayer 2017 operator split  U^{n+1} = L_relax L_cap L_hyper(U^n), with
# the capillary energy sigma|grad c| carried in the conserved total energy and
# Omega built from a separately-advected colour function c.
capillary_closure = 1

### NUMERICS ###
Riemann_Solver.type = hllc
Limiter.type        = vanleer
kappa_method        = 1

### DEBUG (off for production; see Hydro2.H) ###
nan_check  = 0
verbose    = 0
relax_diag = 0

### BOUNDARY CONDITIONS - QUARTER DOMAIN (reflect xlo/ylo + NSCBC xhi/yhi)
# Bubble centre is at the origin, so xlo/ylo are exact symmetry planes.
# This removes the OPPOSING NSCBC PAIRS present in the full domain -- the
# suspected source of the centreline wave pattern -- and exercises the
# NSCBC-next-to-reflect path (nscbc.<face>.type = none) that was just fixed.
density.bc.type.xhi  = nscbc_outflow
density.bc.type.xlo  = nscbc_outflow
density.bc.type.ylo  = nscbc_outflow
density.bc.type.yhi  = nscbc_outflow
energy.bc.type.xhi   = nscbc_outflow
energy.bc.type.xlo   = nscbc_outflow
energy.bc.type.ylo   = nscbc_outflow
energy.bc.type.yhi   = nscbc_outflow
momentum.bc.type.xhi = nscbc_outflow nscbc_outflow
momentum.bc.type.xlo = REFLECT_ODD  REFLECT_EVEN
momentum.bc.type.ylo = REFLECT_EVEN REFLECT_ODD
momentum.bc.type.yhi = nscbc_outflow nscbc_outflow

eta.bc.type.xlo = REFLECT_EVEN
eta.bc.type.xhi = neumann
eta.bc.type.ylo = REFLECT_EVEN
eta.bc.type.yhi = neumann

nscbc.xlo.type = none
nscbc.ylo.type = none
nscbc.xhi.type = outflow
nscbc.xhi.target_p = 101325.0
nscbc.xhi.sigma = 0.15
nscbc.xhi.beta  = 0.5
nscbc.xhi.L_ref = 2.500000e-03
nscbc.xhi.target_u = 0.0
nscbc.xhi.target_v = 0.0
nscbc.yhi.type = outflow
nscbc.yhi.target_p = 101325.0
nscbc.yhi.sigma = 0.15
nscbc.yhi.beta  = 0.5
nscbc.yhi.L_ref = 2.500000e-03
nscbc.yhi.target_u = 0.0
nscbc.yhi.target_v = 0.0
nscbc.small = 1.0e-10

### REFINEMENT CRITERIA ###
# ETA-ONLY refinement.  The other criteria are set to 1e10 so they never fire,
# matching the FlowLaplace unit test.  omega_refinement_criterion in particular
# tags on the VORTICITY GRADIENT -- i.e. on the parasitic currents themselves --
# which refines exactly where they are, creating more coarse-fine boundaries and
# feeding the per-phase ghost-reconstruction failure.  Measured: with these
# active the case aborts at t=5.38e-4; with them disabled it runs past 9.4e-4.
eta_refinement_criterion   = 1e-1
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1e-16

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 1
apply_buoyancy = 0
apply_weight   = 0
Spec_Vol       = 1
grav           = 0.0
