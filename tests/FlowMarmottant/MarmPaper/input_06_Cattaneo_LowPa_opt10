pressure0.ic.expression.constant.R0    = 2.950000e-06
pressure0.ic.expression.region0 = "p_inf"
pressure1.ic.type = expression
pressure1.ic.expression.constant.p_b = 1.022000e+05      # sigma(R0) = 0: gas at p0
pressure1.ic.expression.region0 = "p_b"
equalize_ic_pressure = 1

### MATERIAL / SHELL ###
