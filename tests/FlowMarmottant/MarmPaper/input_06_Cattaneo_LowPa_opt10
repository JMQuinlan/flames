# ===== OPTION 10: face.two_pressure = 1 (faces carry both phase pressures; fixes the zero-energy gas faces next to liquid in tension), shell.slip = 0
# Same as input_06_Cattaneo_LowPa except: shell.slip, constant kappa_s (shell.kappa_s_alpha = 0, the paper's shell model), plot_file,
# and the AMR layout (max_grid_size 16, n_error_buf 4) for speed.
#
# MarmPaper 06: VALIDATION against Cattaneo et al., Nature Physics 21:590 (2025), Fig. 2a (low p_a)
#
# Same ICs as the paper (their code: github.com/cttnmrc/jetting-enables-sonoporation):
#   R0 = 2.95 um, water rho 997.8, c 1481 m/s, mu 0.954e-3, p0 = 102200 Pa, T = 295 K;
#   Marmottant shell chi 0.15 N/m, kappa_s 5e-9 kg/s, sigma(R0) = 0 (R_buckling = R0), rupture at 0.0728 N/m;
#   1 MHz drive, amplitude p_a = 60 kPa (their nominal), with the MEASURED pulse envelope
#   (nscbc.drive_envelope; burst 0..40 us).  Gas-liquid heat transfer ON (their Zhou gas model is
#   heat conducting; Pe = w R0^2/D ~ 2.5, near-isothermal).
#   Cross-law shell viscosity ON (shell.kappa_s_alpha = 4e-6; remedy b).  The paper uses CONSTANT kappa_s:
#   run with shell.kappa_s_alpha=0 on the command line for the paper's shell model.
# TIME AXIS: the burst starts at t = 0 here; their Fig. 2 axis has it at ~2 us (figure t = t + 2 us).
# Their spherical model (Python port, ~/claude_scratch/papers/port_cattaneo.py) with this envelope gives
#   high p_a peaks 3.49 3.82 4.03 4.21 4.39 4.59 4.79 5.02 5.29 um in pulse cycles 1..9 (constant kappa_s);
#   Cross law: 3.56 3.97 4.19 4.39 4.70 5.20 5.95 6.70 6.94 um.  Measured (their Fig. 2a): ~3.55 4.15 4.25
#   4.35 4.45 4.6 4.7 4.95 5.1 um.
# DIFFERENCES from the experiment: free bubble (octant, no cell/substrate), so no translation, no
#   wall-driven jets; their bubble rests on a cell.  Box gain ~1 (20 R0 box << wavelength).
# stop_time = 12 us (pulse time).
#
# COMMON: RK3 + MUSCL2 + HLLC, cfl 0.9, eps/dx_finest = 2, R0/dx_finest = 25.6 (max_level 4), NSCBC far field.
alamo.program = hydro2
plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowMarmottant/MarmPaper/output_06_Cattaneo_LowPa_opt10

### OUTPUT ###
amr.plot_int       = -1
amr.plot_dt        = 2.500000e-08    # 40 frames/us (4x their camera: 10 Mfps); was 1e-7
amr.thermo.plot_dt = 1.000000e-09    # thermo.dat: gas_volume (R_vol), gas_pressure_int, kinetic_energy, interface_area
plot_minimal       = 1

### MESH ###
amr.max_grid_size  = 16   # 2026-11-10: was 32 (8 boxes per level -> most ranks idle)
amr.blocking_factor = 16
amr.regrid_int     = 10
amr.grid_eff       = 0.8
amr.max_level      = 4
amr.n_error_buf    = 4   # 2026-11-10: was 16 (2.4x fewer finest cells, 1.9x faster; band still tagged by grad eta)
nghost = 4

### GEOMETRY -- OCTANT (active); full domain below, commented ###
geometry.prob_lo     = 0.000000e+00 0.000000e+00 0.000000e+00
geometry.prob_hi     = 5.900000e-05 5.900000e-05 5.900000e-05
geometry.is_periodic = 0 0 0
amr.n_cell           = 32 32 32     # base dx 1.8438e-06; finest dx 1.1523e-07 (R0/dx 25.6)
