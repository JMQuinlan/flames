# MarmPaper: free natural spherical oscillation (micro-scale Light_Mili)
#
# Light_Mili deck shrunk to R0 = 2 um with the physical Marmottant shell: same p_inf = 1e5, p_b = 5.8307e4
# (gas below equilibrium, p_eq = 1.4123e5), same 100 R0 domain and R0/dx = 25.6.
# KM: R_min 0.829 R0 (shell buckles), decays to the new equilibrium R ~ 0.88 R0 in ~5 T0.
# stop_time = 12 T0.
#
# COMMON (all MarmPaper decks): coated 2 um bubble, Marmottant shell chi 1.0 N/m, R_buck 0.98 R0
#   (sigma(R0) = 0.0412 N/m, elastic band R/R0 0.980-1.015), kappa_s 7.2e-9 kg/s, water mu 1e-3;
#   KM linear natural frequency f0 = 4.084 MHz (T0 = 244.9 ns); RK3 + MUSCL2 + HLLC, cfl 0.5;
#   eps/dx_finest = 2; R0/dx_finest = 25.6 (max_level 4); NSCBC outflow far field.
#   Interface jump, tensor curvature, relaxation closure etc. are built into the code (flag audit 2026-11-05).
#   THINC (qq) lines below are commented out until the first round of results is in.

alamo.program = hydro2
plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowMarmottant/MarmPaper/output_01_FreeOscillation

### OUTPUT ###
amr.plot_int       = -1
amr.plot_dt        = 1.224290e-08
amr.thermo.plot_dt = 1.224290e-09    # thermo.dat: gas_volume (R_vol), gas_pressure_int, kinetic_energy, interface_area
plot_minimal       = 1

### MESH ###
amr.max_grid_size  = 32
amr.blocking_factor = 16
amr.regrid_int     = 10
amr.grid_eff       = 0.8
amr.max_level      = 4
amr.n_error_buf    = 16
nghost = 4

### GEOMETRY -- OCTANT (active); full domain below, commented ###
geometry.prob_lo     = 0.000000e+00 0.000000e+00 0.000000e+00
geometry.prob_hi     = 2.000000e-04 2.000000e-04 2.000000e-04
geometry.is_periodic = 0 0 0
amr.n_cell           = 160 160 160     # base dx 1.2500e-06; finest dx 7.8125e-08
# --- full domain (swap with the octant block above; also swap the BC block) ---
# geometry.prob_lo     = -2.000000e-04 -2.000000e-04 -2.000000e-04
# geometry.prob_hi     = 2.000000e-04 2.000000e-04 2.000000e-04
# geometry.is_periodic = 0 0 0
# amr.n_cell           = 320 320 320     # base dx 1.2500e-06; finest dx 7.8125e-08

### TIME ###
timestep                = 1.0e-12
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 1.0e-9
dynamictimestep.min     = 1.0e-18
cfl                     = 0.5
stop_time               = 2.938296e-06

### INTERFACE ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 1.562500e-07    # eps/dx_finest = 2
eta.ic.expression.constant.R0      = 2.000000e-06
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y + z*z) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EOS: 0 = water (stiffened gas), 1 = air ###
eos0.gamma = 2.35
eos0.p0    = 1.0e9
eos0.cv    = 1781.0
eos0.cp    = 4186.0
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cv    = 714.286
eos1.cp    = 1000.0

### INITIAL CONDITIONS ###
density0.ic.type = expression
density0.ic.expression.region0 = "1000.0"
density1.ic.type = expression
density1.ic.expression.region0 = "1.0"
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
velocity0.ic.expression.region2 = "0.0"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"
velocity1.ic.expression.region2 = "0.0"
pressure0.ic.type = expression
pressure0.ic.expression.constant.p_inf = 1.000000e+05
pressure0.ic.expression.constant.p_b   = 5.830700e+04
pressure0.ic.expression.constant.R0    = 2.000000e-06
pressure0.ic.expression.region0 = "p_inf - (p_inf - p_b)*R0/max(sqrt(x*x + y*y + z*z), R0)"
pressure1.ic.type = expression
pressure1.ic.expression.constant.p_b = 5.830700e+04
pressure1.ic.expression.region0 = "p_b"
equalize_ic_pressure = 1

### MATERIAL / SHELL ###
mu0   = 1.0e-3     # water
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0
apply_surface_tension = 1
sigma = 0.0728                   # water (= post-rupture tension)
pref  = 0.0
marmottant             = 1
marmottant.R0          = 2.000000e-06  # shell unstrained at the IC radius
marmottant.R_buckling  = 1.96e-6       # 0.98 R0
marmottant.chi         = 1.0           # [N/m]
marmottant.sigma_break = 0.073         # [N/m]
shell.kappa_s = 7.2e-9                  # [kg/s] (micro-scale equivalent of kappa_s = 0.72 at R0 = 2 cm)
shell.mu_s    = 0.0

### BOUNDARY CONDITIONS -- octant: symmetry (lo) + NSCBC outflow (hi) (active) ###
nscbc.xhi.type     = outflow
nscbc.xhi.target_p = 1.000000e+05
nscbc.xhi.sigma    = 0.6
nscbc.xhi.beta     = 0.5
nscbc.xhi.L_ref    = 6.250000e-07
nscbc.yhi.type     = outflow
nscbc.yhi.target_p = 1.000000e+05
nscbc.yhi.sigma    = 0.6
nscbc.yhi.beta     = 0.5
nscbc.yhi.L_ref    = 6.250000e-07
nscbc.zhi.type     = outflow
nscbc.zhi.target_p = 1.000000e+05
nscbc.zhi.sigma    = 0.6
nscbc.zhi.beta     = 0.5
nscbc.zhi.L_ref    = 6.250000e-07
eta.bc.type.xlo = REFLECT_EVEN
eta.bc.type.xhi = neumann
eta.bc.type.ylo = REFLECT_EVEN
eta.bc.type.yhi = neumann
eta.bc.type.zlo = REFLECT_EVEN
eta.bc.type.zhi = neumann
density.bc.type.xlo = REFLECT_EVEN
density.bc.type.xhi = nscbc_outflow
density.bc.type.ylo = REFLECT_EVEN
density.bc.type.yhi = nscbc_outflow
density.bc.type.zlo = REFLECT_EVEN
density.bc.type.zhi = nscbc_outflow
energy.bc.type.xlo = REFLECT_EVEN
energy.bc.type.xhi = nscbc_outflow
energy.bc.type.ylo = REFLECT_EVEN
energy.bc.type.yhi = nscbc_outflow
energy.bc.type.zlo = REFLECT_EVEN
energy.bc.type.zhi = nscbc_outflow
momentum.bc.type.xlo = REFLECT_ODD  REFLECT_EVEN REFLECT_EVEN
momentum.bc.type.xhi = nscbc_outflow nscbc_outflow nscbc_outflow
momentum.bc.type.ylo = REFLECT_EVEN REFLECT_ODD  REFLECT_EVEN
momentum.bc.type.yhi = nscbc_outflow nscbc_outflow nscbc_outflow
momentum.bc.type.zlo = REFLECT_EVEN REFLECT_EVEN REFLECT_ODD
momentum.bc.type.zhi = nscbc_outflow nscbc_outflow nscbc_outflow
