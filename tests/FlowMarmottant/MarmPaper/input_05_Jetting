# MarmPaper: jetting: liquid jet through the bubble, U shape -> torus (FULL DOMAIN)
# THERMAL (2026-11-10): gas-liquid heat transfer ON (thermal.conduction = thermal.exchange = 1); both phases start at 295 K
#   (gas density p_b/(R T) = 1.6756 kg/m^3, water cv calibrated).  Micro bubbles at MHz are near-isothermal (Prosperetti 1977).
#
# Full 3D domain (no symmetry), +-8 R0 box with NSCBC outflow on all six faces, R0/dx 64.
# Bubble at static equilibrium; a downward (-z) Gaussian liquid velocity patch sits on the top cap
# (U = 50 m/s, centre 1.4 R0, lateral 1/e radius 0.4 R0, axial 0.5 R0, liquid side only).  The impulsive start
# sheds a short acoustic pulse (~rho c U/2, sub-ns, decays as 1/r); the solenoidal part of the patch is the jet.
# The jet dynamic pressure rho U^2/2 = 1.25e6 Pa >> gas 1.4e5 and Laplace 4e4 Pa: it indents the top cap (U shape),
# crosses the bubble (~2 R0 / U ~ 80-150 ns) and pierces the bottom -> torus.  Raise U for a faster jet.
# refine_box +-2 R0 keeps the finest level on the jet path.  stop_time = 400 ns.
#
# COMMON (all MarmPaper decks): coated 2 um bubble, Marmottant shell chi 1.0 N/m, R_buck 0.98 R0
#   (sigma(R0) = 0.0412 N/m, elastic band R/R0 0.980-1.015), kappa_s 7.2e-9 kg/s, water mu 1e-3;
#   KM linear natural frequency f0 = 4.084 MHz (T0 = 244.9 ns); RK3 + MUSCL2 + HLLC, cfl 0.5;
#   eps/dx_finest = 2; R0/dx_finest = 64.0 (max_level 4); NSCBC outflow far field.
#   Interface jump, tensor curvature, relaxation closure etc. are built into the code (flag audit 2026-11-05).
#   THINC (qq) lines below are commented out until the first round of results is in.

alamo.program = hydro2
plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowMarmottant/MarmPaper/output_05_Jetting

### OUTPUT ###
amr.plot_int       = -1
amr.plot_dt        = 4.000000e-09
amr.thermo.plot_dt = 2.000000e-10    # thermo.dat: gas_volume (R_vol), gas_pressure_int, kinetic_energy, interface_area
plot_minimal       = 1

### MESH ###
amr.max_grid_size  = 32
amr.blocking_factor = 16
amr.regrid_int     = 10
amr.grid_eff       = 0.8
amr.max_level      = 4
amr.n_error_buf    = 16
nghost = 4

### GEOMETRY -- FULL DOMAIN ###
geometry.prob_lo     = -1.600000e-05 -1.600000e-05 -1.600000e-05
geometry.prob_hi     = 1.600000e-05 1.600000e-05 1.600000e-05
geometry.is_periodic = 0 0 0
amr.n_cell           = 64 64 64     # base dx 5.0000e-07; finest dx 3.1250e-08
refine_box.lo = -4.000000e-06 -4.000000e-06 -4.000000e-06
refine_box.hi = 4.000000e-06 4.000000e-06 4.000000e-06

### TIME ###
timestep                = 1.0e-12
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 1.0e-9
dynamictimestep.min     = 1.0e-18
cfl                     = 0.9
stop_time               = 4.000000e-07

### INTERFACE ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 6.250000e-08    # eps/dx_finest = 2
eta.ic.expression.constant.R0      = 2.000000e-06
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y + z*z) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EOS: 0 = water (stiffened gas), 1 = air ###
eos0.gamma = 2.35
eos0.p0    = 1.0e9
eos0.cv    = 2511.2367      # calibrated: T_water = 295 K at p_inf (thermal on, 2026-11-10)
eos0.cp    = 5901.4062      # = gamma cv
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cv    = 714.286
eos1.cp    = 1000.0

### INITIAL CONDITIONS ###
density0.ic.type = expression
density0.ic.expression.region0 = "1000.0"
density1.ic.type = expression
density1.ic.expression.region0 = "1.675645"      # ideal gas at p_b and 295 K (thermal on)
velocity0.ic.type = expression
velocity0.ic.expression.constant.U  = 5.000000e+01    # jet speed [m/s] (raise for a stronger jet)
velocity0.ic.expression.constant.zc = 2.800000e-06    # patch centre above the top cap
velocity0.ic.expression.constant.w  = 8.000000e-07    # lateral 1/e radius
velocity0.ic.expression.constant.h  = 1.000000e-06    # axial 1/e half-length
velocity0.ic.expression.constant.R0 = 2.000000e-06
velocity0.ic.expression.constant.epsilon = 6.250000e-08
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
velocity0.ic.expression.region2 = "-U*exp(-(x*x + y*y)/(w*w) - (z - zc)*(z - zc)/(h*h))*0.5*(1 + tanh((sqrt(x*x + y*y + z*z) - R0)/epsilon))"
velocity1.ic.type = expression
velocity1.ic.expression.constant.U  = 5.000000e+01    # jet speed [m/s] (raise for a stronger jet)
velocity1.ic.expression.constant.zc = 2.800000e-06    # patch centre above the top cap
velocity1.ic.expression.constant.w  = 8.000000e-07    # lateral 1/e radius
velocity1.ic.expression.constant.h  = 1.000000e-06    # axial 1/e half-length
velocity1.ic.expression.constant.R0 = 2.000000e-06
velocity1.ic.expression.constant.epsilon = 6.250000e-08
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"
velocity1.ic.expression.region2 = "-U*exp(-(x*x + y*y)/(w*w) - (z - zc)*(z - zc)/(h*h))*0.5*(1 + tanh((sqrt(x*x + y*y + z*z) - R0)/epsilon))"
pressure0.ic.type = expression
pressure0.ic.expression.constant.p_inf = 1.000000e+05
pressure0.ic.expression.constant.p_b   = 1.412328e+05
pressure0.ic.expression.constant.R0    = 2.000000e-06
pressure0.ic.expression.region0 = "p_inf"
pressure1.ic.type = expression
pressure1.ic.expression.constant.p_b = 1.412328e+05
pressure1.ic.expression.region0 = "p_b"
equalize_ic_pressure = 1

### MATERIAL / SHELL ###
mu0   = 1.0e-3     # water
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0
apply_surface_tension = 1
sigma = 0.0728                   # water (= post-rupture tension)
pref  = 0.0
marmottant             = 1
marmottant.R0          = 2.000000e-06  # shell unstrained at the IC radius
marmottant.R_buckling  = 1.96e-6       # 0.98 R0
marmottant.chi         = 1.0           # [N/m]
marmottant.sigma_break = 0.073         # [N/m]
shell.kappa_s = 7.2e-9                  # [kg/s] (micro-scale equivalent of kappa_s = 0.72 at R0 = 2 cm)
shell.mu_s    = 0.0

### BOUNDARY CONDITIONS -- full domain ###
nscbc.xlo.type     = outflow
nscbc.xlo.target_p = 1.000000e+05
nscbc.xlo.sigma    = 0.6
nscbc.xlo.beta     = 0.5
nscbc.xlo.L_ref    = 5.000000e-08
nscbc.xhi.type     = outflow
nscbc.xhi.target_p = 1.000000e+05
nscbc.xhi.sigma    = 0.6
nscbc.xhi.beta     = 0.5
nscbc.xhi.L_ref    = 5.000000e-08
nscbc.ylo.type     = outflow
nscbc.ylo.target_p = 1.000000e+05
nscbc.ylo.sigma    = 0.6
nscbc.ylo.beta     = 0.5
nscbc.ylo.L_ref    = 5.000000e-08
nscbc.yhi.type     = outflow
nscbc.yhi.target_p = 1.000000e+05
nscbc.yhi.sigma    = 0.6
nscbc.yhi.beta     = 0.5
nscbc.yhi.L_ref    = 5.000000e-08
nscbc.zlo.type     = outflow
nscbc.zlo.target_p = 1.000000e+05
nscbc.zlo.sigma    = 0.6
nscbc.zlo.beta     = 0.5
nscbc.zlo.L_ref    = 5.000000e-08
nscbc.zhi.type     = outflow
nscbc.zhi.target_p = 1.000000e+05
nscbc.zhi.sigma    = 0.6
nscbc.zhi.beta     = 0.5
nscbc.zhi.L_ref    = 5.000000e-08
eta.bc.type.xlo = neumann
eta.bc.type.xhi = neumann
eta.bc.type.ylo = neumann
eta.bc.type.yhi = neumann
eta.bc.type.zlo = neumann
eta.bc.type.zhi = neumann
density.bc.type.xlo = nscbc_outflow
density.bc.type.xhi = nscbc_outflow
density.bc.type.ylo = nscbc_outflow
density.bc.type.yhi = nscbc_outflow
density.bc.type.zlo = nscbc_outflow
density.bc.type.zhi = nscbc_outflow
energy.bc.type.xlo = nscbc_outflow
energy.bc.type.xhi = nscbc_outflow
energy.bc.type.ylo = nscbc_outflow
energy.bc.type.yhi = nscbc_outflow
energy.bc.type.zlo = nscbc_outflow
energy.bc.type.zhi = nscbc_outflow
momentum.bc.type.xlo = nscbc_outflow nscbc_outflow nscbc_outflow
momentum.bc.type.xhi = nscbc_outflow nscbc_outflow nscbc_outflow
momentum.bc.type.ylo = nscbc_outflow nscbc_outflow nscbc_outflow
momentum.bc.type.yhi = nscbc_outflow nscbc_outflow nscbc_outflow
momentum.bc.type.zlo = nscbc_outflow nscbc_outflow nscbc_outflow
momentum.bc.type.zhi = nscbc_outflow nscbc_outflow nscbc_outflow

### REFINEMENT (eta band) ###
eta_refinement_criterion   = 1.0e-1
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10

### NUMERICS ###
cutoff = 1.0e-4
Riemann_Solver.type = hllc
Limiter.type        = muscl2
# THINC qq (second round; uncomment these three lines and comment out Limiter.type above):
# Limiter.type       = thinc
# Limiter.thinc.thinc_base = muscl2
# Limiter.thinc.thinc_mode = qq       # key is Limiter.thinc.<key> (Limiter.thinc_mode is silently ignored)
integration.type    = RungeKutta
integration.rk.type = 3
visc_subcycle              = 1       # bulk + shell viscous terms sub-cycled
shell.kappa_s_subcycle_max = 8192
shell.heat_split           = 2       # shell viscous heat split by thermal effusivity
thermal.k0                 = 0.6     # water [W/m/K]
thermal.k1                 = 0.026   # air   [W/m/K]
thermal.conduction         = 1       # Fourier conduction in each phase (2026-11-10: micro bubbles are
thermal.exchange           = 1       #   near-isothermal, Pe = w R^2/D ~ 2-16; adiabatic gas is too stiff)
relax_diag                 = 0
apply_weight          = 0
apply_vaporization    = 0
grav                  = 0.0
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0
