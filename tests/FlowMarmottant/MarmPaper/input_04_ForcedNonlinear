# MarmPaper: forced NONLINEAR oscillation near resonance (subharmonic)
#
# Bubble starts at static equilibrium.  Drive f = f0 = 4.084 MHz, amplitude 4.0e5 Pa at the bubble (4 bar,
# liquid far field reaches -3 bar).  KM (km_sub.py): period doubling from the first cycles, locked in by
# cycle ~8: alternate cycles R_min 0.616 / 1.112 R0, R_max 1.491 R0, f/2 subharmonic 2.0x the drive line.
# Robust: period doubling persists for 3.6-4.5 bar and f/f0 0.9-1.1; R_min > 0.5 R0 throughout (validation target).
# stop_time = 20 drive periods = 4.897 us.
#
# COMMON (all MarmPaper decks): coated 2 um bubble, Marmottant shell chi 1.0 N/m, R_buck 0.98 R0
#   (sigma(R0) = 0.0412 N/m, elastic band R/R0 0.980-1.015), kappa_s 7.2e-9 kg/s, water mu 1e-3;
#   KM linear natural frequency f0 = 4.084 MHz (T0 = 244.9 ns); RK3 + MUSCL2 + HLLC, cfl 0.3;
#   eps/dx_finest = 2; R0/dx_finest = 25.6 (max_level 4); NSCBC outflow far field.
#   Interface jump, tensor curvature, relaxation closure etc. are built into the code (flag audit 2026-11-05).
#   THINC (qq) lines below are commented out until the first round of results is in.

alamo.program = hydro2
plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowMarmottant/MarmPaper/output_04_ForcedNonlinear

### OUTPUT ###
amr.plot_int       = -1
amr.plot_dt        = 1.530362e-08
amr.thermo.plot_dt = 6.121450e-10    # thermo.dat: gas_volume (R_vol), gas_pressure_int, kinetic_energy, interface_area
plot_minimal       = 1

### MESH ###
amr.max_grid_size  = 32
amr.blocking_factor = 16
amr.regrid_int     = 10
amr.grid_eff       = 0.8
amr.max_level      = 4
amr.n_error_buf    = 16
nghost = 4

### GEOMETRY -- OCTANT (active); full domain below, commented ###
geometry.prob_lo     = 0.000000e+00 0.000000e+00 0.000000e+00
geometry.prob_hi     = 4.000000e-05 4.000000e-05 4.000000e-05
geometry.is_periodic = 0 0 0
amr.n_cell           = 32 32 32     # base dx 1.2500e-06; finest dx 7.8125e-08
