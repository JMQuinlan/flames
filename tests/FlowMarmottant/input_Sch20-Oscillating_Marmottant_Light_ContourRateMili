#@ [sch20_oscillating_marmottant_light_contourratemili]
#@ exe=hydro2
#@ dim=3
#
# ============ COATED 1-ON-1 TWIN OF Sch20_Oscillating_Neumann_Large_3D ============
# (2026-10-22)  Every line below "alamo.program" is copied from
#     tests/FlowRayleighPlesset/Sch20_Oscillating_Neumann_Large_3D
# (same domain, R0, epsilon, pressures, EOS, BCs, AMR, blocking factor, plot_dt,
# cfl, dt bounds, limiter, inviscid liquid) EXCEPT:
#     plot_file                 -> FlowMarmottant/output_..._ContourRateMili
#     apply_surface_tension 0->1, kappa_method 1, marmottant block, shell.* block
#     plot_minimal = 1, relax_diag = 0   (output/diagnostics only, no physics change)
#
# PURPOSE.  On the 2 um Light deck the band is ~8 cells, R0 ~ 26 cells and the
# oscillation is only ~2 cells, so kappa_s acts on a small, poorly resolved
# motion.  Here p_inf/p_b = 10 (full Sch20 amplitude): R goes 1 -> ~0.5 R0,
# i.e. ~13 cells of travel, and the run sits next to the validated uncoated
# twin for a direct coated-vs-uncoated comparison.
#
# SHELL SCALING.  The elastic shell (chi, R_buckling, sigma_break) is kept as
# on Light; at R0 = 2 cm 2 sigma/R <= 7 Pa, so it is inert (KM confirms: elastic
# only = uncoated to 4 digits).  kappa_s is scaled to keep the SAME dimensionless
# shell viscosity as the 2 um Light deck,
#     K* = kappa_s / (R0^2 sqrt(rho p_inf)) = 7.2e-9/(4e-12 * 1e4) = 0.18
#     -> kappa_s = 0.18 * (0.02)^2 * 1e4 = 0.72 kg/s.
# The shell term 4 kappa_s Rdot/R^2 then sits at the same fraction of p_inf
# as on Light, and the kappa_s dx^3 timestep limit has the same ratio to the
# acoustic dt (both scale with R0).
#
# REFERENCE MODELS (reference/marmottant_rpe_km.py, mu = 0):
#   variant            RPE R_min   KM R_min (t/tc)   KM rebound
#   uncoated           0.2648      0.2727 (1.12)     0.9695
#   elastic only       0.2648      0.2727 (1.12)     0.9695
#   full shell         0.4945      0.4960 (1.44)     0.5886   <- target
# (kappa_s = 0.36 would give KM 0.4109 / rebound 0.6497 if a lighter shell is wanted.)
# Shell rate: contour-rate mode 1 (best Light result so far, INCLINE 10-20).
#
# Analyse with reference/analyze_Sch20_Oscillating_Marmottant_Mili.py
# (coated run vs KM, plus overlay on the uncoated twin's output).
# =================================================================================

alamo.program = hydro2

### OUTPUT ###
# plot_file = ./tests/FlowMarmottant/output_Sch20_Oscillating_Marmottant_Light_ContourRateMili
plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowMarmottant/output_Sch20_Oscillating_Marmottant_Light_ContourRateMili

### MESHING ###
amr.plot_int       = -1
amr.plot_dt        = 5.0e-5
amr.max_grid_size  = 32
amr.blocking_factor = 16
amr.regrid_int     = 10
amr.grid_eff       = 0.8
amr.max_level      = 4
amr.n_cell         = 160 160 160       # base; eta-only AMR -> effective finest 2560^3 (octant)

# n_error_buf pushes the fine patches ~16 dx_finest past the interface band on
# each side, sitting the coarse-fine boundary in pure water (where the Q-Fix
# density partition is exact).  See feedback_density_partition_breaks_cf_ghosts.md
amr.n_error_buf    = 16

nghost = 4

### TIME STEPPING ###
timestep                = 1.0e-7
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 1.0e-5
dynamictimestep.min     = 1.0e-13
cfl                     = 0.5

### DIMENSIONS ###
geometry.prob_lo     =  0.0  0.0  0.0
geometry.prob_hi     =  2.0  2.0  2.0
geometry.is_periodic = 0 0 0
stop_time            = 1e-2

### ETA INITIAL CONDITIONS (identical to _Large) ###
# eta = 0 inside bubble (gas, phase 1), eta = 1 outside (liquid, phase 0).
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.0016     # ~ 2 cells across the band at finest
#eta.ic.expression.constant.epsilon = 0.0008     # ~ 2 cells across the band at finest
eta.ic.expression.constant.R0      = 0.02
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y + z*z) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EQUATION OF STATE -- Sch20 water (Tammann) + air (ideal gas) ###
eos0.gamma = 2.35
eos0.p0    = 1.0e9
eos0.cv    = 1781.0
eos0.cp    = 4186.0

eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cv    = 714.286
eos1.cp    = 1000.0

### HYDRO INITIAL CONDITIONS (identical to _Large) ###
density0.ic.type = expression
density0.ic.expression.region0 = "1000.0"

density1.ic.type = expression
density1.ic.expression.region0 = "1.0"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

# Pressure field IDENTICAL to Sch20_Oscillating_Neumann_Large (the variant that
# gives the closest match to the Chen-2D RPE reference).  See the _Large file
# header for the full derivation.
pressure0.ic.type = expression
pressure0.ic.expression.constant.p_inf = 1.0e5
pressure0.ic.expression.constant.p_b   = 1.0e4
pressure0.ic.expression.constant.R0    = 0.02
pressure0.ic.expression.constant.r_inf = 0.20
pressure0.ic.expression.region0 = "p_inf - (p_inf - p_b)*R0/max(sqrt(x*x + y*y + z*z), R0)"
#pressure0.ic.expression.region0 = "p_inf - (p_inf - p_b)*log(r_inf/max(sqrt(x*x + y*y + z*z), R0))/log(r_inf/R0)"

# Gas interior: uniform bubble pressure p_b.
pressure1.ic.type = expression
pressure1.ic.expression.constant.p_b = 1.0e4
pressure1.ic.expression.region0 = "p_b"

### VISCOSITY (inviscid -- Sch20 nominal) ###
mu0   = 0.0
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### SURFACE TENSION -- Marmottant coated shell (the only physics change) ###
sigma = 72.8e-3                  # same value as the uncoated twin (post-rupture / bare tension)
pref  = 0.0

marmottant             = 1
marmottant.R0          = 0.02    # reference radius (shell strain measured from here)
marmottant.R_buckling  = 0.0196  # 0.98 R0, as on Light
marmottant.chi         = 1.0     # shell elastic modulus [N/m] (inert at this scale)
marmottant.sigma_break = 0.073   # rupture tension [N/m]

# Dilatational shell viscosity, scaled from Light at fixed K* = 0.18 (header).
shell.kappa_s = 0.72             # [kg/s]
shell.kappa_s_contour_rate = 1         # contour-rate shell rate (mode 1)
shell.kappa_s_contour_rate_cap = 0.5   # |div n| <= cap/epsilon
shell.mu_s    = 0.0

### BOUNDARY CONDITIONS - Neumann on all 6 faces (Sch20 non-NSCBC variant) ###
# eta: symmetry (reflect_even) on inner faces, neumann far-field
eta.bc.type.xlo = REFLECT_EVEN
eta.bc.type.xhi = neumann
eta.bc.type.ylo = REFLECT_EVEN
eta.bc.type.yhi = neumann
eta.bc.type.zlo = REFLECT_EVEN
eta.bc.type.zhi = neumann

density.bc.type.xlo = REFLECT_EVEN
density.bc.type.xhi = neumann
density.bc.type.ylo = REFLECT_EVEN
density.bc.type.yhi = neumann
density.bc.type.zlo = REFLECT_EVEN
density.bc.type.zhi = neumann

energy.bc.type.xlo = REFLECT_EVEN
energy.bc.type.xhi = neumann
energy.bc.type.ylo = REFLECT_EVEN
energy.bc.type.yhi = neumann
energy.bc.type.zlo = REFLECT_EVEN
energy.bc.type.zhi = neumann

momentum.bc.type.xlo = REFLECT_ODD  REFLECT_EVEN REFLECT_EVEN
momentum.bc.type.xhi = neumann neumann neumann
momentum.bc.type.ylo = REFLECT_EVEN REFLECT_ODD  REFLECT_EVEN
momentum.bc.type.yhi = neumann neumann neumann
momentum.bc.type.zlo = REFLECT_EVEN REFLECT_EVEN REFLECT_ODD
momentum.bc.type.zhi = neumann neumann neumann

### REFINEMENT -- eta-only, conservative threshold (identical to _Large) ###
eta_refinement_criterion   = 1.0e-1
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

### PHYSICS FLAGS (identical to _Large) ###
apply_surface_tension = 1   # coated (uncoated twin: 0)
apply_buoyancy        = 0
apply_weight          = 0
apply_vaporization    = 0
grav                  = 0.0

### NUMERICS -- WENO5 + SSPRK3 ###
Riemann_Solver.type = hllc
Limiter.type        = weno5
integration.type    = RungeKutta
integration.rk.type = 3
kappa_method        = 1     # REQUIRED for Marmottant (same as uncoated twin)

apply_sharpening     = 0
sharpening_frequency = 20
reinit_max_iter      = 100
reinit_tolerance     = 1e-6
omega_relax          = 0.5
relax_diag           = 0    # uncoated twin: 1 (log-only diagnostics)
plot_minimal         = 1    # ~200 frames; keeps eta, shell, Gamma, p, u, rho, energies

# IC pressure equalization (see _Large header): switch Mix() to the
# gamma-weighted form so the per-phase IC pressures sit in the energy-conserving
# equilibrium RelaxAndReinit would produce, killing the step-1 pressure kick.
equalize_ic_pressure = 1
