#@ [marmottant_l2_decay_mus0]
#@ exe=hydro2
#@ dim=3
# =============================================================================
# NON-SPHERICAL (l = 2) SHAPE-MODE DECAY -- surface SHEAR viscosity test
# =============================================================================
# The one test in the suite that can see mu_s at all.
#
# For purely radial motion the Boussinesq--Scriven shear term cancels
# identically (D_s = (Rdot/R) P and tr P = 2 in 3D), so every spherical case --
# Laplace, Sch20 oscillating/collapsing, the whole sweep -- is BLIND to mu_s.
# Confirmed numerically: a 3D breathing bubble run with mu_s = 0 and
# mu_s = 5e-6 at fixed kappa_s agrees to 6.2e-10 in radius.
#
# A shape mode changes the interface shape at nearly constant area, so D_s is
# deviatoric and mu_s does work.  The bubble is initialised as
#
#     R(theta) = R0 [ 1 + a2 P2(cos theta) ],   P2 = (3 cos^2 theta - 1)/2
#
# with a2 = 0.05 (linear), and the mode is left to ring down.  mu_s should
# increase the decay rate while leaving the frequency nearly unchanged.
#
# Inviscid Lamb frequency for a gas bubble in liquid, mode l:
#     w_l^2 = (l-1)(l+1)(l+2) sigma / (rho_l R0^3)
#   l = 2 here: w = 6.7082 rad/s,  T = 0.9366 s  (sigma = 0.3, rho = 10.0, R0 = 0.2)
#
# OCTANT: P2(cos theta) depends on z/r only, so the l=2, m=0 mode is even under
# reflection in all three coordinate planes -- the octant represents it exactly
# and costs 1/8 of the full domain.
#
# This file: mu_s = 0.0.  Compare across the set with
#     reference/non_spherical_decay_comparison.py
# =============================================================================

#@ [laplace_marmottant_3d]
#@ exe=hydro2
#@ dim=3
# =============================================================================
# MARMOTTANT COATED-BUBBLE LAPLACE TEST -- 3D
# =============================================================================
# A static coated gas bubble (R0=0.2) in liquid, with the IC pressure jump set to
# the Laplace balance for the Marmottant shell tension at R0:
#     dP = (d-1) * sigma(R0) / R0          (d=3 here, so dP = 2 sigma(R0)/R0)
# Marmottant Eq.(4) elastic regime:  sigma(R0) = chi (R0^2/R_buckling^2 - 1).
#   chi=0.1, R_buckling=0.1, R0=0.2  ->  sigma(R0)=0.1*(4-1)=0.3 ->  dP=2*0.3/0.2=3.0
# If the curvature-derived R and sigma(R) are correct, the bubble stays at R0
# (Laplace equilibrium) and does NOT drift (the failure mode of pointwise
# sigma(R=1/kappa)).  Check:  R_pseudo ~ R0, sigma_eff ~ 0.3, R(t)/R0 ~ 1.
# Analysis: reference/check_marmottant.py
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file = ./tests/FlowMarmottant/output_l2_decay_mus0

### MESHING (uniform) ###
amr.plot_int        = -1
amr.max_grid_size   = 32
amr.blocking_factor = 8
amr.max_level       = 0
amr.n_cell          = 64 64 64
nghost = 4

### TIME ###
timestep                = 1.0e-6
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 2.0e-3
dynamictimestep.min     = 1.0e-12
cfl                     = 0.4
stop_time               = 1.4986

### DIMENSIONS -- bubble centered at origin, neumann far field ###
geometry.prob_lo     =  0.0  0.0  0.0
geometry.prob_hi     =  0.5  0.5  0.5
geometry.is_periodic = 0 0 0

### ETA IC -- gas bubble (eta=0 inside) of radius R0=0.2 ###
eta.ic.type = expression
eta.ic.expression.constant.R0  = 0.2
eta.ic.expression.constant.eps = 0.03
eta.ic.expression.constant.a2  = 0.05
eta.ic.expression.region0 = "0.5*(1.0 + tanh((sqrt(x*x+y*y+z*z) - R0*(1.0 + a2*0.5*(3.0*z*z/max(x*x+y*y+z*z,1e-30) - 1.0)))/eps))"
epsilon = 0.03

### EOS -- ideal gas both phases (phase0=liquid, phase1=gas) ###
eos0.gamma = 1.4
eos0.p0    = 0.0
eos0.cv    = 720.0
eos0.cp    = 1008.0
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cv    = 720.0
eos1.cp    = 1008.0

### HYDRO IC ###
density0.ic.type = expression
density0.ic.expression.region0 = "10.0"
density1.ic.type = expression
density1.ic.expression.region0 = "1.0"
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
velocity0.ic.expression.region2 = "0.0"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"
velocity1.ic.expression.region2 = "0.0"
# Laplace-balanced pressure: p = p_out + dP*(1-eta),  p_out=10, dP=1.5.
# Both phases share the profile (relaxed -> mixture p varies across the interface).
pressure0.ic.type = expression
pressure0.ic.expression.constant.p_out = 10.0
pressure0.ic.expression.constant.dP    = 3.0
pressure0.ic.expression.constant.R0    = 0.2
pressure0.ic.expression.constant.eps   = 0.03
pressure0.ic.expression.region0 = "p_out + dP*0.5*(1.0 - tanh((sqrt(x*x + y*y + z*z) - R0)/eps))"
pressure1.ic.type = expression
pressure1.ic.expression.constant.p_out = 10.0
pressure1.ic.expression.constant.dP    = 3.0
pressure1.ic.expression.constant.R0    = 0.2
pressure1.ic.expression.constant.eps   = 0.03
pressure1.ic.expression.region0 = "p_out + dP*0.5*(1.0 - tanh((sqrt(x*x + y*y + z*z) - R0)/eps))"

### VISCOSITY (inviscid) ###
mu0 = 0.0
mu0_b = 0.0
mu1 = 0.0
mu1_b = 0.0

### SURFACE TENSION + MARMOTTANT ###
apply_surface_tension = 1
sigma = 0.3
pref  = 0.0
kappa_method = 1                 # mean curvature -> kappas(...,0) used by the R reduction

marmottant            = 0
marmottant.R0         = 0.2      # reference radius: shell UNSTRAINED here (= bubble R0)
marmottant.R_buckling = 0.1      # R_buckling
marmottant.chi        = 0.1      # shell elastic modulus
marmottant.sigma_break= 100.0    # huge -> never ruptures in this test

### BCs -- neumann all faces (bubble far from boundary) ###
eta.bc.type.xlo = REFLECT_EVEN
eta.bc.type.xhi = neumann
eta.bc.type.ylo = REFLECT_EVEN
eta.bc.type.yhi = neumann
eta.bc.type.zlo = REFLECT_EVEN
eta.bc.type.zhi = neumann
density.bc.type.xlo = REFLECT_EVEN
density.bc.type.xhi = neumann
density.bc.type.ylo = REFLECT_EVEN
density.bc.type.yhi = neumann
density.bc.type.zlo = REFLECT_EVEN
density.bc.type.zhi = neumann
energy.bc.type.xlo = REFLECT_EVEN
energy.bc.type.xhi = neumann
energy.bc.type.ylo = REFLECT_EVEN
energy.bc.type.yhi = neumann
energy.bc.type.zlo = REFLECT_EVEN
energy.bc.type.zhi = neumann
momentum.bc.type.xlo = REFLECT_ODD  REFLECT_EVEN REFLECT_EVEN
momentum.bc.type.xhi = neumann neumann neumann
momentum.bc.type.ylo = REFLECT_EVEN REFLECT_ODD  REFLECT_EVEN
momentum.bc.type.yhi = neumann neumann neumann
momentum.bc.type.zlo = REFLECT_EVEN REFLECT_EVEN REFLECT_ODD
momentum.bc.type.zhi = neumann neumann neumann

### REFINEMENT (off) ###
eta_refinement_criterion   = 1.0e+10
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4

### SOURCE ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

### PHYSICS FLAGS ###
apply_buoyancy        = 0
apply_weight          = 0
apply_vaporization    = 0
grav                  = 0.0

### NUMERICS ###
Riemann_Solver.type = hllc
Limiter.type        = weno3
integration.type    = RungeKutta
integration.rk.type = 3

apply_sharpening = 0
equalize_ic_pressure = 1
amr.plot_dt = 0.02342
shell.kappa_s = 0.0
shell.mu_s = 0
