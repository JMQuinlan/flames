#@ [sch20_oscillating_marmottant]
#@ exe=hydro2
#@ dim=3

# =============================================================================
# COATED-BUBBLE TWIN OF Sch20_Oscillating_Neumann_Large_3D
# Case 1: LOW-PRESSURE-RATIO (p_inf / p_b = 10) -- "OSCILLATING" bubble,
#         Marmottant (2005) lipid shell + Boussinesq-Scriven dilatational
#         shell viscosity.
# =============================================================================
# This is the Schmidmayer-Bryngelson-Colonius (JCP 402, 2020) Case 1 setup with
# a coated interface.  Everything structural is inherited from
# tests/FlowRayleighPlesset/Sch20_Oscillating_Neumann_Large_3D: +x+y+z octant
# with symmetry (reflect) BCs on the inner faces and neumann far field, 3D,
# HLLC + WENO3 + SSPRK3, eta-only AMR at the interface band, and the Sch20
# Eq. (27) equilibrium pressure field.
#
# -----------------------------------------------------------------------------
# WHY THE BUBBLE IS 2 um AND NOT Sch20's 20 mm
# -----------------------------------------------------------------------------
# The Marmottant shell enters the normal stress balance as 2 sigma(R)/R and
# 4 kappa_s Rdot/R^2.  Both scale as 1/R (and 1/R^2), so at Sch20's R0 = 20 mm a
# PHYSICAL shell is dynamically invisible:
#
#     R0        2 sigma/R0      / p_inf     f0 shift vs uncoated
#     2.0e-6 m   7.30e+4 Pa      0.73          -18.4 %
#     1.0e-5 m   1.46e+4 Pa      0.15           -4.7 %
#     1.0e-4 m   1.46e+3 Pa      0.015          -0.5 %
#     2.0e-2 m   7.30e+0 Pa      0.0001         -0.0 %   <- Sch20 radius
#
# Reaching a measurable coating effect at 20 mm would require chi ~ 1e3 N/m,
# which is not a lipid shell.  Instead the ENTIRE Sch20 setup is rescaled by
# 1e-4 in length; because the Rayleigh time tau_c = 0.915 R0 sqrt(rho/p_inf) is
# linear in R0 at fixed pressure, time rescales by the same 1e-4 and every
# dimensionless group (R0/dx, epsilon/dx, L/R0, stop_time/tau_c, p_inf/p_b) is
# preserved EXACTLY.  The result is a 2 um microbubble -- the size Marmottant
# (2005) actually characterizes -- run at Sch20's nominal resolution.
#
#     Sch20 (uncoated)            this file (coated)
#     R0        = 2.0e-2 m        R0        = 2.0e-6 m
#     prob_hi   = 2.0 m (100 R0)  prob_hi   = 2.0e-4 m (100 R0)
#     epsilon   = 1.6e-3          epsilon   = 1.6e-7
#     stop_time = 1.0e-2 s        stop_time = 1.0e-6 s  (5.46 tau_c)
#     p_inf/p_b = 10              p_inf/p_b = 10        (unchanged)
#
# -----------------------------------------------------------------------------
# SHELL PARAMETERS -- Marmottant et al., JASA 118(6):3499, 2005
# -----------------------------------------------------------------------------
#   chi         = 1.0    N/m    shell elastic modulus
#   kappa_s     = 7.2e-9 kg/s   surface DILATATIONAL viscosity
#   sigma_break = 0.073  N/m    rupture tension
#   sigma       = 0.0728 N/m    post-rupture (bare water/air) tension
#   R_buckling  = 0.98 R0       -> Gamma_buck = 1.0412, sigma(R0) = 0.0412 N/m
#
# The bubble therefore STARTS mid-elastic and buckles on the inward stroke.
# The elastic window is intrinsically narrow for a real shell,
#     R_rupture / R_buckling = sqrt(1 + sigma_break/chi) = 1.0359,
# so a large-amplitude free collapse spends most of its time buckled
# (sigma = 0).  That is the physical Marmottant "compression-only" behaviour,
# not a defect of the setup.  The RUPTURED branch is NOT exercised here: this
# IC only under-pressures the bubble, so R never exceeds R0.  Rupture is
# reached in the DRIVEN coated case, not in this free-response test.
#
# -----------------------------------------------------------------------------
# WHAT THIS TEST DISCRIMINATES (reference ODE, R_min/R0)
# -----------------------------------------------------------------------------
#   uncoated  (sigma const, kappa_s = 0)   0.1908
#   elastic only (chi on, kappa_s = 0)     0.3156
#   viscous only (chi = 0, kappa_s on)     0.3906
#   full shell (chi + kappa_s)             0.5172
#
# Both shell terms carry comparable weight, so the measured R_min separates
# them -- the test is diagnostic, not merely pass/fail.  Compare against
# reference/marmottant_rpe_km.py via
#     reference/analyze_Sch20_Oscillating_Marmottant.py
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
# plot_file = ./tests/FlowMarmottant/output_Sch20_Oscillating_Marmottant
plot_file = /mmfs1/home/ttryon/flames/bin/tests/FlowMarmottant/output_Sch20_Oscillating_Marmottant

### MESHING ###
amr.plot_int        = -1
amr.plot_dt         = 5.0e-9          # Sch20 5.0e-5 x 1e-4
amr.max_grid_size   = 32
amr.blocking_factor = 16
amr.regrid_int      = 10
amr.grid_eff        = 0.8
amr.max_level       = 4
amr.n_cell          = 160 160 160     # base dx 1.25e-6; L4 -> dx_finest 7.8125e-8 (R0/dx = 25.6)

# n_error_buf pushes the fine patches ~16 dx_finest past the interface band so
# the coarse-fine boundary sits in pure water, where the Q-Fix density
# partition is exact.
amr.n_error_buf     = 16

nghost = 4

### TIME STEPPING (Sch20 values x 1e-4) ###
timestep                = 1.0e-11
dynamictimestep.on      = 1
dynamictimestep.verbose = 0
dynamictimestep.max     = 1.0e-9
dynamictimestep.min     = 1.0e-17
cfl                     = 0.5

### DIMENSIONS -- octant, 100 R0 ###
geometry.prob_lo     =  0.0     0.0     0.0
geometry.prob_hi     =  2.0e-4  2.0e-4  2.0e-4
geometry.is_periodic = 0 0 0
stop_time            = 1.0e-6         # 5.46 tau_c (tau_c = 1.830e-7 s)

### ETA INITIAL CONDITIONS ###
# eta = 0 inside bubble (gas, phase 1), eta = 1 outside (liquid, phase 0).
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 1.6e-7     # ~2 cells across the band at finest
eta.ic.expression.constant.R0      = 2.0e-6
eta.ic.expression.region0 = "0.5*(1 + tanh((sqrt(x*x + y*y + z*z) - R0)/epsilon))"
epsilon = eta.ic.expression.constant.epsilon

### EQUATION OF STATE -- Sch20 water (Tammann) + air (ideal gas) ###
eos0.gamma = 2.35
eos0.p0    = 1.0e9
eos0.cv    = 1781.0
eos0.cp    = 4186.0

eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cv    = 714.286
eos1.cp    = 1000.0

### HYDRO INITIAL CONDITIONS ###
density0.ic.type = expression
density0.ic.expression.region0 = "1000.0"

density1.ic.type = expression
density1.ic.expression.region0 = "1.0"

velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

# Liquid exterior: Sch20 Eq. (27) equilibrium field, rescaled.
pressure0.ic.type = expression
pressure0.ic.expression.constant.p_inf = 1.0e5
pressure0.ic.expression.constant.p_b   = 1.0e4
pressure0.ic.expression.constant.R0    = 2.0e-6
pressure0.ic.expression.constant.r_inf = 2.0e-5
pressure0.ic.expression.region0 = "p_inf - (p_inf - p_b)*R0/max(sqrt(x*x + y*y + z*z), R0)"

# Gas interior: uniform bubble pressure p_b.
pressure1.ic.type = expression
pressure1.ic.expression.constant.p_b = 1.0e4
pressure1.ic.expression.region0 = "p_b"

### VISCOSITY ###
# Sch20 runs inviscid, but at R0 = 2 um the liquid viscous term 4 mu Rdot/R is
# O(1e4 Pa) -- the same order as the shell terms under test -- so water
# viscosity is retained here and in the reference ODE.  Gas viscosity is
# negligible and is set to zero so the sim and the ODE use the same physics.
mu0   = 1.0e-3
mu0_b = 0.0
mu1   = 0.0
mu1_b = 0.0

### SURFACE TENSION -- Marmottant coated shell ###
apply_surface_tension = 1
sigma = 0.0728                   # post-rupture / bare interface tension [N/m]
pref  = 0.0

kappa_method = 1                 # REQUIRED for Marmottant

marmottant             = 1
marmottant.R0          = 2.0e-6  # reference radius (shell strain measured from here)
marmottant.R_buckling  = 1.96e-6 # 0.98 R0 -> Gamma_buck = 1.0412, sigma(R0) = 0.0412 N/m
marmottant.chi         = 1.0     # shell elastic modulus [N/m]
marmottant.sigma_break = 0.073   # rupture tension [N/m]

# Boussinesq-Scriven interfacial viscosity.  For spherical motion div_s u =
# 2 Rdot/R and the SHEAR viscosity mu_s cancels identically, so kappa_s alone
# sets the shell damping: it contributes 4 kappa_s Rdot/R^2 to the normal
# stress balance.  mu_s is left at 0 (the solver aborts on a nonzero value
# until D_s is implemented in CapillaryOperator).
shell.kappa_s = 7.2e-9           # surface dilatational viscosity [kg/s]
shell.mu_s    = 0.0

### BOUNDARY CONDITIONS -- octant symmetry + neumann far field ###
eta.bc.type.xlo = REFLECT_EVEN
eta.bc.type.xhi = neumann
eta.bc.type.ylo = REFLECT_EVEN
eta.bc.type.yhi = neumann
eta.bc.type.zlo = REFLECT_EVEN
eta.bc.type.zhi = neumann

density.bc.type.xlo = REFLECT_EVEN
density.bc.type.xhi = neumann
density.bc.type.ylo = REFLECT_EVEN
density.bc.type.yhi = neumann
density.bc.type.zlo = REFLECT_EVEN
density.bc.type.zhi = neumann

energy.bc.type.xlo = REFLECT_EVEN
energy.bc.type.xhi = neumann
energy.bc.type.ylo = REFLECT_EVEN
energy.bc.type.yhi = neumann
energy.bc.type.zlo = REFLECT_EVEN
energy.bc.type.zhi = neumann

momentum.bc.type.xlo = REFLECT_ODD  REFLECT_EVEN REFLECT_EVEN
momentum.bc.type.xhi = neumann neumann neumann
momentum.bc.type.ylo = REFLECT_EVEN REFLECT_ODD  REFLECT_EVEN
momentum.bc.type.yhi = neumann neumann neumann
momentum.bc.type.zlo = REFLECT_EVEN REFLECT_EVEN REFLECT_ODD
momentum.bc.type.zhi = neumann neumann neumann

### REFINEMENT -- eta-only at the interface band ###
eta_refinement_criterion   = 1.0e-1
omega_refinement_criterion = 1.0e+10
p_refinement_criterion     = 1.0e+10
rho_refinement_criterion   = 1.0e+10
gradu_refinement_criterion = 1.0e+10
cutoff = 1.0e-4

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

### PHYSICS FLAGS ###
apply_buoyancy        = 0
apply_weight          = 0
apply_vaporization    = 0
grav                  = 0.0

### NUMERICS -- WENO3 + SSPRK3 (project standard for Sch20 tests) ###
Riemann_Solver.type = hllc
Limiter.type        = weno3
integration.type    = RungeKutta
integration.rk.type = 3

apply_sharpening     = 0
sharpening_frequency = 20
reinit_max_iter      = 100
reinit_tolerance     = 1e-6
omega_relax          = 0.5
relax_diag           = 1

# Switch Mix() to the gamma-weighted form so the per-phase IC pressures sit in
# the energy-conserving equilibrium RelaxAndReinit would produce, killing the
# step-1 pressure kick.
equalize_ic_pressure = 1
