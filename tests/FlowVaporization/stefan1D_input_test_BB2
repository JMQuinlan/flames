#@ [stefan-flow-1d-planar]
#@ exe=hydro2
#@ dim=2

alamo.program = hydro2

### OUTPUT ###
plot_file = /mnt/c/Users/samar/Downloads/CloneResearch/flames/bin/tests/stefan/stefan_2.1

### MESHING ###
amr.plot_dt = 1e-3             #Plot every 1 ms
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.regrid_int = 50
amr.grid_eff = 0.8
amr.max_level = 2              #Level 2 (4x refinement)
amr.n_cell = 256 32            #Finer base grid

### TIME STEPPING ###
timestep = 1e-7

## Adaptive
dynamictimestep.on = 1
dynamictimestep.verbose = 1
dynamictimestep.max = 5e-7     #Larger max timestep
dynamictimestep.min = 1e-12
cfl = 0.2                      #More aggressive
cfl_v = 0.2

### DIMENSIONS ###
geometry.prob_lo = 0.0 -0.03125 0.0  # Narrower in y 
geometry.prob_hi = 1.0  0.03125 0.0
geometry.is_periodic = 0 0 0

### TIME STEP ###
stop_time = 0.01               # 1milliseconds 

### ETA INITIAL CONDITIONS ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 0.0078125  # THINNER interface
eta.ic.expression.constant.x_interface = 0.3    # Start at x=0.3 

eta.ic.expression.region0 = "0.5*(1 + tanh((x - x_interface)/(2*sqrt(2)*epsilon)))"
epsilon = eta.ic.expression.constant.epsilon

### HYDRO INITIAL CONDITIONS ###
gamma0 = 1.4
p0_0 = 0
mu0 = 1.8e-5
mu0_b = 0.0

gamma1 = 1.4
p0_1 = 0
mu1 = 1.0e-3
mu1_b = 0.0

# Densities - KEEP YOUR CONTRAST
density0.ic.type = expression
density0.ic.expression.region0 = "1.0"

density1.ic.type = expression
density1.ic.expression.region0 = "1000.0"

# Velocities
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"

velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

# Pressures
pressure0.ic.type = expression
pressure0.ic.expression.region0 = "101325"

pressure1.ic.type = expression
pressure1.ic.expression.region0 = "101325"

# Temperatures - TEMPERATURE GRADIENT TO DRIVE EVAPORATION
temperature0.ic.type = expression
temperature0.ic.expression.constant.T_hot = 373.15   # 100°C (boiling)
temperature0.ic.expression.constant.T_cold = 293.15  # 20°C
temperature0.ic.expression.constant.x_int = 0.3
temperature0.ic.expression.region0 = "T_hot + (T_cold - T_hot) * 0.5 * (1 + tanh((x - x_int) / 0.05))"

temperature1.ic.type = expression
temperature1.ic.expression.constant.T_hot = 373.15
temperature1.ic.expression.constant.T_cold = 293.15
temperature1.ic.expression.constant.x_int = 0.3
temperature1.ic.expression.region0 = "T_hot + (T_cold - T_hot) * 0.5 * (1 + tanh((x - x_int) / 0.05))"

# Thermodynamic properties
cp0 = "1005.0"
cp1 = "4179.0"

cv0 = "717.86"
cv1 = "2984.3"

# Thermal conductivities
k0_thermal.ic.type = expression
k0_thermal.ic.expression.region0 = "0.026"

k1_thermal.ic.type = expression
k1_thermal.ic.expression.region0 = "0.6"

h0_thermal.ic.type = expression
h0_thermal.ic.expression.region0 = "1005.0"

h1_thermal.ic.type = expression
h1_thermal.ic.expression.region0 = "4179.0"

# Surface tension
sigma = 72.8

# Vapor Diffusivity 
Dv = "1.0e-4"                  # larger (stronger evaporation)

# Reference pressure
pref = 0.0

### BOUNDARY CONDITIONS ###
# X-direction: Neumann (allows flow)
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.yhi = neumann
density.bc.type.ylo = neumann

energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.yhi = neumann
energy.bc.type.ylo = neumann

momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.yhi = neumann neumann
momentum.bc.type.ylo = neumann neumann

### REFINEMENT CRITERIA ###
eta_refinement_criterion = 0.005       # Tighter 
omega_refinement_criterion = 50.0
p_refinement_criterion = 5e+4
rho_refinement_criterion = 5e+2
gradu_refinement_criterion = 5e+2
cutoff = 1e-16

### SOURCE TERMS ###
m0.ic.type = constant
m0.ic.constant.value = 0.0

u0.ic.type = constant
u0.ic.constant.value = 0.0 0.0

q.ic.type = constant
q.ic.constant.value = 0.0 0.0

### ADDITIONAL SOURCES ###
apply_surface_tension = 1
apply_buoyancy = 0
apply_weight = 0
apply_vaporization = 1
grav = 9.81

### SOLVER SETTINGS ###
Riemann_Solver = 1
kappa_method = 2
scheme = 0
Limiter = 0
small = 1e-8
lagrange = 0.0
