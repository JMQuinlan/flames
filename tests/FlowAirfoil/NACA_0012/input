#@ [naca0012]
#@ exe=hydro2
#@ dim=2

# =============================================================================
# FlowAirfoil -- NACA 0012, 2D subsonic flow over an EMBEDDED SOLID airfoil
# (rasterized phi bitmap -> diffuse tanh boundary), for lift/drag VALIDATION
# against thin-airfoil theory and tabulated NACA data.
# =============================================================================
# Condition: Ma 0.3 (c = 1 by construction: p = 1/gamma, rho = 1 -> a = 1, U = Ma).
# (Normalization VERIFIED irrelevant: the dimensional p=1bar twin reproduced the
#  identical collapse at the identically-scaled time t=0.035 s = 13 / 374.17.)
# Ma 0.3 keeps the whole alpha-sweep subcritical (at Ma 0.5 a 12%-thick section
# develops local supersonic pockets by alpha ~ 5-6 deg, outside thin-airfoil+PG).
#
#   FLOW:      rho = 1.0,  p = 0.714286 (= 1/gamma),  U = 0.3  (Ma 0.3).
#              rho*U = 0.3000.   E0 = p/(gamma-1) = 1.785714 (eta=1; E1 ~ 0).
#              q_inf = 0.5*rho*U^2 = 0.045000.
#   GEOMETRY:  NACA 0012 at AoA = 4 deg (nose-up, rotated into the bitmap),
#              chord 1.0, from a phi bitmap (fit=coord over the domain box).
#              d>0 fluid, d<0 solid -> phi = 0.5*(1+tanh(d/eps)).
#              Thin-airfoil + Prandtl-Glauert at Ma 0.3: Cl = 2*pi*alpha/beta
#              = 0.460 (alpha = 4 deg, beta = sqrt(1-0.09) = 0.954).
#   WALL:      VISCOUS NO-SLIP Brinkman penalty (solid.slip=0).  eps = 0.0025
#              skin (1.28 finest cells at max_level 5).  SHARP-TE PROGRAM:
#              the band-merged blunt TE was identified as the lift-killer
#              (splitter A/B: Cl 0.15->0.32; eps 0.01->0.005 moved separation
#              25%c -> 60%c).  Halving eps again sharpens the effective TE.
#              mu = 1.2e-4 -> Re_c = rho*U*c/mu = 2500.  The boundary layer is what
#              enforces the Kutta condition at the (diffuse, rounded) trailing
#              edge -- inviscid+slip developed no circulation (Cl ~ 0) and shed
#              vortices off the rounded TE continuously.
#   LIFT/DRAG (post-processed):  F = -integral (p-p_inf) grad(phi) dV;
#              C_l = F_y/(q_inf*c),  C_d = F_x/(q_inf*c).  VISCOUS -> C_d now
#              includes laminar skin friction (~ O(1.3/sqrt(Re)) ~ 0.02) on top
#              of form drag.  SINGLE PHASE: eta = 1 (all fluid 0, ideal-gas
#              air); fluid 1 is the vanished phase at the positivity floor.
#   BCs:       SUBSONIC, PRIMITIVE path (bc.primitive=1) -- Dirichlet freestream
#              (rho, M, p) at xlo, pinned back-PRESSURE at xhi; far-field
#              top/bottom Neumann.  Boundary-echo hypothesis was TESTED and
#              REFUTED (wide-domain twin collapsed at the same t~13-15), so
#              the reflecting Dirichlet faces are acceptable here; NSCBC4's
#              corner closure is not yet stable under tangential mean flow.
# =============================================================================

alamo.program = hydro2

### OUTPUT ###
plot_file            = ./tests/FlowAirfoil/NACA_0012/output
amr.plot_dt          = 0.5
amr.plot_int         = -1

### MESHING ###
# Base dx = 0.0625; AMR refines the airfoil surface (grad phi) + shock.
# max_level = 3 -> dx_finest = base/2^3; eps = 0.01 diffuse skin.
amr.max_grid_size    = 500000
amr.blocking_factor  = 16
amr.regrid_int       = 10
amr.grid_eff         = 0.8
amr.max_level        = 5           # eps=0.0025 -> 1.28 finest cells (dx_finest = 0.00195)
amr.n_cell           = 160 64      # dx = 0.0625 on the [-2,8]x[-2,2] domain; divisible by blocking_factor 16

### DIMENSIONS -- flow in +X ###
# Compact domain (2c upstream, 7.5c wake, +/-2c sidewalls) for fast turnaround.
# NOTE: +/-2c sidewalls give NONTRIVIAL blockage (~10-15% high Cl vs far-field)
# -- fine for debugging dynamics; widen for quantitative Cl validation.
# The bmp coord box (-4,-5)-(8,5) is unchanged: the domain is a SUBSET of it,
# so the airfoil stays at the same physical location (no bitmap regeneration).
geometry.prob_lo     = -2.0 -2.0 0.0
geometry.prob_hi     = 8.0 2.0 0.0
geometry.is_periodic = 0 0 0
nghost = 4       # NSCBC4 requires 4 ghost cells (and weno5 reads 3)

### TIME STEPPING ###
timestep            = 1e-6
dynamictimestep.on  = 1
dynamictimestep.max = 5e-3
dynamictimestep.min = 1e-10
cfl                 = 0.3
cfl_v               = 0.3
# Steady state: Wagner circulation buildup ~5 convective times (~17 t-units)
# + bubble viscous equilibration delta^2/nu ~ 20 t-units -> settled by t~18-20;
# average Cl over the final t=18-24 window.
stop_time           = 24.0

# ----------------------------------------------------------------------------
# EMBEDDED SOLID -- the NACA 0012, from a phi bitmap.  Yang Brinkman wall.
# ----------------------------------------------------------------------------
# (refine_box over the BL/wake was TESTED and removed: forcing the aft shear
#  zone to 100% finest level changed nothing -- the lift-off is not a
#  resolution artifact; see the wall-transpiration theories in the notes.)

apply_embedded_solid     = 1
solid.brinkman           = 240.0       # 2x the 4*U/eps = 120 scale at U=0.3, eps=0.01
# Penalty weight (1-phi)^p.  p=1 (legacy) drags the FLUID side of the diffuse
# band (phi=0.9 still feels lambda/10) -> boundary layer enters the adverse
# gradient with an artificial ~band-width momentum deficit -> separation from
# the crest and Cl ~ 0 (measured at Re 2500).  p=2 localizes the drag to the
# body side (phi=0.9 feels lambda/100).  Set back to 1 to reproduce the old
# behavior for the A/B.
solid.penalty_power      = 2
solid.slip               = 0
phi_refinement_criterion = 0.1

# Bitmap geometry IC:  pixel/255 -> phi,  fit=coord.  The coord box is a TIGHT
# window around the foil (IC::BMP clamps to the edge pixel outside it; edges
# are pure fluid) so the raster stays small at the sharp eps=0.0025 skin
# (pixel = eps/2).  MUST match BMP_LO/BMP_HI in analyze_NACA_0012.py.
solid.phi.ic.type            = bmp
solid.phi.ic.bmp.filename    = ../tests/FlowAirfoil/NACA_0012/naca0012.bmp
solid.phi.ic.bmp.channel     = g
solid.phi.ic.bmp.min         = 0
solid.phi.ic.bmp.max         = 255
solid.phi.ic.bmp.fit         = coord
solid.phi.ic.bmp.coord.lo    = -0.75 -0.5
solid.phi.ic.bmp.coord.hi    = 1.0 0.5

# Prescribed quiescent solid target (air at rest, p = p_inf):
solid.density.ic.type            = constant
solid.density.ic.constant.value  = 1.0
solid.momentum.ic.type           = constant
solid.momentum.ic.constant.value = 0.0 0.0
solid.pressure.ic.type           = constant
solid.pressure.ic.constant.value = 0.714286

### ETA (alpha_1) -- SINGLE PHASE: eta = 1 everywhere (all fluid 0) ###
# Fluid 1 is the vanished phase (alpha_1' -> 0, rho_eta1 -> positivity floor);
# its IC below keeps the pure-phase state sane so the vanished-phase EOS
# recovery stays well-conditioned.
eta.ic.type       = constant
eta.ic.constant.value = 1.0
eta.bc.type.xlo   = dirichlet          # subsonic inflow
eta.bc.val.xlo    = 1.0
eta.bc.type.xhi   = neumann
eta.bc.type.ylo   = neumann
eta.bc.type.yhi   = neumann

### EOS (ideal-gas air, gamma = 1.4) -- fluid 1 identical but vanished (eta=1) ###
eos0.gamma = 1.4
eos0.p0    = 0.0
eos0.cp    = 1005.0
eos0.cv    = 717.86
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cp    = 1005.0
eos1.cv    = 717.86
# Viscosity sized for Re_c = rho*U*c/mu = 1*0.3*1/1.2e-4 = 2500.  Laminar BL
# delta ~ 5c/sqrt(Re) ~ 0.10 (thicker, easier to resolve; at this Re the
# PHYSICAL flow is gently separated with mild TE shedding -- Cl_mean ~ 0.3 --
# so agreement is judged against low-Re references, not 2*pi*alpha).
# Viscous dt limit cfl_v*rho*dx^2/mu ~ 0.15 >> acoustic dt: not limiting.
mu0   = 1.2e-4
mu0_b = 0.0
mu1   = 1.2e-4
mu1_b = 0.0

### FLUID 0 IC (subsonic freestream in +X) ###
density0.ic.type = constant
density0.ic.constant.value = 1.0
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.3"      # vx = U
velocity0.ic.expression.region1 = "0.0"      # vy
pressure0.ic.type = constant
pressure0.ic.constant.value = 0.714286

### FLUID 1 IC (vanished phase, alpha_2 -> 0; identical PURE state to fluid 0
### so the trace-phase EOS recovery (rho_1 = (alpha rho)_1/alpha_2) stays sane) ###
density1.ic.type = constant
density1.ic.constant.value = 1.0
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.3"
velocity1.ic.expression.region1 = "0.0"
pressure1.ic.type = constant
pressure1.ic.constant.value = 0.714286

### INTERACTIONS ###
epsilon = 0.1
sigma   = 0.0
Dv      = 0.0
pref    = 0.0
small   = 1e-6
grav    = 0.0

### BOUNDARY CONDITIONS -- PRIMITIVE PATH (pinned Dirichlet; the stable config) ###
# The wide-domain A/B PROVED the collapse is interior (not boundary echoes),
# so the reflecting-but-robust Dirichlet setup is fine for these runs.
# (NSCBC remains available but its corner closure detonates under sustained
# tangential mean flow -- xlo/yhi corner, t~9-10 -- pending a corner fix.)
bc.primitive = 1

density.bc.type.xlo  = dirichlet
density.bc.val.xlo   = 1.0
density.bc.type.xhi  = neumann
density.bc.type.ylo  = neumann
density.bc.type.yhi  = neumann

momentum.bc.type.xlo = dirichlet dirichlet     # Mx = rho*U, My = 0
momentum.bc.val.xlo  = 0.3 0.0
momentum.bc.type.xhi = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

# Pressure: freestream at inflow, pinned back-pressure at outflow.
pressure.bc.type.xlo = dirichlet
pressure.bc.val.xlo  = 0.714286
pressure.bc.type.xhi = dirichlet          # subsonic outflow: pin back-pressure
pressure.bc.val.xhi  = 0.714286
pressure.bc.type.ylo = neumann
pressure.bc.type.yhi = neumann

# energy.bc is still parsed (AMR FillPatch of the redundant rho E field) but
# no longer pins anything -- the primitive path owns the energy ghosts.
energy.bc.type.xlo   = neumann
energy.bc.type.xhi   = neumann
energy.bc.type.ylo   = neumann
energy.bc.type.yhi   = neumann

### REFINEMENT CRITERIA -- airfoil surface (grad phi) + p/rho gradients ###
# (p/rho tagging is safe again under Dirichlet BCs; it was disabled only for
#  NSCBC, whose corner closure blew up when refinement reached the corners.
#  NOTE: the p criterion carries UNITS: 0.1 at p = 1/gamma scale.)
eta_refinement_criterion   = 1e10
omega_refinement_criterion = 1e10
gradu_refinement_criterion = 1e10
p_refinement_criterion     = 0.1
rho_refinement_criterion   = 0.1
cutoff = 1e-16

### SOURCE TERMS ###
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0

apply_surface_tension = 0
apply_weight          = 0
apply_vaporization    = 0

### SOLVER ###
Riemann_Solver.type = hllc
Limiter.type        = minmod
kappa_method        = 1
apply_sharpening    = 0
