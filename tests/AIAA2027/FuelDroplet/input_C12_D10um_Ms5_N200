# ============================================================================
# AIAA SciTech 2027 -- Mach 5.0 shock on a 10 um n-dodecane column (generated by make_fuel_decks.py; edit there)
#   Case C12_D10um_Ms5_N200: Ms = 5.0, finest D/dx = 200 (base D/dx = 25, max_level = 3), epsilon = 0.0375 um,
#   surface tension on, vaporization off.
#   Liquid: stiffened gas, fit to NIST at 300 K, 1 atm (rho, c, cv, T exact): gamma 2.2923, pinf 5.2591e+08 Pa, cv 1823.0; T_l = 300.0 K, rho_l = 744.290 kg/m3 (SG at 1 atm, T_l).
#   Air at rest: 101325.0 Pa, 288.1 K.  Post-shock air (exact Rankine-Hugoniot): rho 6.12500 kg/m3,
#   u 1361.176 m/s, p 2938425.0 Pa, T 1670.7 K, flow Mach 1.66 (supersonic: a bow shock forms ahead of the column); Re_D = 2382 (inviscid run).
#   t* = D/u2 sqrt(rho_l/rho_g) = 0.0810 us; stop at 0.178 us (t* = 2.20).
#   Half domain: y = 0 is a symmetry plane (REFLECT); x in [-4D, 8.8D], y in [0, 8D].
#   Shock starts at x = -7.50 um and reaches the column at t = 0.0015 us.
# ============================================================================
alamo.program = hydro2
plot_file = /mmfs1/home/ttryon/flames/bin/tests/AIAA2027/FuelDroplet/output_C12_D10um_Ms5_N200

### MESHING ###
amr.plot_dt = 8.908333e-10
amr.max_grid_size = 128
amr.blocking_factor = 8
amr.regrid_int = 10
amr.grid_eff = 0.8
amr.max_level = 3
amr.n_cell = 320 200
amr.n_error_buf = 4

### TIME STEPPING ###
timestep = 1e-12
dynamictimestep.on = 1
dynamictimestep.verbose = 0
dynamictimestep.max = 1e-4
dynamictimestep.min = 1e-12
cfl = 0.3
stop_time = 1.781667e-07

### DOMAIN ###
geometry.prob_lo = -4.000000e-05 0.000000e+00 0.0
geometry.prob_hi = 8.800000e-05 8.000000e-05 0.0
geometry.is_periodic = 0 0 0

### INTERFACE (eta = 1 in the air, 0 in the water) ###
eta.ic.type = expression
eta.ic.expression.constant.epsilon = 3.750000e-08
eta.ic.expression.constant.R0 = 5e-06
eta.ic.expression.region0 = "1.0e-6 + (1.0 - 2.0e-6)*0.5*(1 + tanh((sqrt(x**2 + y**2) - R0)/(2*sqrt(2)*epsilon)))"
epsilon = eta.ic.expression.constant.epsilon

### MATERIALS ###
eos0.gamma = 1.4      # air
eos0.p0 = 0
eos0.cp = "1005.0"
eos0.cv = "717.86"
eos1.gamma = 2.2922573975016114     # n-dodecane, stiffened gas (fit to NIST at 300 K, 1 atm (rho, c, cv, T exact): gamma 2.2923, pinf 5.2591e+08 Pa, cv 1823.0)
eos1.p0 = 525914892.9115628
eos1.cp = "4178.785236"
eos1.cv = "1823.0"
mu0 = 0.00000e+00      # air (inviscid; Re_D = 2382)
mu0_b = 0.0
mu1 = 0.00000e+00      # liquid (inviscid)
mu1_b = 0.0

### INITIAL STATE ###
density0.ic.type = expression
density0.ic.expression.constant.rho_air = 1.225
density0.ic.expression.constant.rho_shock = 6.125000
density0.ic.expression.constant.x_shock = -7.500000e-06
density0.ic.expression.region0 = "(x < x_shock)*rho_shock + (x >= x_shock)*rho_air"
density1.ic.type = expression
density1.ic.expression.region0 = "744.290000"

velocity0.ic.type = expression
velocity0.ic.expression.constant.u_shock = 1361.1760
velocity0.ic.expression.constant.x_shock = -7.500000e-06
velocity0.ic.expression.region0 = "(x < x_shock)*u_shock"
velocity0.ic.expression.region1 = "0.0"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"

pressure0.ic.type = expression
pressure0.ic.expression.constant.p_atm = 101325.0
pressure0.ic.expression.constant.p_shock = 2938425.00
pressure0.ic.expression.constant.x_shock = -7.500000e-06
pressure0.ic.expression.region0 = "(x < x_shock)*p_shock + (x >= x_shock)*p_atm"
pressure1.ic.type = expression
pressure1.ic.expression.region0 = "101325.0"

### SOURCES ###
sigma = 0.024762
apply_surface_tension = 1
apply_vaporization = 0
Dv = "9.31074e-07"
Lv = 0.0
Y_infinity = 0.0

apply_weight = 0
grav = 0.0
pref = 0.0
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value = 0.0 0.0

### BOUNDARIES: xlo inflow (zero gradient), xhi outflow, ylo symmetry, yhi zero gradient ###
eta.bc.type.xlo = neumann
eta.bc.type.xhi = neumann
eta.bc.type.ylo = REFLECT_EVEN
eta.bc.type.yhi = neumann
density.bc.type.xlo = neumann
density.bc.type.xhi = neumann
density.bc.type.ylo = REFLECT_EVEN
density.bc.type.yhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.xhi = neumann
energy.bc.type.ylo = REFLECT_EVEN
energy.bc.type.yhi = neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.xhi = neumann neumann
momentum.bc.type.ylo = REFLECT_EVEN REFLECT_ODD
momentum.bc.type.yhi = neumann neumann

### REFINEMENT: interface and shocks ###
# grad(p)*2*dr > 5% of the incident shock jump (p2 - p1): incident, reflected, transmitted and bow
# shocks are refined to the finest level; weak acoustic waves are not.
eta_refinement_criterion = 0.01
omega_refinement_criterion = 1e+30
gradu_refinement_criterion = 1e+30
p_refinement_criterion = 141855
rho_refinement_criterion = 1e+30
cutoff = 1e-16
small = 1e-6

### NUMERICS (as the water column: HLLC, minmod, SSP-RK3) ###
Riemann_Solver.type = hllc
Limiter.type = minmod
integration.type = RungeKutta
integration.rk.type = 3
kappa_method = 1
nghost = 4
