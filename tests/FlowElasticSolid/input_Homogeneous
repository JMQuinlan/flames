# ============================================================================
# FlowElasticSolid / homogeneous finite deformation  (Hydro2, elastic.on = 1)
#
# A periodic box of uniformly pre-strained solid at rest (elastic.cobasis.ic).  Nothing
# should move; the stress the code reports is compared, component by component, with
# the closed form of the model (Favrie et al. 2009, eq. 12):
#   S = -mu (rho/rho0) dev(Gt^2 - Gt),  Gt = G/|G|^(1/3),  G = sum_b e^b (x) e^b
#   W = (rho/rho0) (mu/4) tr((Gt - I)^2)
# Simple shear X = x - g y (a = b = 1):
#   S_xy = mu (g + g^3),  S_xx = mu g^4/3,  S_yy = -mu (g^2 + 2 g^4/3),  S_zz = mu (g^2 + g^4/3),
#   W = mu (2 g^2 + g^4)/4
# Set a, b, g on the command line (elastic.cobasis.ic.expression.constant.*), and
# density0.ic.constant.value = a*b so that det(e) = rho/rho0.
#
# Run (from bin/): mpirun -np 1 ./hydro2-2d-g++ ../tests/FlowElasticSolid/input_Homogeneous plot_file=<dir>/output
# Check:           python3 ../tests/FlowElasticSolid/reference/homogeneous_check.py <dir> a b g
# ============================================================================
plot_file = ./tests/FlowElasticSolid/output_Homogeneous

Riemann_Solver.type = hllc_elastic
Limiter.type        = minmod
nghost = 4
integration.type    = RungeKutta
integration.rk.type = 3

elastic.on      = 1
elastic.mu0     = 12.0     # phase 0 (eta = 1) is the solid; phase 1 (mu1 = 0) is a gas
elastic.rhoref0 = 1.0
# pre-strain: X = a x - g y, Y = b y  ->  e^1 = (a, -g), e^2 = (0, b), e^3 = (0, 0, 1);  rho = a b rho0
elastic.cobasis.ic.type = expression
elastic.cobasis.ic.expression.constant.a = 1.0
elastic.cobasis.ic.expression.constant.b = 1.0
elastic.cobasis.ic.expression.constant.g = 0.3
elastic.cobasis.ic.expression.region0 = "a"
elastic.cobasis.ic.expression.region1 = "-g"
elastic.cobasis.ic.expression.region2 = "0.0"
elastic.cobasis.ic.expression.region3 = "b"
elastic.cobasis.ic.expression.region4 = "1.0"

eta.ic.type = constant
eta.ic.constant.value = 0.999999
epsilon = 0.01

amr.plot_dt = 0.5
amr.max_level = 0
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.n_cell = 16 16
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 0.0
geometry.is_periodic = 1 1 0

timestep  = 1.0e-3
stop_time = 0.5

m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0
q.ic.type = constant
q.ic.constant.value = 0.0

cfl   = 0.4

eos0.gamma = 3.4
eos1.gamma = 1.4
eos0.p0 = 10.0
eos1.p0 = 0.0
eos0.cp = 1004.5
eos1.cp = 1004.5
eos0.cv = 717.5
eos1.cv = 717.5

mu0   = 0.0
mu1   = 0.0
sigma = 0.0
pref = 0.0

# solid (phase 0)
density0.ic.type = constant
density0.ic.constant.value = 1.0
velocity0.ic.type = constant
velocity0.ic.constant.value = 0.0 0.0
pressure0.ic.type = constant
pressure0.ic.constant.value = 0.1
cp0 = 1.4
cv0 = 1.0

# gas (phase 1, trace)
density1.ic.type = constant
density1.ic.constant.value = 0.001
velocity1.ic.type = constant
velocity1.ic.constant.value = 0.0 0.0
pressure1.ic.type = constant
pressure1.ic.constant.value = 0.1
cp1 = 1.4
cv1 = 1.0

density.bc.type.xhi = periodic
density.bc.type.xlo = periodic
density.bc.type.ylo = periodic
density.bc.type.yhi = periodic
energy.bc.type.xhi = periodic
energy.bc.type.xlo = periodic
energy.bc.type.ylo = periodic
energy.bc.type.yhi = periodic
momentum.bc.type.xhi = periodic periodic
momentum.bc.type.xlo = periodic periodic
momentum.bc.type.ylo = periodic periodic
momentum.bc.type.yhi = periodic periodic

eta_refinement_criterion   = 100000.1
omega_refinement_criterion = 100000.1
gradu_refinement_criterion = 100000.0
rho_refinement_criterion   = 100000.0
p_refinement_criterion     = 100000.0

kappa_method = 1
Dv = 0
g = 0.0
apply_surface_tension = 0
apply_weight = 0
apply_vaporization = 0
reinit_max_iter = 50
reinit_tolerance = 1e-6
apply_ahe   = 1
ahe.method  = 0
cutoff = 1e-4

eta.bc.type.xlo = periodic
eta.bc.type.xhi = periodic
eta.bc.type.ylo = periodic
eta.bc.type.yhi = periodic
