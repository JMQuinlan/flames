# ============================================================================
# FlowElasticSolid / 1D gas shock hitting an elastic solid  (Hydro2, elastic.on = 1)
#
# A Mach 2 shock in a gas (rho = 1, p = 1, gamma = 1.4) travels in +x and hits
# the face (x = 0.6) of a soft elastic solid:
#   rho_s = 10, stiffened gas gamma = 4.4, p_inf = 100, shear modulus mu = 50
#   -> c_s = 6.667, c_l = sqrt(c_s^2 + (4/3) mu/rho_s) = 7.149, Z_s = rho_s c_l = 71.5
# Post-shock gas: p2 = 4.5, rho2 = 2.6667, u2 = 1.479.
# The shock reflects and a longitudinal elastic wave is transmitted.  Impedance
# matching (gas Hugoniot from state 2 against the solid's acoustic relation
# p3 - p1 = Z_s u_i) gives the interface velocity u_i and the reflected
# pressure p3 = -sigma_11; reference/shock_impact_1d_check.py solves it.
# In the solid the pressure rise is only rho_s c_s^2 u_i/c_l: the rest of the
# normal stress is carried by the deviator S_11 = -(4/3) mu u_i/c_l.
#
# Run (from bin/): mpirun -np 4 ./hydro2-2d-g++ ../tests/FlowElasticSolid/input_1D_ShockImpact plot_file=<dir>/output
# Check:           python3 ../tests/FlowElasticSolid/reference/shock_impact_1d_check.py <dir>
# ============================================================================
plot_file = ./tests/FlowElasticSolid/output_1D_ShockImpact

Riemann_Solver.type = hllc_elastic
Limiter.type        = minmod
nghost = 4
integration.type    = RungeKutta
integration.rk.type = 3

elastic.on      = 1
elastic.mu0     = 50.0     # phase 0 (eta = 1): the solid;  phase 1 is the gas (mu1 = 0)
elastic.rhoref0 = 10.0

eta.ic.type = expression
eta.ic.expression.constant.xi = 0.6
eta.ic.expression.region0 = "1.0e-6 + (1.0 - 2.0e-6)*(x > xi)"
epsilon = 0.001

amr.plot_dt = 0.02
amr.max_level = 0
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.n_cell = 1000 4
geometry.prob_lo = 0.0  -0.002   0.0
geometry.prob_hi = 1.0   0.002   0.0
geometry.is_periodic = 0 1 0

timestep  = 1.0e-5
stop_time = 0.24

m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0
q.ic.type = constant
q.ic.constant.value = 0.0

cfl   = 0.4

eos0.gamma = 4.4
eos1.gamma = 1.4
eos0.p0 = 100.0
eos1.p0 = 0.0
eos0.cp = 1004.5
eos1.cp = 1004.5
eos0.cv = 717.5
eos1.cv = 717.5

mu0   = 0.0
mu1   = 0.0
sigma = 0.0
pref = 0.0

# solid (phase 0), at rest at p = 1
density0.ic.type = constant
density0.ic.constant.value = 10.0
velocity0.ic.type = expression
velocity0.ic.expression.constant.xs = 0.3
velocity0.ic.expression.region0 = "1.479019945774904*(x < xs)"
velocity0.ic.expression.region1 = "0.0"
pressure0.ic.type = expression
pressure0.ic.expression.constant.xs = 0.3
pressure0.ic.expression.region0 = "4.5*(x < xs) + 1.0*(x >= xs)"

# gas (phase 1): Mach 2 shock at x = xs moving in +x
density1.ic.type = expression
density1.ic.expression.constant.xs = 0.3
density1.ic.expression.region0 = "2.6666666666666665*(x < xs) + 1.0*(x >= xs)"
velocity1.ic.type = expression
velocity1.ic.expression.constant.xs = 0.3
velocity1.ic.expression.region0 = "1.479019945774904*(x < xs)"
velocity1.ic.expression.region1 = "0.0"
pressure1.ic.type = expression
pressure1.ic.expression.constant.xs = 0.3
pressure1.ic.expression.region0 = "4.5*(x < xs) + 1.0*(x >= xs)"

density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = periodic
density.bc.type.yhi = periodic
energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = periodic
energy.bc.type.yhi = periodic
momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = periodic periodic
momentum.bc.type.yhi = periodic periodic

eta_refinement_criterion   = 100000.1
omega_refinement_criterion = 100000.1
gradu_refinement_criterion = 100000.0
rho_refinement_criterion   = 100000.0
p_refinement_criterion     = 100000.0

kappa_method = 1
Dv = 0
g = 0.0
apply_surface_tension = 0
apply_weight = 0
apply_vaporization = 0
reinit_max_iter = 50
reinit_tolerance = 1e-6
apply_ahe   = 1
ahe.method  = 0
cutoff = 1e-4
