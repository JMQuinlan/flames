# ============================================================================
# FlowElasticSolid / finite-strain uniaxial shock ("piston") in a solid  (Hydro2, elastic.on = 1)
#
# Two halves of the same solid collide at x = 0 with velocities +-U: by symmetry
# x = 0 is a rigid piston, and a shock runs into each half leaving the material at
# rest behind it, compressed UNIAXIALLY by a = rho1/rho0 (10-30 % for U = 0.5-2,
# against 1e-4 in input_1D_ElasticWaves).
# Exact solution: Rankine-Hugoniot for the model's energy (Favrie et al. 2009,
# eqs. 9-12): with Gt = diag(a^(4/3), a^(-2/3), a^(-2/3)),
#   mass      s = U/(a - 1)                         (shock speed in the lab frame)
#   momentum  (p1 - S11(a)) - p0 = rho0 a U^2/(a - 1)
#   energy    e1 - e0 = (1/2)(p1 - S11 + p0)(1 - 1/a)/rho0,   e = e_h(p, rho) + mu/(4 rho0) tr((Gt - I)^2)
# solved for a in reference/piston_check.py.
#   solid rho0 = 1, gamma = 3.4, p_inf = 10, p0 = 0.1, mu = 12  (c_l = 7.095)
#
# Run (from bin/): mpirun -np 4 ./hydro2-2d-g++ ../tests/FlowElasticSolid/input_1D_Piston plot_file=<dir>/output
#                  (other speeds: velocity0.ic.expression.constant.U=.. velocity1.ic.expression.constant.U=..)
# Check:           python3 ../tests/FlowElasticSolid/reference/piston_check.py <dir> [U]
# ============================================================================
plot_file = ./tests/FlowElasticSolid/output_1D_Piston

Riemann_Solver.type = hllc_elastic
Limiter.type        = minmod
nghost = 4
integration.type    = RungeKutta
integration.rk.type = 3

elastic.on      = 1
elastic.mu0     = 12.0     # phase 0 (eta = 1) is the solid; phase 1 (mu1 = 0) is a gas
elastic.rhoref0 = 1.0

eta.ic.type = constant
eta.ic.constant.value = 0.999999
epsilon = 0.01

amr.plot_dt = 0.07
amr.max_level = 0
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.n_cell = 800 4
geometry.prob_lo = -1.0  -0.005   0.0
geometry.prob_hi =  1.0   0.005   0.0
geometry.is_periodic = 0 1 0

timestep  = 1.0e-5
dynamictimestep.on  = 1
dynamictimestep.verbose = 0
dynamictimestep.max = 1e-2
dynamictimestep.min = 1e-10
stop_time = 0.07

m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0
q.ic.type = constant
q.ic.constant.value = 0.0

cfl   = 0.4

eos0.gamma = 3.4
eos1.gamma = 1.4
eos0.p0 = 10.0
eos1.p0 = 0.0
eos0.cp = 1004.5
eos1.cp = 1004.5
eos0.cv = 717.5
eos1.cv = 717.5

mu0   = 0.0
mu1   = 0.0
sigma = 0.0
pref = 0.0

# solid (phase 0)
density0.ic.type = constant
density0.ic.constant.value = 1.0
velocity0.ic.type = expression
velocity0.ic.expression.constant.U = 1.0
velocity0.ic.expression.region0 = "U*((x < 0) - (x > 0))"
velocity0.ic.expression.region1 = "0.0"
pressure0.ic.type = constant
pressure0.ic.constant.value = 0.1
cp0 = 1.4
cv0 = 1.0

# gas (phase 1, trace)
density1.ic.type = constant
density1.ic.constant.value = 0.001
velocity1.ic.type = expression
velocity1.ic.expression.constant.U = 1.0
velocity1.ic.expression.region0 = "U*((x < 0) - (x > 0))"
velocity1.ic.expression.region1 = "0.0"
pressure1.ic.type = constant
pressure1.ic.constant.value = 0.1
cp1 = 1.4
cv1 = 1.0

density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = periodic
density.bc.type.yhi = periodic
energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = periodic
energy.bc.type.yhi = periodic
momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = periodic periodic
momentum.bc.type.yhi = periodic periodic

eta_refinement_criterion   = 100000.1
omega_refinement_criterion = 100000.1
gradu_refinement_criterion = 100000.0
rho_refinement_criterion   = 100000.0
p_refinement_criterion     = 100000.0

kappa_method = 1
Dv = 0
g = 0.0
apply_surface_tension = 0
apply_weight = 0
apply_vaporization = 0
reinit_max_iter = 50
reinit_tolerance = 1e-6
apply_ahe   = 1
ahe.method  = 0
cutoff = 1e-4
