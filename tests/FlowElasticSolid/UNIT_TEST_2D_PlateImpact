# ============================================================================
# FlowElasticSolid / projectile hitting a plate -- SOLID ON SOLID  (Hydro2, elastic.on = 1)
#
# DEFORMING SOLID test after Favrie, Gavrilyuk & Saurel, JCP 228 (2009), Sec. 7.1
# (Figs. 15-18): a square projectile (0.1 x 0.1) moving at Up hits a plate
# (0.1 x 0.5) of the same material, already in contact at t = 0, surrounded by gas.
# The paper uses copper at 800 m/s in air; that stiffness / density ratio is beyond
# the higher-order limiters of this solver (see OPTIMIZATION_CHANGELOG), so a
# softer non-dimensional solid is used:
#   solid  rho_s = 10, stiffened gas gamma = 4.4, p_inf = 100, mu = 50 (c_l = 7.15, c_t = 2.24)
#   gas    rho = 1, p = 1, gamma = 1.4
#   Up = 0.5  (Up/c_l = 0.07; the paper's 800 m/s on copper is Up/c_l = 0.15)
# 400 x 400 cells, all boundaries zero-gradient.
#
# What to look for (paper Figs. 16-18): with shear strength the plate bends and
# springs back (it oscillates); with elastic.mu0 = 0 the "plate" is a liquid sheet
# that the projectile punches through and never recovers.
# 1D check of the first instants on the axis: two identical half-spaces meeting at
# Up give a contact velocity Up/2 and a normal stress rise rho_s c_l Up/2 = 17.9.
#
# Run (from bin/): mpirun -np 16 ./hydro2-2d-g++ ../tests/FlowElasticSolid/UNIT_TEST_2D_PlateImpact plot_file=<dir>/output
#                  (liquid reference: add  elastic.mu0=0.0)
# Check:           python3 ../tests/FlowElasticSolid/reference/deforming_solid_2d_check.py <dir> --title "Plate Impact"
#                  (elastic body only: schlieren, stresses in the solid, histories; add <liquid_dir> for the liquid comparison)
# ============================================================================
plot_file = ./tests/FlowElasticSolid/output_2D_PlateImpact

Riemann_Solver.type = hllc_elastic
Limiter.type        = minmod      # higher-order limiters leave a few-% residual stress at solid|gas interfaces; godunov is clean but diffusive
nghost = 4
integration.type    = RungeKutta
integration.rk.type = 3

elastic.on      = 1
elastic.mu0     = 50.0     # phase 0 (eta = 1): the solid;  phase 1 is the gas (mu1 = 0)
elastic.rhoref0 = 10.0

eta.ic.type = expression
# projectile: square 0.1 x 0.1, x in [0.30, 0.40]; plate: 0.1 x 0.5, x in [0.40, 0.50] (in contact at t = 0)
eta.ic.expression.constant.w = 0.003       # interface half-width (~1 cell)
eta.ic.expression.region0 = "1.0e-6 + (1.0 - 2.0e-6)*max(0.25*(1.0 + tanh((x - 0.30)/w))*(1.0 - tanh((x - 0.40)/w))*0.25*(1.0 + tanh((y - 0.45)/w))*(1.0 - tanh((y - 0.55)/w)), 0.25*(1.0 + tanh((x - 0.40)/w))*(1.0 - tanh((x - 0.50)/w))*0.25*(1.0 + tanh((y - 0.25)/w))*(1.0 - tanh((y - 0.75)/w)))"
epsilon = 0.001

amr.plot_dt = 0.02
amr.max_level = 0
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.n_cell = 400 400
geometry.prob_lo = 0.0  0.0   0.0
geometry.prob_hi = 1.0  1.0   0.0
geometry.is_periodic = 0 0 0

timestep  = 1.0e-5
dynamictimestep.on  = 1
dynamictimestep.verbose = 0
dynamictimestep.max = 1e-2
dynamictimestep.min = 1e-10
stop_time = 1.5

m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0
q.ic.type = constant
q.ic.constant.value = 0.0

cfl   = 0.4

eos0.gamma = 4.4
eos1.gamma = 1.4
eos0.p0 = 100.0
eos1.p0 = 0.0
eos0.cp = 1004.5
eos1.cp = 1004.5
eos0.cv = 717.5
eos1.cv = 717.5

mu0   = 0.0
mu1   = 0.0
sigma = 0.0
pref = 0.0

# solid (phase 0): the projectile moves at Up = 0.5 (7 % of c_l), the plate is at rest
density0.ic.type = constant
density0.ic.constant.value = 10.0
velocity0.ic.type = expression
velocity0.ic.expression.constant.Up = 0.5
velocity0.ic.expression.region0 = "Up*(x > 0.29)*(x < 0.40)*(y > 0.44)*(y < 0.56)"
velocity0.ic.expression.region1 = "0.0"
pressure0.ic.type = constant
pressure0.ic.constant.value = 1.0

# gas (phase 1), at rest except inside the projectile footprint
density1.ic.type = constant
density1.ic.constant.value = 1.0
velocity1.ic.type = expression
velocity1.ic.expression.constant.Up = 0.5
velocity1.ic.expression.region0 = "Up*(x > 0.29)*(x < 0.40)*(y > 0.44)*(y < 0.56)"
velocity1.ic.expression.region1 = "0.0"
pressure1.ic.type = constant
pressure1.ic.constant.value = 1.0

density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = neumann
density.bc.type.yhi = neumann
energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = neumann
energy.bc.type.yhi = neumann
momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = neumann neumann
momentum.bc.type.yhi = neumann neumann

eta_refinement_criterion   = 100000.1
omega_refinement_criterion = 100000.1
gradu_refinement_criterion = 100000.0
rho_refinement_criterion   = 100000.0
p_refinement_criterion     = 100000.0

kappa_method = 1
Dv = 0
g = 0.0
apply_surface_tension = 0
apply_weight = 0
apply_vaporization = 0
reinit_max_iter = 50
reinit_tolerance = 1e-6
apply_ahe   = 1
ahe.method  = 0
cutoff = 1e-4
