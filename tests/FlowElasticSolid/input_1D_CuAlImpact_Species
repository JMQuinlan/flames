# ============================================================================
# FlowElasticSolid / copper - aluminium impact with BOTH METALS AS SPECIES OF ONE SOLID PHASE and air as the other
# phase  (species stage 2b: species.eos = mixture with pinf / rho_ref, elastic.species.*)
#
# Same problem as input_1D_CuAlImpact (Favrie & Schmidmayer 2026, Sec. 5.1, Fig. 4; units GPa, g/cm^3, m, ms, km/s),
# but set up the way that paper does it: three materials.  Phase 0 (eta = 1 - 1e-5) is "the solid" and carries two
# species, Cu (x < 0.5) and Al (x >= 0.5), each with its own gamma, p_inf, reference density, shear modulus, yield
# stress and plastic viscosity; phase 1 is a trace (1e-5) of air everywhere.  The check is that this reproduces the
# two-phase run (copper and aluminium as the two phases, no air) and the published plateaux.
#
# Run (from bin/): mpirun -np 8 ./hydro2-2d-g++ ../tests/FlowElasticSolid/input_1D_CuAlImpact_Species plot_file=<dir>/output [elastic.plastic=0]
# Check:           python3 ../tests/FlowElasticSolid/reference/cual_impact_check.py <plastic_dir> <elastic_dir>
# ============================================================================
plot_file = ./tests/FlowElasticSolid/output_1D_CuAlImpact_Species
Riemann_Solver.type = hllc_elastic
Limiter.type        = minmod
nghost = 4
integration.type    = RungeKutta
integration.rk.type = 3
elastic.on      = 1
eta.ic.type = expression
epsilon = 0.001
amr.plot_dt = 0.005
amr.max_level = 0
amr.max_grid_size = 250
amr.blocking_factor = 2
amr.n_cell = 2000 4
geometry.prob_lo = 0.0  -0.001   0.0
geometry.prob_hi = 1.0   0.001   0.0
geometry.is_periodic = 0 1 0
timestep  = 1.0e-5
stop_time = 0.05
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0
q.ic.type = constant
q.ic.constant.value = 0.0
cfl   = 0.4
eos0.cp = 1004.5
eos1.cp = 1004.5
eos0.cv = 717.5
eos1.cv = 717.5
mu0   = 0.0
mu1   = 0.0
sigma = 0.0
pref = 0.0
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.4*(x < 0.5) - 0.2*(x >= 0.5)"
velocity0.ic.expression.region1 = "0.0"
pressure0.ic.type = expression
pressure0.ic.expression.region0 = "1.0e-4"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.4*(x < 0.5) - 0.2*(x >= 0.5)"
velocity1.ic.expression.region1 = "0.0"
pressure1.ic.type = expression
pressure1.ic.expression.region0 = "1.0e-4"
density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = periodic
density.bc.type.yhi = periodic
energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = periodic
energy.bc.type.yhi = periodic
momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = periodic periodic
momentum.bc.type.yhi = periodic periodic
eta_refinement_criterion   = 100000.1
omega_refinement_criterion = 100000.1
gradu_refinement_criterion = 100000.0
rho_refinement_criterion   = 100000.0
p_refinement_criterion     = 100000.0
kappa_method = 1
Dv = 0
g = 0.0
apply_surface_tension = 0
apply_weight = 0
apply_vaporization = 0
reinit_max_iter = 50
reinit_tolerance = 1e-6
apply_ahe   = 1
ahe.method  = 0
cutoff = 1e-4                    # NOTE: the 1e-5 air trace is therefore not relaxed in this deck (harmless here; the spallation deck needs 1e-8)
eta.bc.type.xlo = neumann
eta.bc.type.xhi = neumann
eta.bc.type.ylo = periodic
eta.bc.type.yhi = periodic
eta_consistent_advect = 1       # minmod at a metal|metal interface (changelog II.25)
elastic.plastic  = 1
eta.ic.expression.region0 = "1.0 - 1.0e-5"
eos0.gamma = 4.2                 # defaults of the solid phase (used only in cells without species)
eos0.p0 = 34.2
eos1.gamma = 1.4                 # phase 1: air
eos1.p0 = 0.0
density0.ic.type = expression
density0.ic.expression.region0 = "8.9*(x < 0.5) + 2.7*(x >= 0.5)"
density1.ic.type = constant
density1.ic.constant.value = 1.2e-3
species.on = 1
species.eos = mixture
species.order = 2
species.phase0.names   = Cu Al
species.phase0.gamma   = 4.2 3.4
species.phase0.cv      = 717.5 717.5
species.phase0.pinf    = 34.2 21.5
species.phase0.rho_ref = 8.9 2.7
species.ic.type = expression
species.ic.expression.region0 = "1.0*(x < 0.5)"
species.ic.expression.region1 = "1.0*(x >= 0.5)"
species.bc.type.xlo = neumann
species.bc.type.xhi = neumann
species.bc.type.ylo = periodic
species.bc.type.yhi = periodic
elastic.species.mu      = 92.0 26.0
elastic.species.sigma_y = 0.297 0.060
elastic.species.Ky      = 1.5e-2 5.0e-3
