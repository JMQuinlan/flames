# ============================================================================
# FlowElasticSolid / CuAlShock: aluminium-copper (solid-solid) shock tube  (Hydro2, elastic.on = 1)
#
# Favrie, Gavrilyuk & Saurel, JCP 228 (2009), Sec. 5.2 / Fig. 5: aluminium at
# rest at p = 1e8 Pa (x < 0.5 m) against copper at rest at p = 1e5 Pa (x > 0.5 m).
#   Al: rho = 2700 kg/m3, stiffened gas gamma = 3.4,  p_inf = 215e8 Pa, mu = 2.6e10 Pa
#   Cu: rho = 8900 kg/m3, stiffened gas gamma = 4.22, p_inf = 342e8 Pa, mu = 9.2e10 Pa
# 1000 cells, minmod.  Both phases are solids (elastic.mu0, elastic.mu1 > 0).
#
# UNITS used here: length m, density 1e3 kg/m3, pressure 1e9 Pa -> velocity km/s, time ms.
#
# The pressure jumps at the contact but the NORMAL STRESS sigma_11 = -p + S_11 is
# continuous.  Small-amplitude (acoustic) solution, c_l^2 = gamma (p + p_inf)/rho + (4/3) mu/rho:
#   c_l(Al) = 6.328 km/s, c_l(Cu) = 5.477 km/s
#   u*       = (p_L - p_R)/(Z_L + Z_R)        = 1.5175e-3 km/s   (paper Fig. 5: 1.52 m/s)
#   sigma_11* = -p_L + Z_L u*                  = -0.07407         (paper: -74 MPa)
#   p*(Al)   = 0.0824, p*(Cu) = 0.0401                           (paper: 82 and 40 MPa)
# The paper quotes t = 134 us, but the wave positions in its Fig. 5 (0.21 m and
# 0.73 m) correspond to t ~ 45 us with these wave speeds; 45 us is used here.
#
# Run (from bin/): mpirun -np 4 ./hydro2-2d-g++ ../tests/FlowElasticSolid/input_1D_CuAlShock plot_file=<dir>/output
# Check:           python3 ../tests/FlowElasticSolid/reference/cual_shock_check.py <dir>
# ============================================================================
plot_file = ./tests/FlowElasticSolid/output_1D_CuAlShock

Riemann_Solver.type = hllc_elastic
Limiter.type        = minmod
nghost = 4
integration.type    = RungeKutta
integration.rk.type = 3

elastic.on      = 1
elastic.mu0     = 26.0     # phase 0 (eta = 1): aluminium
elastic.rhoref0 = 2.7
elastic.mu1     = 92.0     # phase 1 (eta = 0): copper
elastic.rhoref1 = 8.9

eta.ic.type = expression
eta.ic.expression.constant.xi = 0.5
eta.ic.expression.region0 = "1.0e-6 + (1.0 - 2.0e-6)*(x < xi)"
epsilon = 0.001

amr.plot_dt = 0.005
amr.max_level = 0
amr.max_grid_size = 500000
amr.blocking_factor = 2
amr.n_cell = 1000 4
geometry.prob_lo = 0.0  -0.002   0.0
geometry.prob_hi = 1.0   0.002   0.0
geometry.is_periodic = 0 1 0

timestep  = 1.0e-5
stop_time = 0.045

m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0
q.ic.type = constant
q.ic.constant.value = 0.0

cfl   = 0.4

eos0.gamma = 3.4
eos1.gamma = 4.22
eos0.p0 = 21.5
eos1.p0 = 34.2
eos0.cp = 1004.5
eos1.cp = 1004.5
eos0.cv = 717.5
eos1.cv = 717.5

mu0   = 0.0
mu1   = 0.0
sigma = 0.0
pref = 0.0

# aluminium (phase 0)
density0.ic.type = constant
density0.ic.constant.value = 2.7
velocity0.ic.type = constant
velocity0.ic.constant.value = 0.0 0.0
pressure0.ic.type = expression
pressure0.ic.expression.region0 = "0.1*(x < 0.5) + 1.0e-4*(x >= 0.5)"

# copper (phase 1)
density1.ic.type = constant
density1.ic.constant.value = 8.9
velocity1.ic.type = constant
velocity1.ic.constant.value = 0.0 0.0
pressure1.ic.type = expression
pressure1.ic.expression.region0 = "0.1*(x < 0.5) + 1.0e-4*(x >= 0.5)"

density.bc.type.xhi = neumann
density.bc.type.xlo = neumann
density.bc.type.ylo = periodic
density.bc.type.yhi = periodic
energy.bc.type.xhi = neumann
energy.bc.type.xlo = neumann
energy.bc.type.ylo = periodic
energy.bc.type.yhi = periodic
momentum.bc.type.xhi = neumann neumann
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.ylo = periodic periodic
momentum.bc.type.yhi = periodic periodic

eta_refinement_criterion   = 100000.1
omega_refinement_criterion = 100000.1
gradu_refinement_criterion = 100000.0
rho_refinement_criterion   = 100000.0
p_refinement_criterion     = 100000.0

kappa_method = 1
Dv = 0
g = 0.0
apply_surface_tension = 0
apply_weight = 0
apply_vaporization = 0
reinit_max_iter = 50
reinit_tolerance = 1e-6
apply_ahe   = 1
ahe.method  = 0
cutoff = 1e-4
