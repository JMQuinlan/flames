# ============================================================================
# FlowSpecies / the shock tube of input_1D_TwoGammaShockTube with the two gases as the two PHASES  (no species)
#
# Left: phase 0 (gamma 1.4), rho 1, p 1.  Right: phase 1 (gamma 5/3), rho 0.125, p 0.1.  eta = 1 - 1e-6 left, 1e-6 right.
# Same exact solution; this is the existing two-phase capability and serves as the cross-check of the species run.
#
# Run (from bin/): mpirun -np 4 ./hydro2-2d-g++ ../tests/FlowSpecies/input_1D_TwoGammaShockTube_Phases plot_file=<dir>/output
# Check:           python3 ../tests/FlowSpecies/reference/two_gamma_check.py tube <species_dir> --phases <dir>
# ============================================================================
plot_file = ./tests/FlowSpecies/output_1D_TwoGammaShockTube_Phases
amr.plot_dt = 0.02
amr.max_grid_size = 100
amr.blocking_factor = 2
amr.regrid_int       = 10
amr.grid_eff         = 0.8
amr.max_level = 0
amr.n_cell = 400 4
amr.n_error_buf      = 8
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 0.01 0.0
geometry.is_periodic = 0 1 0
timestep = 1e-5
dynamictimestep.on  = 1
dynamictimestep.verbose = 0
dynamictimestep.max = 1e-2
dynamictimestep.min = 1e-9
cfl                 = 0.3
cfl_v               = 0.3
stop_time = 0.2
apply_embedded_solid = 0
eta.ic.type = expression
eta.ic.expression.region0 = "(1.0 - 1.0e-6)*(x < 0.5) + 1.0e-6*(x >= 0.5)"

eos0.gamma = 1.4
eos0.p0    = 0.0
eos0.cp = 3.5
eos0.cv = 2.5
mu0 = 0.0
mu0_b = 0.0
eos1.gamma = 1.6666666666666667
eos1.p0    = 0.0
eos1.cp = 2.5
eos1.cv = 1.5
mu1 = 0.0
mu1_b = 0.0
density0.ic.type = expression
density0.ic.expression.region0 = "1.0*(x < 0.5) + 0.125*(x >= 0.5)"
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
pressure0.ic.type = expression
pressure0.ic.expression.region0 = "1.0*(x < 0.5) + 0.1*(x >= 0.5)"
density1.ic.type = expression
density1.ic.expression.region0 = "1.0*(x < 0.5) + 0.125*(x >= 0.5)"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"
pressure1.ic.type = expression
pressure1.ic.expression.region0 = "1.0*(x < 0.5) + 0.1*(x >= 0.5)"
epsilon = 0.1
sigma   = 0.0
Dv      = 0.0
pref    = 0.0
small   = 1e-6
grav    = 0.0
eta_refinement_criterion   = 1e10
omega_refinement_criterion = 1e10
gradu_refinement_criterion = 1e10
p_refinement_criterion = 1e10
rho_refinement_criterion = 1e10
cutoff = 1e-16
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0
apply_surface_tension = 0
apply_weight          = 0
apply_vaporization    = 0
Riemann_Solver.type = hllc
Limiter.type        = minmod
kappa_method        = 1
eta.bc.type.xlo = neumann
eta.bc.type.xhi = neumann
eta.bc.type.ylo = periodic
eta.bc.type.yhi = periodic
density.bc.type.xlo = neumann
density.bc.type.xhi = neumann
