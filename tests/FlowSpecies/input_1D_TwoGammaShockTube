# ============================================================================
# FlowSpecies / shock tube between two gases of different gamma, as SPECIES of one phase  (species.eos = mixture, stage 2a)
#
# Left: gas A (gamma 1.4, c_v 2.5), rho 1, p 1.  Right: gas B (gamma 5/3, c_v 1.5), rho 0.125, p 0.1.  Both have
# R = (gamma - 1) c_v = 1.  Diaphragm at x = 0.5, t = 0.2.  Both phases carry the same mixture (eta = 0.5), so the only
# thing that distinguishes the gases is the species field: gamma and c_v of every cell come from its composition.
# Exact: the two-gas Riemann solution (rarefaction in A, contact, shock in B), computed by the check script.
# The phase constants eos0 / eos1 below are only the defaults for cells without species; they are not used here.
# Cross-check with the gases as two PHASES (existing capability): input_1D_TwoGammaShockTube_Phases.
#
# Run (from bin/): mpirun -np 4 ./hydro2-2d-g++ ../tests/FlowSpecies/input_1D_TwoGammaShockTube plot_file=<dir>/output
#                  (convergence: amr.n_cell="200 4" ... "1600 4")
# Check:           python3 ../tests/FlowSpecies/reference/two_gamma_check.py tube <dir> [<dir> ...] [--phases <dir>]
# ============================================================================
plot_file = ./tests/FlowSpecies/output_1D_TwoGammaShockTube
amr.plot_dt = 0.02
amr.max_grid_size = 100
amr.blocking_factor = 2
amr.regrid_int       = 10
amr.grid_eff         = 0.8
amr.max_level = 0
amr.n_cell = 400 4
amr.n_error_buf      = 8
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 0.01 0.0
geometry.is_periodic = 0 1 0
timestep = 1e-5
dynamictimestep.on  = 1
dynamictimestep.verbose = 0
dynamictimestep.max = 1e-2
dynamictimestep.min = 1e-9
cfl                 = 0.3
cfl_v               = 0.3
stop_time = 0.2
apply_embedded_solid = 0
eta.ic.type = constant
eta.ic.constant.value = 0.5
eos0.gamma = 1.4
eos0.p0    = 0.0
eos0.cp = 3.5
eos0.cv = 2.5
mu0 = 0.0
mu0_b = 0.0
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cp = 3.5
eos1.cv = 2.5
mu1 = 0.0
mu1_b = 0.0
density0.ic.type = expression
density0.ic.expression.region0 = "1.0*(x < 0.5) + 0.125*(x >= 0.5)"
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "0.0"
velocity0.ic.expression.region1 = "0.0"
pressure0.ic.type = expression
pressure0.ic.expression.region0 = "1.0*(x < 0.5) + 0.1*(x >= 0.5)"
density1.ic.type = expression
density1.ic.expression.region0 = "1.0*(x < 0.5) + 0.125*(x >= 0.5)"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "0.0"
velocity1.ic.expression.region1 = "0.0"
pressure1.ic.type = expression
pressure1.ic.expression.region0 = "1.0*(x < 0.5) + 0.1*(x >= 0.5)"
epsilon = 0.1
sigma   = 0.0
Dv      = 0.0
pref    = 0.0
small   = 1e-6
grav    = 0.0
eta_refinement_criterion   = 1e10
omega_refinement_criterion = 1e10
gradu_refinement_criterion = 1e10
p_refinement_criterion = 1e10
rho_refinement_criterion = 1e10
cutoff = 1e-16
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0
apply_surface_tension = 0
apply_weight          = 0
apply_vaporization    = 0
Riemann_Solver.type = hllc
Limiter.type        = minmod
kappa_method        = 1
eta.bc.type.xlo = neumann
eta.bc.type.xhi = neumann
eta.bc.type.ylo = periodic
eta.bc.type.yhi = periodic
density.bc.type.xlo = neumann
density.bc.type.xhi = neumann
density.bc.type.ylo = periodic
density.bc.type.yhi = periodic
density0.bc.type.xlo = neumann
density0.bc.type.xhi = neumann
density0.bc.type.ylo = periodic
density0.bc.type.yhi = periodic
density1.bc.type.xlo = neumann
density1.bc.type.xhi = neumann
density1.bc.type.ylo = periodic
density1.bc.type.yhi = periodic
energy.bc.type.xlo = neumann
energy.bc.type.xhi = neumann
energy.bc.type.ylo = periodic
energy.bc.type.yhi = periodic
momentum.bc.type.xlo = neumann neumann
momentum.bc.type.xhi = neumann neumann
momentum.bc.type.ylo = periodic periodic
momentum.bc.type.yhi = periodic periodic
nghost = 4
thermal.conduction = 0
thermal.Pr = 0.75
ablation.on = 0
species.on = 1
species.eos = mixture
species.phase0.names = A B
species.phase1.names = A1 B1
species.phase0.gamma = 1.4 1.6666666666666667
species.phase0.cv    = 2.5 1.5
species.phase1.gamma = 1.4 1.6666666666666667
species.phase1.cv    = 2.5 1.5
species.ic.type = expression
species.ic.expression.region0 = "1.0*(x < 0.5)"
species.ic.expression.region1 = "1.0*(x >= 0.5)"
species.ic.expression.region2 = "1.0*(x < 0.5)"
species.ic.expression.region3 = "1.0*(x >= 0.5)"
species.bc.type.xlo = neumann
species.bc.type.xhi = neumann
species.bc.type.ylo = periodic
species.bc.type.yhi = periodic
