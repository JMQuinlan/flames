dynamictimestep.min = 1e-9
cfl                 = 0.3
cfl_v               = 0.3
stop_time = 1.0
apply_embedded_solid = 0
eta.ic.type = constant
eta.ic.constant.value = 0.5
eos0.gamma = 1.4
eos0.p0    = 0.0
eos0.cp = 3.5
eos0.cv = 2.5
mu0 = 0.0
mu0_b = 0.0
eos1.gamma = 1.4
