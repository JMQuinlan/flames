# ============================================================================
# FlowSpecies / species in a liquid slab and in the gas around it, advected together  (Hydro2, species.on = 1, stage 1)
#
# A slab of stiff liquid (phase 0: rho 10, gamma 4.4, p_inf 100; 0.3 < x < 0.7) in a light gas (phase 1: rho 0.1),
# everything moving at u = 1 through a periodic box of length 1 (one turn at t = 1).  The liquid holds two species
# (L2 with a profile across the slab), the gas three (G2 with a wave, and Vap = the vapour of L2 as its own gas entry).
# Checks that each species stays in ITS phase as the diffuse interface moves:
#   sum of the liquid species = alpha_0 rho_0 and sum of the gas species = alpha_1 rho_1 in every cell (round-off),
#   species masses constant, no negatives, the uniform vapour trace Y = 1e-6 preserved, the flow unchanged
#   (uniform p, u kept as without species).
#
# Run (from bin/): mpirun -np 2 ./hydro2-2d-g++ ../tests/FlowSpecies/input_1D_TwoPhaseSlab plot_file=<dir>/output
# Check:           python3 ../tests/FlowSpecies/reference/species_check.py slab <dir>
# ============================================================================
plot_file = ./tests/FlowSpecies/output_1D_TwoPhaseSlab
# Check:           python3 ../tests/FlowConjugateHeat/reference/becker_shock_check.py <dir> [<dir> ...]
# ============================================================================
plot_file = ./tests/FlowConjugateHeat/output_1D_BeckerShock
# Check:           python3 ../tests/FlowAblation/reference/stefan_check.py <dir>
# ============================================================================
plot_file = ./tests/FlowAblation/output_1D_Stefan
amr.plot_dt = 0.1
amr.max_grid_size = 100
amr.blocking_factor = 2
amr.regrid_int       = 10
amr.grid_eff         = 0.8
amr.max_level = 0
amr.n_cell = 200 4
amr.n_error_buf      = 8
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 0.02 0.0
geometry.is_periodic = 1 1 0
timestep = 1e-5
dynamictimestep.on  = 1
dynamictimestep.verbose = 0
dynamictimestep.max = 1e-2
dynamictimestep.min = 1e-9
cfl                 = 0.3
cfl_v               = 0.3
stop_time = 1.0
apply_embedded_solid = 0
eta.ic.type = expression
eta.ic.expression.region0 = "1.0e-6 + (1.0 - 2.0e-6)*(abs(x - 0.5) < 0.2)"
eos0.gamma = 4.4
eos0.p0 = 100.0
eos0.cp = 3.5
eos0.cv = 2.5
mu0 = 0.0
mu0_b = 0.0
eos1.gamma = 1.4
eos1.p0    = 0.0
eos1.cp = 3.5
eos1.cv = 2.5
mu1 = 0.0
mu1_b = 0.0
density0.ic.type = expression
density0.ic.expression.region0 = "10.0"
velocity0.ic.type = expression
velocity0.ic.expression.region0 = "1.0"
velocity0.ic.expression.region1 = "0.0"
pressure0.ic.type = expression
pressure0.ic.expression.region0 = "1.0"
density1.ic.type = expression
density1.ic.expression.region0 = "0.1"
velocity1.ic.type = expression
velocity1.ic.expression.region0 = "1.0"
velocity1.ic.expression.region1 = "0.0"
pressure1.ic.type = expression
pressure1.ic.expression.region0 = "1.0"
epsilon = 0.1
sigma   = 0.0
Dv      = 0.0
pref    = 0.0
small   = 1e-6
grav    = 0.0
eta_refinement_criterion   = 1e10
omega_refinement_criterion = 1e10
gradu_refinement_criterion = 1e10
p_refinement_criterion = 1e10
rho_refinement_criterion = 1e10
cutoff = 1e-16
m0.ic.constant.value = 0.0
u0.ic.constant.value = 0.0 0.0
q.ic.constant.value  = 0.0 0.0
apply_surface_tension = 0
apply_weight          = 0
apply_vaporization    = 0
Riemann_Solver.type = hllc
Limiter.type        = godunov      # first-order face states: a stiff liquid|gas interface is advected with uniform p, u (minmod needs eta_consistent_advect = 1, changelog II.25)
kappa_method        = 1




eta.bc.type.xlo = periodic
eta.bc.type.xhi = periodic
eta.bc.type.ylo = periodic
eta.bc.type.yhi = periodic

density.bc.type.xlo = periodic
density.bc.type.xhi = periodic
density.bc.type.ylo = periodic
density.bc.type.yhi = periodic

density0.bc.type.xlo = periodic
density0.bc.type.xhi = periodic
density0.bc.type.ylo = periodic
density0.bc.type.yhi = periodic

density1.bc.type.xlo = periodic
density1.bc.type.xhi = periodic
density1.bc.type.ylo = periodic
density1.bc.type.yhi = periodic

energy.bc.type.xlo = periodic
energy.bc.type.xhi = periodic
energy.bc.type.ylo = periodic
energy.bc.type.yhi = periodic

momentum.bc.type.xlo = periodic periodic
momentum.bc.type.xhi = periodic periodic
momentum.bc.type.ylo = periodic periodic
momentum.bc.type.yhi = periodic periodic
nghost = 4
thermal.conduction = 0
thermal.Pr = 0.75
ablation.on = 0

species.on = 1
species.phase0.names = L1 L2            # two liquid species (L1 majority)
species.phase1.names = G1 G2 Vap        # two gas species and the vapour of L2 (a separate entry in the gas phase)
species.ic.type = expression
species.ic.expression.region0 = "1.0 - (0.25 + 0.2*cos(2.0*3.141592653589793*(x - 0.5)/0.4))"
species.ic.expression.region1 = "0.25 + 0.2*cos(2.0*3.141592653589793*(x - 0.5)/0.4)"
species.ic.expression.region2 = "1.0 - (0.2 + 0.1*sin(2.0*3.141592653589793*x)) - 1.0e-6"
species.ic.expression.region3 = "0.2 + 0.1*sin(2.0*3.141592653589793*x)"
species.ic.expression.region4 = "1.0e-6"
species.bc.type.xlo = periodic
species.bc.type.xhi = periodic
species.bc.type.ylo = periodic
species.bc.type.yhi = periodic
